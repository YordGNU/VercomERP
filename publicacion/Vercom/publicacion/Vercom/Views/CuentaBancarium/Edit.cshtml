@model Vercom.ViewModels.BankAccountFormViewModel
@{
    ViewBag.Title = "Editar Cuenta Bancaria";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Actualizar Cuenta Bancaria</h4>
        <p class="text-muted small mb-0">Modificación de parámetros de la cuenta institucional.</p>
    </div>
</div>

<div class="row">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>
        <input type="hidden" asp-for="BankAccount.Id" name="BankAccount.Id" />

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card">
                     <div class="card-header border-light justify-content-between">
                        <h5 class="m-0 fw-bold"><i class="ti ti-settings me-2 text-primary"></i>Datos de la Cuenta</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label">Banco / Institución</label>
                                <input asp-for="BankAccount.Banco" name="BankAccount.Banco" class="form-control w-100 bg-light" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tipo de Cuenta</label>
                                <select asp-for="BankAccount.TipoCuenta" name="BankAccount.TipoCuenta" class="form-control form-select w-100" required>
                                    <option value="FISCAL">Cuenta Fiscal</option>
                                    <option value="CORRIENTE">Cuenta Corriente</option>
                                    <option value="AHORRO">Cuenta de Ahorro</option>
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Número de Cuenta</label>
                                <input asp-for="BankAccount.NumeroCuenta" name="BankAccount.NumeroCuenta" class="form-control w-100 bg-light fw-bold" readonly />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Saldo Actual ($)</label>
                                <input asp-for="BankAccount.SaldoActual" name="BankAccount.SaldoActual" type="number" step="0.01" class="form-control w-100 text-numeric" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Moneda</label>
                                <input asp-for="BankAccount.Moneda" name="BankAccount.Moneda" class="form-control w-100 bg-light" readonly />
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch mt-4 pt-2">
                                    <input class="form-check-input" type="checkbox" asp-for="BankAccount.Activa" name="BankAccount.Activa">
                                    <label class="form-check-label fw-bold">Cuenta Activa para Operaciones</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline px-4">VOLVER</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy"></i> GUARDAR CAMBIOS
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
