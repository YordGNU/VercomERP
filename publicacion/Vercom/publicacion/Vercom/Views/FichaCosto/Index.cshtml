@model IEnumerable<Vercom.Models.FichaCosto>
@{
    ViewBag.Title = "Ingeniería de Costos";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Fichas de Costo (MFP)</h4>
        <p class="text-muted small mb-0">Definición de precios de venta basados en costos de insumos, mano de obra y gastos indirectos.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Producción</a></li>
            <li class="breadcrumb-item active">Fichas de Costo</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-file-analytics"></i> NUEVA FICHA DE COSTO
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle">
            <h5 class="m-0 fw-bold"><i class="ti ti-table me-2 text-primary"></i>Catálogo de Fichas Versionadas</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="costSheetsTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th>Producto Elaborado</th>
                          <th>Versión</th>
                          <th>Estado</th>
                            <th>Costo Estándar ($)</th>
                            <th>Precio Sugerido ($)</th>
                          <th>Utilidad (%)</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isVigente = item.Estado == "VIGENTE";
                            <tr>
                                <td>
                                    <div class="fw-bold fs-13">@item.Producto.Nombre</div>
                                    <small class="text-muted tiny font-monospace">@item.Producto.Codigo</small>
                                </td>
                                <td >
                                    <span class="badge border border-primary text-primary px-2">v.@item.Version</span>
                                </td>
                                <td >
                                    <span class="badge @(isVigente ? "bg-success" : "bg-light text-muted") px-3 py-1">@item.Estado</span>
                                </td>
                                <td class="text-end fw-bold">@item.CostoTotalUnitario?.ToString("N2")</td>
                                <td class="text-end text-primary fw-bold">@item.PrecioSugerido?.ToString("N2")</td>
                                <td fw-bold text-success">@item.MargenPorcentaje%</td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Ver Detalle">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        @if (isVigente)
                                        {
                                            <a asp-action="Create" asp-route-productoId="@item.ProductoId" class="btn btn-sm btn-outline py-1 px-2 text-primary" title="Nueva Versión">
                                                <i class="ti ti-copy"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#costSheetsTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
            });
        });
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-13 { font-size: 0.8125rem; }
</style>
