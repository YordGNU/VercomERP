@model Vercom.ViewModels.EntityRegistrationViewModel
@{
    Layout = "_LayoutSimple";
    ViewBag.Title = "Registro de Nueva Entidad";
}

<div class="container-tight py-4">
    <div class="text-center mb-4">
        <a href="." class="navbar-brand navbar-brand-autodark"><img src="~/Content/images/logo.png" height="36" alt=""></a>
    </div>
    <form class="card card-md" asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <h2 class="card-title text-center mb-4">Registro de Nueva S.U.R.L. / Entidad</h2>
            <p class="text-muted text-center small mb-4">Complete los datos de su empresa para solicitar el acceso al ERP Vercom Elite.</p>

            <div asp-validation-summary="All" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>

            <h5 class="mb-3 border-bottom pb-2 text-primary"><i class="ti ti-building me-2"></i>Datos Legales de la Entidad</h5>

            <div class="mb-3">
                <label class="form-label">Razón Social</label>
                <input asp-for="Entidad.RazonSocial" class="form-control" placeholder="Ej: Cooperativa de Producción Agropecuaria Alfa" required />
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label">NIT / Identificación</label>
                    <input asp-for="Entidad.Nit" class="form-control" placeholder="Ej: 5000..." required />
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label">Código REEUP</label>
                    <input asp-for="Entidad.CodigoReeup" class="form-control" placeholder="Ej: 123.1..." />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Dirección Legal</label>
                <textarea asp-for="Entidad.DireccionLegal" class="form-control" rows="2" required></textarea>
            </div>

            <h5 class="mb-3 mt-4 border-bottom pb-2 text-primary"><i class="ti ti-user-cog me-2"></i>Credenciales del Administrador</h5>
            <p class="text-muted small italic mb-3">Estos datos se usarán para el primer inicio de sesión tras la aprobación.</p>

            <div class="mb-3">
                <label class="form-label">Nombre Completo del Responsable</label>
                <input asp-for="AdminFullName" class="form-control" placeholder="Ej: Juan Pérez López" required />
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label">Usuario</label>
                    <input asp-for="AdminUsername" class="form-control" placeholder="admin_alfa" required />
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label">Email Institucional</label>
                    <input asp-for="AdminEmail" type="email" class="form-control" placeholder="admin@empresa.cu" required />
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label">Contraseña</label>
                    <input asp-for="Password" type="password" class="form-control" required />
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label">Confirmar Contraseña</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                </div>
            </div>

            <div class="form-footer mt-4">
                <button type="submit" class="btn btn-primary w-100 py-3 shadow">
                    <i class="ti ti-send me-1"></i> ENVIAR SOLICITUD DE REGISTRO
                </button>
            </div>
        </div>
    </form>
    <div class="text-center text-muted mt-3">
        ¿Ya tiene una cuenta? <a asp-controller="Auth" asp-action="Login">Iniciar Sesión</a>
    </div>
</div>
