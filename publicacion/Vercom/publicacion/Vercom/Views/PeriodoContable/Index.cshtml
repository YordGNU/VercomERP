@model IEnumerable<Vercom.Models.PeriodoContable>
@{
    ViewBag.Title = "Periodos Contables";
    var meses = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Control de Periodos Fiscales</h4>
        <p class="text-muted small mb-0">Gestión de aperturas y cierres mensuales para el reporte de estados financieros.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Contabilidad</a></li>
            <li class="breadcrumb-item active">Periodos</li>
        </ol>
    </div>
</div>
<div class="row">   
    @foreach (var item in Model)    {
        var isClosed = item.Estado == "CERRADO";   
        <div class="col-md-4">
            <div class="card @(isClosed ? "border-danger" : "ssborder-primary") card-bordered">
                <div class="card-body">  
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>  
                            <h5 class="card-title mb-1 text-primary">@meses[item.Mes]</h5>                       
                            <h6 class="card-subtitle text-body-secondary">Año @item.Anio</h6>
                        </div>
                        <span class="badge @(isClosed ? "bg-danger" : "bg-success")">@item.Estado</span>
                    </div>
                    <div class="small text-muted mb-3">
                        <i class="ti ti-calendar-range me-1"></i> @item.FechaInicio.ToString("dd/MM") al @item.FechaFin.ToString("dd/MM")
                    </div>        
                    @if (isClosed)
                    {
                        <div class="alert alert-secondary py-2 small mb-0 mt-3">
                            <i class="ti ti-lock me-1"></i> Cerrado el @item.CerradoEn?.ToString("dd/MM/yyyy")
                        </div>
                    } else
                    {
                        <button type="button" class="btn btn-danger btn-sm"  onclick="confirmClose('@item.Id', '@meses[item.Mes] @item.Anio')">
                            <i class="ti ti-lock-square-rounded me-1"></i> CERRAR PERIODO
                        </button>
                    }  
                </div> 
             </div> 
         </div>           
    }
</div>
<!-- Modal de Confirmación -->
<div class="modal fade" id="closePeriodModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="Close" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="closePeriodId" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Cierre Fiscal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <i class="ti ti-alert-triangle fs-48 text-warning mb-3"></i>
                    <h4>�Cerrar el periodo <span id="periodNameLabel"></span>?</h4>
                    <p class="text-muted">
                        Al cerrar el periodo, ya no se podrán registrar nuevos asientos contables.
                        Esta acción es definitiva y asegura la integridad de los estados financieros.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger px-4">S�, CERRAR PERIODO</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function confirmClose(id, name) {
            document.getElementById('closePeriodId').value = id;
            document.getElementById('periodNameLabel').innerText = name;
            new bootstrap.Modal(document.getElementById('closePeriodModal')).show();
        }
    </script>
}



