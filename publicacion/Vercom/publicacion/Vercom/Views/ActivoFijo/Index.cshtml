@model IEnumerable<Vercom.Models.ActivoFijo>
@{
    ViewBag.Title = "Submayor de Activos Fijos";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Medios Básicos y Activos Tangibles</h4>
        <p class="text-muted small mb-0">Control de propiedad, planta y equipo con cálculo de depreciación integrada.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Contabilidad</a></li>
            <li class="breadcrumb-item active">Activos Fijos</li>
        </ol>  
    </div>
</div>
<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-building-warehouse me-2 text-primary"></i>Inventario de Activos</h5>      
            <div class="d-flex gap-1">               
                <a asp-action="Create" class="btn btn-sm btn-primary ms-1">
                    <i class="ti ti-plus"></i> NUEVO ACTIVO
                 </a>
            </div>
        </div>
        <div class="card-body">
            <table id="assetsTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th> Cód. Inventario</th>
                        <th>Descripción del Activo</th>
                      <th>F. Adquisición</th>
                        <th>Valor Inicial ($)</th>
                        <th>Deprec. Acum.</th>
                        <th>Valor Neto</th>
                      <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var valorNeto = item.ValorAdquisicion - item.DepreciacionAcumulada;
                        var statusClass = item.Estado switch
                        {
                            "ACTIVO" => "badge-soft-success",
                            "BAJA" => "badge-soft-danger",
                            "MANTENIMIENTO" => "badge-soft-warning",
                            _ => "badge-soft-secondary"
                        };

                        <tr>
                            <td class="text-numeric fw-bold text-primary">@item.CodigoInventario</td>
                            <td class="fw-semibold">@item.Descripcion</td>
                             <td>@item.FechaAdquisicion.ToString("dd/MM/yyyy")</td>
                            <td class="text-numeric">@item.ValorAdquisicion.ToString("N2")</td>
                            <td class="text-numeric text-danger">-@item.DepreciacionAcumulada.ToString("N2")</td>
                            <td class="text-numeric fw-bold text-success">@valorNeto.ToString("N2")</td>
                            <td ><span class="badge @statusClass">@item.Estado</span></td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Detalles">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Editar">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#assetsTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
            });
        });
    </script>
}
