@model IEnumerable<Vercom.Models.FacturaVentum>
@{
    ViewBag.Title = "Historial de Ventas";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Ventas y Facturación Fiscal</h4>
        <p class="text-muted small mb-0">Gestión de ingresos por ventas directas y corporativas (ERP/POS).</p>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-receipt"></i> EMITIR NUEVA FACTURA
        </a>
    </div>
</div>

<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Libro de Ventas</h5>
        </div>
        <div class="card-body">
            <table id="salesTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th width="160" class="text-center">Fecha / Hora</th>
                        <th> Nº Factura</th>
                        <th>Cliente / Razón Social</th>
                        <th >Canal</th>
                       <th>Monto Total ($)</th>
                        <th  class="text-center">Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.Estado switch
                        {
                            "EMITIDA" => "badge-soft-success",
                            "ANULADA" => "badge-soft-danger",
                            "PENDIENTE" => "badge-soft-warning",
                            _ => "badge-soft-secondary"
                        };

                        <tr>
                            <td class="text-date text-muted">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-numeric fw-bold text-primary">@item.Serie-@item.NumeroFactura</td>
                            <td class="fw-semibold">@item.Cliente.NombreRazonSocial</td>
                            <td>
                                @if (item.CanalVenta == "POS")
                                {
                                    <span class="badge badge-soft-info"><i class="ti ti-device-mobile me-1"></i> POS</span>
                                }
                                else
                                {

                                    <span class="badge badge-soft-primary"><i class="ti ti-world me-1"></i> ERP</span>
                                }
                            </td>
                            <td class="text-numeric fw-bold">@item.Total.ToString("N2")</td>
                            <td ><span class="badge @statusClass">@item.Estado</span></td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Detalles">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    @if (item.Estado != "ANULADA")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline py-1 px-2 text-danger" title="Anular" onclick="confirmCancel('@item.Id')">
                                            <i class="ti ti-ban"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#salesTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'desc']]
            });
        });

        function confirmCancel(id) {
            Swal.fire({
                title: '¿Anular Factura?',
                text: "Esta acción generará un asiento de reversión automática (RF-12).",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'SÍ, ANULAR',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Submit cancel form or call API
                }
            });
        }
    </script>
}
