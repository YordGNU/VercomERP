@{
    ViewData["Title"] = "Actualizar Contraseña";
    Layout = "_LayoutAuth";
}

<div class="card p-4">
    <div class="text-center mb-4">
        <div class="avatar-lg bg-warning-subtle text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
            <i class="ti ti-shield-lock fs-32"></i>
        </div>
        <h2 class="fw-bold">Actualizar Clave</h2>
        <p class="text-muted">Por seguridad, debe actualizar su contraseña antes de acceder al panel principal.</p>
    </div>

    <form asp-action="ChangePassword" method="post" id="changePassForm">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="mb-3">
            <label class="form-label small fw-bold">Contraseña Actual</label>
            <input type="password" name="currentPassword" class="form-control" placeholder="Clave temporal" required />
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold">Nueva Contraseña</label>
            <input type="password" name="newPassword" class="form-control" placeholder="Nueva clave robusta" required minlength="6" />
            <div class="form-text small">Mínimo 6 caracteres, incluya números y símbolos.</div>
        </div>

        <div class="mb-4">
            <label class="form-label small fw-bold">Confirmar Nueva Contraseña</label>
            <input type="password" name="confirmPassword" class="form-control" placeholder="Repita la nueva clave" required />
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary py-2 fw-bold">GUARDAR Y CONTINUAR</button>
        </div>
    </form>

    <div class="mt-4 border-top pt-3 text-center">
        <form asp-action="Logout" method="post">
            <button type="submit" class="btn btn-link btn-sm text-muted text-decoration-none">
                <i class="ti ti-logout me-1"></i> Cerrar sesión y salir
            </button>
        </form>
    </div>
</div>
