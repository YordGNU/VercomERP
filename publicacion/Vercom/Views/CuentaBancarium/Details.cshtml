@model Vercom.Models.CuentaBancarium
@{
    ViewBag.Title = "Estado de Cuenta Bancaria";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Cuenta: @Model.Banco - @Model.NumeroCuenta</h4>
        <p class="text-muted small mb-0">Monitoreo de liquidez, conciliación y movimientos bancarios.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Tesorería</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Bancos</a></li>
            <li class="breadcrumb-item active">Estado</li>
        </ol>
        <div class="btn-list">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                <i class="ti ti-edit me-1"></i> MODIFICAR CUENTA
            </a>
            <a asp-controller="MovimientoBancario" asp-action="Create" asp-route-accountId="@Model.Id" class="btn btn-sm btn-primary shadow-sm">
                <i class="ti ti-plus me-1"></i> REGISTRAR MOVIMIENTO
            </a>
        </div>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <!-- Tarjeta de Saldo Estilo Wallet -->
        <div class="col-lg-4">
            <div class="card bg-dark text-white border-0 shadow-lg mb-4 overflow-hidden" style="border-radius: 1.25rem;">
                <div class="card-body p-4 position-relative">
                    <div class="position-absolute end-0 top-0 mt-n4 me-n4 opacity-10">
                        <i class="ti ti-building-bank fs-150"></i>
                    </div>
                    <div class="d-flex justify-content-between align-items-start mb-5">
                        <div>
                            <h5 class="text-white-50 small fw-bold text-uppercase mb-1">Saldo Disponible</h5>
                            <h1 class="display-5 fw-bold mb-0">@Model.SaldoActual.ToString("N2")</h1>
                            <span class="badge bg-primary px-3">@Model.Moneda</span>
                        </div>
                        <div class="bg-white bg-opacity-10 p-2 rounded-3">
                            <i class="ti ti-wifi fs-24"></i>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-end mt-4">
                        <div class="small">
                            <span class="text-white-50 d-block">Número de Cuenta</span>
                            <span class="fw-bold font-monospace">@Model.NumeroCuenta</span>
                        </div>
                        <div class="text-end">
                            <span class="badge @(Model.Activa ? "bg-success" : "bg-danger") px-3 py-2">
                                @(Model.Activa ? "OPERATIVA" : "SUSPENDIDA")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold small text-uppercase">Vínculo Contable</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle me-3">
                            <i class="ti ti-calculator fs-28"></i>
                        </div>
                        <div>
                            <div class="text-muted tiny fw-bold text-uppercase">Libro Mayor</div>
                            <div class="fw-bold text-primary">@Model.CuentaContable.Codigo - @Model.CuentaContable.Nombre</div>
                        </div>
                    </div>
                    <div class="alert alert-info py-2 px-3 mt-4 mb-0 small border-0">
                        <i class="ti ti-info-circle me-1"></i> Todos los movimientos bancarios se reflejan automáticamente en esta cuenta.
                    </div>
                </div>
            </div>
        </div>

        <!-- Listado de Movimientos -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Historial de Transacciones</h5>
                    <span class="badge badge-soft-primary">Últimos 50 registros</span>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-hover">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Concepto / Referencia</th>
                                  <th>Tipo</th>
                                    <th>Monto</th>
                                  <th>Conc.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.MovimientoBancarios.OrderByDescending(x => x.Fecha).Take(50))
                                {
                                    var isCredit = m.Tipo == "CREDITO" || m.Tipo == "INGRESO";
                                    <tr>
                                        <td class="small text-muted">@m.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <div class="fw-bold fs-13">@m.Descripcion</div>
                                            <div class="text-muted tiny font-monospace">REF: @m.Referencia</div>
                                        </td>
                                        <td >
                                            <span class="badge @(isCredit ? "badge-soft-success" : "badge-soft-danger") tiny fw-bold">@m.Tipo</span>
                                        </td>
                                        <td class="text-end fw-bold @(isCredit ? "text-success" : "text-danger")">
                                            @(isCredit ? "" : "-")@m.Monto.ToString("N2")
                                        </td>
                                        <td >
                                            @if(m.Conciliado) { <i class="ti ti-circle-check-filled text-success" title="Conciliado"></i> }
                                            else { <i class="ti ti-clock text-warning" title="Pendiente"></i> }
                                        </td>
                                    </tr>
                                }
                                @if(!Model.MovimientoBancarios.Any()) {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted small">No se registran transacciones para esta cuenta.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="ti ti-arrow-left me-1"></i> VOLVER AL LISTADO
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-13 { font-size: 0.8125rem; }
    .fs-150 { font-size: 150px; }
</style>
