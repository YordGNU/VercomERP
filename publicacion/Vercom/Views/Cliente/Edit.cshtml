@model Vercom.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Editar Cliente</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Ventas</a></li>
            <li class="breadcrumb-item active">Clientes</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Edición</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="col-md-6">
                            <label asp-for="EntidadId" class="form-label"></label>
                            <select asp-for="EntidadId" class="form-select" asp-items="ViewBag.EntidadId"></select>
                            <span asp-validation-for="EntidadId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TipoPersona" class="form-label"></label>
                            <select asp-for="TipoPersona" class="form-select">
                                <option value="">Seleccione tipo</option>
                                <option value="Natural">Persona Natural</option>
                                <option value="Juridica">Persona Jurídica</option>
                            </select>
                            <span asp-validation-for="TipoPersona" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="NitOCi" class="form-label"></label>
                            <input asp-for="NitOCi" class="form-control" placeholder="NIT o CI" />
                            <span asp-validation-for="NitOCi" class="text-danger"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="NombreRazonSocial" class="form-label"></label>
                            <input asp-for="NombreRazonSocial" class="form-control" placeholder="Nombre o razón social" />
                            <span asp-validation-for="NombreRazonSocial" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Segmento" class="form-label"></label>
                            <select asp-for="Segmento" class="form-select">
                                <option value="">Seleccione segmento</option>
                                <option value="Minorista">Minorista</option>
                                <option value="Mayorista">Mayorista</option>
                                <option value="Estatal">Estatal</option>
                                <option value="Mipyme">MIPYME</option>
                            </select>
                            <span asp-validation-for="Segmento" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ListaPrecioId" class="form-label"></label>
                            <select asp-for="ListaPrecioId" class="form-select" asp-items="ViewBag.ListaPrecioId"></select>
                            <span asp-validation-for="ListaPrecioId" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="LimiteCredito" class="form-label"></label>
                            <input asp-for="LimiteCredito" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="LimiteCredito" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Direccion" class="form-label"></label>
                            <input asp-for="Direccion" class="form-control" placeholder="Dirección completa" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label"></label>
                            <input asp-for="Telefono" class="form-control" placeholder="Teléfono de contacto" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="Correo electrónico" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CuentaContableId" class="form-label"></label>
                            <select asp-for="CuentaContableId" class="form-select" asp-items="ViewBag.CuentaContableId"></select>
                            <span asp-validation-for="CuentaContableId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CreadoEn" class="form-label"></label>
                            <input asp-for="CreadoEn" class="form-control" type="datetime-local" />
                            <span asp-validation-for="CreadoEn" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" asp-for="Activo" />
                                <label class="form-check-label" asp-for="Activo">
                                    @Html.DisplayNameFor(model => model.Activo)
                                </label>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}