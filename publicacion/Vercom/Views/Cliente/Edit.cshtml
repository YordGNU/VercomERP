@model Vercom.Models.Cliente
@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Actualizar Datos de Cliente</h4>
        <p class="text-muted small mb-0">Modificación de perfil comercial y límites de riesgo (RF-50).</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Ventas</a></li>
            <li class="breadcrumb-item active">Clientes</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary"><i class="ti ti-edit me-2"></i>Editando: @Model.NombreRazonSocial</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> VOLVER AL LISTADO
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" class="row g-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-4">
                            <label asp-for="TipoPersona" class="form-label fw-bold">Tipo de Cliente</label>
                            <select asp-for="TipoPersona" class="form-select">
                                <option value="JURIDICA">PERSONA JURÍDICA (EMPRESA)</option>
                                <option value="NATURAL">PERSONA NATURAL (PARTICULAR)</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="NitOCi" class="form-label fw-bold">Identificación (NIT/CI)</label>
                            <input asp-for="NitOCi" class="form-control" maxlength="20" required />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Segmento" class="form-label fw-bold">Segmento Mercantil</label>
                            <select asp-for="Segmento" class="form-select">
                                <option value="MINORISTA">MINORISTA (PÚBLICO)</option>
                                <option value="MAYORISTA">MAYORISTA (CORPORATIVO)</option>
                            </select>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="NombreRazonSocial" class="form-label fw-bold">Nombre / Razón Social</label>
                            <input asp-for="NombreRazonSocial" class="form-control fw-bold" required />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ListaPrecioId" class="form-label fw-bold">Lista de Precios</label>
                            <select asp-for="ListaPrecioId" class="form-select select2" asp-items="ViewBag.ListaPrecioId">
                                <option value="">-- PRECIOS GENERALES --</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Direccion" class="form-label fw-bold">Dirección Fiscal / Residencia</label>
                            <input asp-for="Direccion" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label fw-bold">Teléfono</label>
                            <input asp-for="Telefono" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
                            <input asp-for="Email" class="form-control" type="email" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LimiteCredito" class="form-label fw-bold">Límite de Crédito Permitido ($)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="LimiteCredito" class="form-control text-end fw-bold text-danger" type="number" step="0.01" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CuentaContableId" class="form-label fw-bold">Cuenta Contable (Contabilidad)</label>
                            <select asp-for="CuentaContableId" class="form-select select2" asp-items="ViewBag.CuentaContableId" required></select>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="Activo">
                                <label class="form-check-label fw-bold" asp-for="Activo">Cliente Activo para Operaciones</label>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-primary px-5 shadow">
                                <i class="ti ti-device-floppy me-1"></i> ACTUALIZAR CLIENTE
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
