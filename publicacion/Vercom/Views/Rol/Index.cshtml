@model IEnumerable<Vercom.Models.Rol>
@{
    ViewBag.Title = "Seguridad: Roles de Usuario";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Seguridad: Perfiles de Acceso</h4>
        <p class="text-muted small mb-0">Definición de roles y matrices de permisos según segregación de funciones (Res. 60/2011).</p>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-shield-plus"></i> CREAR NUEVO ROL
        </a>
    </div>
</div>

<div class="row">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card h-100 border-top border-primary border-3 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold m-0 text-primary">@item.Nombre</h5>
                            @if(item.EsSistema) {
                                <span class="badge bg-danger-subtle text-danger small">SISTEMA</span>
                            }
                        </div>
                        <p class="text-muted small mb-4" style="min-height: 40px;">
                            @(item.Descripcion ?? "Sin descripción asignada.")
                        </p>

                        <div class="d-flex justify-content-between align-items-center py-2 px-3 bg-light rounded-3 mb-4">
                            <div class="small">
                                <i class="ti ti-key me-1"></i> <span class="fw-bold">@item.Permisos.Count</span> Permisos
                            </div>
                            <div class="small">
                                <i class="ti ti-users me-1"></i> <span class="fw-bold">@item.UsuarioRols.Count</span> Usuarios
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="ti ti-eye me-1"></i> VER MATRIZ
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-ghost-secondary flex-grow-1">
                                    <i class="ti ti-edit"></i>
                                </a>
                                @if(!item.EsSistema) {
                                    <button type="button" class="btn btn-sm btn-ghost-danger flex-grow-1" onclick="confirmDelete('@item.Id')">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            Swal.fire({
                title: '¿Eliminar Rol?',
                text: "Esta acción afectará el acceso de todos los usuarios vinculados.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'ELIMINAR'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Acción de borrado vía AJAX o Form oculto
                }
            });
        }
    </script>
}
