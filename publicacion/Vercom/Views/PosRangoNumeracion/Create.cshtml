@model Vercom.Models.PosRangoNumeracion

@{
    ViewData["Title"] = "Create";
}



<h4>PosRangoNumeracion</h4>
<hr />
<div class="row">
    <div class="col-md-4">
       <div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Crear PosRangoNumeracion</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">PosRangoNumeracion</a></li>
            <li class="breadcrumb-item active">Crear</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h4 class="card-title">Formulario de Creación</h4>
                </div>
                <div class="card-body">
<form class="row g-3" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="DispositivoPosId" class="form-label"></label>
                <select asp-for="DispositivoPosId" class ="form-control" asp-items="ViewBag.DispositivoPosId"></select>
            </div>
            <div class="mb-3">
                <label asp-for="Serie" class="form-label"></label>
                <input asp-for="Serie" class="form-control" />
                <span asp-validation-for="Serie" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NumeroDesde" class="form-label"></label>
                <input asp-for="NumeroDesde" class="form-control" />
                <span asp-validation-for="NumeroDesde" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NumeroHasta" class="form-label"></label>
                <input asp-for="NumeroHasta" class="form-control" />
                <span asp-validation-for="NumeroHasta" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NumeroSiguienteLocal" class="form-label"></label>
                <input asp-for="NumeroSiguienteLocal" class="form-control" />
