@model Vercom.Models.CuentaPorPagar
@{
    ViewBag.Title = "Alta de Cuenta por Pagar";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Registrar Obligación de Pago</h4>
        <p class="text-muted small mb-0">Carga manual de pasivos con proveedores o compromisos financieros pendientes.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Finanzas</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">CxP</a></li>
            <li class="breadcrumb-item active">Nueva</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 border-start border-danger border-4">
                <div class="card-header bg-danger-subtle py-3">
                    <h5 class="m-0 fw-bold text-danger"><i class="ti ti-receipt-tax me-2"></i>Datos del Pasivo Exigible</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-4">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Proveedor / Acreedor</label>
                            <select asp-for="ProveedorId" class="form-control form-select w-100 select2" asp-items="ViewBag.ProveedorId" required>
                                <option value="">-- Buscar en Directorio de Proveedores --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tipo de Documento Sustento</label>
                            <select asp-for="DocumentoOrigenTipo" class="form-select" required>
                                <option value="FACTURA_PROV">Factura de Proveedor</option>
                                <option value="ORDEN_COMPRA">Orden de Compra</option>
                                <option value="REVERSION">Reversión de Cobro</option>
                                <option value="OTROS">Otros Gastos</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nº Factura / Documento</label>
                            <input asp-for="DocumentoOrigenId" name="DocumentoOrigenId" class="form-control" placeholder="Ej: INV-9988" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Fecha de Emisión</label>
                            <input asp-for="FechaEmision" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Fecha de Pago Comprometida</label>
                            <input asp-for="FechaVencimiento" type="date" class="form-control" value="@DateTime.Now.AddDays(15).ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-6 mt-4 pt-3 border-top">
                            <label class="form-label fw-bold">Importe Total Original ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="MontoOriginal" class="form-control fw-bold text-end" placeholder="0.00" step="0.01" required />
                            </div>
                        </div>

                        <div class="col-md-6 mt-4 pt-3 border-top">
                            <label class="form-label fw-bold">Saldo Pendiente Real ($)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="SaldoPendiente" class="form-control fw-bold text-danger text-end" placeholder="0.00" step="0.01" required />
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-danger px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> REGISTRAR DEUDA
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
