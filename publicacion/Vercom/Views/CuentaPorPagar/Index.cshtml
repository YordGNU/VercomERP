@model IEnumerable<Vercom.Models.CuentaPorPagar>
@{
    ViewBag.Title = "Cuentas por Pagar";
    var today = DateOnly.FromDateTime(DateTime.Now);
    var overdueAmount = Model.Where(c => c.FechaVencimiento < today && c.Estado != "PAGADA").Sum(c => c.SaldoPendiente);
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Obligaciones Financieras: Cuentas por Pagar</h4>
        <p class="text-muted small mb-0">Seguimiento de deudas con proveedores y compromisos de pago pendientes.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Finanzas</a></li>
            <li class="breadcrumb-item active">CxP</li>
        </ol>
        <div class="bg-dark text-white px-3 py-2 rounded-3 shadow-sm d-inline-block">
            <span class="small fw-bold opacity-75">PASIVO EXIGIBLE VENCIDO:</span>
            <span class="h4 m-0 fw-bold ms-2">@overdueAmount.ToString("C")</span>
        </div>
    </div>
</div>

<div class="container-xxl">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold"><i class="ti ti-receipt-tax me-2 text-danger"></i>Programación de Pagos a Proveedores</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="cxpTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th class="ps-4">Vencimiento</th>
                            <th>Proveedor</th>
                            <th>Nº Documento</th>
                            <th>Monto Original</th>
                            <th>Saldo Pendiente</th>
                          <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(c => c.FechaVencimiento))
                        {
                            var isOverdue = item.FechaVencimiento < today && item.Estado != "PAGADA";
                            var rowClass = isOverdue ? "bg-danger-subtle bg-opacity-10" : "";

                            <tr class="@rowClass">
                              <td>
                                    <div class="fw-bold @(isOverdue ? "text-danger" : "")">
                                        @item.FechaVencimiento.ToString("dd/MM/yyyy")
                                        @if (isOverdue) { <i class="ti ti-alert-triangle ms-1" title="DEUDA VENCIDA"></i> }
                                    </div>
                                    <small class="text-muted tiny">Emisión: @item.FechaEmision.ToString("dd/MM")</small>
                                </td>
                                <td>
                                    <div class="fw-semibold fs-13">@item.Proveedor.RazonSocial</div>
                                    <small class="text-muted tiny">NIT: @item.Proveedor.Nit</small>
                                </td>
                                <td>
                                    <span class="badge badge-outline text-muted small">@item.DocumentoOrigenTipo</span>
                                </td>
                                <td class="text-end small">@item.MontoOriginal.ToString("N2")</td>
                                <td class="text-end fw-bold @(isOverdue ? "text-danger" : "text-dark")">
                                    @item.SaldoPendiente.ToString("N2")
                                </td>
                                <td >
                                    @{
                                        var statusClass = item.Estado switch {
                                            "PENDIENTE" => "bg-warning-subtle text-warning",
                                            "PARCIAL" => "bg-info-subtle text-info",
                                            "PAGADA" => "bg-success-subtle text-success",
                                            _ => "bg-light"
                                        };
                                    }
                                    <span class="badge @statusClass px-3">@item.Estado</span>
                                </td>
                                <td>
                                    <div class="btn-list justify-content-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle" title="Registrar Pago">
                                            <i class="ti ti-cash"></i>
                                        </a>
                                        <a asp-controller="Proveedor" asp-action="Details" asp-route-id="@item.ProveedorId" class="btn btn-sm btn-icon btn-light rounded-circle" title="Ficha Proveedor">
                                            <i class="ti ti-truck-delivery"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#cxpTable').DataTable({
                language: { url: '/js/i18n/es-ES.json' },
                order: [[0, 'asc']]
            });
        });
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-13 { font-size: 0.8125rem; }
</style>
