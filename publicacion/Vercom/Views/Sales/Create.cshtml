@model Vercom.ViewModels.SalesCreateViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Emisión de Factura de Venta</h4>
        <p class="text-muted small mb-0">Registro de ingresos y generación automática de comprobante fiscal y cuenta por cobrar.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Comercial</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Ventas</a></li>
            <li class="breadcrumb-item active">Nueva Factura</li>
        </ol>
    </div>
</div>

<div class="row">
    <form asp-action="Create" method="post" id="invoiceForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>

        <div class="row">
            <!-- Columna Principal: Datos y Partidas -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light-subtle py-3">
                        <h5 class="m-0 fw-bold"><i class="ti ti-user-circle me-2 text-primary"></i>Datos del Cliente y Despacho</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Invoice.ClienteId" class="form-label fw-bold"></label>
                                <select asp-for="Invoice.ClienteId" class="form-control form-select w-100 select2" asp-items="Model.Clientes" required>
                                    <option value="">-- Buscar Cliente --</option>
                                </select>
                                <span asp-validation-for="Invoice.ClienteId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Invoice.ContratoId" class="form-label fw-bold"></label>
                                <select asp-for="Invoice.ContratoId" class="form-control form-select w-100" asp-items="Model.Contratos">
                                    <option value="">-- Operación sin contrato --</option>
                                </select>
                                <span asp-validation-for="Invoice.ContratoId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Invoice.AlmacenId" class="form-label fw-bold"></label>
                                <select asp-for="Invoice.AlmacenId" class="form-control form-select w-100 select2" asp-items="Model.Almacenes" required></select>
                                <span asp-validation-for="Invoice.AlmacenId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Invoice.TipoVenta" class="form-label fw-bold"></label>
                                <select asp-for="Invoice.TipoVenta" class="form-control form-select w-100" id="tipoVenta">
                                    <option value="MINORISTA">Minorista (Público)</option>
                                    <option value="MAYORISTA">Mayorista (Empresarial)</option>
                                </select>
                                <span asp-validation-for="Invoice.TipoVenta" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Invoice.Serie" class="form-label fw-bold"></label>
                                <input asp-for="Invoice.Serie" name="Invoice.Serie" class="form-control w-100 fw-bold text-center text-primary" value="ERP" required />
                                <span asp-validation-for="Invoice.Serie" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center py-3">
                        <h5 class="m-0 fw-bold"><i class="ti ti-shopping-cart me-2 text-primary"></i>Detalle de Artículos y Servicios</h5>
                        <button type="button" class="btn btn-sm btn-primary shadow-sm" onclick="addRow()">
                            <i class="ti ti-plus me-1"></i> AÑADIR LÍNEA
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table mb-0" id="detailsTable">
                            <thead class="thead-sm text-uppercase fs-xxs">
                                    <tr>
                                        <th class="ps-4">Producto / Servicio</th>
                                        <th class="text-center" width="120">Cantidad</th>
                                        <th class="text-end" width="150">Precio Unit. ($)</th>
                                        <th class="text-end pe-4" width="150">Importe ($)</th>
                                        <th width="40"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dinámico por JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Lateral: Resumen de Cobro -->
            <div class="col-lg-4">
                <div class="card border-primary border-3 shadow-lg mb-4">
                    <div class="card-header bg-primary text-white border-0 py-3">
                        <h5 class="m-0 fw-bold"><i class="ti ti-calculator me-2"></i>Totalización</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal Neto:</span>
                            <span class="fw-bold" id="labelSubtotal">0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 align-items-center">
                            <span class="text-muted small">Descuento Global:</span>
                            <div class="input-group input-group-sm w-50">
                                <span class="input-group-text bg-transparent border-end-0 text-danger">-</span>
                                <input asp-for="Invoice.DescuentoTotal" name="Invoice.DescuentoTotal" class="form-control text-end border-start-0 text-danger fw-bold" value="0.00" onchange="calculateTotals()" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted" id="labelTaxText">Impuesto Ventas (10%):</span>
                            <span class="fw-bold" id="labelTax">0.00</span>
                        </div>
                        <hr class="border-secondary opacity-10">
                        <div class="text-center py-2">
                            <h4 class="text-muted tiny fw-bold text-uppercase mb-1">TOTAL FACTURA</h4>
                            <h1 class="display-5 fw-bold text-primary mb-0" id="labelTotal">0.00</h1>
                        </div>

                        <div class="bg-light-subtle rounded-3 p-4 mt-4 border border-dashed">
                            <h6 class="tiny fw-bold text-uppercase text-muted mb-3"><i class="ti ti-cash me-1"></i>Cobro en Punto de Venta</h6>
                            <div class="mb-2">
                                <label class="form-label small fw-bold">Efectivo Recibido</label>
                                <input type="number" name="Invoice.FormaPagoVenta[0].Monto" id="pagoMonto" class="form-control form-control-lg text-end fw-bold text-success" value="0.00" step="0.01" onchange="calculateTotals()" />
                                <input type="hidden" name="Invoice.FormaPagoVenta[0].FormaPago" value="EFECTIVO" />
                            </div>
                            <div id="alertCredito" style="display:none;" class="alert alert-warning border-0 py-2 small mt-3 mb-0">
                                <i class="ti ti-alert-circle me-1"></i> Se generará saldo en <strong>Cuentas por Cobrar</strong>.
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg py-3 shadow" id="btnSubmit" disabled>
                                <i class="ti ti-printer me-1"></i> EMITIR FACTURA
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">DESCARTAR</a>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info border-0 shadow-sm small py-3">
                    <i class="ti ti-info-circle me-1"></i> La emisión de esta factura rebajará automáticamente el stock del almacén seleccionado.
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let rowCount = 0;
        const parsedProductos = @Html.Raw(Json.Serialize(Model.ProductosDisponibles));
        const taxRate = parseFloat('@ViewBag.TaxRate') / 100;

        function addRow() {
            const tbody = document.querySelector("#detailsTable tbody");
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>
                    <select name="Invoice.FacturaVentaDetalles[${rowCount}].ProductoId" class="form-control form-select w-100 select2-dynamic" onchange="updatePrice(this, ${rowCount})" required>
                        <option value="">-- Buscar Artículo --</option>
                        ${parsedProductos.map(p => `<option value="${p.id}" data-price="${p.precioVentaActual}">${p.codigo} - ${p.nombre}</option>`).join('')}
                    </select>
                    <div class="tope-warning small text-danger mt-1" style="display:none;"><i class="ti ti-alert-triangle"></i> Excede tope legal</div>
                </td>
                <td><input name="Invoice.FacturaVentaDetalles[${rowCount}].Cantidad" type="number" step="0.01" class="form-control text-center fw-bold input-qty" value="1.00" onchange="calculateTotals()" required /></td>
                <td><input name="Invoice.FacturaVentaDetalles[${rowCount}].PrecioUnitario" type="number" step="0.01" class="form-control text-end input-price" value="0.00" onchange="calculateTotals()" required /></td>
               <td class="pe-4 fw-bold text-dark label-line-total">0.00</td>
                <td>
                    <button type="button" class="btn btn-sm btn-icon btn-ghost-danger border-0" onclick="this.closest('tr').remove(); calculateTotals();">
                        <i class="ti ti-trash"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(row);

            $(row).find('.select2-dynamic').select2({
                width: '100%',
                placeholder: '-- Buscar Artículo --',
                dropdownParent: $('#invoiceForm')
            });

            rowCount++;
        }

        function updatePrice(select, index) {
            const option = select.options[select.selectedIndex];
            const price = option.getAttribute('data-price') || 0;
            const row = select.closest('tr');
            row.querySelector('.input-price').value = price;

            // Validar Tope de Precio (AJAX opcional o local si se tuviera la data)
            const productoId = $(select).val();
            const precio = parseFloat(price);

            fetch(`/TopePrecioMfp/GetTope?productoId=${productoId}`)
                .then(res => res.json())
                .then(data => {
                    const warning = $(row).find('.tope-warning');
                    if (data.exists && precio > data.precioMaximo) {
                        warning.text(`Excede tope legal ($${data.precioMaximo})`).show();
                    } else {
                        warning.hide();
                    }
                });

            calculateTotals();
        }

        function calculateTotals() {
            let subtotal = 0;
            document.querySelectorAll("#detailsTable tbody tr").forEach(row => {
                const qty = parseFloat(row.querySelector('.input-qty').value || 0);
                const price = parseFloat(row.querySelector('.input-price').value || 0);
                const lineTotal = qty * price;
                row.querySelector('.label-line-total').innerText = lineTotal.toLocaleString('en-US', { minimumFractionDigits: 2 });
                subtotal += lineTotal;
            });

            const discount = parseFloat(document.getElementsByName('Invoice.DescuentoTotal')[0].value || 0);
            const tax = (subtotal - discount) * taxRate;
            const total = (subtotal - discount) + tax;

            document.getElementById('labelSubtotal').innerText = subtotal.toLocaleString('en-US', { minimumFractionDigits: 2 });
            document.getElementById('labelTax').innerText = tax.toLocaleString('en-US', { minimumFractionDigits: 2 });
            document.getElementById('labelTotal').innerText = total.toLocaleString('en-US', { minimumFractionDigits: 2 });
            document.getElementById('labelTaxText').innerText = `Impuesto Ventas (${(taxRate * 100).toFixed(0)}%):`;

            const pagoMontoInput = document.getElementById('pagoMonto');
            if (parseFloat(pagoMontoInput.value) === 0) pagoMontoInput.value = total.toFixed(2);

            const isCredit = (parseFloat(pagoMontoInput.value) < total - 0.01);
            document.getElementById('alertCredito').style.display = isCredit ? 'block' : 'none';

            if (isCredit) {
                checkCreditLimit(total - parseFloat(pagoMontoInput.value));
            }

            document.getElementById('btnSubmit').disabled = total <= 0;
        }

        function checkCreditLimit(amount) {
            const clienteId = $('#Invoice_ClienteId').val();
            if (!clienteId) return;

            fetch(`/Sales/CheckCreditLimit?clienteId=${clienteId}&amount=${amount}`)
                .then(res => res.json())
                .then(data => {
                    if (!data.succeeded) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Riesgo de Crédito',
                            text: data.message,
                            confirmButtonColor: '#3085d6'
                        });
                        $('#btnSubmit').prop('disabled', true);
                    }
                });
        }

        document.addEventListener('DOMContentLoaded', () => {
            addRow();
            $('#Invoice_ClienteId').on('change', calculateTotals);
            window.SubmitAjaxForm('invoiceForm');
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
