@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>ACCESO DENEGADO | VERCOM ELITE</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="~/css/vendors.min.css" rel="stylesheet" />
    <link href="~/css/app.min.css" rel="stylesheet" />
    <link href="~/css/animate.css" rel="stylesheet" />
    <style>
        .error-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="text-center p-5 animated shake">
            <div class="mb-4">
                <i class="ti ti-lock-off text-danger" style="font-size: 80px"></i>
            </div>
            <h1 class="fw-bold display-4">403</h1>
            <h3 class="mb-3">Acceso Restringido</h3>
            <p class="text-muted mb-4">
                Lo sentimos, no tiene los permisos necesarios para acceder a este módulo.<br/>
                Por favor, contacte con el administrador del sistema.
            </p>
            <div class="d-flex gap-2 justify-content-center">
                <a href="/" class="btn btn-primary px-4">Ir al Dashboard</a>
                <form asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-secondary px-4">Cerrar Sesión</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
