@model Vercom.ViewModels.BomCreateViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">@Model.Title</h4>
        <p class="text-muted small mb-0">Configuración de la hoja de ruta de materiales y normas de consumo.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Producción</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">BOM</a></li>
            <li class="breadcrumb-item active">Nueva</li>
        </ol>
    </div>
</div>

<div class="row">
    <form asp-action="Create" method="post" id="bomForm">
        @Html.AntiForgeryToken()
        <div class="row">
            <!-- Encabezado de la Estructura -->
            <div class="col-lg-12 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="row g-4 align-items-end">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Producto Terminado / Elaborado</label>
                                <select asp-for="Bom.ProductoTerminadoId" name="Bom.ProductoTerminadoId" class="form-control form-select w-100 select2" asp-items="Model.ProductosElaborados" required>
                                    <option value="">-- Seleccione el producto final --</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Versión</label>
                                <input asp-for="Bom.Version" name="Bom.Version" class="form-control fw-bold text-center" value="1" required />
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch p-2 bg-light-subtle rounded border border-dashed">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Bom.Activa" name="Bom.Activa" checked>
                                    <label class="form-check-label fw-bold" asp-for="Bom.Activa">Activar automáticamente</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detalle de Partidas (Explosión) -->
            <div class="col-lg-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center py-3">
                        <h5 class="m-0 fw-bold"><i class="ti ti-components me-2 text-primary"></i>Materiales, Insumos y Envases</h5>
                        <button type="button" class="btn btn-sm btn-primary shadow-sm" onclick="addRow()">
                            <i class="ti ti-plus me-1"></i> AÑADIR INSUMO
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table table-hover mb-0" id="detailsTable">
                            <thead class="thead-sm text-uppercase fs-xxs">
                                    <tr>
                                        <th class="ps-4">Insumo / Materia Prima</th>
                                        <th>Cant. Neta (x 1 UN)</th>
                                        <th>Merma Est. (%)</th>
                                        <th class="pe-4">Observaciones del Componente</th>
                                        <th width="50"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dinámico por JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-light-subtle d-flex justify-content-between align-items-center p-4">
                        <div class="text-muted small">
                            <i class="ti ti-info-circle me-1"></i> El sistema escalará automáticamente estas cantidades al generar Órdenes de Producción.
                        </div>
                        <div class="btn-list">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR ESTRUCTURA
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // ... (resto del código JS de addRow)

        document.addEventListener('DOMContentLoaded', () => {
            if (document.querySelectorAll("#detailsTable tbody tr").length === 0) addRow();
            window.SubmitAjaxForm('bomForm');
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
