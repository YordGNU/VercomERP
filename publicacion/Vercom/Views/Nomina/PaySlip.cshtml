@model Vercom.Models.NominaDetalle
@{
    ViewBag.Title = "Boleta de Pago";
    var meses = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}

<div class="page-title-head d-flex align-items-center mb-4 print-hide">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Comprobante de Pago Individual</h4>
        <p class="text-muted small mb-0">Detalle de haberes y retenciones para el colaborador.</p>
    </div>
    <div class="text-end">
        <button onclick="window.print()" class="btn btn-sm btn-primary">
            <i class="ti ti-printer me-1"></i> IMPRIMIR BOLETA
        </button>
        <a asp-action="Details" asp-route-id="@Model.PeriodoNominaId" class="btn btn-sm btn-outline-secondary">VOLVER</a>
    </div>
</div>

<div class="container" style="max-width: 800px;">
    <div class="card border shadow-none" style="background: white;">
        <div class="card-body p-5">
            <!-- Header Boleta -->
            <div class="row mb-4 border-bottom pb-3">
                <div class="col-6">
                    <h5 class="fw-bold mb-0">TIERRA PROMETIDA S.U.R.L.</h5>
                    <p class="text-muted tiny mb-0">BOLETA DE PAGO DE SALARIOS</p>
                </div>
                <div class="col-6 text-end">
                    <div class="badge bg-light text-dark p-2 border">
                        PERIODO: @meses[Model.PeriodoNomina.Mes] @Model.PeriodoNomina.Anio
                    </div>
                </div>
            </div>

            <!-- Datos Colaborador -->
            <div class="row g-3 mb-4">
                <div class="col-md-7">
                    <label class="tiny fw-bold text-muted text-uppercase d-block">Colaborador:</label>
                    <div class="fw-bold fs-5">@Model.Empleado.NombreCompleto</div>
                    <small class="text-muted">Cargo: @Model.Empleado.Cargo.Nombre</small>
                </div>
                <div class="col-md-5 text-md-end">
                    <label class="tiny fw-bold text-muted text-uppercase d-block">Identificación:</label>
                    <div class="fw-semibold">@Model.Empleado.CarnetIdentidad</div>
                    <small class="text-muted">Días Liquidados: @Model.DiasTrabajados.ToString("N1")</small>
                </div>
            </div>

            <!-- Tabla de Conceptos -->
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3">Concepto / Descripción</th>
                            <th class="text-end" width="150">Devengo (+)</th>
                            <th class="text-end pe-3" width="150">Deducción (-)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ps-3">Salario por Tiempo / Resultados</td>
                            <td class="text-end">@Model.SalarioDevengado.ToString("N2")</td>
                           <td class="pe-3">-</td>
                        </tr>
                        @foreach (var c in Model.NominaDetalleConceptos)
                        {
                            <tr>
                                <td class="ps-3 small">@c.Concepto.Nombre</td>
                                <td class="text-end">@(c.Monto > 0 ? c.Monto.ToString("N2") : "-")</td>
                               <td class="pe-3">@(c.Monto < 0 ? Math.Abs(c.Monto).ToString("N2") : "-")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="fw-bold bg-primary bg-opacity-10">
                        <tr>
                            <td class="ps-3 text-uppercase">Totales:</td>
                            <td class="text-end">@Model.SalarioDevengado.ToString("N2")</td>
                           <td class="pe-3 text-danger">@Model.TotalDeducciones.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Gran Total -->
            <div class="text-end mt-4">
                <div class="d-inline-block border-bottom border-primary border-3 pb-1">
                    <h6 class="text-muted tiny fw-bold text-uppercase mb-1">Neto a Percibir:</h6>
                    <h2 class="fw-bold text-primary mb-0">@Model.SalarioNeto.ToString("C")</h2>
                </div>
            </div>

            <!-- Mensaje de Bancarización -->
            @if(!string.IsNullOrEmpty(Model.Empleado.CuentaBancariaPago)) {
                <div class="alert alert-light border-0 small mt-4 p-3 bg-light">
                    <i class="ti ti-credit-card me-1"></i> Fondos dispersados a cuenta: <strong>@Model.Empleado.CuentaBancariaPago</strong>
                </div>
            }

            <!-- Firmas (Para imprimir) -->
            <div class="row mt-5 pt-5 text-center d-none d-print-flex">
                <div class="col-6">
                    <div class="border-top border-dark pt-2 mx-5 small fw-bold">FIRMA DEL COLABORADOR</div>
                </div>
                <div class="col-6">
                    <div class="border-top border-dark pt-2 mx-5 small fw-bold">SELLO DE LA ENTIDAD</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    @@media print {
        .print-hide { display: none !important; }
        .card { border: none !important; }
        body { background: white !important; }
    }
</style>
