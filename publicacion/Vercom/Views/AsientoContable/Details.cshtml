@model Vercom.Models.AsientoContable
@{
    ViewBag.Title = "Detalle de Comprobante";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Comprobante de @Model.TipoComprobante.Nombre</h4>
    </div>
    <div class="text-end d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Volver al Diario</a>
        @if (Model.Estado == "BORRADOR")
        {
            <form asp-action="Post" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-sm btn-success"><i class="ti ti-check me-1"></i> CONTABILIZAR</button>
            </form>
        }
        @if (Model.Estado == "CONTABILIZADO")
        {
            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#reverseModal">
                <i class="ti ti-rotate-2 me-1"></i> REVERTIR
            </button>
        }
    </div>
</div>

<div class="row mt-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <!-- Encabezado del Comprobante -->
            <div class="row mb-4">
                <div class="col-sm-6">
                    <h5 class="text-muted text-uppercase small mb-1">Nº Comprobante</h5>
                    <h3 class="fw-bold">@Model.NumeroComprobante.ToString("D8")</h3>
                    <p class="mb-0">Modulo Origen: <span class="badge bg-light text-dark">@Model.ModuloOrigen</span></p>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <h5 class="text-muted text-uppercase small mb-1">Fecha de Registro</h5>
                    <h4 class="fw-bold">@Model.Fecha.ToString("dd 'de' MMMM, yyyy")</h4>
                    <p class="mb-0">Estado:
                        @if(Model.Estado == "CONTABILIZADO") { <span class="text-success fw-bold">FINALIZADO (Inmutable)</span> }
                        else { <span class="text-warning fw-bold">@Model.Estado</span> }
                    </p>
                </div>
            </div>

            <div class="bg-light rounded p-3 mb-4">
                <h6 class="fw-bold mb-1 text-primary">Concepto General:</h6>
                <p class="mb-0 fs-15">@Model.Concepto</p>
            </div>

            <!-- Detalle de Partidas -->
            <table class="table table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th >Cuenta</th>
                        <th>Descripción / Glosa</th>
                        <th>DEBE</th>
                        <th>HABER</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var det in Model.AsientoDetalles.OrderBy(d => d.Haber > 0))
                    {
                        <tr>
                            <td class="font-monospace">@det.Cuenta.Codigo</td>
                            <td>
                                <div class="fw-bold">@det.Cuenta.Nombre</div>
                                <small class="text-muted">@det.Glosa</small>
                            </td>
                            <td>@(det.Debe > 0 ? det.Debe.ToString("N2") : "")</td>
                            <td>@(det.Haber > 0 ? det.Haber.ToString("N2") : "")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-bold fs-16">
                    <tr>
                        <td colspan="2" class="text-end">TOTALES:</td>
                        <td class="text-end text-primary">@Model.TotalDebe.ToString("N2")</td>
                        <td class="text-end text-primary">@Model.TotalHaber.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
            <!-- Firma y Metadatos -->
            <div class="row mt-5">
                <div class="col-sm-4 text-center">
                    <div class="border-top pt-2 small text-muted">Contabilizado por</div>
                    <div class="fw-bold">@Model.CreadoPor</div> <!-- Debería ser el nombre real -->
                </div>
                <div class="col-sm-4 offset-sm-4 text-sm-end">
                    <p class="small text-muted mb-0">Marca de tiempo: @Model.CreadoEn.ToString("g")</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Reversión -->
<div class="modal fade" id="reverseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="Reverse" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Reversión</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <strong>Atención:</strong> Esta acción generará un asiento de ajuste con los valores invertidos para anular el efecto contable de este comprobante.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Motivo de la Reversión:</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="Ej: Error en imputación de centro de costo..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-danger">PROCEDER CON LA REVERSIÓN</button>
                </div>
            </div>
        </form>
    </div>
</div>
