@using Vercom.Security
@inject IEntidadProvider EntidadProvider
@model Vercom.ViewModels.UserFormViewModel
@{
    ViewBag.Title = "Editar Perfil de Usuario";
    var isMaster = EntidadProvider.IsMaster;
}
<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Actualizar Usuario: @Model.Usuario.NombreUsuario</h4>
        <p class="text-muted small mb-0">Gestión de datos personales y asignación de perfiles.</p>
    </div>
</div>
<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <form asp-action="Edit" method="post" id="editUserForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Usuario.Id" name="Usuario.Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>

                <div class="row">
                    <!-- Columna Izquierda -->
                    <div class="col-lg-7">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-light-subtle py-3">
                                <h5 class="m-0 fw-bold"><i class="ti ti-user-edit me-2 text-primary"></i>Datos de la Cuenta</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Nombre de Usuario</label>
                                        <input asp-for="Usuario.NombreUsuario" name="Usuario.NombreUsuario" class="form-control bg-light" readonly />
                                        <small class="text-muted tiny">No modificable por seguridad.</small>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Nombre Completo</label>
                                        <input asp-for="Usuario.NombreCompleto" name="Usuario.NombreCompleto" class="form-control" placeholder="Ej: Juan Pérez" required />
                                        <span asp-validation-for="Usuario.NombreCompleto" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-12">
                                        <label class="form-label fw-bold">Correo Electrónico</label>
                                        <input asp-for="Usuario.Email" name="Usuario.Email" type="email" class="form-control" placeholder="usuario@empresa.cu" />
                                    </div>

                                    @if (isMaster)
                                    {
                                        <div class="col-md-12">
                                            <label asp-for="Usuario.EntidadId" class="form-label fw-bold">Entidad Pertenencia</label>
                                            <select asp-for="Usuario.EntidadId" name="Usuario.EntidadId" class="form-select select2" asp-items="Model.Entidades"></select>
                                        </div>
                                    }
                                    else
                                    {
                                        <input type="hidden" asp-for="Usuario.EntidadId" name="Usuario.EntidadId" />
                                    }

                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Asignación de Sucursal</label>
                                        <select asp-for="Usuario.SucursalId" name="Usuario.SucursalId" class="form-control form-select w-100 select2" asp-items="Model.Sucursales">
                                            <option value="">-- Acceso Global (Supervisión) --</option>
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Vincular con Colaborador (RF-20)</label>
                                        <select asp-for="Usuario.EsEmpleadoId" name="Usuario.EsEmpleadoId" class="form-control form-select w-100 select2" asp-items="Model.Empleados">
                                            <option value="">-- No vincular a RRHH --</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Zona de Seguridad -->
                        <div class="card shadow-sm border-0 border-start border-danger border-3 bg-light-subtle mb-4">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <h4 class="fw-bold text-danger mb-1"><i class="ti ti-shield-lock me-2"></i>Gestión de Credenciales</h4>
                                        <p class="text-muted small mb-0">Forzar reinicio de contraseña.</p>
                                    </div>
                                    <button type="button" class="btn btn-danger btn-sm px-4" data-bs-toggle="modal" data-bs-target="#resetModal">
                                        REINICIAR PASS
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Columna Derecha -->
                    <div class="col-lg-5">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-light-subtle py-3">
                                <h5 class="m-0 fw-bold"><i class="ti ti-shield-check me-2 text-primary"></i>Perfiles y Roles</h5>
                            </div>
                            <div class="card-body p-4">
                                <label class="form-label fw-bold mb-3">Roles del Usuario</label>
                                <div class="bg-light-subtle rounded-3 p-3 border border-dashed mb-4" style="max-height: 300px; overflow-y: auto;">
                                    @foreach (var role in Model.RolesDisponibles)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role.Value" id="role_@role.Value"
                                                   @(Model.SelectedRoles.Contains(int.Parse(role.Value)) ? "checked" : "")
                                                   @(role.Disabled ? "disabled" : "")>
                                            <label class="form-check-label @(role.Disabled ? "text-muted" : "fw-semibold")" for="role_@role.Value">
                                                @role.Text
                                                @if (role.Disabled) { <small class="ms-1 tiny">(Protegido)</small> }
                                            </label>
                                        </div>
                                    }
                                </div>

                                <div class="form-check form-switch p-3 bg-light rounded-3 mb-0">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Usuario.Activo" name="Usuario.Activo">
                                    <label class="form-check-label fw-bold" asp-for="Usuario.Activo">Usuario con Acceso Activo</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-primary py-3 shadow">
                                <i class="ti ti-device-floppy me-1"></i> ACTUALIZAR PERFIL
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">CANCELAR</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Reset (Estandarizado) -->
<div class="modal fade" id="resetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="ResetPassword" method="post" class="w-100">
            <input type="hidden" name="id" value="@Model.Usuario.Id" />
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header border-0 p-4">
                    <h5 class="modal-title fw-bold"><i class="ti ti-key text-danger me-2"></i>Nueva Clave Temporal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 pt-0">
                    <div class="alert alert-warning border-0 small py-3 mb-4">
                        <i class="ti ti-alert-triangle me-1"></i> Se enviará esta clave al usuario para que restablezca su acceso.
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-bold">Clave Provisoria</label>
                        <input type="text" name="newPassword" class="form-control fw-bold text-center" value="Vercom.2026!" required />
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-danger px-4">CONFIRMAR REINICIO</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('editUserForm');
        });
    </script>
}
