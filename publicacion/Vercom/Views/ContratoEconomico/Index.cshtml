@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model IEnumerable<Vercom.Models.ContratoEconomico>
@{
    ViewBag.Title = "Contratos Económicos";
    var today = DateOnly.FromDateTime(DateTime.Now);
}
<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Relaciones Contractuales (B2B)</h4>
        <p class="text-muted small mb-0">Gestión de convenios comerciales con clientes y proveedores (RF-50).</p>
    </div>
    @if ((await AuthorizationService.AuthorizeAsync(User, "COMERCIAL.CONTRATO.CREAR")).Succeeded)
    {
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-file-plus"></i> NUEVO CONTRATO
        </a>
    }
</div>
<div class="row">
    <!-- Sección de Filtros -->
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body p-3">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-lg-3">
                        <label class="form-label small fw-bold">Número o Tercero</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="ti ti-search text-muted"></i></span>
                            <input type="text" name="search" class="form-control border-start-0" placeholder="Buscar contrato..." value="@ViewBag.CurrentSearch" />
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <label class="form-label small fw-bold">Tipo</label>
                        <select name="type" class="form-select">
                            <option value="">-- Todos --</option>
                            <!option value="CLIENTE" @(ViewBag.CurrentType == "CLIENTE" ? "selected" : "")>VENTAS</!option>
                            <!option value="PROVEEDOR" @(ViewBag.CurrentType == "PROVEEDOR" ? "selected" : "")>COMPRAS</!option>
                        </select>
                    </div>
                    <div class="col-lg-2">
                        <label class="form-label small fw-bold">Estado</label>
                        <select name="status" class="form-select">
                            <option value="">-- Todos --</option>
                            <!option value="VIGENTE" @(ViewBag.CurrentStatus == "VIGENTE" ? "selected" : "")>VIGENTES</!option>
                            <!option value="VENCIDO" @(ViewBag.CurrentStatus == "VENCIDO" ? "selected" : "")>VENCIDOS</!option>
                            <!option value="RESCINDIDO" @(ViewBag.CurrentStatus == "RESCINDIDO" ? "selected" : "")>RESCINDIDOS</!option>
                        </select>
                    </div>
                    <div class="col-lg-5 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="ti ti-filter me-1"></i> APLICAR FILTROS
                        </button>
                        <a asp-action="Index" class="btn btn-light" title="Limpiar"><i class="ti ti-refresh"></i></a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header border-light justify-content-between">
                <h5 class="m-0 fw-bold"><i class="ti ti-briefcase me-2 text-primary"></i>Archivo de Contratos</h5>               
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="card-body text-center py-5">
                        <i class="ti ti-file-off fs-48 text-muted mb-3 d-block"></i>
                        <h4 class="fw-bold">No hay contratos registrados</h4>
                        <p class="text-muted small">Los contratos económicos son obligatorios para operaciones mayoristas entre entidades.</p>
                        <a asp-action="Create" class="btn btn-sm btn-primary mt-2">REGISTRAR PRIMER CONTRATO</a>
                    </div>
                }
                else
                {
                    <table id="contractsTable" class="table table-striped table-hover dt-responsive">
                        <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th> Nº Contrato</th>
                                <th>Tercero (Contraparte)</th>
                                <th>Periodo de Vigencia</th>
                                <th>Monto Total ($)</th>
                                <th>Estado</th>
                                <th>Doc</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var hasDoc = !string.IsNullOrEmpty(item.DocumentoUrl);
                                var thirdParty = item.TerceroTipo == "CLIENTE" ? item.Cliente?.NombreRazonSocial : item.Proveedor?.RazonSocial;
                                var typeIcon = item.TerceroTipo == "CLIENTE" ? "ti-user-check text-success" : "ti-truck text-info";

                                var isExpired = item.FechaFin.HasValue && item.FechaFin.Value < today;
                                var isExpiring = item.FechaFin.HasValue && item.FechaFin.Value <= today.AddDays(30) && !isExpired;

                                var statusClass = isExpired ? "badge-soft-danger" : (isExpiring ? "badge-soft-warning" : "badge-soft-success");

                                <tr>
                                    <td class="text-numeric fw-bold text-primary">@item.NumeroContrato</td>
                                    <td class="fw-semibold">
                                        <i class="ti @typeIcon me-2"></i> @thirdParty
                                        <small class="text-muted d-block ps-4 opacity-75">@item.TerceroTipo</small>
                                    </td>
                                    <td class="text-date small">
                                        <span class="text-muted">De</span> @item.FechaInicio.ToString("dd/MM/yyyy")
                                        <span class="text-muted">a</span> @(item.FechaFin.HasValue ? item.FechaFin.Value.ToString("dd/MM/yyyy") : "Indef.")
                                    </td>
                                    <td class="text-numeric fw-bold">@item.MontoTotal?.ToString("N2")</td>
                                    <td>
                                        <span class="badge @statusClass">@(isExpired ? "VENCIDO" : item.Estado)</span>
                                    </td>
                                    <td>
                                        @if (hasDoc)
                                        {
                                            var isPdf = item.DocumentoUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                            <a href="@item.DocumentoUrl" target="_blank" class="btn btn-sm btn-icon btn-ghost-primary rounded-circle" title="Descargar Contrato">
                                                <i class="ti ti-file-@(isPdf ? "type-pdf" : "type-doc") fs-18"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle" title="Ver">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle" title="Editar">
                                                <i class="ti ti-edit"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>   
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#contractsTable').DataTable({
                pageLength: 25,
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
                responsive: true,
            });
        });
    </script>
}
