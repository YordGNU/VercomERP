@model Vercom.ViewModels.ProviderFormViewModel
@{
    ViewBag.Title = "Registrar Proveedor";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Proveedores</h4>
        <p class="text-muted small mb-0">Alta de suministradores y configuración de cuentas de pasivo (RF-50).</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Comercial</a></li>
            <li class="breadcrumb-item active">Proveedores</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary"><i class="ti ti-truck-delivery me-2"></i>Nuevo Registro de Proveedor</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> VOLVER AL LISTADO
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" class="row g-4" id="createProviderForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>
                        <div class="col-md-4">
                            <label asp-for="Provider.TipoPersona" class="form-label fw-bold">Tipo de Entidad</label>
                            <select asp-for="Provider.TipoPersona" class="form-select">
                                <option value="JURIDICA">PERSONA JURÍDICA (ESTATAL/MIPYME)</option>
                                <option value="NATURAL">PERSONA NATURAL (TCP/PARTICULAR)</option>
                            </select>
                            <span asp-validation-for="Provider.TipoPersona" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Provider.Nit" class="form-label fw-bold">Identificación (NIT/CI)</label>
                            <input asp-for="Provider.Nit" class="form-control" placeholder="NIT / CI" maxlength="20" required />
                            <span asp-validation-for="Provider.Nit" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Provider.RazonSocial" class="form-label fw-bold">Razón Social</label>
                            <input asp-for="Provider.RazonSocial" class="form-control fw-bold" placeholder="Nombre legal de la empresa" maxlength="255" required />
                            <span asp-validation-for="Provider.RazonSocial" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Provider.Direccion" class="form-label fw-bold">Dirección Fiscal</label>
                            <input asp-for="Provider.Direccion" class="form-control" placeholder="Dirección completa para contratos y facturas" />
                            <span asp-validation-for="Provider.Direccion" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Provider.Telefono" class="form-label fw-bold">Teléfono de Contacto</label>
                            <input asp-for="Provider.Telefono" class="form-control" placeholder="+53 ..." />
                            <span asp-validation-for="Provider.Telefono" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Provider.Email" class="form-label fw-bold">Correo Electrónico</label>
                            <input asp-for="Provider.Email" class="form-control" type="email" placeholder="ventas@@proveedor.cu" />
                            <span asp-validation-for="Provider.Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Provider.CuentaBancaria" class="form-label fw-bold">Cuenta Bancaria (Pagos)</label>
                            <input asp-for="Provider.CuentaBancaria" class="form-control font-monospace" placeholder="92..." />
                            <span asp-validation-for="Provider.CuentaBancaria" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Provider.CuentaContableId" class="form-label fw-bold">Cuenta por Pagar (Contabilidad)</label>
                            <select asp-for="Provider.CuentaContableId" class="form-select select2-cuenta" asp-items="Model.CuentasContables">
                                <option value="">-- SELECCIONE CUENTA DE PASIVO --</option>
                            </select>
                            <span asp-validation-for="Provider.CuentaContableId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <hr class="my-2" />
                            <h6 class="fw-bold text-muted mb-2">
                                <i class="ti ti-toggle-right me-1"></i> Estado del Proveedor
                            </h6>
                            <div class="form-check form-switch form-switch-lg p-3 border rounded bg-light-subtle">
                                <input asp-for="Provider.Activo" class="form-check-input" type="checkbox" role="switch" checked />
                                <label class="form-check-label fw-bold" asp-for="Provider.Activo">Proveedor Habilitado</label>
                                <small class="text-muted d-block">Solo los proveedores habilitados pueden utilizarse en compras y contratos.</small>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">DESCARTAR</a>
                            <button type="submit" class="btn btn-primary px-5 shadow">
                                <i class="ti ti-device-floppy me-1"></i> REGISTRAR PROVEEDOR
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('createProviderForm');
        });
    </script>
}
