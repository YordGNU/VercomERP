@model Vercom.Models.Proveedor
@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Actualizar Datos de Proveedor</h4>
        <p class="text-muted small mb-0">Gestión de suministradores y cuentas de pasivo (RF-50).</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Comercial</a></li>
            <li class="breadcrumb-item active">Proveedores</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary"><i class="ti ti-edit me-2"></i>Editando: @Model.RazonSocial</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> VOLVER AL LISTADO
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" class="row g-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="EntidadId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-4">
                            <label asp-for="TipoPersona" class="form-label fw-bold">Tipo de Entidad</label>
                            <select asp-for="TipoPersona" class="form-select">
                                <option value="JURIDICA">PERSONA JURÍDICA (ESTATAL/MIPYME)</option>
                                <option value="NATURAL">PERSONA NATURAL (TCP/PARTICULAR)</option>
                            </select>
                            <span asp-validation-for="TipoPersona" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Nit" class="form-label fw-bold">Identificación (NIT/CI)</label>
                            <input asp-for="Nit" class="form-control" maxlength="20" required />
                            <span asp-validation-for="Nit" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="RazonSocial" class="form-label fw-bold">Razón Social</label>
                            <input asp-for="RazonSocial" class="form-control fw-bold" required />
                            <span asp-validation-for="RazonSocial" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Direccion" class="form-label fw-bold">Dirección Fiscal</label>
                            <input asp-for="Direccion" class="form-control" />
                            <span asp-validation-for="Direccion" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label fw-bold">Teléfono de Contacto</label>
                            <input asp-for="Telefono" class="form-control" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CuentaBancaria" class="form-label fw-bold">Cuenta Bancaria (Pagos)</label>
                            <input asp-for="CuentaBancaria" class="form-control font-monospace" placeholder="92..." />
                            <span asp-validation-for="CuentaBancaria" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CuentaContableId" class="form-label fw-bold">Cuenta Contable (CxP)</label>
                            <select asp-for="CuentaContableId" class="form-select select2" asp-items="ViewBag.CuentaContableId">
                                <option value="">-- SELECCIONE CUENTA DE PASIVO --</option>
                            </select>
                            <span asp-validation-for="CuentaContableId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="Activo">
                                <label class="form-check-label fw-bold" asp-for="Activo">Proveedor Activo para Operaciones</label>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-primary px-5 shadow">
                                <i class="ti ti-device-floppy me-1"></i> ACTUALIZAR PROVEEDOR
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
