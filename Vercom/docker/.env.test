@'
# ============================================================
# VercomERP - Config para contenedor de pruebas
# ============================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# JWT (mínimo 32 bytes)
Jwt__SecretKey=EstaEsUnaClaveDeAlMenos32BytesParaVercomERP2026!
Jwt__Issuer=VercomERP
Jwt__Audience=VercomERP.Client

# Base de datos (CAMBIO: DefaultConnection, no Default)
ConnectionStrings__DefaultConnection=Server=vercom-db,1433;Database=VercomERP;User Id=sa;Password=Vercom#2026!StrongPass;TrustServerCertificate=True;Encrypt=False

# Zona horaria
TZ=America/Havana

# Worker POS
Pos__SyncIntervalSeconds=30
'@ | Out-File -FilePath docker\.env.test -Encoding utf8 -NoNewline

# Verificar
Get-Content docker\.env.test