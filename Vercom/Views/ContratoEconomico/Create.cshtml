@model Vercom.ViewModels.EconomicContractViewModel
@{
    ViewBag.Title = Model.Title;
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Contabilidad", Title = "Formalizar Contrato Económico", Subtitle = "Registro de convenios B2B para operaciones de compra o venta (RF-50).", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />


<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                 <div class="card-header bg-light-subtle py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary"><i class="ti ti-file-certificate me-2"></i>Nuevo Contrato Económico (RF-50)</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> VOLVER
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" class="row g-4" id="createContractForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>
                        <input asp-for="Contract.Estado" type="hidden" value="VIGENTE" />
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Tipo de Contraparte</label>
                            <select asp-for="Contract.TerceroTipo" name="Contract.TerceroTipo" class="form-select w-100 fw-bold" id="terceroTipo" required>
                                <option value="">-- SELECCIONE TIPO --</option>
                                <option value="CLIENTE">CLIENTE (VENTAS)</option>
                                <option value="PROVEEDOR">PROVEEDOR (COMPRAS)</option>
                            </select>
                            <span asp-validation-for="Contract.TerceroTipo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8" id="divCliente" style="display:none;">
                            <label class="form-label fw-bold">Buscar Cliente</label>
                            <select asp-for="Contract.ClienteId" name="Contract.ClienteId" class="form-select select2" asp-items="Model.Clientes">
                                <option value="">-- BUSCAR POR NOMBRE --</option>
                            </select>
                        </div>

                        <div class="col-md-8" id="divProveedor" style="display:none;">
                            <label class="form-label fw-bold">Buscar Proveedor</label>
                            <select asp-for="Contract.ProveedorId" name="Contract.ProveedorId" class="form-select select2" asp-items="Model.Proveedores">
                                <option value="">-- BUSCAR POR RAZÓN SOCIAL --</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Número de Contrato (Legal)</label>
                            <input asp-for="Contract.NumeroContrato" name="Contract.NumeroContrato" class="form-control fw-bold text-primary" placeholder="Ej: CT-2026/045" required />
                            <span asp-validation-for="Contract.NumeroContrato" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Objeto del Contrato</label>
                            <input asp-for="Contract.Objeto" name="Contract.Objeto" class="form-control w-100" placeholder="Ej: Suministro de materias primas..." required />
                            <span asp-validation-for="Contract.Objeto" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Fecha de Firma</label>
                            <input asp-for="Contract.FechaFirma" name="Contract.FechaFirma" class="form-control w-100" type="date" required />
                            <span asp-validation-for="Contract.FechaFirma" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Fecha Inicio Vigencia</label>
                            <input asp-for="Contract.FechaInicio" name="Contract.FechaInicio" class="form-control w-100" type="date" required />
                            <span asp-validation-for="Contract.FechaInicio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Fecha Vencimiento</label>
                            <input asp-for="Contract.FechaFin" name="Contract.FechaFin" class="form-control w-100" type="date" />
                            <span asp-validation-for="Contract.FechaFin" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Monto Total Pactado ($)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">$</span>
                                <input asp-for="Contract.MontoTotal" name="Contract.MontoTotal" class="form-control" placeholder="0.00" type="number" step="0.01" />
                            </div>
                            <small class="text-muted italic">Dejar vacío para monto indeterminado.</small>
                            <span asp-validation-for="Contract.MontoTotal" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Adjuntar Contrato Digitalizado (Word/PDF)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-link"></i></span>
                                <input type="file" asp-for="DocumentoContrato" class="form-control" accept=".doc,.docx,.pdf" />
                            </div>
                            <small class="text-muted italic">Máx. 10 MB (PDF o Word).</small>
                        </div>    
                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR CONTRATO
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            const toggleDivs = () => {
                const val = $('#terceroTipo').val();
                $('#divCliente').toggle(val === 'CLIENTE');
                $('#divProveedor').toggle(val === 'PROVEEDOR');
            };
            $('#terceroTipo').change(toggleDivs);
            toggleDivs();

            window.SubmitAjaxForm('createContractForm');
        });
    </script>
}
