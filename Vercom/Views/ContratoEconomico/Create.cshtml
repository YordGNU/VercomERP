@model Vercom.Models.ContratoEconomico

@{
    ViewData["Title"] = "Crear Contrato Económico";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Crear Contrato Económico</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Comercial</a></li>
            <li class="breadcrumb-item active">Contratos Económicos</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Creación</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-md-6">
                            <label asp-for="EntidadId" class="form-label"></label>
                            <select asp-for="EntidadId" class="form-select" asp-items="ViewBag.EntidadId"></select>
                            <span asp-validation-for="EntidadId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TerceroTipo" class="form-label"></label>
                            <select asp-for="TerceroTipo" class="form-select">
                                <option value="">Seleccione tipo</option>
                                <option value="Cliente">Cliente</option>
                                <option value="Proveedor">Proveedor</option>
                            </select>
                            <span asp-validation-for="TerceroTipo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ClienteId" class="form-label"></label>
                            <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId"></select>
                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProveedorId" class="form-label"></label>
                            <select asp-for="ProveedorId" class="form-select" asp-items="ViewBag.ProveedorId"></select>
                            <span asp-validation-for="ProveedorId" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="NumeroContrato" class="form-label"></label>
                            <input asp-for="NumeroContrato" class="form-control" placeholder="Número de contrato" />
                            <span asp-validation-for="NumeroContrato" class="text-danger"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Objeto" class="form-label"></label>
                            <input asp-for="Objeto" class="form-control" placeholder="Objeto del contrato" />
                            <span asp-validation-for="Objeto" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FechaFirma" class="form-label"></label>
                            <input asp-for="FechaFirma" class="form-control" type="date" />
                            <span asp-validation-for="FechaFirma" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FechaInicio" class="form-label"></label>
                            <input asp-for="FechaInicio" class="form-control" type="date" />
                            <span asp-validation-for="FechaInicio" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="FechaFin" class="form-label"></label>
                            <input asp-for="FechaFin" class="form-control" type="date" />
                            <span asp-validation-for="FechaFin" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MontoTotal" class="form-label"></label>
                            <input asp-for="MontoTotal" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="MontoTotal" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DocumentoUrl" class="form-label"></label>
                            <input asp-for="DocumentoUrl" class="form-control" placeholder="URL del documento" />
                            <span asp-validation-for="DocumentoUrl" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}