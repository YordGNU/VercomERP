@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model IEnumerable<Vercom.Models.ContratoEconomico>
@{
    ViewBag.Title = "Contratos Económicos";
    var today = DateOnly.FromDateTime(DateTime.Now);
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Relaciones Contractuales (B2B)</h4>
    </div>
    <div class="text-end">
        @if ((await AuthorizationService.AuthorizeAsync(User, "COMERCIAL.CONTRATO.CREAR")).Succeeded)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-file-plus me-1"></i> Nuevo Contrato
            </a>
        }
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nº Contrato</th>
                            <th>Tercero (Cliente/Proveedor)</th>
                            <th class="text-center">Vigencia</th>
                            <th class="text-end">Monto Total</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var thirdParty = item.TerceroTipo == "CLIENTE" ? item.Cliente?.NombreRazonSocial : item.Proveedor?.RazonSocial;
                            var typeIcon = item.TerceroTipo == "CLIENTE" ? "ti-user-check text-success" : "ti-truck text-info";

                            var isExpiring = item.FechaFin.HasValue && item.FechaFin.Value <= today.AddDays(30) && item.FechaFin.Value >= today;
                            var isExpired = item.FechaFin.HasValue && item.FechaFin.Value < today;

                            var badgeClass = isExpired ? "bg-danger" : (isExpiring ? "bg-warning" : "bg-success");

                            <tr>
                                <td class="fw-bold">@item.NumeroContrato</td>
                                <td>
                                    <i class="ti @typeIcon me-1"></i> @thirdParty
                                </td>
                                <td class="text-center small">
                                    @item.FechaInicio.ToString("dd/MM/yyyy") @(item.FechaFin.HasValue ? " al " + item.FechaFin.Value.ToString("dd/MM/yyyy") : " (Indefinido)")
                                </td>
                                <td class="text-end fw-bold">@item.MontoTotal?.ToString("C")</td>
                                <td class="text-center">
                                    <span class="badge @badgeClass">@item.Estado</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-edit"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
