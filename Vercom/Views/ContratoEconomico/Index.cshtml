@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model IEnumerable<Vercom.Models.ContratoEconomico>
@{
    ViewBag.Title = "Contratos Económicos";
    var today = DateOnly.FromDateTime(DateTime.Now);
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Relaciones Contractuales (B2B)</h4>
        <p class="text-muted small mb-0">Gestión de convenios comerciales con clientes y proveedores (RF-50).</p>
    </div>
    <div class="text-end">
        @if ((await AuthorizationService.AuthorizeAsync(User, "COMERCIAL.CONTRATO.CREAR")).Succeeded)
        {
            <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
                <i class="ti ti-file-plus"></i> NUEVO CONTRATO
            </a>
        }
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-briefcase me-2 text-primary"></i>Archivo de Contratos</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="contractsTable"  class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th width="140">Nº Contrato</th>
                            <th>Tercero (Contraparte)</th>
                            <th width="200" class="text-center">Periodo de Vigencia</th>
                            <th width="140" class="text-end">Monto Total ($)</th>
                            <th width="120" class="text-center">Estado</th>
                            <th width="100" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var thirdParty = item.TerceroTipo == "CLIENTE" ? item.Cliente?.NombreRazonSocial : item.Proveedor?.RazonSocial;
                            var typeIcon = item.TerceroTipo == "CLIENTE" ? "ti-user-check text-success" : "ti-truck text-info";

                            var isExpired = item.FechaFin.HasValue && item.FechaFin.Value < today;
                            var isExpiring = item.FechaFin.HasValue && item.FechaFin.Value <= today.AddDays(30) && !isExpired;

                            var statusClass = isExpired ? "badge-soft-danger" : (isExpiring ? "badge-soft-warning" : "badge-soft-success");

                            <tr>
                                <td class="text-numeric fw-bold text-primary">@item.NumeroContrato</td>
                                <td class="fw-semibold">
                                    <i class="ti @typeIcon me-2"></i> @thirdParty
                                    <small class="text-muted d-block ps-4 opacity-75">@item.TerceroTipo</small>
                                </td>
                                <td class="text-date small">
                                    <span class="text-muted">De</span> @item.FechaInicio.ToString("dd/MM/yyyy")
                                    <span class="text-muted">a</span> @(item.FechaFin.HasValue ? item.FechaFin.Value.ToString("dd/MM/yyyy") : "Indef.")
                                </td>
                                <td class="text-numeric fw-bold">@item.MontoTotal?.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @statusClass">@(isExpired ? "VENCIDO" : item.Estado)</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Ver">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#contractsTable').DataTable({
                         language: { url: '/js/i18n/es-ES.json' },
                order: [[2, 'desc']]
            });
        });
    </script>
}
