@model Vercom.ViewModels.ListaPrecioFormViewModel
@{
    ViewBag.Title = "Editar Lista de Precios";
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti ti-arrow-left me-1'></i> Volver</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Ventas", Title = "Gestión de Catálogo: Listas", Subtitle = "Actualización de términos comerciales y vigencias.", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />

<div class="row mt-4">
    <form asp-action="Edit" method="post" id="editPriceListForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ListaPrecio.Id" />
        <input type="hidden" asp-for="ListaPrecio.EntidadId" />
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small border-0 mb-4 shadow-sm", @role = "alert", @tabindex = "-1", @id = "errorSummary" })

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light-subtle py-3">
                        <h5 class="m-0 fw-bold text-primary"><i class="ti ti-edit me-2"></i>Modificar Tarifario</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="ListaPrecio.Nombre" class="form-label fw-bold">Nombre de la Lista</label>
                            <input asp-for="ListaPrecio.Nombre" name="ListaPrecio.Nombre" class="form-control fw-bold" required maxlength="100" />
                            <span asp-validation-for="ListaPrecio.Nombre" class="text-danger small"></span>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="ListaPrecio.VigenteDesde" class="form-label fw-bold">Vigente Desde</label>
                                <input asp-for="ListaPrecio.VigenteDesde" name="ListaPrecio.VigenteDesde" type="date" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ListaPrecio.VigenteHasta" class="form-label fw-bold">Vigente Hasta</label>
                                <input asp-for="ListaPrecio.VigenteHasta" name="ListaPrecio.VigenteHasta" type="date" class="form-control" />
                                <small class="text-muted tiny">Opcional.</small>
                            </div>
                        </div>
                        <div class="form-check form-switch p-3 bg-light-subtle border rounded-3">
                            <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="ListaPrecio.Activa" name="ListaPrecio.Activa">
                            <label class="form-check-label fw-bold">Lista de Precios Habilitada</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center py-3">
                        <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Productos de la Lista</h5>
                        <button type="button" class="btn btn-sm btn-primary shadow-sm" onclick="addRow()">
                            <i class="ti ti-plus me-1"></i> AÑADIR PRODUCTO
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table mb-0" id="detailsTable">
                                <thead class="thead-sm text-uppercase fs-xxs">
                                    <tr>
                                        <th class="ps-4">Producto</th>
                                        <th class="text-end" width="120">P. Base</th>
                                        <th class="text-end" width="150">Precio Lista ($)</th>
                                        <th width="40"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.ListaPrecio.ListaPrecioDetalles.Count; i++)
                                    {
                                        var detalle = Model.ListaPrecio.ListaPrecioDetalles.ElementAt(i);
                                        <tr>
                                            <td>
                                                <select name="ListaPrecio.ListaPrecioDetalles[@i].ProductoId" class="form-control form-select w-100 select2-dynamic" onchange="updatePrice(this)" required>
                                                    <option value="">-- Buscar Producto --</option>
                                                    <option value="@detalle.ProductoId" data-price="@detalle.Producto?.PrecioVentaActual" selected>
                                                        @(detalle.Producto is null ? $"Producto {detalle.ProductoId}" : $"{detalle.Producto.Codigo} - {detalle.Producto.Nombre}")
                                                    </option>
                                                </select>
                                            </td>
                                            <td class="text-end"><span class="badge bg-light text-dark base-price-badge">@((detalle.Producto?.PrecioVentaActual ?? 0m).ToString("N2"))</span></td>
                                            <td><input name="ListaPrecio.ListaPrecioDetalles[@i].Precio" type="number" step="0.01" class="form-control text-end fw-bold input-price" value="@detalle.Precio" required /></td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-icon btn-ghost-danger border-0" aria-label="Eliminar línea" onclick="removeRow(this)">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    <tr id="emptyRow" style="display:none;">
                                        <td colspan="3" class="text-center py-4 text-muted">
                                            <i class="ti ti-package me-1"></i>
                                            No hay productos. Haz clic en <strong>Añadir Producto</strong> para comenzar.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a asp-action="Index" class="btn btn-sm btn-outline px-4">CANCELAR</a>
            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                <i class="ti ti-device-floppy me-1"></i> ACTUALIZAR LISTA
            </button>
        </div>
    </form>
</div>

@section Styles {
    <style>
        #detailsTable { table-layout: fixed; }
        #detailsTable td { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        #detailsTable .select2-dynamic { max-width: 100%; }
        #detailsTable .btn-icon { min-width: 32px; min-height: 32px; }
        #emptyRow td { white-space: normal; }
    </style>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        let rowCount = @Model.ListaPrecio.ListaPrecioDetalles.Count;
        const productSearchUrl = '@Url.Action("BuscarProductos", "ListaPrecio")';

        function initializeProductSelect(select) {
            $(select).select2({
                width: '100%',
                placeholder: '-- Buscar Producto --',
                minimumInputLength: 2,
                dropdownParent: $('#editPriceListForm'),
                ajax: {
                    url: productSearchUrl,
                    dataType: 'json',
                    delay: 250,
                    data: params => ({ search: params.term }),
                    processResults: data => data,
                    cache: true
                }
            }).on('select2:select', function(event) {
                const option = this.options[this.selectedIndex];
                option.dataset.price = event.params.data.price ?? 0;
                updatePrice(this);
            });
        }

        function addRow() {
            const tbody = document.querySelector("#detailsTable tbody");
            const emptyRow = document.getElementById("emptyRow");
            if (emptyRow) emptyRow.style.display = "none";
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>
                    <select name="ListaPrecio.ListaPrecioDetalles[${rowCount}].ProductoId" class="form-control form-select w-100 select2-dynamic" onchange="updatePrice(this)" required>
                        <option value="">-- Buscar Producto --</option>
                    </select>
                </td>
                <td class="text-end"><span class="badge bg-light text-dark base-price-badge">0.00</span></td>
                <td><input name="ListaPrecio.ListaPrecioDetalles[${rowCount}].Precio" type="number" step="0.01" class="form-control text-end fw-bold input-price" value="0.00" required /></td>
                <td>
                    <button type="button" class="btn btn-sm btn-icon btn-ghost-danger border-0" aria-label="Eliminar línea" onclick="removeRow(this)">
                        <i class="ti ti-trash"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(row);

            initializeProductSelect(row.querySelector('.select2-dynamic'));

            rowCount++;
        }

        function updatePrice(select) {
            const option = select.options[select.selectedIndex];
            const price = Number(option.getAttribute('data-price') || 0);
            const row = select.closest('tr');
            row.querySelector('.base-price-badge').textContent = price.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            row.querySelector('.input-price').value = price.toFixed(2);
        }

        function removeRow(btn) {
            btn.closest('tr').remove();
            const tbody = document.querySelector("#detailsTable tbody");
            if (tbody.querySelectorAll("tr:not(#emptyRow)").length === 0) {
                const emptyRow = document.getElementById("emptyRow");
                if (emptyRow) emptyRow.style.display = "";
            }
        }

        $(document).ready(function() {
            $('#detailsTable .select2-dynamic').each(function() {
                initializeProductSelect(this);
            });
            window.SubmitAjaxForm('editPriceListForm');
            document.getElementById('editPriceListForm').addEventListener('submit', function() {
                setTimeout(() => {
                    const errorSummary = document.getElementById('errorSummary');
                    if (errorSummary && errorSummary.offsetParent !== null) {
                        errorSummary.focus();
                    }
                }, 150);
            });
        });
    </script>
}
