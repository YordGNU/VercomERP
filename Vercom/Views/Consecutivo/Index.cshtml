@model IEnumerable<Vercom.Models.Consecutivo>
@{ ViewBag.Title = "Consecutivos"; }

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> NUEVO CONCEPTO</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Administración", Title = "Consecutivos", Subtitle = "Control de numeración de documentos.", Icon = "ti-list-numbers", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />


<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card h-100 transition-all hover-shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">@item.TipoDocumento</h5>
                            <small class="text-muted text-uppercase fw-semibold tiny">Unidad: @(item.Sucursal?.Nombre ?? "Central")</small>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline py-1 px-2 border-0" data-bs-toggle="dropdown" aria-expanded="false"><i class="ti ti-dots-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="">
                                <li><a asp-action="Details" asp-route-id="@item.Id" class="dropdown-item py-2"><i class="ti ti-list-search me-1"></i> Ver detalle</a></li>
                                <li><a asp-action="Edit" asp-route-id="@item.Id" class="dropdown-item py-2"><i class="ti ti-edit me-2 text-info"></i> Editar Datos</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="text-center py-3 bg-light-subtle border rounded-3 mb-2">
                        <h2 class="fw-bold text-success mb-0 text-numeric">@item.UltimoNumero</h2>
                        <p class="small text-muted text-uppercase mb-0 fw-bold">Ultimo número</p>
                    </div>
                    <div class="bg-light-subtle border rounded-3 p-1 mb-2">
                        <div class="row g-0 text-center">
                            <div class="col-12">
                                <span>SERIE</span>
                                <span class="fw-semibold text-primary">@item.Serie</span>
                            </div>                        
                        </div>
                    </div>                   
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="avatar-xl bg-light-subtle rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 100px; height: 100px;">
                <i class="ti ti-cash fs-48 text-muted"></i>
            </div>
            <h3 class="fw-bold">No hay consecutivos configurados</h3>
            <p class="text-muted">Configure la numeración de documentos registrando el primer consecutivo.</p>
            <a asp-action="Create" class="btn btn-sm btn-primary mt-3">CONFIGURAR CONSECUTIVO</a>
        </div>
    }
</div>
<style>
    .hover-shadow:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }

    .tiny {
        font-size: 0.65rem;
        letter-spacing: 0.05em;
    }
</style>