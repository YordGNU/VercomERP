@model Vercom.Models.Existencium

@{
    ViewData["Title"] = "Editar Existencia";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Editar Existencia</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Inventario</a></li>
            <li class="breadcrumb-item active">Existencias</li>
        </ol>
    </div>
</div>
<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Edición</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="col-md-6">
                            <label asp-for="AlmacenId" class="form-label"></label>
                            <select asp-for="AlmacenId" class="form-select" asp-items="ViewBag.AlmacenId"></select>
                            <span asp-validation-for="AlmacenId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProductoId" class="form-label"></label>
                            <select asp-for="ProductoId" class="form-select" asp-items="ViewBag.ProductoId"></select>
                            <span asp-validation-for="ProductoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Cantidad" class="form-label"></label>
                            <input asp-for="Cantidad" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Cantidad" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CostoPromedio" class="form-label"></label>
                            <input asp-for="CostoPromedio" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="CostoPromedio" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="StockMinimo" class="form-label"></label>
                            <input asp-for="StockMinimo" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="StockMinimo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StockMaximo" class="form-label"></label>
                            <input asp-for="StockMaximo" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="StockMaximo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActualizadoEn" class="form-label"></label>
                            <input asp-for="ActualizadoEn" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActualizadoEn" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}