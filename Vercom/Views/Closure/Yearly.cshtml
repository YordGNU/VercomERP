@model Vercom.ViewModels.ClosureYearlyViewModel
@{
    ViewBag.Title = "Cierre de Ejercicio Fiscal";
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Cierre de Ejercicio " + Model.Year
}' />
<div class="row mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-danger border-opacity-25">
                <div class="card-header bg-danger bg-opacity-10 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 text-danger">Validación de Pre-cierre (RF-18)</h5>
                    <span class="badge bg-danger">Ejercicio @Model.Year</span>
                </div>
                <div class="card-body">
                    <div class="text-center py-4 mb-4 bg-light rounded">
                        <h6 class="text-muted text-uppercase small mb-1">Utilidad Estimada del Ejercicio</h6>
                        <h1 class="fw-bold @(Model.EstimatedProfit >= 0 ? "text-success" : "text-danger")">
                            @Model.EstimatedProfit.ToString("C")
                        </h1>
                    </div>

                    <h6 class="fw-bold border-bottom pb-2 mb-3">Requisitos de Control Interno</h6>
                    <ul class="list-group list-group-flush mb-4">
                        @if (Model.ValidationMessages.Any())
                        {
                            @foreach (var msg in Model.ValidationMessages)
                            {
                                <li class="list-group-item text-danger small"><i class="ti ti-x me-2"></i> @msg</li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-success small"><i class="ti ti-check me-2"></i> Todos los periodos mensuales están debidamente cerrados.</li>
                            <li class="list-group-item text-success small"><i class="ti ti-check me-2"></i> No existen asientos en borrador pendientes.</li>
                            <li class="list-group-item text-success small"><i class="ti ti-check me-2"></i> Depreciación de activos fijos ejecutada.</li>
                        }
                    </ul>

                    <form asp-action="ExecuteYearly" method="post" id="yearlyClosureForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="year" value="@Model.Year" />

                        <div class="d-grid">
                            <button type="submit" class="btn btn-danger btn-lg py-3 fw-bold" @(Model.CanClose ? "" : "disabled")>
                                <i class="ti ti-lock-access me-1"></i> EJECUTAR CIERRE DEFINITIVO Y SELLADO
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="alert alert-warning mt-4 py-2 small border-0 shadow-sm">
                <i class="ti ti-alert-triangle me-1"></i> <strong>AVISO LEGAL:</strong> El cierre de ejercicio genera el asiento de transferencia de resultados y bloquea permanentemente la edición de cualquier documento del año @Model.Year (Resolución 60/2011 CGR).
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('yearlyClosureForm');
        });
    </script>
}
