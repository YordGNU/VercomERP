@model Vercom.Models.CentroCosto
@{
    ViewBag.Title = "Detalle de Centro de Costo";
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = Model.Nombre,
    Subtitle = "Código: " + Model.Codigo
}' />

<div class="row">
    <div class="row">
        <div class="col-lg-6">
            <div class="card mb-4">
                 <div class="card-header border-light justify-content-between">
                    <h5 class="m-0 fw-bold"><i class="ti ti-map-pin me-2 text-primary"></i>Ubicación y Estado</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold d-block">Código Interno</label>
                            <span class="fs-16 fw-bold text-primary">@Model.Codigo</span>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold d-block">Estado Operativo</label>
                            @if (Model.Activo) { <span class="badge bg-success">ACTIVO</span> }
                            else { <span class="badge bg-danger">INACTIVO</span> }
                        </div>
                        <div class="col-md-12">
                            <label class="text-muted small text-uppercase fw-bold d-block">Nombre del Centro</label>
                            <span class="fs-16">@Model.Nombre</span>
                        </div>
                        <div class="col-md-12">
                            <label class="text-muted small text-uppercase fw-bold d-block">Sucursal Asociada</label>
                            <span class="fw-bold">@(Model.Sucursal?.Nombre ?? "CENTRAL / GLOBAL")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card mb-4">
                 <div class="card-header border-light justify-content-between">
                    <h5 class="m-0 fw-bold"><i class="ti ti-chart-bar me-2 text-primary"></i>Resumen de Ejecución</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Este centro de costo permite la imputación de gastos e ingresos para el análisis de rentabilidad por áreas.</p>
                    <div class="list-group list-group-flush border rounded">
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Presupuesto Asignado (Año Actual)</span>
                            <span class="fw-bold">Por definir</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <span>Gastos Acumulados</span>
                            <span class="text-danger fw-bold">Por calcular</span>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a asp-controller="Reports" asp-action="CostCenterReport" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-info w-100">
                            <i class="ti ti-file-analytics me-1"></i> VER REPORTE DE COSTOS
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
