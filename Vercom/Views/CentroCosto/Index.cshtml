@model IEnumerable<Vercom.Models.CentroCosto>
@{
    ViewBag.Title = "Centros de Costo";
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Gestión de Centros de Costo",
    Subtitle = "Nomenclador para la imputación analítica de gastos y recursos por unidad.",
    PrimaryAction = new Vercom.ViewModels.ActionLinkModel { Controller = "CentroCosto", Action = "Create", Text = "NUEVO CENTRO DE COSTO", Icon = "ti ti-plus" },
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Vercom", Url = "javascript: void(0);" },
        new() { Text = "Contabilidad", Url = "javascript: void(0);" },
        new() { Text = "Centros de costo", IsActive = true }
    }
}' />
<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-chart-dots me-2 text-primary"></i>Configuración de Unidades de Costo</h5>
            <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
                <i class="ti ti-plus"></i> NUEVO CENTRO DE COSTO
            </a>
        </div>
        <div class="card-body">
            <table id="costCenterTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th>Código</th>
                        <th>Nombre del Centro de Costo</th>
                        <th>Sucursal / Unidad</th>
                      <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td><i class="ti ti-building-community me-1 text-muted"></i> @(item.Sucursal?.Nombre ?? "Central")</td>
                            <td >
                                @if (item.Activo)
                                {
                                    <span class="badge badge-soft-success">ACTIVO</span>
                                }
                                else
                                {

                                    <span class="badge badge-soft-danger">INACTIVO</span>
                                }
                            </td>
                            <td>
                                   <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Detalles">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Editar">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#costCenterTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                    order: [[1, 'asc']],
                    dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
            });
        });
    </script>
}
