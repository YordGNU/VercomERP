@model IEnumerable<Vercom.Models.CentroCosto>
@{
    ViewBag.Title = "Centros de Costo";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Centros de Costo</h4>
        <p class="text-muted small mb-0">Nomenclador para la imputación analítica de gastos y recursos por unidad.</p>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus"></i> NUEVO CENTRO DE COSTO
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-chart-dots me-2 text-primary"></i>Configuración de Unidades de Costo</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="costCenterTable" class="table">
                    <thead>
                        <tr>
                            <th width="150">Código</th>
                            <th>Nombre del Centro de Costo</th>
                            <th width="200">Sucursal / Unidad</th>
                            <th width="120" class="text-center">Estado</th>
                            <th width="100" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td><i class="ti ti-building-community me-1 text-muted"></i> @(item.Sucursal?.Nombre ?? "Central")</td>
                                <td class="text-center">
                                    @if (item.Activo) { <span class="badge badge-soft-success">ACTIVO</span> }
                                    else { <span class="badge badge-soft-danger">INACTIVO</span> }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Detalles">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#costCenterTable').DataTable({
                         language: { url: '/js/i18n/es-ES.json' }
            });
        });
    </script>
}
