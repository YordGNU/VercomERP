@model Vercom.ViewModels.CentroCostoFormViewModel
@{
    ViewData["Title"] = "Crear Centro de Costo";
}
@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Contabilidad", Title = "Crear Centro de Costo", Subtitle = "Imputación analítica de gastos por unidad organizativa.", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold"><i class="ti ti-chart-dots me-2 text-primary"></i>Formulario de Registro</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" class="row g-4">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-4">
                            <label class="form-label">Código Interno</label>
                            <input asp-for="CentroCosto.Codigo" name="CentroCosto.Codigo" class="form-control w-100 fw-bold text-primary" placeholder="ej: CC-01" required />
                            <span asp-validation-for="CentroCosto.Codigo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Nombre descriptivo</label>
                            <input asp-for="CentroCosto.Nombre" name="CentroCosto.Nombre" class="form-control w-100" placeholder="Nombre del centro de costo" required />
                            <span asp-validation-for="CentroCosto.Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Sucursal Asociada</label>
                            <select asp-for="CentroCosto.SucursalId" name="CentroCosto.SucursalId" class="form-control form-select w-100 select2" asp-items="Model.Sucursales">
                                <option value="">-- Uso Global / Corporativo --</option>
                            </select>
                            <span asp-validation-for="CentroCosto.SucursalId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 d-flex align-items-end pb-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="CentroCosto.Activo" name="CentroCosto.Activo" checked>
                                <label class="form-check-label fw-bold">Centro Operativo</label>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR CENTRO
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}