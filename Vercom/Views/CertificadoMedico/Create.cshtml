@model Vercom.Models.CertificadoMedico

@{
    ViewData["Title"] = "Crear Certificado Médico";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Crear Certificado Médico</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">RRHH</a></li>
            <li class="breadcrumb-item active">Certificados Médicos</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Creación</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-md-6">
                            <label asp-for="EmpleadoId" class="form-label"></label>
                            <select asp-for="EmpleadoId" class="form-select" asp-items="ViewBag.EmpleadoId"></select>
                            <span asp-validation-for="EmpleadoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NumeroCertificado" class="form-label"></label>
                            <input asp-for="NumeroCertificado" class="form-control" placeholder="Número del certificado" />
                            <span asp-validation-for="NumeroCertificado" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaInicio" class="form-label"></label>
                            <input asp-for="FechaInicio" class="form-control" type="date" />
                            <span asp-validation-for="FechaInicio" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaFin" class="form-label"></label>
                            <input asp-for="FechaFin" class="form-control" type="date" />
                            <span asp-validation-for="FechaFin" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="DiagnosticoCie" class="form-label"></label>
                            <input asp-for="DiagnosticoCie" class="form-control" placeholder="Código CIE-10 del diagnóstico" />
                            <span asp-validation-for="DiagnosticoCie" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}