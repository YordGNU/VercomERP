@model Vercom.ViewModels.AuditIndexViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 text-dark"><i class="ti ti-history me-1"></i> @Model.Title</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <!-- Filtros Avanzados -->
    <div class="card mb-4 bg-light shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Usuario</label>
                    <input type="text" name="filterUser" value="@Model.FilterUser" class="form-control form-control-sm" placeholder="Buscar usuario...">
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Tabla / Objeto</label>
                    <input type="text" name="filterTable" value="@Model.FilterTable" class="form-control form-control-sm" placeholder="ej: comercial.factura_venta">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Desde</label>
                    <input type="date" name="start" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Hasta</label>
                    <input type="date" name="end" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-dark w-100"><i class="ti ti-search me-1"></i> FILTRAR</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="auditTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Ocurrido En</th>
                            <th>Usuario</th>
                            <th>Acción</th>
                            <th>Ubicación (Tabla)</th>
                            <th>Reg. ID</th>
                            <th>Canal</th>
                            <th class="text-end">Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            var actionClass = log.Accion switch {
                                "INSERT" => "text-success",
                                "UPDATE" => "text-warning",
                                "DELETE" => "text-danger",
                                "LOGIN_FALLIDO" => "text-danger fw-bold",
                                _ => "text-info"
                            };

                            <tr>
                                <td class="small font-monospace">@log.OcurridoEn.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td><span class="badge bg-light text-dark border">@log.NombreUsuario</span></td>
                                <td class="fw-bold small @actionClass">@log.Accion</td>
                                <td class="small">@log.EsquemaTabla</td>
                                <td class="small text-muted">@log.RegistroId</td>
                                <td class="text-center">
                                    <span class="badge @(log.Canal == "POS" ? "bg-info" : "bg-secondary")">@log.Canal</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@log.Id" class="btn btn-xs btn-outline-dark"><i class="ti ti-eye"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4 py-2 small border-0 shadow-sm">
        <i class="ti ti-info-circle me-1"></i> RF-03: Los registros de auditoría son inalterables y cumplen con la Resolución 60/2011 de la CGR para trazabilidad total.
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#auditTable').DataTable({
                dom: 'Bfrtip',
                buttons: ['excel', 'pdf'],
                         language: { url: '/js/i18n/es-ES.json' },
                order: [[0, 'desc']]
            });
        });
    </script>
}
