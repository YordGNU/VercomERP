@model Vercom.Models.CuentaPorPagar

@{
    ViewData["Title"] = "Crear Cuenta por Pagar";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Crear Cuenta por Pagar</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Contabilidad</a></li>
            <li class="breadcrumb-item active">Cuentas por Pagar</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Creación</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-md-6">
                            <label asp-for="EntidadId" class="form-label"></label>
                            <select asp-for="EntidadId" class="form-select" asp-items="ViewBag.EntidadId"></select>
                            <span asp-validation-for="EntidadId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProveedorId" class="form-label"></label>
                            <select asp-for="ProveedorId" class="form-select" asp-items="ViewBag.ProveedorId"></select>
                            <span asp-validation-for="ProveedorId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DocumentoOrigenTipo" class="form-label"></label>
                            <select asp-for="DocumentoOrigenTipo" class="form-select">
                                <option value="">Seleccione documento</option>
                                <option value="Factura">Factura</option>
                                <option value="Contrato">Contrato</option>
                                <option value="NotaCredito">Nota de Crédito</option>
                            </select>
                            <span asp-validation-for="DocumentoOrigenTipo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DocumentoOrigenId" class="form-label"></label>
                            <input asp-for="DocumentoOrigenId" class="form-control" placeholder="ID del documento" />
                            <span asp-validation-for="DocumentoOrigenId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AsientoOrigenId" class="form-label"></label>
                            <select asp-for="AsientoOrigenId" class="form-select" asp-items="ViewBag.AsientoOrigenId"></select>
                            <span asp-validation-for="AsientoOrigenId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaEmision" class="form-label"></label>
                            <input asp-for="FechaEmision" class="form-control" type="date" />
                            <span asp-validation-for="FechaEmision" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaVencimiento" class="form-label"></label>
                            <input asp-for="FechaVencimiento" class="form-control" type="date" />
                            <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MontoOriginal" class="form-label"></label>
                            <input asp-for="MontoOriginal" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="MontoOriginal" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SaldoPendiente" class="form-label"></label>
                            <input asp-for="SaldoPendiente" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="SaldoPendiente" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}