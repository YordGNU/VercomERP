@model Vercom.ViewModels.CxPFormViewModel
@{
    ViewBag.Title = "Editar Cuenta por Pagar";
    var fmt = new System.Globalization.CultureInfo("es-CU");
    var badgeEstado = Model.Item.Estado switch
    {
        "PAGADA" => "bg-success-subtle text-success",
        "PARCIAL" => "bg-warning-subtle text-warning",
        _ => "bg-primary-subtle text-primary"
    };
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Editar Cuenta por Pagar", Subtitle = "Mantenimiento del pasivo y su saldo vigente.", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row justify-content-center mt-2">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0 border-top border-danger border-3">
            <form asp-action="Edit" asp-route-id="@Model.Item.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Item.Id" />
                <input type="hidden" asp-for="Item.DocumentoOrigenId" />
                <div class="card-header bg-danger-subtle py-3 d-flex align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="ti ti-receipt-tax fs-5 text-danger"></i>
                        <h5 class="m-0 fw-bold">Pasivo Exigible</h5>
                    </div>
                    <span class="badge @badgeEstado">@Model.Item.Estado</span>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small shadow-sm border-0"></div>

                    <div class="alert alert-secondary py-2 small border-0 mb-4">
                        <i class="ti ti-clock me-1"></i> Registrada el <strong>@Model.Item.CreadoEn.ToString("dd/MM/yyyy HH:mm")</strong>
                        · Documento <strong>@Model.Item.DocumentoOrigenTipo @Model.Item.DocumentoOrigenNumero</strong>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Item.ProveedorId" class="form-label fw-bold">Proveedor / acreedor</label>
                            <select asp-for="Item.ProveedorId" class="form-select" asp-items="Model.Proveedores">
                                <option value="">-- Seleccione el proveedor --</option>
                            </select>
                            <span asp-validation-for="Item.ProveedorId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Item.Moneda" class="form-label fw-bold">Moneda</label>
                            <select asp-for="Item.Moneda" class="form-select">
                                @foreach (var m in Vercom.ViewModels.CarteraCatalogos.Monedas)
                                {
                                    <!option value="@m" @(m == Model.Item.Moneda ? "selected" : "")>@m</!option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Item.DocumentoOrigenTipo" class="form-label fw-bold">Tipo de documento</label>
                            <select asp-for="Item.DocumentoOrigenTipo" class="form-select">
                                <option value="">-- Seleccione --</option>
                                @foreach (var t in Vercom.ViewModels.CarteraCatalogos.TiposDocumento)
                                {
                                    <!option value="@t" @(t == Model.Item.DocumentoOrigenTipo ? "selected" : "")>@t</!option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Item.DocumentoOrigenNumero" class="form-label fw-bold">Nº de documento / referencia</label>
                            <input asp-for="Item.DocumentoOrigenNumero" class="form-control" placeholder="ej: INV-9988" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Item.FechaEmision" class="form-label fw-bold">Fecha de emisión</label>
                            <input asp-for="Item.FechaEmision" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Item.FechaVencimiento" class="form-label fw-bold">Fecha de pago comprometida</label>
                            <input asp-for="Item.FechaVencimiento" type="date" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Item.MontoOriginal" class="form-label fw-bold">Importe original</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="ti ti-currency-peso"></i></span>
                                <input asp-for="Item.MontoOriginal" type="number" step="0.01" min="0.01" class="form-control fw-bold text-end" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Item.SaldoPendiente" class="form-label fw-bold">Saldo pendiente</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="ti ti-currency-peso"></i></span>
                                <input asp-for="Item.SaldoPendiente" type="number" step="0.01" min="0" class="form-control fw-bold text-end" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Item.Estado" class="form-label fw-bold">Estado</label>
                            <select asp-for="Item.Estado" class="form-select">
                                @foreach (var e in Vercom.ViewModels.CarteraCatalogos.Estados)
                                {
                                    <!option value="@e" @(e == Model.Item.Estado ? "selected" : "")>@e</!option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="alert alert-warning py-2 small mb-0 border-0">
                                <i class="ti ti-alert-triangle me-1"></i>
                                Los pagos registrados se aplican sobre el saldo pendiente. Ajustar el saldo manualmente influye en la cartera, no en la contabilidad; para registrar pagos use la acción correspondiente en el índice.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light-subtle d-flex justify-content-between gap-2 px-4 py-3">
                    <a asp-action="Details" asp-route-id="@Model.Item.Id" class="btn btn-outline-secondary">
                        <i class="ti ti-eye me-1"></i> Ver ficha
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}