@model Vercom.ViewModels.CxPIndexViewModel
@{
    ViewBag.Title = "Cuentas por Pagar";
    var filtros = new RouteValueDictionary { ["search"] = Model.Search, ["tipo"] = Model.DocumentoTipo, ["estado"] = Model.Estado, ["vencidas"] = Model.VencidasOnly };
    var aplicarId = Context.Request.Query["aplicar"].ToString();
    var fmt = new System.Globalization.CultureInfo("es-CU");
    var hoy = DateOnly.FromDateTime(DateTime.Now);
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Cuentas por Pagar",
    Subtitle = "Cartera de pagos a proveedores, antigüedad de saldos y procesamiento de pagos.",
    PrimaryAction = new Vercom.ViewModels.ActionLinkModel { Controller = "CuentaPorPagar", Action = "Create", Text = "REGISTRAR", Icon = "ti ti-plus" },
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Vercom", Url = "javascript: void(0);" },
        new() { Text = "Contabilidad", Url = "javascript: void(0);" },
        new() { Text = "Cuentas por Pagar", IsActive = true }
    }
}' />

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm mb-0">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <span class="avatar bg-primary-subtle text-primary"><i class="ti ti-wallet fs-20"></i></span>
                <div>
                    <div class="fs-5 fw-bold mb-0">@Model.TotalAbierto.ToString("N2", fmt)</div>
                    <div class="text-muted small">Total abierto · @Model.DocumentosAbiertos docs.</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm mb-0">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <span class="avatar bg-danger-subtle text-danger"><i class="ti ti-alert-triangle fs-20"></i></span>
                <div>
                    <div class="fs-5 fw-bold mb-0">@Model.TotalVencido.ToString("N2", fmt)</div>
                    <div class="text-muted small">Vencido (en mora)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm mb-0">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <span class="avatar bg-success-subtle text-success"><i class="ti ti-calendar-check fs-20"></i></span>
                <div>
                    <div class="fs-5 fw-bold mb-0">@Model.TotalPorVencer.ToString("N2", fmt)</div>
                    <div class="text-muted small">Por vencer</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm mb-0">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <span class="avatar bg-info-subtle text-info"><i class="ti ti-handshake fs-20"></i></span>
                <div>
                    <div class="fs-5 fw-bold mb-0">@Model.TotalAplicado.ToString("N2", fmt)</div>
                    <div class="text-muted small">Pagado acumulado</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold mb-1">Buscar</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="ti ti-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Proveedor, NIT o Nº documento..." autocomplete="off" />
                    <button type="submit" class="btn btn-primary"><i class="ti ti-arrow-right"></i></button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Tipo documento</label>
                <select name="tipo" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Todos --</option>
                    @foreach (var t in Vercom.ViewModels.CarteraCatalogos.TiposDocumento)
                    {
                        <!option value="@t" @(t == Model.DocumentoTipo ? "selected" : "")>@t</!option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Estado</label>
                <select name="estado" class="form-select" onchange="this.form.submit()">
                    <!option value="">-- Todos --</!option>
                    @foreach (var e in Vercom.ViewModels.CarteraCatalogos.Estados)
                    {
                        <!option value="@e" @(e == Model.Estado ? "selected" : "")>@e</!option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end justify-content-between gap-2">
                <div class="form-check form-switch form-switch-sm ms-0" title="Solo documentos cuyo vencimiento ya pasó">
                    <input class="form-check-input" type="checkbox" id="chkVencidas" name="vencidas" value="true" onchange="this.form.submit()" @(Model.VencidasOnly ? "checked" : "")>
                    <label class="form-check-label small fw-bold" for="chkVencidas">Vencidas</label>
                </div>
                <a asp-action="Index" class="btn btn-light">
                    <i class="ti ti-refresh me-1"></i> LIMPIAR
                </a>
            </div>
        </form>
    </div>
</div>

<ul class="nav nav-pills mb-4" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tabCartera" type="button" role="tab">
            <i class="ti ti-file-text me-1"></i> Detalle de la Cartera
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tabAging" type="button" role="tab">
            <i class="ti ti-chart-histogram me-1"></i> Antigüedad de Saldos
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tabCartera" role="tabpanel">
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="fw-bold text-uppercase small">Documento</th>
                            <th class="fw-bold text-uppercase small">Proveedor</th>
                            <th class="fw-bold text-uppercase small">Emisión</th>
                            <th class="fw-bold text-uppercase small">Vencimiento</th>
                            <th class="fw-bold text-uppercase small text-end">Importe</th>
                            <th class="fw-bold text-uppercase small text-end">Saldo</th>
                            <th class="fw-bold text-uppercase small">Antigüedad</th>
                            <th class="fw-bold text-uppercase small">Estado</th>
                            <th class="fw-bold text-uppercase small text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var diasVenc = hoy.DayNumber - item.FechaVencimiento.DayNumber;
                            var badgeAnt = diasVenc switch
                            {
                                <= 0 => "badge-soft-success",
                                <= 30 => "badge-soft-warning",
                                _ => "badge-soft-danger"
                            };
                            var badgeEstado = item.Estado switch
                            {
                                "PAGADA" => "bg-success-subtle text-success",
                                "PARCIAL" => "bg-warning-subtle text-warning",
                                _ => "bg-primary-subtle text-primary"
                            };
                            <tr>
                                <td>
                                    <div class="fw-bold small">@item.DocumentoOrigenTipo</div>
                                    <code class="text-muted small">@(string.IsNullOrEmpty(item.DocumentoOrigenNumero) ? "S/N" : item.DocumentoOrigenNumero)</code>
                                </td>
                                <td>
                                    <div class="fw-bold small">@item.Proveedor.RazonSocial</div>
                                    <span class="text-muted small">@item.Proveedor.Nit</span>
                                </td>
                                <td class="small">@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td class="small">@item.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td class="text-end small fw-semibold">@item.MontoOriginal.ToString("N2", fmt)</td>
                                <td class="text-end small fw-semibold">@item.SaldoPendiente.ToString("N2", fmt)</td>
                                <td>
                                    @if (item.Estado == "PAGADA")
                                    {
                                        <span class="badge badge-soft-success">Al día</span>
                                    }
                                    else
                                    {
                                        <span class="badge @badgeAnt">
                                            @if (diasVenc <= 0) { <text>@(-diasVenc) días</text> } else { <text>@diasVenc días vencido</text> }
                                        </span>
                                    }
                                </td>
                                <td><span class="badge @badgeEstado">@item.Estado</span> <span class="badge bg-light text-muted">@item.Moneda</span></td>
                                <td class="text-end">
                                    <div class="dropdown d-inline-block">
                                        <button class="btn btn-sm btn-icon btn-light border" data-bs-toggle="dropdown" type="button" title="Acciones">
                                            <i class="ti ti-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li><h6 class="dropdown-header small text-uppercase">Acciones</h6></li>
                                            @if (item.Estado != "PAGADA")
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item btn-pagar" data-id="@item.Id" data-saldo="@item.SaldoPendiente.ToString("N2", fmt)" data-doc="@item.DocumentoOrigenTipo @item.DocumentoOrigenNumero" data-bs-toggle="modal" data-bs-target="#pagoModal">
                                                        <i class="ti ti-cash me-1 text-success"></i> Aplicar pago
                                                    </button>
                                                </li>
                                            }
                                            <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="ti ti-eye me-1 text-primary"></i> Detalles</a></li>
                                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="ti ti-edit me-1 text-info"></i> Editar</a></li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Items.Any())
            {
                <div class="text-center py-5">
                    <div class="avatar-lg bg-light text-muted rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="ti ti-search-off fs-40"></i>
                    </div>
                    <h4>Sin resultados</h4>
                    <p class="text-muted">@(Model.TotalItems == 0 ? "No hay cuentas por pagar registradas para esta entidad." : "Ninguna cuenta coincide con los filtros aplicados.")</p>
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                var inicio = Math.Max(1, Model.Page - 2);
                var fin = Math.Min(Model.TotalPages, Model.Page + 2);
                <nav class="py-2">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tipo="@Model.DocumentoTipo" asp-route-estado="@Model.Estado" asp-route-vencidas="@Model.VencidasOnly" asp-route-page="@(Model.Page - 1)">Anterior</a>
                        </li>
                        @for (int p = inicio; p <= fin; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tipo="@Model.DocumentoTipo" asp-route-estado="@Model.Estado" asp-route-vencidas="@Model.VencidasOnly" asp-route-page="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tipo="@Model.DocumentoTipo" asp-route-estado="@Model.Estado" asp-route-vencidas="@Model.VencidasOnly" asp-route-page="@(Model.Page + 1)">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            }

            <div class="text-center text-muted small py-2 border-top">
                Mostrando @Model.Items.Count() de @Model.TotalItems cuentas por pagar
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tabAging" role="tabpanel">
        <div class="card shadow-sm border-0">
            @if (Model.Aging.Any())
            {
                var total = Model.Aging.Sum(a => a.Total);
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="fw-bold text-uppercase small">Tercero</th>
                                <th class="fw-bold text-uppercase small text-end">Por vencer</th>
                                <th class="fw-bold text-uppercase small text-end">1 - 30 días</th>
                                <th class="fw-bold text-uppercase small text-end">31 - 60 días</th>
                                <th class="fw-bold text-uppercase small text-end">Más de 60</th>
                                <th class="fw-bold text-uppercase small text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Aging)
                            {
                                <tr>
                                    <td class="fw-bold small">@r.NombreTercero</td>
                                    <td class="text-end small">@r.PorVencer.ToString("N2", fmt)</td>
                                    <td class="text-end small">@r.De1a30Dias.ToString("N2", fmt)</td>
                                    <td class="text-end small">@r.De31a60Dias.ToString("N2", fmt)</td>
                                    <td class="text-end small">@r.MasDe60Dias.ToString("N2", fmt)</td>
                                    <td class="text-end small fw-bold">@r.Total.ToString("N2", fmt)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th class="fw-bold">TOTALES</th>
                                <th class="text-end fw-bold">@Model.Aging.Sum(a => a.PorVencer).ToString("N2", fmt)</th>
                                <th class="text-end fw-bold">@Model.Aging.Sum(a => a.De1a30Dias).ToString("N2", fmt)</th>
                                <th class="text-end fw-bold">@Model.Aging.Sum(a => a.De31a60Dias).ToString("N2", fmt)</th>
                                <th class="text-end fw-bold">@Model.Aging.Sum(a => a.MasDe60Dias).ToString("N2", fmt)</th>
                                <th class="text-end fw-bold">@total.ToString("N2", fmt)</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="avatar-lg bg-light text-muted rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="ti ti-chart-histogram fs-40"></i>
                    </div>
                    <h4>Sin datos</h4>
                    <p class="text-muted">No hay saldos abiertos para analizar.</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="pagoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <form asp-action="RecordPayment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ItemId" id="payItemId" />
                <div class="modal-header bg-primary-subtle">
                    <h5 class="modal-title fw-bold"><i class="ti ti-cash me-1"></i> Aplicar Pago</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="small text-muted mb-3" id="payDocInfo">Seleccione un documento de la cartera.</div>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Saldo pendiente</label>
                            <div class="form-control bg-light fw-bold" id="paySaldo">--</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Importe a pagar</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="ti ti-currency-peso"></i></span>
                                <input type="number" step="0.01" min="0.01" name="Amount" id="payAmount" class="form-control" placeholder="0.00" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Forma de pago</label>
                            <select name="PaymentMethod" class="form-select">
                                @foreach (var fp in Vercom.ViewModels.CarteraCatalogos.FormasPago)
                                {
                                    <!option value="@fp" @(fp == "EFECTIVO" ? "selected" : "")>@fp</!option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Referencia</label>
                            <input type="text" name="Reference" class="form-control" placeholder="Nº de operación..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4"><i class="ti ti-circle-check me-1"></i> CONFIRMAR PAGO</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            function fillPago(btn) {
                var $btn = $(btn);
                $('#payItemId').val($btn.data('id'));
                $('#payDocInfo').text('Documento: ' + $btn.data('doc'));
                $('#paySaldo').text($btn.data('saldo'));
                $('#payAmount').attr('max', parseFloat(String($btn.data('saldo')).replace(/,/g, '')) || 0);
                $('#payAmount').val('');
            }
            $('.btn-pagar').on('click', function () { fillPago(this); });

            var aplicar = '@aplicarId';
            if (aplicar) {
                var $target = $('.btn-pagar[data-id="' + aplicar + '"]');
                if ($target.length) {
                    fillPago($target[0]);
                    new bootstrap.Modal($('#pagoModal')[0]).show();
                } else {
                    $('#pagoModal .modal-body .small').text('El documento ya no está en esta página; use un documento de la lista.');
                    new bootstrap.Modal($('#pagoModal')[0]).show();
                }
            }
        });
    </script>
}