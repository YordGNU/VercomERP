@model IEnumerable<Vercom.Models.CuentaPorPagar>
@{
    ViewBag.Title = "Cuentas por Pagar";
    var today = DateOnly.FromDateTime(DateTime.Now);
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 text-danger">Obligaciones de Pago (CxP)</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>F. Emisión</th>
                            <th>F. Vencimiento</th>
                            <th>Proveedor</th>
                            <th class="text-end">Monto Original</th>
                            <th class="text-end">Saldo Pendiente</th>
                            <th class="text-center">Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isOverdue = item.FechaVencimiento < today && item.Estado != "PAGADA";
                            var rowClass = isOverdue ? "table-danger" : "";

                            <tr class="@rowClass">
                                <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="fw-bold @(isOverdue ? "text-danger" : "")">
                                        @item.FechaVencimiento.ToString("dd/MM/yyyy")
                                        @if(isOverdue) { <i class="ti ti-alert-triangle ms-1" title="VENCIDA"></i> }
                                    </span>
                                </td>
                              
                                <td class="text-end">@item.MontoOriginal.ToString("C")</td>
                                <td class="text-end fw-bold text-danger">@item.SaldoPendiente.ToString("C")</td>
                                <td class="text-center">
                                    <span class="badge @(item.Estado == "PENDIENTE" ? "bg-warning" : (item.Estado == "PARCIAL" ? "bg-info" : "bg-success"))">
                                        @item.Estado
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-eye"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
