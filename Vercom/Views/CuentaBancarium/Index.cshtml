@model IEnumerable<Vercom.Models.CuentaBancarium>
@{
    ViewBag.Title = "Cuentas Bancarias";
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Saldos y Disponibilidad Bancaria",
    Subtitle = "Control de cuentas en instituciones financieras para cobros y pagos corporativos.",
    PrimaryAction = new Vercom.ViewModels.ActionLinkModel { Controller = "CuentaBancarium", Action = "Create", Text = "AÑADIR CUENTA BANCARIA", Icon = "ti ti-plus" }
}' />

<div class="row">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-6 col-md-12 mb-2">
                <div class="card h-100 transition-all hover-shadow">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center">
                                <div class="avatar-md bg-info-subtle text-info rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                                    <i class="ti ti-building-bank fs-24"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">@item.Banco</h5>
                                    <span class="text-numeric text-primary fw-semibold small">@item.NumeroCuenta</span>
                                    <span class="badge badge-soft-info">@item.TipoCuenta</span>
                                </div>                              
                            </div>                        
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline py-1 px-2 border-0" data-bs-toggle="dropdown" aria-expanded="false"><i class="ti ti-dots-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="">
                                    <li><a asp-action="Details" asp-route-id="@item.Id" class="dropdown-item py-2"><i class="ti ti-info-circle me-1"></i> Detalles</a></li>
                                    <li><a asp-action="MovimientoBancario" asp-route-id="@item.Id" class="dropdown-item py-2"><i class="ti ti-list-search me-1"></i> Ver movimientos</a></li>
                                    <li><a asp-action="Edit" asp-route-id="@item.Id" class="dropdown-item py-2"><i class="ti ti-edit me-2 text-info"></i> Editar Datos</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between py-3 px-4 bg-light-subtle border rounded-3 mb-2">
                            <div>
                                <p class="small text-muted text-uppercase mb-0 fw-bold">Saldo en @item.TipoCuenta</p>
                                <h3 class="fw-bold text-dark mb-0 text-numeric">@item.SaldoActual.ToString("N2")</h3>
                            </div>
                            <div class="text-end">
                                <span class="badge badge-soft-success py-1 px-3 border-0"><i class="ti ti-circle-check-filled me-1"></i> CONCILIADO</span>
                                <small class="text-muted d-block mt-1 tiny">Act. @DateTime.Now.ToString("dd/MM")</small>
                            </div>
                        </div>   
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge @(item.Activa ? "badge-soft-success" : "badge-soft-danger")">
                                <i class="ti ti-circle-filled fs-8 me-1"></i> @(item.Activa ? "OPERATIVA" : "INACTIVA")
                            </span>
                        </div>
                    </div>
                </div>
             </div>
        }
    </div>
</div>

<style>
    .hover-shadow:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
