@model IEnumerable<Vercom.Models.CuentaBancarium>
@{
    ViewBag.Title = "Cuentas Bancarias";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Saldos en Bancos</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Añadir Cuenta
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 border-start border-info border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <div>
                                <h4 class="card-title mb-1">@item.Banco</h4>
                                <code class="text-primary fs-15">@item.NumeroCuenta</code>
                            </div>
                            <span class="badge bg-info-subtle text-info">@item.TipoCuenta</span>
                        </div>

                        <div class="d-flex align-items-center justify-content-between py-2 px-3 bg-light rounded">
                            <h3 class="fw-bold mb-0">@item.SaldoActual.ToString("C")</h3>
                            <div class="text-end small">
                                <span class="text-muted d-block">Saldo Contable</span>
                                <span class="text-success"><i class="ti ti-check me-1"></i>Conciliado</span>
                            </div>
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <a asp-controller="MovimientoBancario" asp-action="Index" asp-route-cuentaId="@item.Id" class="btn btn-sm btn-outline-secondary w-100">Ver Movimientos</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light btn-icon"><i class="ti ti-settings"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any()) {
            <div class="col-12 text-center py-5 text-muted small">No hay cuentas bancarias registradas.</div>
        }
    </div>
</div>


@section Scripts {
    <script>
        .ready(function () {
            #dataTable.DataTable();
        });
    </script>
}


