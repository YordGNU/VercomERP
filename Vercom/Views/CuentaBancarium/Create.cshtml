@model Vercom.Models.CuentaBancarium

@{
    ViewData["Title"] = "Crear Cuenta Bancaria";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Crear Cuenta Bancaria</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Tesorería</a></li>
            <li class="breadcrumb-item active">Cuentas Bancarias</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Creación</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-md-6">
                            <label asp-for="EntidadId" class="form-label"></label>
                            <select asp-for="EntidadId" class="form-select" asp-items="ViewBag.EntidadId"></select>
                            <span asp-validation-for="EntidadId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Banco" class="form-label"></label>
                            <select asp-for="Banco" class="form-select">
                                <option value="">Seleccione banco</option>
                                <option value="BPA">Banco Popular de Ahorro (BPA)</option>
                                <option value="BANDEC">Banco de Crédito y Comercio (BANDEC)</option>
                                <option value="BFI">Banco Financiero Internacional (BFI)</option>
                                <option value="BICSA">Banco Internacional de Comercio S.A. (BICSA)</option>
                                <option value="Metropolitano">Banco Metropolitano</option>
                            </select>
                            <span asp-validation-for="Banco" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NumeroCuenta" class="form-label"></label>
                            <input asp-for="NumeroCuenta" class="form-control" placeholder="Número de cuenta" />
                            <span asp-validation-for="NumeroCuenta" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TipoCuenta" class="form-label"></label>
                            <select asp-for="TipoCuenta" class="form-select">
                                <option value="">Seleccione tipo</option>
                                <option value="Fiscal">Cuenta Fiscal</option>
                                <option value="Corriente">Cuenta Corriente</option>
                                <option value="Ahorro">Cuenta de Ahorro</option>
                            </select>
                            <span asp-validation-for="TipoCuenta" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CuentaContableId" class="form-label"></label>
                            <select asp-for="CuentaContableId" class="form-select" asp-items="ViewBag.CuentaContableId"></select>
                            <span asp-validation-for="CuentaContableId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SaldoActual" class="form-label"></label>
                            <input asp-for="SaldoActual" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="SaldoActual" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}