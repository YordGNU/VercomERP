@model Vercom.Models.Caja
@{
    ViewBag.Title = "Detalles de Caja";
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Gestión de Arca: " + Model.Nombre,
    Subtitle = "Detalle técnico, ubicación y estado financiero de la caja seleccionada.",
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Vercom", Url = "javascript: void(0);" },
        new() { Text = "Tesorería", Url = "javascript: void(0);" },
        new() { Text = "Cajas", Url = Url.Action("Index") },
        new() { Text = "Detalles", IsActive = true }
    }
}' />

<div class="row">
    <div class="row">
        <!-- Columna Izquierda: Información Financiera -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-status-top bg-primary"></div>
                <div class="card-body text-center p-4">
                    <div class="avatar avatar-xl bg-primary-subtle text-primary rounded-circle mb-3 mx-auto" style="width: 80px; height: 80px;">
                        <i class="ti ti-cash fs-40"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.SaldoActual.ToString("C")</h3>
                    <p class="text-muted small text-uppercase fw-bold mb-0">Saldo Actual en Arca</p>

                    <div class="mt-4 pt-3 border-top">
                        <span class="badge @(Model.Activa ? "badge-soft-success" : "badge-soft-danger") fs-12 px-3 py-2">
                            <i class="ti ti-circle-filled me-1"></i> @(Model.Activa ? "CAJA ACTIVA" : "CAJA INACTIVA")
                        </span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold"><i class="ti ti-settings me-2 text-primary"></i>Límites de Control</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small fw-bold text-uppercase d-block mb-1">Límite de Efectivo</label>
                        <h4 class="m-0 text-primary fw-bold">@(Model.LimiteEfectivo?.ToString("C") ?? "SIN LÍMITE")</h4>
                    </div>
                    <div class="progress progress-sm">
                        @{
                            var percent = Model.LimiteEfectivo > 0 ? (Model.SaldoActual / Model.LimiteEfectivo.Value) * 100 : 0;
                            var progressClass = percent > 90 ? "bg-danger" : percent > 70 ? "bg-warning" : "bg-success";
                        }
                        <div class="progress-bar @progressClass" style="width: @percent%"></div>
                    </div>
                    <small class="text-muted mt-2 d-block">Utilización del cupo: @percent.ToString("N1")%</small>
                </div>
            </div>
        </div>
        <!-- Columna Derecha: Detalles Técnicos e Integración -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header justify-content-between bg-light-subtle">
                    <h5 class="m-0 fw-bold"><i class="ti ti-info-circle me-2 text-primary"></i>Configuración de Integración</h5>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary shadow-sm">
                        <i class="ti ti-edit me-1"></i> MODIFICAR CONFIGURACIÓN
                    </a>
                </div>
                <div class="card-body">
                    <table class="table table-vcenter card-table">
                        <tbody>
                            <tr>
                                <td class="text-muted fw-bold text-uppercase small" width="200">ID Técnico</td>
                                <td class="font-monospace small">@Model.Id</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-bold text-uppercase small">Nombre Identificativo</td>
                                <td class="fw-bold">@Model.Nombre</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-bold text-uppercase small">Sucursal / Ubicación</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="ti ti-building-community me-2 text-muted"></i>
                                        <div>
                                            <div class="fw-bold">@Model.Sucursal.Nombre</div>
                                            <div class="small text-muted">Código: @Model.Sucursal.Codigo</div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-bold text-uppercase small">Cuenta Contable (Integración)</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="ti ti-calculator me-2 text-muted"></i>
                                        <div>
                                            <div class="fw-bold text-primary">@Model.CuentaContable.Nombre</div>
                                            <div class="small text-muted">Código: @Model.CuentaContable.Codigo</div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="alert alert-info border-0 shadow-sm rounded-3">
                <div class="d-flex align-items-center">
                    <i class="ti ti-bulb fs-32 me-3 opacity-50"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Información de Control Interno</h6>
                        <p class="mb-0 small">Esta caja está vinculada directamente al Libro Mayor. Cualquier movimiento registrado en el POS o en Tesorería impactará automáticamente la cuenta contable <strong>@Model.CuentaContable.Codigo</strong>.</p>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="ti ti-arrow-left me-1"></i> VOLVER AL LISTADO
                </a>
            </div>
        </div>
    </div>
</div>
