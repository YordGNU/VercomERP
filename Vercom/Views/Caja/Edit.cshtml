@model Vercom.ViewModels.CajaFormViewModel

@{
    ViewData["Title"] = Model.Caja.Id == Guid.Empty ? "Nueva Caja" : "Editar Caja";
    var esNueva = Model.Caja.Id == Guid.Empty;
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = esNueva ? "Nueva Caja" : "Editar Caja",
    Subtitle = esNueva ? "Complete los datos de la nueva caja" : "Actualice los datos de la caja",
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Inicio", Url = Url.Action("Index", "Dashboard") },
        new() { Text = "Cajas", Url = Url.Action("Index") },
        new() { Text = esNueva ? "Nueva" : "Editar", IsActive = true }
    }
}' />

<div class="row mt-3">
    <div class="col-lg-12">
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="ti ti-file-text me-1"></i>
                    @(esNueva ? "Complete los datos de la nueva caja" : "Actualice los datos de la caja")
                </h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="ti ti-arrow-left me-1"></i> Volver al listado
                </a>
            </div>
            <div class="card-body">
                <form asp-action="@(esNueva ? "Create" : "Edit")" class="row g-3 needs-validation" novalidate id="editCajaForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Caja.Id" />
                    <input type="hidden" asp-for="Caja.EntidadId" />

                    <!-- ======================================== -->
                    <!-- DATOS GENERALES -->
                    <!-- ======================================== -->
                    <div class="col-12">
                        <h6 class="text-muted border-bottom pb-2">
                            <i class="ti ti-info-circle me-1"></i> Información General
                        </h6>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Caja.Nombre" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-building"></i></span>
                                <input asp-for="Caja.Nombre" class="form-control" placeholder="Ej: Caja Principal, Caja Secundaria..." />
                            </div>
                            <span asp-validation-for="Caja.Nombre" class="text-danger small"></span>
                            <small class="form-text text-muted">Nombre descriptivo de la caja para identificarla fácilmente.</small>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Caja.SucursalId" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-map-pin"></i></span>
                                <select asp-for="Caja.SucursalId" class="form-select" asp-items="@Model.Sucursales">
                                    <option value="">-- Seleccionar Sucursal --</option>
                                </select>
                            </div>
                            <span asp-validation-for="Caja.SucursalId" class="text-danger small"></span>
                            <small class="form-text text-muted">Sucursal a la que pertenece esta caja.</small>
                        </div>
                    </div>

                    <!-- ======================================== -->
                    <!-- CONFIGURACIÓN CONTABLE -->
                    <!-- ======================================== -->
                    <div class="col-12 mt-3">
                        <h6 class="text-muted border-bottom pb-2">
                            <i class="ti ti-book me-1"></i> Configuración Contable
                        </h6>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Caja.CuentaContableId" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-coin"></i></span>
                                <select asp-for="Caja.CuentaContableId" class="form-select select2-cuenta" asp-items="@Model.CuentasContables">
                                    <option value="">-- Seleccionar Cuenta --</option>
                                </select>
                            </div>
                            <span asp-validation-for="Caja.CuentaContableId" class="text-danger small"></span>
                            <small class="form-text text-muted">Cuenta del plan de cuentas que representa esta caja (ej. 101-001).</small>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Caja.LimiteEfectivo" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-cash"></i></span>
                                <input asp-for="Caja.LimiteEfectivo" class="form-control" placeholder="0.00" type="number" step="0.01" min="0" />
                                <span class="input-group-text">CUP</span>
                            </div>
                            <span asp-validation-for="Caja.LimiteEfectivo" class="text-danger small"></span>
                            <small class="form-text text-muted">Monto máximo de efectivo permitido en esta caja (control interno).</small>
                        </div>
                    </div>

                    <!-- ======================================== -->
                    <!-- SALDO Y ESTADO -->
                    <!-- ======================================== -->
                    <div class="col-12 mt-3">
                        <h6 class="text-muted border-bottom pb-2">
                            <i class="ti ti-cash-banknote me-1"></i> Saldo y Estado
                        </h6>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Caja.SaldoActual" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-wallet"></i></span>
                                <input asp-for="Caja.SaldoActual" class="form-control" placeholder="0.00" type="number" step="0.01" min="0" />
                                <span class="input-group-text">CUP</span>
                            </div>
                            <span asp-validation-for="Caja.SaldoActual" class="text-danger small"></span>
                            <small class="form-text text-muted">Saldo inicial o actual de la caja. Se actualizará con los movimientos.</small>
                        </div>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-group pt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" asp-for="Caja.Activa" />
                                <label class="form-check-label fw-semibold" asp-for="Caja.Activa">
                                    <i class="ti ti-@(Model.Caja.Activa ? "check-circle" : "x-circle") me-1"></i>
                                    @(Model.Caja.Activa ? "Activa" : "Inactiva")
                                </label>
                            </div>
                            <small class="form-text text-muted d-block">
                                Una caja inactiva no podrá ser utilizada en nuevas transacciones.
                            </small>
                        </div>
                    </div>

                    <!-- ======================================== -->
                    <!-- BOTONES DE ACCIÓN -->
                    <!-- ======================================== -->
                    <div class="col-12 mt-4 d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="ti ti-x me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="ti ti-device-floppy me-1"></i>
                            @(esNueva ? "Crear Caja" : "Guardar Cambios")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Styles{  
    <link href="~/css/plugins/select2/select2.min.css" rel="stylesheet" />
}
@section Scripts {
    <script src="~/js/plugins/select2/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // ... (resto del código igual)
            window.SubmitAjaxForm('editCajaForm');
        });
    </script>
}
