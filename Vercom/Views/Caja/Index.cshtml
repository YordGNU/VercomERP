@model IEnumerable<Vercom.Models.Caja>
@{
    ViewBag.Title = "Gestión de Arcas";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Disponibilidad en Caja</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Nueva Caja
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-start border-success border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <h4 class="card-title">@item.Nombre</h4>
                            <span class="badge @(item.Activa ? "bg-success" : "bg-danger")">@(item.Activa ? "OPERATIVA" : "CERRADA")</span>
                        </div>

                        <div class="text-center py-2 bg-light rounded mb-3">
                            <h2 class="fw-bold text-success mb-0">@item.SaldoActual.ToString("C")</h2>
                            <small class="text-muted">Saldo Disponible</small>
                        </div>

                        <div class="small text-muted">
                            <p class="mb-1"><strong>Cuenta:</strong> @item.CuentaContable.Codigo - @item.CuentaContable.Nombre</p>
                            <p class="mb-0"><strong>Límite:</strong> @(item.LimiteEfectivo?.ToString("C") ?? "Sin límite")</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any()) {
            <div class="col-12 text-center py-5 text-muted small">No hay cajas configuradas.</div>
        }
    </div>
</div>


@section Scripts {
    <script>
        .ready(function () {
            #dataTable.DataTable();
        });
    </script>
}


