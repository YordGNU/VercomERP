@model Vercom.ViewModels.CajaFormViewModel
@{
    ViewData["Title"] = "Crear Caja";
}
<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Configurar Nueva Arca / Caja",
    Subtitle = "Habilitación de cajas físicas para el manejo de efectivo y cobros POS.",
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Vercom", Url = "javascript: void(0);" },
        new() { Text = "Tesorería", Url = "javascript: void(0);" },
        new() { Text = "Nueva Caja", IsActive = true }
    }
}' />

<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                 <div class="card-header border-light justify-content-between">
                    <h5 class="m-0 fw-bold"><i class="ti ti-cash me-2 text-primary"></i>Datos del Arca</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" class="row g-4" id="createCajaForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>
                        <div class="col-md-6">
                            <label class="form-label">Sucursal de Ubicación</label>
                            <select asp-for="Caja.SucursalId" name="Caja.SucursalId" class="form-control form-select w-100 select2" asp-items="Model.Sucursales" required></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Nombre Identificativo de Caja</label>
                            <input asp-for="Caja.Nombre" name="Caja.Nombre" class="form-control w-100" placeholder="Ej: Caja Principal 01" required />
                            <span asp-validation-for="Caja.Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Cuenta Mayor Asociada (Tesorería)</label>
                            <select asp-for="Caja.CuentaContableId" name="Caja.CuentaContableId" class="form-control form-select w-100 select2-cuenta" asp-items="Model.CuentasContables" required></select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Límite de Efectivo ($)</label>
                            <input asp-for="Caja.LimiteEfectivo" name="Caja.LimiteEfectivo" class="form-control w-100" placeholder="0.00" type="number" step="0.01" />
                            <span asp-validation-for="Caja.LimiteEfectivo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Saldo de Apertura ($)</label>
                            <input asp-for="Caja.SaldoActual" name="Caja.SaldoActual" class="form-control w-100" placeholder="0.00" type="number" step="0.01" />
                            <span asp-validation-for="Caja.SaldoActual" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> REGISTRAR CAJA
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('createCajaForm');
        });
    </script>
}
