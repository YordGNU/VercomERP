@model Vercom.ViewModels.CajaFormViewModel
@{
    ViewData["Title"] = "Crear Caja";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Crear Caja</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Tesorería</a></li>
            <li class="breadcrumb-item active">Cajas</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Creación</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>                       
                        <div class="col-md-6">
                            <label asp-for="Caja.SucursalId" class="form-label">Sucursal</label>
                            <select asp-for="Caja.SucursalId" name="Caja.SucursalId" class="form-control form-select w-100 select2" asp-items="Model.Sucursales" required></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Caja.Nombre" class="form-label"></label>
                            <input asp-for="Caja.Nombre" class="form-control" placeholder="Nombre de la caja" />
                            <span asp-validation-for="Caja.Nombre" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Caja.CuentaContableId" class="form-label">Cuenta contable asociada</label>
                            <select asp-for="Caja.CuentaContableId" name="Caja.CuentaContableId" class="form-control form-select w-100 select2" asp-items="Model.CuentasContables" required></select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Caja.LimiteEfectivo" class="form-label"></label>
                            <input asp-for="Caja.LimiteEfectivo" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Caja.LimiteEfectivo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Caja.SaldoActual" class="form-label"></label>
                            <input asp-for="Caja.SaldoActual" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Caja.SaldoActual" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}