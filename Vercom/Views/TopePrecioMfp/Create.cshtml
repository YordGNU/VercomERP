@model Vercom.ViewModels.PriceLimitFormViewModel
@{
    ViewBag.Title = "Configurar Tope de Precio";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Precios Máximos (MFP)</h4>
        <p class="text-muted small mb-0">Definición de límites legales para la venta minorista y servicios (RF-55).</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Comercial</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Topes MFP</a></li>
            <li class="breadcrumb-item active">Nuevo</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary"><i class="ti ti-lock me-2"></i>Nueva Regulación de Precio</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> VOLVER
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" class="row g-4" id="createPriceLimitForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-12">
                            <div class="alert alert-info border-0 py-3 mb-2 small">
                                <i class="ti ti-info-circle-filled me-1"></i>
                                Puede aplicar el tope a un <strong>Producto específico</strong> o a una <strong>Familia completa</strong>.
                                Si selecciona ambos, el tope individual tendrá prioridad.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Producto Específico</label>
                            <select asp-for="Limit.ProductoId" name="Limit.ProductoId" class="form-select select2" asp-items="Model.Productos">
                                <option value="">-- No aplica a producto único --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Familia de Productos</label>
                            <select asp-for="Limit.FamiliaId" name="Limit.FamiliaId" class="form-select select2" asp-items="Model.Familias">
                                <option value="">-- No aplica a familia --</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Precio Máximo Permitido ($)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="Limit.PrecioMaximo" name="Limit.PrecioMaximo" class="form-control fw-bold text-danger fs-5" placeholder="0.00" type="number" step="0.01" required />
                            </div>
                            <span asp-validation-for="Limit.PrecioMaximo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Vigente Desde</label>
                            <input asp-for="Limit.VigenteDesde" name="Limit.VigenteDesde" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Vigente Hasta</label>
                            <input asp-for="Limit.VigenteHasta" name="Limit.VigenteHasta" class="form-control" type="date" />
                            <small class="text-muted tiny">Opcional.</small>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Resolución de Referencia / Justificación</label>
                            <input asp-for="Limit.ResolucionReferencia" name="Limit.ResolucionReferencia" class="form-control" placeholder="Ej: Res. 12/2026 MFP - Precios de Canasta Básica" />
                            <span asp-validation-for="Limit.ResolucionReferencia" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">DESCARTAR</a>
                            <button type="submit" class="btn btn-primary px-5 shadow">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR TOPE MFP
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('createPriceLimitForm');
        });
    </script>
}
