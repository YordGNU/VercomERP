@model Vercom.Models.TopePrecioMfp
@{
    ViewBag.Title = "Editar Tope de Precio";
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Topes MFP</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Gestión de Precios Máximos (MFP)", Subtitle = "Modificación de límites legales para la venta minorista y servicios (RF-55).", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary"><i class="ti ti-edit me-2"></i>Actualizar Regulación</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> VOLVER
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" class="row g-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Producto Específico</label>
                            <select asp-for="ProductoId" class="form-select select2" asp-items="ViewBag.ProductoId">
                                <option value="">-- No aplica a producto único --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Familia de Productos</label>
                            <select asp-for="FamiliaId" class="form-select select2" asp-items="ViewBag.FamiliaId">
                                <option value="">-- No aplica a familia --</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Precio Máximo Permitido ($)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="PrecioMaximo" class="form-control fw-bold text-danger fs-5" type="number" step="0.01" required />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Vigente Desde</label>
                            <input asp-for="VigenteDesde" class="form-control" type="date" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Vigente Hasta</label>
                            <input asp-for="VigenteHasta" class="form-control" type="date" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Resolución de Referencia</label>
                            <input asp-for="ResolucionReferencia" class="form-control" />
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-primary px-5 shadow">
                                <i class="ti ti-device-floppy me-1"></i> ACTUALIZAR TOPE
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
