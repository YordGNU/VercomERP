@model IEnumerable<Vercom.Models.TopePrecioMfp>
@{
    ViewBag.Title = "Precios Máximos MFP";
}

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> NUEVO TOPE</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Producción", Title = "Gestión de Precios Máximos (MFP)", Subtitle = "Control de topes oficiales para productos minoristas y servicios (Resoluciones MFP).", Icon = "ti-plus", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <!-- Sección de Filtros -->
    <div class="col-12 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-3">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-lg-6">
                        <label class="form-label small fw-bold">Producto o Familia</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="ti ti-search text-muted"></i></span>
                            <input type="text" name="search" class="form-control border-start-0" placeholder="Buscar regulación..." value="@ViewBag.CurrentSearch" />
                        </div>
                    </div>
                    <div class="col-lg-6 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="ti ti-filter me-1"></i> FILTRAR TOPES
                        </button>
                        <a asp-action="Index" class="btn btn-light" title="Limpiar"><i class="ti ti-refresh"></i></a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold"><i class="ti ti-list-check me-2 text-primary"></i>Nomenclador de Precios Limitados</h5>
                </div>
                <div class="card-body">                   
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="ti ti-lock-off fs-48 text-muted mb-3 d-block"></i>
                            <h4 class="fw-bold">Sin regulaciones de precios</h4>
                            <p class="text-muted small">Configure aquí los topes máximos establecidos por el MFP para el control legal en facturación.</p>
                            <a asp-action="Create" class="btn btn-sm btn-primary mt-2">DEFINIR NUEVA REGULACIÓN</a>
                        </div>
                    }
                    else
                    {
                        <table id="priceLimitsTable" class="table table-striped table-hover dt-responsive">
                            <thead class="thead-sm text-uppercase fs-xxs">
                                <tr>
                                    <th>Producto / Familia</th>
                                    <th>Precio Máx. ($)</th>
                                    <th>Vigencia</th>
                                    <th>Resolución de Referencia</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var isVigente = item.VigenteHasta == null || item.VigenteHasta >= DateOnly.FromDateTime(DateTime.Now);
                                    <tr>
                                        <td>
                                            @if (item.Producto != null)
                                            {
                                                <div class="fw-bold">@item.Producto.Nombre</div>
                                                <small class="text-muted text-uppercase tiny">Artículo Individual</small>
                                            }
                                            else
                                            {
                                                <div class="fw-bold text-primary">@item.Familia?.Nombre</div>
                                                <small class="text-muted text-uppercase tiny">Familia de Productos</small>
                                            }
                                        </td>
                                       <td class="fw-bold text-danger">@item.PrecioMaximo.ToString("N2")</td>
                                        <td small">
                                            <div class="text-muted">Desde: @item.VigenteDesde.ToString("dd/MM/yyyy")</div>
                                            <div class="fw-bold">Hasta: @(item.VigenteHasta?.ToString("dd/MM/yyyy") ?? "Indefinido")</div>
                                        </td>
                                        <td class="small italic">@(item.ResolucionReferencia ?? "-")</td>
                                        <td>
                                            <span class="badge @(isVigente ? "bg-success" : "bg-secondary") small">@(isVigente ? "ACTIVO" : "VENCIDO")</span>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Editar">
                                                    <i class="ti ti-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Ver Historial">
                                                    <i class="ti ti-eye"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#priceLimitsTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
                order: [[2, 'desc']]
            });
        });
    </script>
}
