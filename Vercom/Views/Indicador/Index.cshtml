@model IEnumerable<Vercom.Models.Indicador>
@{
    ViewBag.Title = "Diccionario de Indicadores";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Inteligencia de Negocio: Indicadores (KPIs)</h4>
        <p class="text-muted small mb-0">Definición de fórmulas métricas para el análisis de rendimiento y salud financiera.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Reportes</a></li>
            <li class="breadcrumb-item active">KPIs</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-chart-infographic"></i> NUEVO INDICADOR
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Catálogo de Métricas</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="indicatorsTable" class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th width="150">Código KPI</th>
                            <th>Nombre del Indicador</th>
                            <th width="180">Categoría</th>
                            <th>Fórmula / Descripción Técnica</th>
                            <th width="100" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var catClass = item.Categoria switch {
                                "LIQUIDEZ" => "badge-soft-info",
                                "RENTABILIDAD" => "badge-soft-success",
                                "ACTIVIDAD" => "badge-soft-warning",
                                "PRESUPUESTO" => "badge-soft-primary",
                                _ => "badge-soft-secondary"
                            };

                            <tr>
                                <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td><span class="badge @catClass">@item.Categoria</span></td>
                                <td class="small text-muted">@item.FormulaDescripcion</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Ver Historial">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#indicatorsTable').DataTable({
                language: { url: '/js/i18n/es-ES.json' },
                order: [[2, 'asc'], [1, 'asc']]
            });
        });
    </script>
}
