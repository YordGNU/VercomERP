@model IEnumerable<Vercom.Models.Indicador>
@{
    ViewBag.Title = "Diccionario de Indicadores";
}

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> NUEVO INDICADOR</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Inteligencia de Negocio: Indicadores (KPIs)", Subtitle = "Definición de fórmulas métricas para el análisis de rendimiento y salud financiera.", Icon = "ti-chart-infographic", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Catálogo de Métricas</h5>
        </div>
        <div class="card-body">
            <table id="indicatorsTable" class="table table-hover align-middle">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                           <th>Código KPI</th>
                        <th>Nombre del Indicador</th>
                        <th >Categoría</th>
                        <th>Fórmula / Descripción Técnica</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var catClass = item.Categoria switch
                        {
                            "LIQUIDEZ" => "badge-soft-info",
                            "RENTABILIDAD" => "badge-soft-success",
                            "ACTIVIDAD" => "badge-soft-warning",
                            "PRESUPUESTO" => "badge-soft-primary",
                            _ => "badge-soft-secondary"
                        };

                        <tr>
                            <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td><span class="badge @catClass">@item.Categoria</span></td>
                            <td class="small text-muted">@item.FormulaDescripcion</td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Editar">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Ver Historial">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#indicatorsTable').DataTable({
           language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[2, 'asc'], [1, 'asc']]
            });
        });
    </script>
}
