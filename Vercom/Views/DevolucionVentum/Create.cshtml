@model Vercom.Models.DevolucionVentum

@{
    ViewData["Title"] = "Crear Devolución de Venta";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Crear Devolución de Venta</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Ventas</a></li>
            <li class="breadcrumb-item active">Devoluciones</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Creación</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-md-6">
                            <label asp-for="FacturaId" class="form-label"></label>
                            <select asp-for="FacturaId" class="form-select" asp-items="ViewBag.FacturaId"></select>
                            <span asp-validation-for="FacturaId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TotalDevuelto" class="form-label"></label>
                            <input asp-for="TotalDevuelto" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="TotalDevuelto" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Motivo" class="form-label"></label>
                            <input asp-for="Motivo" class="form-control" placeholder="Motivo de la devolución" />
                            <span asp-validation-for="Motivo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MovimientoInventarioId" class="form-label"></label>
                            <select asp-for="MovimientoInventarioId" class="form-select" asp-items="ViewBag.MovimientoInventarioId"></select>
                            <span asp-validation-for="MovimientoInventarioId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AsientoId" class="form-label"></label>
                            <select asp-for="AsientoId" class="form-select" asp-items="ViewBag.AsientoId"></select>
                            <span asp-validation-for="AsientoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AutorizadoPor" class="form-label"></label>
                            <input asp-for="AutorizadoPor" class="form-control" placeholder="Usuario autorizador" />
                            <span asp-validation-for="AutorizadoPor" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}