@model IEnumerable<Vercom.Models.OrdenCompra>
@{ ViewBag.Title = "Órdenes de Compra"; }

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-shopping-cart-plus me-1'></i> NUEVA ORDEN</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Compras", Title = "Abastecimiento y Compras", Subtitle = "Gestión de órdenes de compra a proveedores y recepción de mercancías.", Icon = "ti-shopping-cart-plus", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />

<div class="row">
    <!-- Sección de Filtros -->
    <div class="col-12 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-3">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-lg-4">
                        <label class="form-label small fw-bold">Número u Origen</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="ti ti-search text-muted"></i></span>
                            <input type="text" name="search" class="form-control border-start-0" placeholder="Buscar orden o proveedor..." value="@ViewBag.CurrentSearch" />
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <label class="form-label small fw-bold">Estado del Ciclo</label>
                        <select name="status" class="form-select">
                            <option value="">-- Todos los Estados --</option>
                            <!option value="BORRADOR" @(ViewBag.CurrentStatus == "BORRADOR" ? "selected" : "")>BORRADOR</!option>
                            <!option value="APROBADA" @(ViewBag.CurrentStatus == "APROBADA" ? "selected" : "")>APROBADA</!option>
                            <!option value="RECIBIDA" @(ViewBag.CurrentStatus == "RECIBIDA" ? "selected" : "")>RECIBIDA</!option>
                            <!option value="ANULADA" @(ViewBag.CurrentStatus == "ANULADA" ? "selected" : "")>ANULADA</!option>
                        </select>
                    </div>
                    <div class="col-lg-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="ti ti-filter me-1"></i> APLICAR FILTROS
                        </button>
                        <a asp-action="Index" class="btn btn-light" title="Limpiar"><i class="ti ti-refresh"></i></a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Órdenes de Compra Emitidas</h5>
        </div>
        <div class="card-body">
            <table id="purchaseTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th>Fecha</th>
                        <th> Nº Orden</th>
                        <th>Proveedor</th>
                        <th >Moneda</th>
                       <th>Monto Total ($)</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.Estado switch
                        {
                            "RECIBIDA_TOTAL" => "badge-soft-success",
                            "RECIBIDA_PARCIAL" => "badge-soft-info",
                            "RECIBIDA" => "badge-soft-success",
                            "APROBADA" => "badge-soft-primary",
                            "BORRADOR" => "badge-soft-warning",
                            "ANULADA" => "badge-soft-danger",
                            _ => "badge-soft-secondary"
                        };

                        <tr>
                             <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="text-numeric fw-bold text-primary">@item.NumeroOrden</td>
                            <td class="fw-semibold">@item.Proveedor.RazonSocial</td>
                            <td >@item.Moneda</td>
                            <td class="text-numeric fw-bold">@item.Total.ToString("N2")</td>
                            <td ><span class="badge @statusClass">@item.Estado</span></td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Detalles">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    @if (item.Estado == "APROBADA")
                                    {
                                        <a asp-action="Receive" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2 text-success" title="Recibir Mercancía">
                                            <i class="ti ti-download"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#purchaseTable').DataTable({
                    language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'desc']]
            });
        });
    </script>
}
