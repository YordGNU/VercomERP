@model Vercom.ViewModels.PurchaseOrderViewModel
@{
    ViewBag.Title = Model.Title;
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Compras</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Nueva Orden de Compra", Subtitle = "Gestión de aprovisionamiento y solicitudes a proveedores (RF-51).", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <form asp-action="Create" method="post" id="purchaseForm">
        @Html.AntiForgeryToken()
        <div class="row">
            <!-- Columna Principal: Cabecera y Partidas -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light-subtle py-3">
                        <h5 class="m-0 fw-bold"><i class="ti ti-truck-delivery me-2 text-primary"></i>Datos del Suministro</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Order.ProveedorId" class="form-label fw-bold"></label>
                                <select asp-for="Order.ProveedorId" name="Order.ProveedorId" class="form-control form-select w-100 select2" asp-items="Model.Proveedores" required>
                                    <option value="">-- Seleccione Proveedor --</option>
                                </select>
                                <span asp-validation-for="Order.ProveedorId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Order.ContratoId" class="form-label fw-bold"></label>
                                <select asp-for="Order.ContratoId" name="Order.ContratoId" class="form-control form-select w-100" asp-items="Model.Contratos">
                                    <option value="">-- Compra Directa sin Contrato --</option>
                                </select>
                                <span asp-validation-for="Order.ContratoId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Order.AlmacenDestinoId" class="form-label fw-bold"></label>
                                <select asp-for="Order.AlmacenDestinoId" name="Order.AlmacenDestinoId" class="form-control form-select w-100 select2" asp-items="Model.Almacenes" required></select>
                                <span asp-validation-for="Order.AlmacenDestinoId" class="text-danger small"></span>
                                <small class="text-muted tiny">Donde ingresará físicamente la mercancía.</small>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Order.Fecha" class="form-label fw-bold"></label>
                                <input asp-for="Order.Fecha" name="Order.Fecha" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="Order.Fecha" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Order.Moneda" class="form-label fw-bold"></label>
                                <select asp-for="Order.Moneda" name="Order.Moneda" class="form-control form-select">
                                    <option value="CUP">CUP - Pesos</option>
                                    <option value="USD">USD - Moneda Libremente Conv.</option>
                                </select>
                                <span asp-validation-for="Order.Moneda" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center py-3">
                        <h5 class="m-0 fw-bold"><i class="ti ti-list-details me-2 text-primary"></i>Artículos Solicitados</h5>
                        <button type="button" class="btn btn-sm btn-primary shadow-sm" onclick="addRow()">
                            <i class="ti ti-plus me-1"></i> AÑADIR LÍNEA
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table table-hover mb-0" id="detailsTable">
                            <thead class="thead-sm text-uppercase fs-xxs">
                                    <tr>
                                        <th class="ps-4">Producto / Insumo</th>
                                        <th class="text-center" width="140">Cantidad</th>
                                        <th class="text-end" width="150">Precio Unit. ($)</th>
                                        <th class="text-end pe-4" width="150">Importe ($)</th>
                                        <th width="40"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dinámico por JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Lateral: Totales y Envío -->
            <div class="col-lg-4">
                <div class="card shadow-lg mb-4">
                    <div class="card-header bg-primary text-white border-0 py-3">
                        <h5 class="m-0 fw-bold"><i class="ti ti-calculator me-2"></i>Presupuesto de Orden</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal Neto:</span>
                            <span class="fw-bold" id="labelSubtotal">0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-muted">Otros Cargos / Fletes:</span>
                            <span class="fw-bold">0.00</span>
                        </div>
                        <hr class="border-secondary opacity-10">
                        <div class="text-center py-2">
                            <h4 class="text-muted tiny fw-bold text-uppercase mb-1">TOTAL ESTIMADO</h4>
                            <h1 class="display-5 fw-bold text-primary mb-0" id="labelTotal">0.00</h1>
                        </div>

                        <div class="alert alert-info border-0 py-3 small mt-4 mb-4">
                            <i class="ti ti-info-circle-filled me-1"></i> La orden se creará como <strong>BORRADOR</strong>. Deberá ser aprobada por el responsable de compras para ser válida.
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg py-3 shadow" id="btnSubmit" disabled>
                                <i class="ti ti-send me-1"></i> EMITIR SOLICITUD
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">CANCELAR</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let rowCount = 0;
        const parsedProductos = @Html.Raw(Json.Serialize(Model.ProductosDisponibles));

        function addRow() {
            const tbody = document.querySelector("#detailsTable tbody");
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>
                    <select name="Order.OrdenCompraDetalles[${rowCount}].ProductoId" class="form-control form-select w-100 select2-dynamic" required>
                        <option value="">-- Buscar Artículo --</option>
                        ${parsedProductos.map(p => `<option value="${p.id}">${p.codigo} - ${p.nombre}</option>`).join('')}
                    </select>
                </td>
                <td><input name="Order.OrdenCompraDetalles[${rowCount}].CantidadSolicitada" type="number" step="0.01" class="form-control text-center fw-bold input-qty" value="1.00" onchange="calculateTotals()" required /></td>
                <td><input name="Order.OrdenCompraDetalles[${rowCount}].PrecioUnitario" type="number" step="0.01" class="form-control text-end input-price" value="0.00" onchange="calculateTotals()" required /></td>
               <td class="pe-4 fw-bold text-dark label-line-total">0.00</td>
                <td>
                    <button type="button" class="btn btn-sm btn-icon btn-ghost-danger border-0" onclick="this.closest('tr').remove(); calculateTotals();">
                        <i class="ti ti-trash"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(row);

            $(row).find('.select2-dynamic').select2({
                width: '100%',
                placeholder: '-- Buscar Artículo --',
                dropdownParent: $('#purchaseForm')
            });

            rowCount++;
        }

        function calculateTotals() {
            let total = 0;
            document.querySelectorAll("#detailsTable tbody tr").forEach(row => {
                const qty = parseFloat(row.querySelector('.input-qty').value || 0);
                const price = parseFloat(row.querySelector('.input-price').value || 0);
                const lineTotal = qty * price;
                row.querySelector('.label-line-total').innerText = lineTotal.toLocaleString('en-US', { minimumFractionDigits: 2 });
                total += lineTotal;
            });

            document.getElementById('labelSubtotal').innerText = total.toLocaleString('en-US', { minimumFractionDigits: 2 });
            document.getElementById('labelTotal').innerText = total.toLocaleString('en-US', { minimumFractionDigits: 2 });
            document.getElementById('btnSubmit').disabled = total <= 0;
        }

        document.addEventListener('DOMContentLoaded', () => {
            addRow();
            window.SubmitAjaxForm('purchaseForm');
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
