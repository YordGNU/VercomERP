@model IEnumerable<Vercom.Models.Usuario>
@{
    ViewBag.Title = "Gestión de Usuarios";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Seguridad: Usuarios del Sistema</h4>
        <p class="text-muted small mb-0">Control de acceso, gestión de identidades y monitoreo de sesiones.</p>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-user-plus"></i> NUEVO USUARIO
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-shield me-2 text-primary"></i>Directorio de Usuarios</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="usersTable" class="table">
                    <thead>
                        <tr>
                            <th>Nombre de Usuario</th>
                            <th>Colaborador</th>
                            <th>Correo Electrónico</th>
                            <th width="150">Sucursal</th>
                            <th width="120" class="text-center">Estado</th>
                            <th width="180" class="text-center">Último Acceso</th>
                            <th width="120" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Activo ? "badge-soft-success" : "badge-soft-danger";

                            <tr>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-xs bg-light rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                            <i class="ti ti-user fs-16 text-primary"></i>
                                        </div>
                                        @item.NombreUsuario
                                    </div>
                                </td>
                                <td class="fw-semibold">@item.NombreCompleto</td>
                                <td class="small">@item.Email</td>
                                <td><span class="badge badge-soft-secondary">@(item.Sucursal?.Nombre ?? "Acceso Global")</span></td>
                                <td class="text-center">
                                    <span class="badge @statusClass">@(item.Activo ? "ACTIVO" : "INACTIVO")</span>
                                </td>
                                <td class="text-date text-muted small">
                                    @(item.UltimoLogin.HasValue ? item.UltimoLogin.Value.ToString("dd/MM/yyyy HH:mm") : "Sin registro")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Detalles">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline py-1 px-2 @(item.Activo ? "text-danger" : "text-success")"
                                                    title="@(item.Activo ? "Desactivar" : "Activar")">
                                                <i class="ti @(item.Activo ? "ti-user-off" : "ti-user-check")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#usersTable').DataTable({
                         language: { url: '/js/i18n/es-ES.json' }
            });
        });
    </script>
}
