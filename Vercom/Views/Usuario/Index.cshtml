@model IEnumerable<Vercom.Models.Usuario>

@{
    ViewData["Title"] = "Index";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Gestión de Usuario</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Usuario</a></li>
            <li class="breadcrumb-item active">Listado</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Listado de Usuario</h4>
                </div>
                <div class="card-body">



<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="table-responsive"><table class="table data-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreUsuario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NombreCompleto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HashPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DebeCambiarPass)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IntentosFallidos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BloqueadoHasta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UltimoLogin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Activo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreadoEn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ActualizadoEn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Entidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EsEmpleado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sucursal)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NombreUsuario)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NombreCompleto)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HashPassword)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DebeCambiarPass)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IntentosFallidos)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BloqueadoHasta)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UltimoLogin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Activo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreadoEn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ActualizadoEn)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Entidad.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EsEmpleado.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sucursal.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table></div>
                </div>
            </div>
        </div>
    </div>
</div>
