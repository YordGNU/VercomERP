@model IEnumerable<Vercom.Models.Usuario>
@{
    ViewBag.Title = "Gestión de Usuarios";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Usuarios del Sistema</h4>
    </div>
    <div class="text-end">
        @if (User.HasClaim(c => c.Type == "Permission" && c.Value == "SEC_EDIT_USERS") || User.IsInRole("ADMINISTRADOR"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-plus me-1"></i> Nuevo Usuario
            </a>
        }
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="dataTable" class="table table-hover align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Usuario</th>
                            <th>Nombre Completo</th>
                            <th>Email</th>
                            <th>Sucursal</th>
                            <th>Estado</th>
                            <th>Último Acceso</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Activo ? "badge bg-success-subtle text-success" : "badge bg-danger-subtle text-danger";
                            var statusText = item.Activo ? "Activo" : "Inactivo";

                            <tr>
                                <td class="fw-bold">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-xs bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-2">
                                            <i class="ti ti-user fs-16"></i>
                                        </div>
                                        @item.NombreUsuario
                                    </div>
                                </td>
                                <td>@item.NombreCompleto</td>
                                <td>@item.Email</td>
                                <td>@(item.Sucursal?.Nombre ?? "Acceso Global")</td>
                                <td><span class="@statusClass">@statusText</span></td>
                                <td class="small text-muted">
                                    @(item.UltimoLogin.HasValue ? item.UltimoLogin.Value.ToString("dd/MM/yyyy HH:mm") : "Nunca")
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light" title="Ver Detalles">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm @(item.Activo ? "btn-outline-danger" : "btn-outline-success")"
                                                    title="@(item.Activo ? "Desactivar" : "Activar")">
                                                <i class="ti @(item.Activo ? "ti-user-off" : "ti-user-check")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        .ready(function () {
            #dataTable.DataTable();
        });
    </script>
}
