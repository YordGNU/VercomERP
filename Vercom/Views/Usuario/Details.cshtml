@model Vercom.Models.Usuario
@{
    ViewBag.Title = "Perfil de Usuario";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Perfil de Usuario: @Model.NombreUsuario</h4>
        <p class="text-muted small mb-0">Gestión de identidad, seguridad y roles asignados.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Seguridad</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Usuarios</a></li>
            <li class="breadcrumb-item active">Perfil</li>
        </ol>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-edit me-1"></i> EDITAR DATOS
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <!-- Columna Izquierda: Tarjeta de Identidad -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-status-top bg-primary"></div>
                <div class="card-body text-center p-4">
                    <div class="avatar avatar-xl bg-primary-subtle text-primary rounded-circle mb-3 mx-auto" style="width: 100px; height: 100px;">
                        <i class="ti ti-user-circle fs-48"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.NombreCompleto</h3>
                    <p class="text-muted mb-3">@Model.Email</p>

                    <div class="d-flex justify-content-center gap-2 mb-4">
                        @foreach (var ur in Model.UsuarioRolUsuarios)
                        {
                            <span class="badge badge-soft-info px-3">@ur.Rol.Nombre</span>
                        }
                    </div>

                    <div class="bg-light-subtle rounded-3 p-3 text-start small">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted fw-bold">ESTADO:</span>
                            <span class="badge @(Model.Activo ? "bg-success" : "bg-danger")">@(Model.Activo ? "ACTIVO" : "INACTIVO")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted fw-bold">SUCURSAL:</span>
                            <span class="fw-bold">@(Model.Sucursal?.Nombre ?? "Acceso Global")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted fw-bold">ENTIDAD:</span>
                            <span class="text-truncate" title="@Model.Entidad.RazonSocial">@Model.Entidad.RazonSocial</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gestión de Seguridad -->
            <div class="card shadow-sm border-0 border-start border-danger border-3">
                <div class="card-header bg-danger-subtle">
                    <h5 class="m-0 fw-bold text-danger"><i class="ti ti-shield-lock me-2"></i>Seguridad de Acceso</h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-4">El reinicio de contraseña establecerá una clave temporal.</p>
                    <form asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Nueva Clave</label>
                            <div class="input-group input-group-sm input-group-flat">
                                <input type="password" name="newPassword" class="form-control" required minlength="6" placeholder="******" />
                                <span class="input-group-text">
                                    <i class="ti ti-eye cursor-pointer"></i>
                                </span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-sm btn-danger w-100">
                            <i class="ti ti-rotate me-1"></i> REINICIAR CONTRASEÑA
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Actividad y Vinculación -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold"><i class="ti ti-history me-2 text-primary"></i>Actividad de Cuenta</h5>
                </div>
                <div class="card-body">
                    <table class="table table-vcenter card-table">
                        <tbody>
                            <tr>
                                <td class="text-muted fw-bold small" width="200">ID ÚNICO</td>
                                <td class="font-monospace small">@Model.Id</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-bold small">ÚLTIMO ACCESO</td>
                                <td class="fw-bold">@(Model.UltimoLogin?.ToString("dd MMM yyyy, HH:mm") ?? "Sin actividad registrada")</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-bold small">INTENTOS FALLIDOS</td>
                                <td>
                                    <span class="badge @(Model.IntentosFallidos > 0 ? "bg-warning" : "bg-success")">@Model.IntentosFallidos</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-bold small">CREADO EN</td>
                                <td>@Model.CreadoEn.ToString("F")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.EsEmpleadoId.HasValue)
            {
                <div class="card shadow-sm border-0 mb-4 bg-primary-subtle border-primary border-opacity-25">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="avatar bg-primary text-white me-3">
                                <i class="ti ti-briefcase fs-24"></i>
                            </div>
                            <div>
                                <h4 class="m-0 fw-bold">Vinculación Laboral Activa</h4>
                                <p class="text-muted mb-0 small">Este usuario está enlazado al expediente de <strong>@Model.EsEmpleado.Nombres @Model.EsEmpleado.Apellidos</strong>.</p>
                                <a asp-controller="Empleado" asp-action="File" asp-route-id="@Model.EsEmpleadoId" class="btn btn-sm btn-link p-0 mt-1">Ir al Expediente <i class="ti ti-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold"><i class="ti ti-key me-2 text-primary"></i>Permisos Efectivos</h5>
                </div>
                <div class="card-body">
                    @if (Model.UsuarioRolUsuarios.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table table-hover">
                                <thead>
                                    <tr>
                                        <th>Rol Asignado</th>
                                        <th>Alcance / Descripción</th>
                                      <th>Desde</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ur in Model.UsuarioRolUsuarios)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">@ur.Rol.Nombre</td>
                                            <td class="small text-muted">@ur.Rol.Descripcion</td>
                                            <td small">@ur.AsignadoEn.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="ti ti-alert-circle fs-40 text-warning opacity-50 mb-2"></i>
                            <p class="text-muted italic">Sin roles asignados. El usuario no podrá operar.</p>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary mt-2">ASIGNAR ROL</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
