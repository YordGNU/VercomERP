@model Vercom.ViewModels.UserFormViewModel
@{
    ViewBag.Title = "Editar Usuario";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Actualizar Perfil de Usuario</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                        <input type="hidden" asp-for="Usuario.Id" name="Usuario.Id" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Usuario.NombreUsuario" class="form-label fw-bold">Nombre de Usuario</label>
                                <input asp-for="Usuario.NombreUsuario" name="Usuario.NombreUsuario" class="form-control" readonly />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Usuario.NombreCompleto" class="form-label fw-bold">Nombre Completo</label>
                                <input asp-for="Usuario.NombreCompleto" name="Usuario.NombreCompleto" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Usuario.Email" class="form-label fw-bold">Correo Electrónico</label>
                                <input asp-for="Usuario.Email" name="Usuario.Email" type="email" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Usuario.SucursalId" class="form-label fw-bold">Sucursal</label>
                                <select asp-for="Usuario.SucursalId" name="Usuario.SucursalId" class="form-select" asp-items="Model.Sucursales">
                                    <option value="">Acceso Global</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Usuario.EsEmpleadoId" class="form-label fw-bold">Vincular con Empleado</label>
                                <select asp-for="Usuario.EsEmpleadoId" name="Usuario.EsEmpleadoId" class="form-select" asp-items="Model.Empleados">
                                    <option value="">-- No vincular --</option>
                                </select>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Acciones de Seguridad -->
            <div class="card mt-4 border-danger border-opacity-25">
                <div class="card-header bg-danger bg-opacity-10">
                    <h4 class="card-title text-danger">Zona de Seguridad</h4>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0">Reiniciar Credenciales</h6>
                            <p class="text-muted small mb-0">Se enviará una clave temporal y se exigirá cambio (RF-01).</p>
                        </div>
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#resetModal">REINICIAR PASS</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Reset -->
<div class="modal fade" id="resetModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="ResetPassword" method="post">
            <input type="hidden" name="id" value="@Model.Usuario.Id" />
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Reiniciar Contraseña</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nueva Contraseña Temporal:</label>
                        <input type="text" name="newPassword" class="form-control" value="Vercom.2026!" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">CONFIRMAR REINICIO</button>
                </div>
            </div>
        </form>
    </div>
</div>
