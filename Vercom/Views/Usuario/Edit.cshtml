@model Vercom.Models.Usuario

@{
    ViewData["Title"] = "Edit";
}



<h4>Usuario</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Editar Usuario</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Usuario</a></li>
            <li class="breadcrumb-item active">Editar</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Formulario de Edición</h4>
                </div>
                <div class="card-body">
<form class="row g-3" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="EntidadId" class="form-label"></label>
                <select asp-for="EntidadId" class="form-control" asp-items="ViewBag.EntidadId"></select>
                <span asp-validation-for="EntidadId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SucursalId" class="form-label"></label>
                <select asp-for="SucursalId" class="form-control" asp-items="ViewBag.SucursalId"></select>
                <span asp-validation-for="SucursalId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NombreUsuario" class="form-label"></label>
                <input asp-for="NombreUsuario" class="form-control" />
                <span asp-validation-for="NombreUsuario" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <input asp-for="NombreCompleto" class="form-control" />
                <span asp-validation-for="NombreCompleto" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HashPassword" class="form-label"></label>
                <input asp-for="HashPassword" class="form-control" />
                <span asp-validation-for="HashPassword" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="DebeCambiarPass" /> @Html.DisplayNameFor(model => model.DebeCambiarPass)
                </label>
            </div>
            <div class="mb-3">
                <label asp-for="IntentosFallidos" class="form-label"></label>
                <input asp-for="IntentosFallidos" class="form-control" />
                <span asp-validation-for="IntentosFallidos" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BloqueadoHasta" class="form-label"></label>
                <input asp-for="BloqueadoHasta" class="form-control" />
                <span asp-validation-for="BloqueadoHasta" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UltimoLogin" class="form-label"></label>
                <input asp-for="UltimoLogin" class="form-control" />
                <span asp-validation-for="UltimoLogin" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Activo" /> @Html.DisplayNameFor(model => model.Activo)
                </label>
            </div>
            <div class="mb-3">
                <label asp-for="EsEmpleadoId" class="form-label"></label>
                <select asp-for="EsEmpleadoId" class="form-control" asp-items="ViewBag.EsEmpleadoId"></select>
                <span asp-validation-for="EsEmpleadoId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CreadoEn" class="form-label"></label>
                <input asp-for="CreadoEn" class="form-control" />
                <span asp-validation-for="CreadoEn" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ActualizadoEn" class="form-label"></label>
                <input asp-for="ActualizadoEn" class="form-control" />
                <span asp-validation-for="ActualizadoEn" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

