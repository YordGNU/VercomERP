@model Vercom.Models.Usuario
@{
    ViewBag.Title = "Editar Usuario";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Actualizar Perfil</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Información de: @Model.NombreUsuario</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NombreUsuario" class="form-label fw-bold">Nombre de Usuario</label>
                                <input asp-for="NombreUsuario" class="form-control" readonly />
                                <small class="text-muted">El identificador de acceso no se puede cambiar.</small>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">Correo Electrónico</label>
                                <input asp-for="Email" type="email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="NombreCompleto" class="form-label fw-bold">Nombre Completo</label>
                                <input asp-for="NombreCompleto" class="form-control" required />
                                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SucursalId" class="form-label fw-bold">Sucursal Asignada</label>
                                <select asp-for="SucursalId" class="form-select" asp-items="ViewBag.SucursalId">
                                    <option value="">Acceso Global (Todas)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EsEmpleadoId" class="form-label fw-bold">Vínculo con Empleado</label>
                                <select asp-for="EsEmpleadoId" class="form-select" asp-items="ViewBag.EsEmpleadoId">
                                    <option value="">-- No vincular --</option>
                                </select>
                            </div>

                            <div class="col-md-6 mt-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Activo">
                                    <label class="form-check-label fw-bold" asp-for="Activo">Estado de Cuenta Activo</label>
                                </div>
                            </div>

                            <div class="col-md-6 mt-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="DebeCambiarPass">
                                    <label class="form-check-label" asp-for="DebeCambiarPass">Forzar cambio de clave en el próximo login</label>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Registrado el: @Model.CreadoEn.ToString("dd/MM/yyyy HH:mm")</span>
                            <div class="d-flex gap-2">
                                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="ti ti-device-floppy me-1"></i> ACTUALIZAR DATOS
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mt-4 border-warning-subtle">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h5 class="mb-1 text-warning">Zona de Seguridad</h5>
                        <p class="text-muted mb-0 small">Para cambiar la contraseña de este usuario, use la opción de Reiniciar desde los detalles.</p>
                    </div>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-warning">Ir a Seguridad</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
