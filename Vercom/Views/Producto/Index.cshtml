@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model IEnumerable<Vercom.Models.Producto>
@{
    ViewBag.Title = "Catálogo de Productos";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Maestro de Productos e Insumos</h4>
        <p class="text-muted small mb-0">Catálogo centralizado para inventario, producción y ventas.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Inventario</a></li>
            <li class="breadcrumb-item active">Productos</li>
        </ol>
        @if ((await AuthorizationService.AuthorizeAsync(User, "INVENTARIO.PRODUCTO.CREAR")).Succeeded)
        {
            <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
                <i class="ti ti-plus"></i> NUEVO PRODUCTO
            </a>
        }
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-box me-2 text-primary"></i>Artículos Registrados</h5>
            <div class="d-flex gap-2">
                <span class="badge badge-soft-info">@Model.Count() Items</span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="productsTable" class="table">
                    <thead>
                        <tr>
                            <th width="100">Código</th>
                            <th>Descripción / Producto</th>
                            <th width="140">Familia</th>
                            <th width="80" class="text-center">U.M.</th>
                            <th width="130" class="text-end">Precio Venta ($)</th>
                            <th width="120" class="text-center">Tipo</th>
                            <th width="100" class="text-center">Estado</th>
                            <th width="120" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var typeClass = item.Tipo switch {
                                "TERMINADO" => "badge-soft-success",
                                "INSUMO" => "badge-soft-info",
                                "ELABORADO" => "badge-soft-warning",
                                _ => "badge-soft-secondary"
                            };

                            <tr>
                                <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-xs bg-light rounded-2 d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px;">
                                            <i class="ti ti-package-export fs-16 text-muted"></i>
                                        </div>
                                        <div class="fw-semibold">@item.Nombre</div>
                                    </div>
                                </td>
                                <td><span class="small text-muted">@item.Familia?.Nombre</span></td>
                                <td class="text-center small fw-bold">@item.UnidadMedida.Codigo</td>
                                <td class="text-numeric fw-bold text-success">@item.PrecioVentaActual?.ToString("N2")</td>
                                <td class="text-center"><span class="badge @typeClass">@item.Tipo</span></td>
                                <td class="text-center">
                                    @if (item.Activo) { <span class="badge badge-soft-success">ACTIVO</span> }
                                    else { <span class="badge badge-soft-danger">INACTIVO</span> }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Detalles">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#productsTable').DataTable({
                         language: { url: '/js/i18n/es-ES.json' },
                order: [[1, 'asc']]
            });
        });
    </script>
}
