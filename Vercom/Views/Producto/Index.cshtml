@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model IEnumerable<Vercom.Models.Producto>
@{
    ViewBag.Title = "Catálogo de Productos";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Maestro de Productos e Insumos</h4>
    </div>
    <div class="text-end">
        @if ((await AuthorizationService.AuthorizeAsync(User, "INVENTARIO.PRODUCTO.CREAR")).Succeeded)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-plus me-1"></i> Nuevo Producto
            </a>
        }
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-header bg-light-subtle">
            <div class="row align-items-center">
                <div class="col">
                    <h4 class="card-title">Listado General</h4>
                </div>
                <div class="col-auto">
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" placeholder="Buscar por nombre o código...">
                        <button class="btn btn-outline-secondary" type="button"><i class="ti ti-search"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="dataTable" class="table table-hover align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th width="100">Código</th>
                            <th>Producto / Descripción</th>
                            <th>Familia</th>
                            <th>U.M.</th>
                            <th class="text-end">Precio Venta</th>
                            <th class="text-center">Tipo</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold"><code>@item.Codigo</code></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-xs bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-2">
                                            <i class="ti ti-package fs-16"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@item.Nombre</div>
                                            <small class="text-muted">@item.CodigoBarras</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge border text-dark">@item.Familia?.Nombre</span></td>
                                <td><small>@item.UnidadMedida.Nombre</small></td>
                                <td class="text-end fw-bold">@item.PrecioVentaActual?.ToString("C")</td>
                                <td class="text-center">
                                    <small class="badge bg-info-subtle text-info">@item.Tipo</small>
                                </td>
                                <td class="text-center">
                                    @if (item.Activo) { <span class="text-success">? Activo</span> }
                                    else { <span class="text-danger">? Inactivo</span> }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-edit"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-xs btn-light text-danger"><i class="ti ti-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        .ready(function () {
            #dataTable.DataTable();
        });
    </script>
}
