            <td>
                @Html.DisplayFor(modelItem => item.CuentaInventarioId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CuentaCostoVentaId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CuentaIngresoId)
