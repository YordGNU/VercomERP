            <th>
                @Html.DisplayNameFor(model => model.CuentaCostoVentaId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CuentaIngresoId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioVentaActual)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AplicaImpuestoVentas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Activo)
