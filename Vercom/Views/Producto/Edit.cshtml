@model Vercom.ViewModels.ProductFormViewModel
@{
    ViewBag.Title = "Editar Producto";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Actualizar Ficha Técnica</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <input type="hidden" asp-for="Producto.Id" name="Producto.Id" />

        <div class="row">
            <div class="col-lg-12">
                <!-- Nav Tabs -->
                <ul class="nav nav-tabs nav-justified bg-white rounded-top border-bottom-0 shadow-sm" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active fw-bold" data-bs-toggle="tab" href="#tab-general" role="tab">1. Datos Generales</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold" data-bs-toggle="tab" href="#tab-accounting" role="tab">2. Configuración Contable</a>
                    </li>
                </ul>

                <div class="tab-content bg-white shadow-sm rounded-bottom p-4">
                    <!-- Tab: Datos Generales -->
                    <div class="tab-pane fade show active" id="tab-general" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="Producto.Codigo" class="form-label fw-bold">Código SKU</label>
                                <input asp-for="Producto.Codigo" name="Producto.Codigo" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Producto.CodigoBarras" class="form-label fw-bold">Código de Barras</label>
                                <input asp-for="Producto.CodigoBarras" name="Producto.CodigoBarras" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Producto.Nombre" class="form-label fw-bold">Nombre</label>
                                <input asp-for="Producto.Nombre" name="Producto.Nombre" class="form-control" required />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Producto.FamiliaId" class="form-label fw-bold">Familia</label>
                                <select asp-for="Producto.FamiliaId" name="Producto.FamiliaId" class="form-select" asp-items="Model.Familias" required></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Producto.UnidadMedidaId" class="form-label fw-bold">U. Medida</label>
                                <select asp-for="Producto.UnidadMedidaId" name="Producto.UnidadMedidaId" class="form-select" asp-items="Model.UnidadesMedida" required></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Producto.Tipo" class="form-label fw-bold">Tipo</label>
                                <select asp-for="Producto.Tipo" name="Producto.Tipo" class="form-select" asp-items="Model.TiposProducto"></select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Producto.PrecioVentaActual" class="form-label fw-bold">Precio Vigente</label>
                                <input asp-for="Producto.PrecioVentaActual" name="Producto.PrecioVentaActual" type="number" step="0.01" class="form-control" />
                            </div>

                            <div class="col-md-8 d-flex align-items-end gap-4 pb-1">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Producto.AplicaImpuestoVentas" name="Producto.AplicaImpuestoVentas">
                                    <label class="form-check-label fw-bold">Aplica Impuesto</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Producto.Activo" name="Producto.Activo">
                                    <label class="form-check-label fw-bold">Habilitado</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab: Contabilidad -->
                    <div class="tab-pane fade" id="tab-accounting" role="tabpanel">
                        <div class="row g-4">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Producto.CuentaInventarioId" class="control-label fw-bold"></label>
                                    <select asp-for="Producto.CuentaInventarioId" asp-items="Model.CuentasInventario" class="form-control select2-cuenta">
                                        <option value="">-- Seleccionar --</option>
                                    </select>
                                    <span asp-validation-for="Producto.CuentaInventarioId" class="text-danger"></span>
                                    <small class="form-text text-muted">Cuenta de Activo (ej. 240-251 Activos Fijos Tangibles)</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Producto.CuentaCostoVentaId" class="control-label fw-bold"></label>
                                    <select asp-for="Producto.CuentaCostoVentaId" asp-items="Model.CuentasCostoVenta" class="form-control select2-cuenta">
                                        <option value="">-- Seleccionar --</option>
                                    </select>
                                    <span asp-validation-for="Producto.CuentaCostoVentaId" class="text-danger"></span>
                                    <small class="form-text text-muted">Cuenta de Egreso (ej. 810 Costo de Ventas)</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Producto.CuentaIngresoId" class="control-label fw-bold"></label>
                                    <select asp-for="Producto.CuentaIngresoId" asp-items="Model.CuentasIngresos" class="form-control select2-cuenta">
                                        <option value="">-- Seleccionar --</option>
                                    </select>
                                    <span asp-validation-for="Producto.CuentaIngresoId" class="text-danger"></span>
                                    <small class="form-text text-muted">Cuenta de Ingreso (ej. 701 Producción Propia para Insumo)</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Descartar</a>
                    <button type="submit" class="btn btn-primary px-5">
                        <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
