@model Vercom.Models.Producto

@{
    ViewData["Title"] = "Edit";
}



<h4>Producto</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Editar Producto</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Producto</a></li>
            <li class="breadcrumb-item active">Editar</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Formulario de Edición</h4>
                </div>
                <div class="card-body">
<form class="row g-3" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="EntidadId" class="form-label"></label>
                <input asp-for="EntidadId" class="form-control" />
                <span asp-validation-for="EntidadId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" />
                <span asp-validation-for="Codigo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CodigoBarras" class="form-label"></label>
                <input asp-for="CodigoBarras" class="form-control" />
                <span asp-validation-for="CodigoBarras" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FamiliaId" class="form-label"></label>
                <select asp-for="FamiliaId" class="form-control" asp-items="ViewBag.FamiliaId"></select>
                <span asp-validation-for="FamiliaId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UnidadMedidaId" class="form-label"></label>
                <select asp-for="UnidadMedidaId" class="form-control" asp-items="ViewBag.UnidadMedidaId"></select>
                <span asp-validation-for="UnidadMedidaId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Tipo" class="form-label"></label>
                <input asp-for="Tipo" class="form-control" />
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CuentaInventarioId" class="form-label"></label>
                <input asp-for="CuentaInventarioId" class="form-control" />
                <span asp-validation-for="CuentaInventarioId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CuentaCostoVentaId" class="form-label"></label>
                <input asp-for="CuentaCostoVentaId" class="form-control" />
                <span asp-validation-for="CuentaCostoVentaId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CuentaIngresoId" class="form-label"></label>
                <input asp-for="CuentaIngresoId" class="form-control" />
                <span asp-validation-for="CuentaIngresoId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PrecioVentaActual" class="form-label"></label>
                <input asp-for="PrecioVentaActual" class="form-control" />
                <span asp-validation-for="PrecioVentaActual" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="AplicaImpuestoVentas" /> @Html.DisplayNameFor(model => model.AplicaImpuestoVentas)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Activo" /> @Html.DisplayNameFor(model => model.Activo)
                </label>
            </div>
            <div class="mb-3">
                <label asp-for="CreadoEn" class="form-label"></label>
                <input asp-for="CreadoEn" class="form-control" />
                <span asp-validation-for="CreadoEn" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ActualizadoEn" class="form-label"></label>
                <input asp-for="ActualizadoEn" class="form-control" />
                <span asp-validation-for="ActualizadoEn" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

