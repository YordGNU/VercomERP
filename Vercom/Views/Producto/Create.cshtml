@model Vercom.ViewModels.ProductFormViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">@Model.Title</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <div class="row">
            <div class="col-lg-12">
                <!-- Nav Tabs -->
                <ul class="nav nav-tabs nav-justified bg-white rounded-top border-bottom-0 shadow-sm" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active fw-bold" data-bs-toggle="tab" href="#tab-general" role="tab">1. Datos Generales</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold" data-bs-toggle="tab" href="#tab-accounting" role="tab">2. Configuración Contable</a>
                    </li>
                </ul>

                <div class="tab-content bg-white shadow-sm rounded-bottom p-4">
                    <!-- Tab: Datos Generales -->
                    <div class="tab-pane fade show active" id="tab-general" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="Producto.Codigo" class="form-label fw-bold">Código Interno (SKU)</label>
                                <input asp-for="Producto.Codigo" name="Producto.Codigo" class="form-control" placeholder="Ej: PROD-001" required />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Producto.CodigoBarras" class="form-label fw-bold">Código de Barras</label>
                                <input asp-for="Producto.CodigoBarras" name="Producto.CodigoBarras" class="form-control" placeholder="UPC / EAN" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Producto.Nombre" class="form-label fw-bold">Nombre del Producto</label>
                                <input asp-for="Producto.Nombre" name="Producto.Nombre" class="form-control" required />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Producto.FamiliaId" class="form-label fw-bold">Familia / Categoría</label>
                                <select asp-for="Producto.FamiliaId" name="Producto.FamiliaId" class="form-select" asp-items="Model.Familias" required></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Producto.UnidadMedidaId" class="form-label fw-bold">Unidad de Medida</label>
                                <select asp-for="Producto.UnidadMedidaId" name="Producto.UnidadMedidaId" class="form-select" asp-items="Model.UnidadesMedida" required></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Producto.Tipo" class="form-label fw-bold">Tipo de Ítem</label>
                                <select asp-for="Producto.Tipo" name="Producto.Tipo" class="form-select" asp-items="Model.TiposProducto"></select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Producto.PrecioVentaActual" class="form-label fw-bold">Precio de Venta</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Producto.PrecioVentaActual" name="Producto.PrecioVentaActual" type="number" step="0.01" class="form-control" />
                                </div>
                            </div>

                            <div class="col-md-8 d-flex align-items-end gap-4 pb-1">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Producto.AplicaImpuestoVentas" name="Producto.AplicaImpuestoVentas">
                                    <label class="form-check-label fw-bold" asp-for="Producto.AplicaImpuestoVentas">Aplica Impuesto (10%)</label>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Producto.Activo" name="Producto.Activo">
                                    <label class="form-check-label fw-bold" asp-for="Producto.Activo">Activo para Operación</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Producto.Descripcion" class="form-label fw-bold">Descripción / Especificaciones</label>
                                <textarea asp-for="Producto.Descripcion" name="Producto.Descripcion" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Tab: Contabilidad -->
                    <div class="tab-pane fade" id="tab-accounting" role="tabpanel">
                        <div class="alert alert-info py-2 small mb-4">
                            <i class="ti ti-info-circle me-1"></i> Defina las cuentas donde se registrarán automáticamente los movimientos de este producto.
                        </div>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label asp-for="Producto.CuentaInventarioId" class="form-label fw-bold">Cuenta de Inventario</label>
                                <select asp-for="Producto.CuentaInventarioId" name="Producto.CuentaInventarioId" class="form-select" asp-items="Model.CuentasContables">
                                    <option value="">-- Usar por defecto --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Producto.CuentaCostoVentaId" class="form-label fw-bold">Cuenta de Costo de Ventas</label>
                                <select asp-for="Producto.CuentaCostoVentaId" name="Producto.CuentaCostoVentaId" class="form-select" asp-items="Model.CuentasContables">
                                    <option value="">-- Usar por defecto --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Producto.CuentaIngresoId" class="form-label fw-bold">Cuenta de Ingresos (Ventas)</label>
                                <select asp-for="Producto.CuentaIngresoId" name="Producto.CuentaIngresoId" class="form-select" asp-items="Model.CuentasContables">
                                    <option value="">-- Usar por defecto --</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-5">
                        <i class="ti ti-device-floppy me-1"></i> REGISTRAR PRODUCTO
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
