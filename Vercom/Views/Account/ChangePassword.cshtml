@{
    ViewData["Title"] = "Cambiar Contraseña";
    Layout = "_LayoutAuth";

    var mustChange = string.Equals(User.FindFirst("MustChangePassword")?.Value, "True", StringComparison.OrdinalIgnoreCase);
}

<div class="auth-bg"></div>

<div class="auth-box d-flex">
    <div class="container-xxl">
        <div class="row justify-content-center position-relative">
            <div class="col-xl-7">
                <div class="rounded-3">
                    <div class="row g-0">
                        <!-- Panel de marca: solo desde lg -->
                        <div class="col-lg-7 d-none d-lg-block align-content-around rounded-3">
                            <div class="auth-brand text-center mb-4">
                                <div class="logo-wrapper">
                                    <img src="~/css/images/logo.gif" alt="Logotipo de VERCOM" class="logo" decoding="async" />
                                </div>
                                <h4 class="fw-bold mt-4">VERCOM ERP</h4>
                                <p class="text-muted w-lg-75 mx-auto">Mantenga su cuenta segura actualizando su contraseña periódicamente.</p>
                            </div>
                        </div>

                        <!-- Formulario -->
                        <div class="col-12 col-lg-5">
                            <div class="d-lg-none text-center mb-3">
                                <div class="logo-wrapper">
                                    <img src="~/css/images/logo.gif" alt="Logotipo de VERCOM" class="logo" decoding="async" />
                                </div>
                            </div>

                            <form asp-action="ChangePassword" method="post" id="changePassForm" autocomplete="off" class="auth-form">
                                <div class="card mb-0">
                                    <div class="card-header py-2">
                                        <h5 class="card-title mb-0">
                                            <i class="ti ti-shield-lock me-1"></i>
                                            @(mustChange ? "Actualice su clave" : "Cambiar contraseña")
                                        </h5>
                                    </div>

                                    <div class="card-body p-3">
                                        @if (mustChange)
                                        {
                                            <div class="alert alert-warning py-2 small mb-3" role="alert">
                                                <i class="ti ti-alert-triangle me-1"></i>
                                                Por seguridad, debe actualizar su contraseña antes de continuar.
                                            </div>
                                        }

                                        @if (TempData["Success"] != null)
                                        {
                                            <div class="alert alert-success py-2 small mb-3" role="alert">
                                                @TempData["Success"]
                                            </div>
                                        }

                                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                                        <!-- Actual -->
                                        <div class="mb-2">
                                            <label for="currentPassword" class="form-label mb-1">Contraseña actual</label>
                                            <div class="input-group has-validation">
                                                <span class="input-group-text bg-light border-end-0">
                                                    <i class="ti ti-lock" aria-hidden="true"></i>
                                                </span>
                                                <input type="password" id="currentPassword" name="currentPassword"
                                                       class="form-control border-start-0 border-end-0 ps-0 auth-password-input"
                                                       placeholder="Clave actual" autocomplete="current-password" required />
                                                <button type="button" class="input-group-text bg-light border-start-0 auth-eye toggle-pass"
                                                        data-target="currentPassword" aria-label="Mostrar contraseña" tabindex="-1">
                                                    <i class="ti ti-eye icon-eye" aria-hidden="true"></i>
                                                    <i class="ti ti-eye-off icon-eye-off" aria-hidden="true" hidden></i>
                                                </button>
                                                <div class="invalid-feedback">Ingrese su contraseña actual.</div>
                                            </div>
                                        </div>

                                        <!-- Nueva -->
                                        <div class="mb-2">
                                            <label for="newPassword" class="form-label mb-1">Nueva contraseña</label>
                                            <div class="input-group has-validation">
                                                <span class="input-group-text bg-light border-end-0">
                                                    <i class="ti ti-key" aria-hidden="true"></i>
                                                </span>
                                                <input type="password" id="newPassword" name="newPassword"
                                                       class="form-control border-start-0 border-end-0 ps-0 auth-password-input"
                                                       placeholder="Nueva clave robusta" autocomplete="new-password"
                                                       required minlength="6" />
                                                <button type="button" class="input-group-text bg-light border-start-0 auth-eye toggle-pass"
                                                        data-target="newPassword" aria-label="Mostrar contraseña" tabindex="-1">
                                                    <i class="ti ti-eye icon-eye" aria-hidden="true"></i>
                                                    <i class="ti ti-eye-off icon-eye-off" aria-hidden="true" hidden></i>
                                                </button>
                                                <div class="invalid-feedback">Mínimo 6 caracteres.</div>
                                            </div>
                                            <div id="strength" class="form-text small mt-1"></div>
                                        </div>

                                        <!-- Confirmar -->
                                        <div class="mb-3">
                                            <label for="confirmPassword" class="form-label mb-1">Confirmar nueva contraseña</label>
                                            <div class="input-group has-validation">
                                                <span class="input-group-text bg-light border-end-0">
                                                    <i class="ti ti-key" aria-hidden="true"></i>
                                                </span>
                                                <input type="password" id="confirmPassword" name="confirmPassword"
                                                       class="form-control border-start-0 border-end-0 ps-0 auth-password-input"
                                                       placeholder="Repita la nueva clave" autocomplete="new-password" required />
                                                <button type="button" class="input-group-text bg-light border-start-0 auth-eye toggle-pass"
                                                        data-target="confirmPassword" aria-label="Mostrar contraseña" tabindex="-1">
                                                    <i class="ti ti-eye icon-eye" aria-hidden="true"></i>
                                                    <i class="ti ti-eye-off icon-eye-off" aria-hidden="true" hidden></i>
                                                </button>
                                                <div class="invalid-feedback">Repita la nueva contraseña.</div>
                                            </div>
                                            <div id="matchHint" class="form-text small mt-1"></div>
                                        </div>

                                        <!-- Botón -->
                                        <div class="d-grid">
                                            <button type="submit" class="btn btn-primary auth-submit" id="submitBtn">
                                                <span class="btn-text">
                                                    <i class="ti ti-device-floppy me-1" aria-hidden="true"></i> Guardar y continuar
                                                </span>
                                                <span class="btn-loading" role="status" aria-live="polite" hidden>
                                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                                    Guardando…
                                                </span>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="text-center mt-2">
                                    <small>
                                        @if (!mustChange)
                                        {
                                            <a asp-controller="Dashboard" asp-action="Index" class="text-primary fw-semibold">Volver al panel</a>
                                            <span class="text-muted">&nbsp;·&nbsp;</span>
                                        }
                                        <form asp-action="Logout" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-link btn-sm text-muted text-decoration-none p-0">
                                                Cerrar sesión
                                            </button>
                                        </form>
                                        &nbsp;·&nbsp; &copy; @DateTime.Now.Year VERCOM
                                    </small>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        (function () {
            'use strict';

            function toggle(btn) {
                const id = btn.getAttribute('data-target');
                const input = document.getElementById(id);
                if (!input) return;
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                const eye = btn.querySelector('.icon-eye');
                const eyeOff = btn.querySelector('.icon-eye-off');
                if (eye) eye.hidden = show;
                if (eyeOff) eyeOff.hidden = !show;
                btn.setAttribute('aria-pressed', show ? 'true' : 'false');
            }

            document.querySelectorAll('.toggle-pass').forEach(function (btn) {
                btn.addEventListener('click', function () { toggle(btn); });
            });

            const np = document.getElementById('newPassword');
            const cp = document.getElementById('confirmPassword');
            const strength = document.getElementById('strength');
            const matchHint = document.getElementById('matchHint');
            const submit = document.getElementById('submitBtn');

            function evalStrength(v) {
                let score = 0;
                if (v.length >= 6) score++;
                if (v.length >= 10) score++;
                if (/[0-9]/.test(v)) score++;
                if (/[^A-Za-z0-9]/.test(v)) score++;
                if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
                if (score <= 1) return { label: 'Débil', cls: 'text-danger' };
                if (score <= 3) return { label: 'Media', cls: 'text-warning' };
                return { label: 'Fuerte', cls: 'text-success' };
            }

            function validate() {
                const v = np.value;
                if (v.length === 0) { strength.textContent = ''; }
                else {
                    const r = evalStrength(v);
                    strength.textContent = 'Seguridad: ' + r.label;
                    strength.className = 'form-text small mt-1 ' + r.cls;
                }

                if (cp.value.length === 0) { matchHint.textContent = ''; submit.disabled = false; return; }
                if (np.value === cp.value) {
                    matchHint.textContent = 'Las contraseñas coinciden.';
                    matchHint.className = 'form-text small mt-1 text-success';
                    submit.disabled = false;
                } else {
                    matchHint.textContent = 'Las contraseñas no coinciden.';
                    matchHint.className = 'form-text small mt-1 text-danger';
                    submit.disabled = true;
                }
            }

            np.addEventListener('input', validate);
            cp.addEventListener('input', validate);

            // Loading state on submit
            const form = document.getElementById('changePassForm');
            form.addEventListener('submit', function () {
                const btnText = submit.querySelector('.btn-text');
                const btnLoading = submit.querySelector('.btn-loading');
                if (btnText) btnText.hidden = true;
                if (btnLoading) btnLoading.hidden = false;
                submit.disabled = true;
            });
        })();
    </script>
}
