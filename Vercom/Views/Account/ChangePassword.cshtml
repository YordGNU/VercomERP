@{
    ViewData["Title"] = "Actualizar Contraseña";
    Layout = "_LayoutAuth";
}

<div class="card p-4">
    <div class="text-center mb-4">
        <div class="avatar-lg bg-warning-subtle text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
            <i class="ti ti-shield-lock fs-32"></i>
        </div>
        <h2 class="fw-bold">Actualizar Clave</h2>
        <p class="text-muted">Por seguridad, debe actualizar su contraseña antes de acceder al panel principal.</p>
    </div>

    <form asp-action="ChangePassword" method="post" id="changePassForm" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2 small">@TempData["Success"]</div>
        }

        <div class="mb-3">
            <label class="form-label small fw-bold">Contraseña Actual</label>
            <div class="input-group">
                <input type="password" name="currentPassword" id="currentPassword" class="form-control" placeholder="Clave actual" required />
                <button type="button" class="btn btn-outline-secondary toggle-pass" data-target="currentPassword" tabindex="-1"><i class="ti ti-eye"></i></button>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold">Nueva Contraseña</label>
            <div class="input-group">
                <input type="password" name="newPassword" id="newPassword" class="form-control" placeholder="Nueva clave robusta" required minlength="6" />
                <button type="button" class="btn btn-outline-secondary toggle-pass" data-target="newPassword" tabindex="-1"><i class="ti ti-eye"></i></button>
            </div>
            <div class="form-text small">Mínimo 6 caracteres. Se recomienda incluir números y símbolos.</div>
            <div id="strength" class="small mt-1"></div>
        </div>

        <div class="mb-4">
            <label class="form-label small fw-bold">Confirmar Nueva Contraseña</label>
            <div class="input-group">
                <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Repita la nueva clave" required />
                <button type="button" class="btn btn-outline-secondary toggle-pass" data-target="confirmPassword" tabindex="-1"><i class="ti ti-eye"></i></button>
            </div>
            <div id="matchHint" class="small mt-1"></div>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary py-2 fw-bold" id="submitBtn">GUARDAR Y CONTINUAR</button>
        </div>
    </form>

    <div class="mt-4 border-top pt-3 text-center">
        <form asp-action="Logout" method="post">
            <button type="submit" class="btn btn-link btn-sm text-muted text-decoration-none">
                <i class="ti ti-logout me-1"></i> Cerrar sesión y salir
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function toggle(btn) {
                const id = btn.getAttribute('data-target');
                const input = document.getElementById(id);
                if (!input) return;
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.querySelector('i').className = show ? 'ti ti-eye-off' : 'ti ti-eye';
            }

            document.querySelectorAll('.toggle-pass').forEach(function (btn) {
                btn.addEventListener('click', function () { toggle(btn); });
            });

            const np = document.getElementById('newPassword');
            const cp = document.getElementById('confirmPassword');
            const strength = document.getElementById('strength');
            const matchHint = document.getElementById('matchHint');
            const submit = document.getElementById('submitBtn');

            function evalStrength(v) {
                let score = 0;
                if (v.length >= 6) score++;
                if (v.length >= 10) score++;
                if (/[0-9]/.test(v)) score++;
                if (/[^A-Za-z0-9]/.test(v)) score++;
                if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
                if (score <= 1) return { label: 'Débil', cls: 'text-danger' };
                if (score <= 3) return { label: 'Media', cls: 'text-warning' };
                return { label: 'Fuerte', cls: 'text-success' };
            }

            function validate() {
                const v = np.value;
                if (v.length === 0) { strength.textContent = ''; }
                else {
                    const r = evalStrength(v);
                    strength.textContent = 'Seguridad: ' + r.label;
                    strength.className = 'small mt-1 ' + r.cls;
                }

                if (cp.value.length === 0) { matchHint.textContent = ''; submit.disabled = false; return; }
                if (np.value === cp.value) {
                    matchHint.textContent = 'Las contraseñas coinciden.';
                    matchHint.className = 'small mt-1 text-success';
                    submit.disabled = false;
                } else {
                    matchHint.textContent = 'Las contraseñas no coinciden.';
                    matchHint.className = 'small mt-1 text-danger';
                    submit.disabled = true;
                }
            }

            np.addEventListener('input', validate);
            cp.addEventListener('input', validate);
        })();
    </script>
}
