@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutAuth";
}

<div class="auth-page">
    <section class="auth-hero" aria-label="Presentación del sistema">
        <div class="auth-hero-content">
            <div class="auth-brand">
                <img src="~/css/images/logo.svg" alt="Logo Vercom" class="auth-logo" />
                <h1 class="auth-title">Tierra Prometida</h1>
                <p class="auth-tagline">Sistema ERP Integral</p>
            </div>

            <ul class="auth-features">
                <li class="auth-feature">
                    <span class="auth-feature-icon"><i class="ti ti-shield-lock" aria-hidden="true"></i></span>
                    <div>
                        <h3>Seguridad Garantizada</h3>
                        <p>Cifrado de datos y auditoría inmutable conforme a Resolución 60/2011</p>
                    </div>
                </li>
                <li class="auth-feature">
                    <span class="auth-feature-icon"><i class="ti ti-scale" aria-hidden="true"></i></span>
                    <div>
                        <h3>Conformidad Regulatoria</h3>
                        <p>Alineado con NCC/NCIF, ONAT y marcos legales cubanos</p>
                    </div>
                </li>
                <li class="auth-feature">
                    <span class="auth-feature-icon"><i class="ti ti-server" aria-hidden="true"></i></span>
                    <div>
                        <h3>On-Premise Confiable</h3>
                        <p>Disponible offline con sincronización automática</p>
                    </div>
                </li>
            </ul>
        </div>

        <div class="auth-hero-footer">
            <p>Versión empresarial &copy; 2024 - 2026</p>
        </div>
    </section>

    <section class="auth-panel" aria-label="Formulario de acceso">
        <div class="auth-form-wrap">
            <form asp-action="Login" method="post" class="auth-form" novalidate>
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="auth-form-header">
                    <h2>Acceso al Sistema</h2>
                    <p>Ingresa tus credenciales para continuar</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert" aria-live="assertive">
                    <i class="ti ti-alert-triangle auth-alert-icon" aria-hidden="true"></i>
                    <div>
                        <strong>Error de autenticación</strong>
                        <p>Verifica tu usuario y contraseña. Si se repite, contacta al administrador.</p>
                    </div>
                </div>

                <div class="auth-field">
                    <label for="username" class="auth-label">Usuario</label>
                    <div class="auth-input">
                        <i class="ti ti-user auth-input-icon" aria-hidden="true"></i>
                        <input 
                            type="text" 
                            id="username" 
                            name="username" 
                            placeholder="nombre.usuario"
                            autocomplete="username"
                            required 
                            autofocus
                            aria-label="Nombre de usuario"
                            aria-describedby="username-hint" />
                    </div>
                    <small id="username-hint" class="auth-hint">Usa el formato: nombre.apellido</small>
                </div>

                <div class="auth-field">
                    <div class="auth-label-row">
                        <label for="password" class="auth-label">Contraseña</label>
                    </div>
                    <div class="auth-input">
                        <i class="ti ti-lock auth-input-icon" aria-hidden="true"></i>
                        <input 
                            type="password" 
                            id="password" 
                            name="password" 
                            placeholder="••••••••"
                            autocomplete="current-password"
                            required
                            aria-label="Contraseña"
                            aria-describedby="password-requirements" />
                        <button 
                            class="auth-eye" 
                            type="button" 
                            id="togglePassword"
                            aria-label="Mostrar contraseña"
                            aria-pressed="false">
                            <i class="ti ti-eye icon-eye" aria-hidden="true"></i>
                            <i class="ti ti-eye-off icon-eye-off" aria-hidden="true" style="display: none;"></i>
                        </button>
                    </div>
                    <small id="password-requirements" class="auth-hint">Mínimo 12 caracteres con mayúscula, minúscula, número y símbolo</small>
                </div>

                <label class="auth-remember">
                    <input 
                        type="checkbox" 
                        id="rememberMe" 
                        name="rememberMe" 
                        value="true" />
                    Recordarme en este equipo
                </label>

                <button type="submit" class="auth-submit">
                    <span class="btn-text">Acceder al Sistema</span>
                    <span class="btn-loading" style="display: none;">
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        Autenticando...
                    </span>
                </button>

                <div class="auth-foot">
                    <p>&copy; 2024 - 2026 VERCOM | yordanisvc@gmail.com</p>
                </div>
            </form>
        </div>
    </section>
</div>

@section Styles {
    <link href="~/css/login.style.css" rel="stylesheet" type="text/css">
}

@section Scripts {
    <script>
        const togglePasswordBtn = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');

        if (togglePasswordBtn && passwordInput) {
            const eyeIcon = togglePasswordBtn.querySelector('.icon-eye');
            const eyeOffIcon = togglePasswordBtn.querySelector('.icon-eye-off');

            togglePasswordBtn.addEventListener('click', function (e) {
                e.preventDefault();
                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';
                eyeIcon.style.display = isPassword ? 'none' : 'block';
                eyeOffIcon.style.display = isPassword ? 'block' : 'none';
                this.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
                this.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
            });
        }

        const loginForm = document.querySelector('.auth-form');
        if (loginForm) {
            loginForm.addEventListener('submit', function (e) {
                const username = document.getElementById('username').value.trim();
                const password = document.getElementById('password').value;

                if (!username || !password) {
                    e.preventDefault();
                    alert('Por favor, ingresa usuario y contraseña');
                    return;
                }

                const submitBtn = loginForm.querySelector('button[type="submit"]');
                const btnText = submitBtn.querySelector('.btn-text');
                const btnLoading = submitBtn.querySelector('.btn-loading');

                if (btnText && btnLoading) {
                    submitBtn.disabled = true;
                    btnText.style.display = 'none';
                    btnLoading.style.display = 'block';
                }
            });
        }
    </script>
}