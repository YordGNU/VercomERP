@model IEnumerable<Vercom.Models.SaldoVacacione>
@{
    ViewBag.Title = "Control de Vacaciones";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Saldos de Vacaciones (9.09%)</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        @foreach (var item in Model)
        {
            var warningClass = item.SaldoActual > 30 ? "border-danger" : (item.SaldoActual > 20 ? "border-warning" : "border-success");

            <div class="col-md-4 mb-4">
                <div class="card h-100 border-top border-3 @warningClass shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title mb-0">@item.Empleado.Nombres @item.Empleado.Apellidos</h5>
                            <span class="badge bg-secondary-subtle text-secondary">Año @item.Anio</span>
                        </div>

                        <div class="row text-center bg-light rounded p-3 g-0 mb-3">
                            <div class="col-4 border-end">
                                <h4 class="mb-0">@item.DiasAcumulados.ToString("N1")</h4>
                                <small class="text-muted">Ganados</small>
                            </div>
                            <div class="col-4 border-end">
                                <h4 class="mb-0 text-danger">@item.DiasDisfrutados.ToString("N1")</h4>
                                <small class="text-muted">Gozados</small>
                            </div>
                            <div class="col-4">
                                <h4 class="mb-0 text-primary">@(item.SaldoActual?.ToString("N1") ?? "0.0")</h4>
                                <small class="text-muted">Saldo</small>
                            </div>
                        </div>

                        @if (item.SaldoActual > 30)
                        {
                            <div class="alert alert-danger py-1 px-2 small mb-0">
                                <i class="ti ti-alert-circle me-1"></i> Exceso de acumulado detectado.
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted small">
                No hay saldos de vacaciones calculados para este año.
            </div>
        }
    </div>
</div>


@section Scripts {
    <script>
        .ready(function () {
            #dataTable.DataTable();
        });
    </script>
}


