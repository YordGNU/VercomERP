@model IEnumerable<Vercom.Models.Proveedor>
@{
    ViewBag.Title = "Registro de Proveedores";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Abastecimiento: Proveedores</h4>
        <p class="text-muted small mb-0">Directorio de suministradores de bienes y servicios para la S.U.R.L.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Comercial</a></li>
            <li class="breadcrumb-item active">Proveedores</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-truck-delivery"></i> NUEVO PROVEEDOR
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card h-100 transition-all hover-shadow">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start mb-3">
                            <div class="avatar-lg bg-info-subtle text-info rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 54px; height: 54px;">
                                <i class="ti ti-building-factory-2 fs-28"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h5 class="mb-1 text-truncate fw-bold">@item.RazonSocial</h5>
                                <p class="text-muted mb-0 small">NIT: <span class="text-numeric">@item.Nit</span></p>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline py-1 px-2 border-0" data-bs-toggle="dropdown"><i class="ti ti-dots-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li><a class="dropdown-item py-2" asp-action="Details" asp-route-id="@item.Id"><i class="ti ti-info-circle me-2 text-primary"></i> Detalles</a></li>
                                    <li><a class="dropdown-item py-2" asp-action="Edit" asp-route-id="@item.Id"><i class="ti ti-edit me-2 text-info"></i> Editar</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Purchase" asp-action="Index" asp-route-proveedorId="@item.Id"><i class="ti ti-shopping-cart me-2"></i> Ver Órdenes</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="bg-light-subtle rounded-3 p-3 mb-3 border">
                            <div class="d-flex align-items-center mb-2">
                                <i class="ti ti-phone text-muted me-2"></i>
                                <span class="small fw-semibold">@item.Telefono</span>
                            </div>
                            <div class="d-flex align-items-center overflow-hidden">
                                <i class="ti ti-mail text-muted me-2"></i>
                                <span class="small text-truncate">@item.Email</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="badge @(item.Activo ? "badge-soft-success" : "badge-soft-danger")">
                                <i class="ti ti-circle-filled fs-8 me-1"></i> @(item.Activo ? "ACTIVO" : "INACTIVO")
                            </span>
                            <a asp-controller="Purchase" asp-action="Create" asp-route-proveedorId="@item.Id" class="btn btn-sm btn-outline py-0 border-0 fw-bold">
                                PEDIR <i class="ti ti-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any()) {
            <div class="col-12 text-center py-5">
                <div class="avatar-xl bg-light-subtle rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 100px; height: 100px;">
                    <i class="ti ti-building-factory fs-48 text-muted"></i>
                </div>
                <h3 class="fw-bold">Sin proveedores registrados</h3>
                <a asp-action="Create" class="btn btn-sm btn-primary mt-3">AGREGAR PROVEEDOR</a>
            </div>
        }
    </div>
</div>

<style>
    .hover-shadow:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }
</style>
