@model Vercom.ViewModels.ProviderListViewModel
@{ ViewData["Title"] = "Registro de Proveedores"; var estado = Model.Activo switch { true => "activa", false => "inactiva", _ => "" }; }

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-truck-delivery me-1'></i> NUEVO PROVEEDOR</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Gestión de Abastecimiento", Title = "Proveedores", Subtitle = "Directorio de suministradores de bienes y servicios para la S.U.R.L.", Icon = "ti-building-factory", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />

@{ var kpiTotal = new Vercom.ViewModels.KpiCardModel { Label = "Proveedores", Value = Model.Total.ToString(), Icon = "ti-building-factory", Tone = "primary" }; var kpiActivos = new Vercom.ViewModels.KpiCardModel { Label = "Proveedores activos", Value = Model.Activos.ToString(), Icon = "ti-circle-check", Tone = "success" }; var kpiInactivos = new Vercom.ViewModels.KpiCardModel { Label = "Proveedores inactivos", Value = Model.Inactivos.ToString(), Icon = "ti-circle-x", Tone = "danger" }; }
<div class='row g-2 mb-3'>
    <div class='col-md-4 col-6'>
        <partial name='_KpiCard' model='kpiTotal' />
    </div>
    <div class='col-md-4 col-6'>
        <partial name='_KpiCard' model='kpiActivos' />
    </div>
    <div class='col-md-4 col-6'>
        <partial name='_KpiCard' model='kpiInactivos' />
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold mb-1">Buscar</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="ti ti-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Razón social o NIT..." autocomplete="off" />
                    <button type="submit" class="btn btn-primary"><i class="ti ti-arrow-right"></i></button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Tipo de Entidad</label>
                <select name="tipoPersona" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Todos --</option>
                    @if (Model.TipoPersona == "JURIDICA")
                    {
                        <option value="JURIDICA" selected>PERSONA JURÍDICA</option>
                        <option value="NATURAL">PERSONA NATURAL</option>
                    }
                    else if (Model.TipoPersona == "NATURAL")
                    {
                        <option value="JURIDICA">PERSONA JURÍDICA</option>
                        <option value="NATURAL" selected>PERSONA NATURAL</option>
                    }
                    else
                    {
                        <option value="JURIDICA">PERSONA JURÍDICA</option>
                        <option value="NATURAL">PERSONA NATURAL</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Estado</label>
                <select name="estado" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Todos --</option>
                    @if (estado == "activa")
                    {
                        <option value="activa" selected>Activos</option>
                        <option value="inactiva">Inactivos</option>
                    }
                    else if (estado == "inactiva")
                    {
                        <option value="activa">Activos</option>
                        <option value="inactiva" selected>Inactivos</option>
                    }
                    else
                    {
                        <option value="activa">Activos</option>
                        <option value="inactiva">Inactivos</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-light w-100">
                    <i class="ti ti-refresh me-1"></i> LIMPIAR
                </a>
            </div>
        </form>
    </div>
</div>

<div class="row">
    @foreach (var item in Model.Items)
    {
        var tipo = (string.IsNullOrEmpty(item.TipoPersona) ? "SIN TIPO" : item.TipoPersona).ToUpperInvariant();
        var tipoBadge = tipo == "JURIDICA" ? "bg-primary-subtle text-primary" : "bg-info-subtle text-info";
        var contacto = new[] { item.Direccion, item.Telefono, item.Email }.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
        <div class="col-md-6 col-xl-4 mb-4">
            <div class="card h-100 border-0 shadow-sm overflow-hidden">
                <div class="card-status-top @(item.Activo ? "bg-success" : "bg-secondary")"></div>
                <div class="card-body p-3 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex gap-2 align-items-center">
                            <span class="avatar bg-light text-primary"><i class="ti ti-building-factory-2 fs-22"></i></span>
                            <div>
                                <span class="badge @tipoBadge text-uppercase mb-1">@tipo</span>
                                <h5 class="card-title mb-0 fs-14 text-truncate fw-bold" style="max-width: 200px;">@item.RazonSocial</h5>
                                <code class="text-muted small">NIT: @item.Nit</code>
                            </div>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-icon btn-light border" data-bs-toggle="dropdown" type="button" title="Acciones">
                                <i class="ti ti-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><h6 class="dropdown-header small text-uppercase">Acciones</h6></li>
                                <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="ti ti-eye me-1 text-primary"></i> Detalles</a></li>
                                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="ti ti-edit me-1 text-info"></i> Editar</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Purchase" asp-action="Index" asp-route-proveedorId="@item.Id"><i class="ti ti-shopping-cart me-1"></i> Ver órdenes</a></li>
                            </ul>
                        </div>
                    </div>

                    @if (item.Direccion != null || !contacto.Any())
                    {
                        <div class="small text-muted mb-1">
                            <i class="ti ti-map-pin me-1 text-danger"></i>
                            @(string.IsNullOrWhiteSpace(item.Direccion) ? "Sin dirección registrada" : item.Direccion)
                        </div>
                    }
                    @if (item.Telefono != null)
                    {
                        <div class="small text-muted mb-1">
                            <i class="ti ti-phone me-1 text-success"></i>@item.Telefono
                        </div>
                    }
                    @if (item.Email != null)
                    {
                        <div class="small text-muted mb-1">
                            <i class="ti ti-mail me-1 text-primary"></i><span class="text-truncate d-inline-block align-bottom" style="max-width: 190px;">@item.Email</span>
                        </div>
                    }
                    @if (item.CuentaBancaria != null)
                    {
                        <div class="small text-muted mb-3">
                            <i class="ti ti-building-bank me-1 text-warning"></i><span class="font-monospace">@item.CuentaBancaria</span>
                        </div>
                    }
                    @if (item.CuentaBancaria == null && item.Email == null && item.Telefono == null && string.IsNullOrWhiteSpace(item.Direccion))
                    {
                        <div class="small text-muted mb-3"><i class="ti ti-info-circle me-1"></i>Sin datos de contacto.</div>
                    }

                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge @(item.Activo ? "badge-soft-success" : "badge-soft-danger")">
                            <i class="ti ti-circle-filled me-1"></i> @(item.Activo ? "ACTIVO" : "INACTIVO")
                        </span>
                        <div class="btn-list">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="ti ti-eye"></i> VER</a>
                            <a asp-controller="Purchase" asp-action="Create" asp-route-proveedorId="@item.Id" class="btn btn-sm btn-primary">
                                PEDIR <i class="ti ti-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="avatar-lg bg-light text-muted rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="ti ti-building-factory fs-40"></i>
            </div>
            <h4>@(Model.TotalItems == 0 ? "Sin proveedores registrados" : "Sin resultados")</h4>
            <p class="text-muted">@(Model.TotalItems == 0 ? "Registre su primer suministrador para iniciar el abastecimiento." : "Ningún proveedor coincide con los filtros aplicados.")</p>
            <a asp-action="Create" class="btn btn-primary mt-2"><i class="ti ti-plus me-1"></i> Registrar proveedor</a>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    var inicio = Math.Max(1, Model.Page - 2);
    var fin = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav class="mt-2">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tipoPersona="@Model.TipoPersona" asp-route-estado="@estado" asp-route-page="@(Model.Page - 1)">Anterior</a>
            </li>
            @for (int p = inicio; p <= fin; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tipoPersona="@Model.TipoPersona" asp-route-estado="@estado" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tipoPersona="@Model.TipoPersona" asp-route-estado="@estado" asp-route-page="@(Model.Page + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}
<div class="text-center text-muted small mt-2">
    Mostrando @Model.Items.Count() de @Model.TotalItems proveedores
</div>