@model Vercom.Models.UtileResponsabilidad
@{
    ViewBag.Title = "Asignar Medio";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Entrega de Medios y Útiles</h4>
        <p class="text-muted small mb-0">Formalización de la responsabilidad material sobre activos de la empresa.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">RRHH</a></li>
            <li class="breadcrumb-item active">Asignación</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle py-3">
                    <h5 class="m-0 fw-bold"><i class="ti ti-id-badge-2 me-2 text-primary"></i>Datos de la Entrega</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Assign" method="post" class="row g-4" id="assignUtileForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Colaborador Responsable</label>
                            <select asp-for="EmpleadoId" class="form-control form-select w-100 select2" asp-items="ViewBag.EmpleadoId" required>
                                <option value="">-- Seleccione Trabajador --</option>
                            </select>
                            <span asp-validation-for="EmpleadoId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Descripción del Artículo / Medio</label>
                            <input asp-for="Descripcion" class="form-control" placeholder="Ej: Laptop Lenovo ThinkPad L14" required />
                            <small class="text-muted tiny">Incluya marca, modelo y características básicas.</small>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Número de Serie</label>
                            <input asp-for="NumeroSerie" class="form-control font-monospace" placeholder="S/N o ID de Activo" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Fecha de Entrega</label>
                            <input asp-for="FechaEntrega" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Estado de Entrega</label>
                            <select asp-for="EstadoEntrega" class="form-select">
                                <option value="NUEVO">NUEVO / SELLADO</option>
                                <option value="USADO_EXCELENTE">USADO (COMO NUEVO)</option>
                                <option value="USADO_BUENO">USADO (BUEN ESTADO)</option>
                                <option value="USADO_REGULAR">USADO (CON DESGASTE)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Observaciones de Custodia</label>
                            <textarea asp-for="Observaciones" class="form-control" rows="3" placeholder="Detalles adicionales sobre la entrega..."></textarea>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-controller="Empleado" asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-check me-1"></i> FORMALIZAR ENTREGA
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('assignUtileForm');
        });
    </script>
}
