@model IEnumerable<Vercom.Models.UtileResponsabilidad>
@{
    ViewBag.Title = "Custodia de Útiles y Medios";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Responsabilidad Material</h4>
        <p class="text-muted small mb-0">Control de herramientas, equipos y medios de protección asignados al personal.</p>
    </div>
    <div class="text-end">
        <a asp-action="Assign" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus me-1"></i> NUEVA ASIGNACIÓN
        </a>
    </div>
</div>
<div class="card shadow-sm border-0">
    <div class="card-header bg-light-subtle">
        <h5 class="m-0 fw-bold"><i class="ti ti-tool me-2 text-primary"></i>Inventario de Medios en Custodia</h5>
    </div>
    <div class="card-body">
        <table id="utilesTable" class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Descripción del Medio</th>
                    <th>Trabajador Responsable</th>
                    <th class="text-center">Fecha Entrega</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var isReturned = item.FechaDevolucion.HasValue;
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold">@item.Descripcion</div>
                            <small class="text-muted tiny">S/N: @(item.NumeroSerie ?? "N/A")</small>
                        </td>
                        <td>
                            <div class="small fw-semibold">@item.Empleado.NombreCompleto</div>
                        </td>
                        <td class="text-center small">@item.FechaEntrega.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            @if (isReturned)
                            {
                                <span class="badge bg-secondary-subtle text-secondary px-3">DEVUELTO (@item.FechaDevolucion?.ToString("dd/MM/yy"))</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success px-3">EN CUSTODIA</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-list justify-content-end">
                                @if (!isReturned)
                                {
                                    <button type="button" class="btn btn-sm btn-icon btn-light rounded-circle text-danger"
                                            onclick="returnMedio('@item.Id', '@item.Descripcion')" title="Registrar Devolución">
                                        <i class="ti ti-arrow-back"></i>
                                    </button>
                                }
                                <a asp-controller="Empleado" asp-action="File" asp-route-id="@item.EmpleadoId" class="btn btn-sm btn-icon btn-light rounded-circle" title="Ver Expediente">
                                    <i class="ti ti-user-search"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#utilesTable').DataTable({
                pageLength: 25,
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
                responsive: true,
            });
        });

        function returnMedio(id, desc) {
            Swal.fire({
                title: 'Registrar Devolución',
                text: `¿Confirma la entrega del medio: ${desc}?`,
                input: 'textarea',
                inputPlaceholder: 'Estado de devolución u observaciones...',
                showCancelButton: true,
                confirmButtonText: 'PROCESAR RETORNO',
                cancelButtonText: 'CANCELAR'
            }).then((result) => {
                if (result.isConfirmed) {
                    const formData = new FormData();
                    formData.append("id", id);
                    formData.append("returnDate", new Date().toISOString().split('T')[0]);
                    formData.append("observations", result.value);
                    formData.append("__RequestVerificationToken", $('input[name="__RequestVerificationToken"]').val());

                    fetch('/Utile/Return', {
                        method: 'POST',
                        body: formData
                    }).then(res => res.json()).then(data => {
                        if (data.success) {
                            location.reload();
                        } else {
                            toastr.error(data.message);
                        }
                    });
                }
            });
        }
    </script>
}
