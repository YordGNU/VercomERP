@model Vercom.ViewModels.PayrollIndexViewModel
@{
    ViewBag.Title = Model.Title;
    var meses = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Nómina de Salarios (RF-22)</h4>
    </div>
    <div class="text-end">
        <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#calcPayrollModal">
            <i class="ti ti-calculator me-1"></i> CALCULAR NUEVA NÓMINA
        </button>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table id="dataTable" class="table table-hover align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Periodo Fiscal</th>
                            <th>Frecuencia</th>
                            <th class="text-center">Estado (Flujo)</th>
                            <th>F. de Cálculo</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Periodos)
                        {
                            var statusClass = item.Estado == "APROBADA" ? "badge bg-success" : "badge bg-warning";

                            <tr>
                                <td class="fw-bold">@meses[item.Mes] @item.Anio</td>
                                <td><span class="badge border text-dark">@item.Tipo</span></td>
                                <td class="text-center"><span class="@statusClass">@item.Estado</span></td>
                                <td class="small text-muted">@item.CalculadoEn?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="ti ti-file-text me-1"></i> REVISAR
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Cálculo (XP: Exploración de periodo) -->
<div class="modal fade" id="calcPayrollModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="Calculate" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Iniciar Cálculo de Nómina</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 small">
                        <i class="ti ti-info-circle me-1"></i> El cálculo tomará la asistencia registrada del mes y el salario pactado en el contrato vigente (RF-22).
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Año Fiscal</label>
                            <input type="number" name="anio" class="form-control" value="@Model.CurrentAnio" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Mes</label>
                            <select name="mes" class="form-select" required>
                                @for(int m=1; m<=12; m++) {
                                    <!option value="@m" @(Model.CurrentMes == m ? "selected" : "")>@meses[m]</!option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">PROCESAR CÁLCULO</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' },
                order: [[0, 'desc']]
            });
        });
    </script>
}
