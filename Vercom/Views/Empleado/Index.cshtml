@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model IEnumerable<Vercom.Models.Empleado>
@{
    ViewBag.Title = "Plantilla de Empleados";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Expedientes del Personal</h4>
    </div>
    <div class="text-end">
        @if ((await AuthorizationService.AuthorizeAsync(User, "RRHH.EMPLEADO.CREAR")).Succeeded)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-user-plus me-1"></i> Nuevo Ingreso
            </a>
        }
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="avatar-lg bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                                <i class="ti ti-user fs-28"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h5 class="mb-0 text-truncate"><a asp-action="File" asp-route-id="@item.Id" class="text-dark">@item.Nombres @item.Apellidos</a></h5>
                                <p class="text-muted mb-0 small">@item.Cargo.Nombre</p>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light btn-icon" data-bs-toggle="dropdown"><i class="ti ti-dots-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-action="File" asp-route-id="@item.Id"><i class="ti ti-folder me-1"></i> Ver Expediente</a></li>
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="ti ti-edit me-1"></i> Editar</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="bg-light rounded p-2 mb-3">
                            <div class="row g-0 text-center">
                                <div class="col-6 border-end">
                                    <span class="d-block small text-muted">CI</span>
                                    <span class="fw-bold small">@item.CarnetIdentidad</span>
                                </div>
                                <div class="col-6">
                                    <span class="d-block small text-muted">Ingreso</span>
                                    <span class="fw-bold small">@item.FechaIngreso.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge @(item.Estado == "ACTIVO" ? "bg-success" : "bg-danger")">@item.Estado</span>
                            <div class="small text-muted">
                                <i class="ti ti-phone me-1"></i> @item.Telefono
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="ti ti-users-group fs-48 mb-3"></i>
                <h3>No hay empleados registrados</h3>
                <p>Comience dando de alta al personal para gestionar la nómina.</p>
            </div>
        }
    </div>
</div>


@section Scripts {
    <script>
        .ready(function () {
            #dataTable.DataTable();
        });
    </script>
}


