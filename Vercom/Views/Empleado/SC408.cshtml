@model IEnumerable<Vercom.Services.SC408Row>
@inject Vercom.Services.IEntidadDisplayService EntidadDisplay
@{
    var emp = ViewBag.Employee as Vercom.Models.Empleado;
    ViewBag.Title = "Modelo SC-4-08: " + emp?.Nombres;
}

<div class="page-title-head d-flex align-items-center mb-4 print-hide">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Registro de Salarios y Tiempo de Servicio</h4>
        <p class="text-muted small mb-0">Certificación oficial para trámites de seguridad social (SC-4-08).</p>
    </div>
    <div class="text-end">
        <button onclick="window.print()" class="btn btn-sm btn-primary">
            <i class="ti ti-printer me-1"></i> IMPRIMIR MODELO
        </button>
        <a asp-action="File" asp-route-id="@emp?.Id" class="btn btn-sm btn-outline-secondary">VOLVER</a>
    </div>
</div>

<div class="row">
    <div class="card border-dark shadow-none" style="background: white;">
        <div class="card-body p-5">
            <!-- Encabezado Oficial MTSS -->
            <div class="row mb-4 border-bottom border-2 border-dark pb-3">
                <div class="col-8">
                    <h5 class="fw-bold mb-0">MINISTERIO DE TRABAJO Y SEGURIDAD SOCIAL</h5>
                    <h6 class="text-muted small text-uppercase">MODELO SC-4-08 (REGISTRO DE SALARIOS)</h6>
                </div>
                <div class="col-4 text-end">
                    <div class="border p-2 border-dark d-inline-block text-start">
                        <small class="fw-bold tiny d-block">ENTIDAD / SURL:</small>
                        <strong>@EntidadDisplay.Name</strong>
                    </div>
                </div>
            </div>

            <!-- Datos del Trabajador -->
            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <label class="tiny fw-bold text-muted text-uppercase d-block mb-1">Nombre y Apellidos:</label>
                    <div class="h5 fw-bold border-bottom border-dark pb-1">@emp?.Nombres @emp?.Apellidos</div>
                </div>
                <div class="col-md-3">
                    <label class="tiny fw-bold text-muted text-uppercase d-block mb-1">C. Identidad:</label>
                    <div class="h5 fw-bold border-bottom border-dark pb-1">@emp?.CarnetIdentidad</div>
                </div>
                <div class="col-md-3">
                    <label class="tiny fw-bold text-muted text-uppercase d-block mb-1">Fecha Ingreso:</label>
                    <div class="h5 fw-bold border-bottom border-dark pb-1">@emp?.FechaIngreso.ToString("dd/MM/yyyy")</div>
                </div>
            </div>

            <!-- Cuerpo del Reporte -->
            <div class="table-responsive mt-2">
                <table class="table table-bordered border-dark align-middle">
                    <thead class="bg-light text-center">
                        <tr class="border-dark">
                            <th width="150" class="border-dark small fw-bold">AÑO / MES</th>
                            <th class="border-dark small fw-bold">DÍAS TRAB.</th>
                            <th class="border-dark small fw-bold">SALARIO DEVENGADO (CUP)</th>
                            <th class="border-dark small fw-bold">T. SERVICIO ACUM. (MESES)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model)
                        {
                            <tr>
                                <td fw-bold border-dark font-monospace">@row.Periodo</td>
                                <td border-dark">@row.DiasTrabajados.ToString("N1")</td>
                               <td class="fw-bold border-dark pe-4">@row.SalarioDevengado.ToString("N2")</td>
                                <td border-dark">@row.TiempoServicioMeses</td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted italic">No se registran nóminas aprobadas para este trabajador.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="fw-bold">
                        <tr class="bg-light">
                           <td class="border-dark pe-3">TOTALES:</td>
                            <td border-dark">@Model.Sum(r => r.DiasTrabajados).ToString("N1")</td>
                           <td class="border-dark pe-4 text-primary">@Model.Sum(r => r.SalarioDevengado).ToString("C")</td>
                            <td border-dark">-</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Firmas -->
            <div class="row mt-5 pt-5 text-center">
                <div class="col-4">
                    <div class="border-top border-dark pt-2 mx-4 small fw-bold">FIRMA DEL TRABAJADOR</div>
                </div>
                <div class="col-4">
                    <div class="border-top border-dark pt-2 mx-4 small fw-bold">RESPONSABLE RR.HH.</div>
                </div>
                <div class="col-4">
                    <div class="border-top border-dark pt-2 mx-4 small fw-bold">DIRECTOR ENTIDAD</div>
                </div>
            </div>

            <div class="text-center mt-5">
                <p class="tiny text-muted">Certificación generada por el sistema Vercom Elite el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>
    </div>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    @@media print {
        .print-hide, .sidenav-menu, .topbar { display: none !important; }
        .content-page { margin-left: 0 !important; padding: 0 !important; margin-top: 0 !important; }
        .card { border: none !important; }
        body { background: white !important; }
        .container-xxl { max-width: 100% !important; padding: 0 !important; }
    }
</style>
