@model Vercom.ViewModels.EmployeeCreateViewModel

@{
    ViewData["Title"] = "Editar Trabajador";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Actualización de Expediente</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Edit" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                        <input type="hidden" asp-for="Empleado.Id" name="Empleado.Id" />

                        <div class="col-md-4">
                            <label asp-for="Empleado.CarnetIdentidad" class="form-label fw-bold">Carnet de Identidad</label>
                            <input asp-for="Empleado.CarnetIdentidad" name="Empleado.CarnetIdentidad" class="form-control" readonly />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Empleado.Nombres" class="form-label fw-bold">Nombres</label>
                            <input asp-for="Empleado.Nombres" name="Empleado.Nombres" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Empleado.Apellidos" class="form-label fw-bold">Apellidos</label>
                            <input asp-for="Empleado.Apellidos" name="Empleado.Apellidos" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Empleado.Estado" class="form-label fw-bold">Estado Laboral</label>
                            <select asp-for="Empleado.Estado" name="Empleado.Estado" class="form-select">
                                <option value="ACTIVO">Activo</option>
                                <option value="BAJA">Baja (RF-21)</option>
                                <option value="LICENCIA">Licencia</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Empleado.CargoId" class="form-label fw-bold">Cargo Actual</label>
                            <select asp-for="Empleado.CargoId" name="Empleado.CargoId" class="form-select" asp-items="Model.Cargos" required></select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Empleado.SucursalId" class="form-label fw-bold">Sucursal</label>
                            <select asp-for="Empleado.SucursalId" name="Empleado.SucursalId" class="form-select" asp-items="Model.Sucursales" required></select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Empleado.FechaBaja" class="form-label fw-bold">Fecha de Baja</label>
                            <input asp-for="Empleado.FechaBaja" name="Empleado.FechaBaja" class="form-control" type="date" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Empleado.MotivoBaja" class="form-label fw-bold">Motivo de Baja</label>
                            <input asp-for="Empleado.MotivoBaja" name="Empleado.MotivoBaja" class="form-control" />
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
