@model Vercom.ViewModels.EmployeeCreateViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">@Model.Title</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header bg-light-subtle">
                    <h4 class="card-title">Información del Trabajador (RF-20)</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="row g-3">
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                        <input type="hidden" asp-for="Empleado.Estado" name="Empleado.Estado" value="ACTIVO" />

                        <div class="col-md-4">
                            <label asp-for="Empleado.CarnetIdentidad" class="form-label fw-bold">Carnet de Identidad</label>
                            <input asp-for="Empleado.CarnetIdentidad" name="Empleado.CarnetIdentidad" class="form-control" maxlength="11" required />
                            <span asp-validation-for="Empleado.CarnetIdentidad" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Empleado.Nombres" class="form-label fw-bold">Nombres</label>
                            <input asp-for="Empleado.Nombres" name="Empleado.Nombres" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Empleado.Apellidos" class="form-label fw-bold">Apellidos</label>
                            <input asp-for="Empleado.Apellidos" name="Empleado.Apellidos" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Empleado.FechaNacimiento" class="form-label fw-bold">Fecha de Nacimiento</label>
                            <input asp-for="Empleado.FechaNacimiento" name="Empleado.FechaNacimiento" class="form-control" type="date" required />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Empleado.Sexo" class="form-label fw-bold">Sexo</label>
                            <select asp-for="Empleado.Sexo" name="Empleado.Sexo" class="form-select" required>
                                <option value="">-- Seleccione --</option>
                                <option value="M">Masculino</option>
                                <option value="F">Femenino</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Empleado.SucursalId" class="form-label fw-bold">Sucursal / Unidad</label>
                            <select asp-for="Empleado.SucursalId" name="Empleado.SucursalId" class="form-select" asp-items="Model.Sucursales" required></select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Empleado.Direccion" class="form-label fw-bold">Dirección Particular</label>
                            <input asp-for="Empleado.Direccion" name="Empleado.Direccion" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Empleado.CargoId" class="form-label fw-bold">Cargo (Nomenclador)</label>
                            <select asp-for="Empleado.CargoId" name="Empleado.CargoId" class="form-select" asp-items="Model.Cargos" required></select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Empleado.NivelEscolaridad" class="form-label fw-bold">Nivel Escolar</label>
                            <select asp-for="Empleado.NivelEscolaridad" name="Empleado.NivelEscolaridad" class="form-select">
                                <option value="PRIMARIA">Primaria</option>
                                <option value="SECUNDARIA">Secundaria</option>
                                <option value="PREUNIVERSITARIO">Preuniversitario</option>
                                <option value="TECNICO_MEDIO">Técnico Medio</option>
                                <option value="UNIVERSITARIO">Universitario</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Empleado.FechaIngreso" class="form-label fw-bold">Fecha de Ingreso</label>
                            <input asp-for="Empleado.FechaIngreso" name="Empleado.FechaIngreso" class="form-control" type="date" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Empleado.CuentaBancariaPago" class="form-label fw-bold">Cuenta Bancaria (Bancarización)</label>
                            <input asp-for="Empleado.CuentaBancariaPago" name="Empleado.CuentaBancariaPago" class="form-control" placeholder="92xx xxxx xxxx xxxx" />
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Descartar</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="ti ti-device-floppy me-1"></i> ALTA DE TRABAJADOR
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
