@model IEnumerable<Vercom.Models.ConteoFisico>
@{
    ViewBag.Title = "Conteos Físicos";
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Gestión de Inventario Físico",
    Subtitle = "Control de existencias mediante conteos periódicos y ajustes automáticos.",
    PrimaryAction = new Vercom.ViewModels.ActionLinkModel { Controller = "ConteoFisico", Action = "Start", Text = "INICIAR NUEVO CONTEO", Icon = "ti ti-scan" },
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Vercom", Url = "javascript: void(0);" },
        new() { Text = "Inventario", Url = "javascript: void(0);" },
        new() { Text = "Conteos", IsActive = true }
    }
}' />

<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Historial de Conteos</h5>
        </div>
        <div class="card-body">
            <table id="countsTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th>Fecha</th>
                        <th>Almacén</th>
                        <th >Tipo</th>
                        <th>Estado</th>
                        <th >Responsable</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.Estado switch
                        {
                            "FINALIZADO" => "badge-soft-success",
                            "EN_PROCESO" => "badge-soft-warning",
                            "ANULADO" => "badge-soft-danger",
                            _ => "badge-soft-secondary"
                        };

                        <tr>
                            <td class="text-date fw-semibold">@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="fw-bold">@item.Almacen.Nombre</td>
                            <td><span class="badge badge-soft-info">@item.Tipo</span></td>
                            <td ><span class="badge @statusClass">@item.Estado</span></td>
                            <td class="small">@item.ResponsableId</td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Detalles">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Iniciar Conteo -->
<div class="modal fade" id="startCountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Start" method="post" class="w-100" id="startCountForm">
            @Html.AntiForgeryToken()
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-0 p-4">
                    <h5 class="modal-title fw-bold">Iniciar Conteo Físico</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 pt-0">
                    <div class="mb-3">
                        <label class="form-label">Seleccionar Almacén</label>
                        <select name="almacenId" class="form-control form-select w-100 select2" asp-items="ViewBag.Almacenes" required>
                            <option value="">-- Elija Almacén --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="submit" class="btn btn-sm btn-primary w-100 py-3 shadow">INICIAR PROCESO</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#countsTable').DataTable({
                    language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'desc']]
            });

            window.SubmitAjaxForm('startCountForm');
        });
    </script>
}
