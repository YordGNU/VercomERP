@model IEnumerable<Vercom.Models.ConteoFisico>
@{
    ViewBag.Title = "Conteos Físicos";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Inventario Físico</h4>
        <p class="text-muted small mb-0">Control de existencias mediante conteos periódicos y ajustes automáticos.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Inventario</a></li>
            <li class="breadcrumb-item active">Conteos</li>
        </ol>
        <button type="button" class="btn btn-sm btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#startCountModal">
            <i class="ti ti-scan"></i> INICIAR NUEVO CONTEO
        </button>
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Historial de Conteos</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="countsTable"  class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th width="150" class="text-center">Fecha</th>
                            <th>Almacén</th>
                            <th width="120">Tipo</th>
                            <th width="120" class="text-center">Estado</th>
                            <th width="180">Responsable</th>
                            <th width="100" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Estado switch {
                                "FINALIZADO" => "badge-soft-success",
                                "EN_PROCESO" => "badge-soft-warning",
                                "ANULADO" => "badge-soft-danger",
                                _ => "badge-soft-secondary"
                            };

                            <tr>
                                <td class="text-date fw-semibold">@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="fw-bold">@item.Almacen.Nombre</td>
                                <td><span class="badge badge-soft-info">@item.Tipo</span></td>
                                <td class="text-center"><span class="badge @statusClass">@item.Estado</span></td>
                                <td class="small">@item.ResponsableId</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Detalles">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Iniciar Conteo -->
<div class="modal fade" id="startCountModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Start" method="post" class="w-100">
            @Html.AntiForgeryToken()
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header border-0 p-4">
                    <h5 class="modal-title fw-bold">Iniciar Conteo Físico</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 pt-0">
                    <div class="mb-3">
                        <label class="form-label">Seleccionar Almacén</label>
                        <select name="almacenId" class="form-control form-select w-100" asp-items="ViewBag.Almacenes" required>
                            <option value="">-- Elija Almacén --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="submit" class="btn btn-sm btn-primary w-100 py-3 shadow">INICIAR PROCESO</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#countsTable').DataTable({
                    language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'desc']]
            });
        });
    </script>
}
