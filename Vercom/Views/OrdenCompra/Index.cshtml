@model IEnumerable<Vercom.Models.OrdenCompra>
@{
    ViewBag.Title = "Órdenes de Compra";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Gestión de Abastecimiento</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Nueva Orden de Compra
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Nº Orden</th>
                            <th>Proveedor</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Estado switch {
                                "RECIBIDA" => "badge bg-success",
                                "APROBADA" => "badge bg-info",
                                "BORRADOR" => "badge bg-warning",
                                _ => "badge bg-secondary"
                            };

                            <tr>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="fw-bold">@item.NumeroOrden</td>
                                <td>@item.Proveedor.RazonSocial</td>
                                <td class="text-end fw-bold">@item.Total.ToString("C")</td>
                                <td class="text-center"><span class="@statusClass">@item.Estado</span></td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-eye"></i></a>
                                        @if (item.Estado == "BORRADOR") {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-edit"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
