@model Vercom.Models.ActivoFijo

@{
    ViewData["Title"] = "Crear Activo Fijo";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Crear Activo Fijo</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Activos Fijos</a></li>
            <li class="breadcrumb-item active">Crear</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Creación</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Sección: Ubicación -->
                        <div class="col-md-6">
                            <label asp-for="EntidadId" class="form-label"></label>
                            <select asp-for="EntidadId" class="form-select" asp-items="ViewBag.EntidadId"></select>
                            <span asp-validation-for="EntidadId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SucursalId" class="form-label"></label>
                            <select asp-for="SucursalId" class="form-select" asp-items="ViewBag.SucursalId"></select>
                            <span asp-validation-for="SucursalId" class="text-danger"></span>
                        </div>

                        <!-- Sección: Datos del Activo -->
                        <div class="col-md-4">
                            <label asp-for="CodigoInventario" class="form-label"></label>
                            <input asp-for="CodigoInventario" class="form-control" placeholder="Código de inventario" />
                            <span asp-validation-for="CodigoInventario" class="text-danger"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <input asp-for="Descripcion" class="form-control" placeholder="Descripción del activo fijo" />
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <!-- Sección: Cuentas Contables -->
                        <div class="col-md-4">
                            <label asp-for="CuentaActivoId" class="form-label"></label>
                            <select asp-for="CuentaActivoId" class="form-select" asp-items="ViewBag.CuentaActivoId"></select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CuentaDepreciacionId" class="form-label"></label>
                            <select asp-for="CuentaDepreciacionId" class="form-select" asp-items="ViewBag.CuentaDepreciacionId"></select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CuentaGastoDepId" class="form-label"></label>
                            <select asp-for="CuentaGastoDepId" class="form-select" asp-items="ViewBag.CuentaGastoDepId"></select>
                        </div>

                        <!-- Sección: Valores -->
                        <div class="col-md-4">
                            <label asp-for="FechaAdquisicion" class="form-label"></label>
                            <input asp-for="FechaAdquisicion" class="form-control" type="date" />
                            <span asp-validation-for="FechaAdquisicion" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ValorAdquisicion" class="form-label"></label>
                            <input asp-for="ValorAdquisicion" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="ValorAdquisicion" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ValorResidual" class="form-label"></label>
                            <input asp-for="ValorResidual" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="ValorResidual" class="text-danger"></span>
                        </div>

                        <!-- Sección: Depreciación -->
                        <div class="col-md-4">
                            <label asp-for="VidaUtilMeses" class="form-label"></label>
                            <input asp-for="VidaUtilMeses" class="form-control" placeholder="Meses" />
                            <span asp-validation-for="VidaUtilMeses" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="TasaDepreciacionAnual" class="form-label"></label>
                            <input asp-for="TasaDepreciacionAnual" class="form-control" placeholder="%" />
                            <span asp-validation-for="TasaDepreciacionAnual" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DepreciacionAcumulada" class="form-label"></label>
                            <input asp-for="DepreciacionAcumulada" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="DepreciacionAcumulada" class="text-danger"></span>
                        </div>

                        <!-- Sección: Baja -->
                        <div class="col-md-6">
                            <label asp-for="FechaBaja" class="form-label"></label>
                            <input asp-for="FechaBaja" class="form-control" type="date" />
                            <span asp-validation-for="FechaBaja" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MotivoBaja" class="form-label"></label>
                            <input asp-for="MotivoBaja" class="form-control" placeholder="Motivo de la baja" />
                            <span asp-validation-for="MotivoBaja" class="text-danger"></span>
                        </div>

                        <!-- Botones -->
                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}