@model IEnumerable<Vercom.Models.ActivoFijo>
@{
    ViewBag.Title = "Submayor de Activos Fijos";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Control de Medios Básicos y Activos</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Alta de Activo
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Cód. Inventario</th>
                            <th>Descripción</th>
                            <th>F. Adquisición</th>
                            <th class="text-end">Valor Inicial</th>
                            <th class="text-end">Deprec. Acumulada</th>
                            <th class="text-end">Valor Neto</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var valorNeto = item.ValorAdquisicion - item.DepreciacionAcumulada;
                            <tr>
                                <td class="fw-bold">@item.CodigoInventario</td>
                                <td>@item.Descripcion</td>
                                <td>@item.FechaAdquisicion.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">@item.ValorAdquisicion.ToString("N2")</td>
                                <td class="text-end text-danger">@item.DepreciacionAcumulada.ToString("N2")</td>
                                <td class="text-end fw-bold">@valorNeto.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @(item.Estado == "ACTIVO" ? "bg-success" : "bg-secondary")">@item.Estado</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-edit"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any()) {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted small">No hay activos fijos registrados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
