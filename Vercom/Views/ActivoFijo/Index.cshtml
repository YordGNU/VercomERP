@model IEnumerable<Vercom.Models.ActivoFijo>
@{
    ViewBag.Title = "Submayor de Activos Fijos";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Medios Básicos y Activos Tangibles</h4>
        <p class="text-muted small mb-0">Control de propiedad, planta y equipo con cálculo de depreciación integrada.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Contabilidad</a></li>
            <li class="breadcrumb-item active">Activos Fijos</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus"></i> ALTA DE ACTIVO
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-building-warehouse me-2 text-primary"></i>Inventario de Activos</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="assetsTable"  class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th width="140">Cód. Inventario</th>
                            <th>Descripción del Activo</th>
                            <th width="120" class="text-center">F. Adquisición</th>
                            <th width="130" class="text-end">Valor Inicial ($)</th>
                            <th width="130" class="text-end">Deprec. Acum.</th>
                            <th width="130" class="text-end">Valor Neto</th>
                            <th width="100" class="text-center">Estado</th>
                            <th width="100" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var valorNeto = item.ValorAdquisicion - item.DepreciacionAcumulada;
                            var statusClass = item.Estado switch {
                                "ACTIVO" => "badge-soft-success",
                                "BAJA" => "badge-soft-danger",
                                "MANTENIMIENTO" => "badge-soft-warning",
                                _ => "badge-soft-secondary"
                            };

                            <tr>
                                <td class="text-numeric fw-bold text-primary">@item.CodigoInventario</td>
                                <td class="fw-semibold">@item.Descripcion</td>
                                <td class="text-date">@item.FechaAdquisicion.ToString("dd/MM/yyyy")</td>
                                <td class="text-numeric">@item.ValorAdquisicion.ToString("N2")</td>
                                <td class="text-numeric text-danger">-@item.DepreciacionAcumulada.ToString("N2")</td>
                                <td class="text-numeric fw-bold text-success">@valorNeto.ToString("N2")</td>
                                <td class="text-center"><span class="badge @statusClass">@item.Estado</span></td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Detalles">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#assetsTable').DataTable({
                    language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'asc']]
            });
        });
    </script>
}
