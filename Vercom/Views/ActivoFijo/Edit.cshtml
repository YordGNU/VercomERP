@model Vercom.ViewModels.AssetFormViewModel
@{
    ViewBag.Title = "Editar Activo";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">@Model.Title</h4>
    </div>
</div>

<div class="row mt-4">
    <form asp-action="Edit" method="post" id="editAssetForm">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-lg-12">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                        <input type="hidden" asp-for="Asset.Id" name="Asset.Id" />

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="Asset.CodigoInventario" class="form-label fw-bold">Código de Inventario</label>
                                <input asp-for="Asset.CodigoInventario" name="Asset.CodigoInventario" class="form-control" readonly />
                            </div>
                            <div class="col-md-9">
                                <label asp-for="Asset.Descripcion" class="form-label fw-bold">Descripción del Activo</label>
                                <input asp-for="Asset.Descripcion" name="Asset.Descripcion" class="form-control" required />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Asset.Estado" class="form-label fw-bold">Estado Operativo</label>
                                <select asp-for="Asset.Estado" name="Asset.Estado" class="form-select">
                                    <option value="ACTIVO">Activo</option>
                                    <option value="BAJA">Baja</option>
                                    <option value="MANTENIMIENTO">Mantenimiento</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Asset.ValorAdquisicion" class="form-label fw-bold">Valor de Adquisición</label>
                                <input asp-for="Asset.ValorAdquisicion" name="Asset.ValorAdquisicion" class="form-control text-end" step="0.01" />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Asset.DepreciacionAcumulada" class="form-label fw-bold">Dep. Acumulada Actual</label>
                                <input asp-for="Asset.DepreciacionAcumulada" name="Asset.DepreciacionAcumulada" class="form-control text-end" readonly />
                                <small class="text-muted italic">Actualizada por el cierre de periodo.</small>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Descartar</a>
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('editAssetForm');
        });
    </script>
}
