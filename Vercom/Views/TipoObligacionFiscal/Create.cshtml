@model VERCOM.Models.TipoObligacionFiscal
@{
    ViewBag.Title = "Crear Tipo de Obligación Fiscal";
}

@{ var pageHeader = new VERCOM.ViewModels.PageHeaderModel { Eyebrow = "Administración", Title = "Crear Tipo de Obligación Fiscal", Subtitle = "", Icon = "ti-file-invoice" }; }
<partial name='_PageHeader' model='pageHeader' />

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header border-light justify-content-between">
                <h4 class="card-title">Formulario de Creación</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3 col-md-4">
                        <label asp-for="Codigo" class="form-label"></label>
                        <input asp-for="Codigo" class="form-control" />
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="mb-3 col-md-4">
                        <label asp-for="Periodicidad" class="form-label"></label>
                        <select asp-for="Periodicidad" class="form-select">
                            <option value="MENSUAL">MENSUAL</option>
                            <option value="TRIMESTRAL">TRIMESTRAL</option>
                            <option value="ANUAL">ANUAL</option>
                        </select>
                        <span asp-validation-for="Periodicidad" class="text-danger"></span>
                    </div>
                    <div class="mb-3 col-md-4">
                        <label asp-for="TasaActual" class="form-label"></label>
                        <input asp-for="TasaActual" class="form-control" type="number" step="0.0001" />
                        <span asp-validation-for="TasaActual" class="text-danger"></span>
                    </div>
                    <div class="mb-3 col-md-12">
                        <label asp-for="BaseLegal" class="form-label"></label>
                        <textarea asp-for="BaseLegal" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="BaseLegal" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-action="Index" class="btn btn-light">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
