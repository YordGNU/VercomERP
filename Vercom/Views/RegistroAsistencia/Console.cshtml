@model Vercom.ViewModels.AttendanceConsoleViewModel
@{
    ViewBag.Title = "Consola de Asistencia";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Control de Jornada: @Model.Date.ToString("dddd, dd MMMM yyyy")</h4>
        <p class="text-muted small mb-0">Captación de incidencias, horas extra y cumplimiento de jornada laboral (RF-21).</p>
    </div>
    <div class="text-end d-flex align-items-center gap-3">
        <div class="d-none d-md-block">
            <ol class="breadcrumb m-0 py-0 mb-1 justify-content-end">
                <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
                <li class="breadcrumb-item"><a href="javascript: void(0);">RRHH</a></li>
                <li class="breadcrumb-item active">Asistencia</li>
            </ol>        
        </div>
    </div>
</div>
<div class="container-xxl">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form asp-action="Console" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Fecha de Jornada</label>
                    <input type="date" name="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Unidad / Sucursal</label>
                    <select name="sucursalId" class="form-select" asp-items="ViewBag.SucursalId" onchange="this.form.submit()">
                        <option value="">-- Todas las Unidades --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Cargo</label>
                    <select name="cargoId" class="form-select select2" asp-items="ViewBag.CargoId" onchange="this.form.submit()">
                        <option value="">-- Todos --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Buscar por Nombre/CI</label>
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="Escriba aquí..." value="@ViewBag.CurrentSearch" />
                        <button type="submit" class="btn btn-primary"><i class="ti ti-search"></i></button>
                    </div>
                </div>
                <div class="col-md-1">
                    <a asp-action="Console" class="btn btn-light w-100" title="Limpiar"><i class="ti ti-refresh"></i></a>
                </div>
            </form>
        </div>
    </div>

    <form asp-action="SaveConsole" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
        <div class="card shadow-sm border-0">
            <div class="card-header justify-content-between bg-light-subtle">
                <h5 class="m-0 fw-bold"><i class="ti ti-users me-2 text-primary"></i>Listado de Plantilla Activa (@Model.Rows.Count)</h5>
               </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped dt-responsive mb-0">
                    <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th class="ps-4">Empleado</th>
                                <th class="text-center" width="140">Hora Entrada</th>
                                <th class="text-center" width="140">Hora Salida</th>
                                <th class="text-center" width="120">Horas Extra</th>
                                <th>Incidencia / Ausencia (RF-21)</th>
                                <th class="pe-4">Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                var row = Model.Rows[i];
                                <tr>
                                    <td class="ps-4">
                                        <input type="hidden" name="logs[@i].EmpleadoId" value="@row.EmpleadoId" />
                                        <input type="hidden" name="logs[@i].Fecha" value="@Model.Date.ToString("yyyy-MM-dd")" />
                                        <div class="fw-bold fs-13">@row.NombreCompleto</div>
                                        <small class="text-muted tiny text-uppercase">@row.Cargo</small>
                                    </td>
                                    <td>
                                        <input type="time" name="logs[@i].HoraEntrada" class="form-control form-control-sm text-center font-monospace" value="@row.Record.HoraEntrada?.ToString("HH:mm")" />
                                    </td>
                                    <td>
                                        <input type="time" name="logs[@i].HoraSalida" class="form-control form-control-sm text-center font-monospace" value="@row.Record.HoraSalida?.ToString("HH:mm")" />
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="number" step="0.5" name="logs[@i].HorasExtra" class="form-control text-center" value="@row.Record.HorasExtra" />
                                            <span class="input-group-text bg-light">h</span>
                                        </div>
                                    </td>
                                    <td>
                                        <select name="logs[@i].TipoAusenciaId" class="form-select form-select-sm fw-bold">
                                            <option value="">-- Presente --</option>
                                            @foreach (var ta in Model.TiposAusencia)
                                            {
                                                <!option value="@ta.Id" @(row.Record.TipoAusenciaId == ta.Id ? "selected" : "")>@ta.Nombre</!option>
                                            }
                                        </select>
                                    </td>
                                    <td class="pe-4">
                                        <input name="logs[@i].Observaciones" class="form-control form-control-sm" value="@row.Record.Observaciones" placeholder="Justificación..." maxlength="200" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light-subtle d-flex justify-content-between align-items-center p-4">
                <div class="text-muted small italic">
                    <i class="ti ti-info-circle me-1"></i> Los cambios impactarán automáticamente el acumulado de vacaciones (9.09%).
                </div>
                <div class="btn-list">
                    <a asp-action="Index" class="btn btn-outline-secondary">CANCELAR</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i> GUARDAR ASISTENCIA DEL DÍA
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-13 { font-size: 0.8125rem; }
</style>
