@model Vercom.ViewModels.AttendanceConsoleViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Control de Jornada: @Model.Date.ToString("dddd, dd MMMM yyyy")</h4>
    </div>
    <div class="text-end d-flex gap-2">
        <input type="date" class="form-control form-control-sm" id="jumpDate" value="@Model.Date.ToString("yyyy-MM-dd")" onchange="window.location.href='?date=' + this.value" />
    </div>
</div>

<div class="container-xxl mt-4">
    <form asp-action="SaveConsole" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Empleado</th>
                                <th width="120">Entrada</th>
                                <th width="120">Salida</th>
                                <th width="100">Extras (h)</th>
                                <th width="200">Incidencia / Ausencia (RF-21)</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                var row = Model.Rows[i];
                                <tr>
                                    <td>
                                        <input type="hidden" name="logs[@i].EmpleadoId" value="@row.EmpleadoId" />
                                        <input type="hidden" name="logs[@i].Fecha" value="@Model.Date.ToString("yyyy-MM-dd")" />
                                        <div class="fw-bold">@row.NombreCompleto</div>
                                        <small class="text-muted">@row.Cargo</small>
                                    </td>
                                    <td>
                                        <input type="time" name="logs[@i].HoraEntrada" class="form-control form-control-sm" value="@row.Record.HoraEntrada?.ToString("HH:mm")" />
                                    </td>
                                    <td>
                                        <input type="time" name="logs[@i].HoraSalida" class="form-control form-control-sm" value="@row.Record.HoraSalida?.ToString("HH:mm")" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.5" name="logs[@i].HorasExtra" class="form-control form-control-sm" value="@row.Record.HorasExtra" />
                                    </td>
                                    <td>
                                        <select name="logs[@i].TipoAusenciaId" class="form-select form-select-sm">
                                            <option value="">-- Presente --</option>
                                            @foreach (var ta in Model.TiposAusencia)
                                            {
                                                <!option value="@ta.Id" @(row.Record.TipoAusenciaId == ta.Id ? "selected" : "")>@ta.Nombre</!option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input name="logs[@i].Observaciones" class="form-control form-control-sm" value="@row.Record.Observaciones" placeholder="..." />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light d-flex justify-content-end">
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="ti ti-device-floppy me-1"></i> GUARDAR ASISTENCIA DEL DÍA
                </button>
            </div>
        </div>
    </form>
</div>
