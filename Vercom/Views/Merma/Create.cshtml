@model Vercom.ViewModels.MermaFormViewModel
@{
    ViewBag.Title = "Reportar Merma";
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Mermas</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Inventario", Title = "Registro de Ineficiencia Extraordinaria", Subtitle = "Captación de desperdicios, roturas o mermas fuera de la norma técnica.", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 border-start border-danger border-4">
                <div class="card-header bg-danger-subtle py-3">
                    <h5 class="m-0 fw-bold text-danger"><i class="ti ti-alert-triangle me-2"></i>Detalle del Incidente Operativo</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-4" id="mermaForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-7">
                            <label class="form-label fw-bold">Orden de Producción (Origen)</label>
                            <select asp-for="Merma.OrdenProduccionId" class="form-control form-select w-100 select2" asp-items="ViewBag.OrdenProduccionId">
                                <option value="">-- Merma no vinculada a OP (Ajuste Directo) --</option>
                            </select>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label fw-bold">Fecha de Ocurrencia</label>
                            <input asp-for="Merma.Fecha" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Artículo / Insumo Afectado</label>
                            <select asp-for="Merma.ProductoId" class="form-control form-select w-100 select2" asp-items="ViewBag.ProductoId" required>
                                <option value="">-- Buscar en Catálogo --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Cantidad Desperdiciada</label>
                            <div class="input-group">
                                <input asp-for="Merma.Cantidad" type="number" step="0.0001" class="form-control fw-bold text-danger" placeholder="0.0000" required />
                                <span class="input-group-text bg-light tiny">U.M.</span>
                            </div>
                            <span asp-validation-for="Merma.Cantidad" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Causa del Desperdicio</label>
                            <select asp-for="Merma.Causa" class="form-select" required>
                                <option value="DURANTE_PROCESO">Desperdicio en Proceso</option>
                                <option value="ROTURA_MAQUINARIA">Falla Técnica / Maquinaria</option>
                                <option value="ERROR_HUMANO">Error de Operación</option>
                                <option value="VENCIMIENTO">Caducidad de Insumo</option>
                                <option value="OTRO">Otros Motivos</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Observaciones / Justificación Técnica</label>
                            <textarea asp-for="Merma.Observaciones" class="form-control" rows="3" placeholder="Describa brevemente cómo ocurrió la pérdida..."></textarea>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-danger px-5 py-2 shadow">
                                <i class="ti ti-alert-triangle me-1"></i> REGISTRAR MERMA
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('mermaForm');
        });
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
