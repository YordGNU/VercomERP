@model Vercom.Models.Merma
@{
    ViewBag.Title = "Reportar Merma";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 text-danger">Registro de Ineficiencia Extraordinaria</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <form asp-action="Create" method="post">
                <div class="card border-danger-subtle">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="OrdenProduccionId" class="form-label fw-bold">Orden de Producción Asociada</label>
                                <select asp-for="OrdenProduccionId" class="form-select" asp-items="ViewBag.OrdenProduccionId">
                                    <option value="">-- Merma no vinculada a OP --</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label asp-for="ProductoId" class="form-label fw-bold">Artículo Dañado / Desperdiciado</label>
                                <select asp-for="ProductoId" class="form-select select2" asp-items="ViewBag.ProductoId" required>
                                    <option value="">-- Seleccione Producto --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Cantidad" class="form-label fw-bold">Cantidad</label>
                                <input asp-for="Cantidad" type="number" step="0.01" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Causa" class="form-label fw-bold">Motivo / Causa</label>
                                <select asp-for="Causa" class="form-select">
                                    <option value="DURANTE_PROCESO">Desperdicio en Proceso</option>
                                    <option value="ROTURA_MAQUINARIA">Falla Técnica</option>
                                    <option value="ERROR_HUMANO">Error de Operación</option>
                                    <option value="VENCIMIENTO">Caducidad</option>
                                    <option value="OTRO">Otros Motivos</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label asp-for="Observaciones" class="form-label fw-bold">Detalle del Incidente</label>
                                <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="ti ti-alert-triangle me-1"></i> REGISTRAR MERMA
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
