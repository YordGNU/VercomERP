@model IEnumerable<Vercom.Models.Merma>
@{
    ViewBag.Title = "Control de Mermas";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Desperdicios y Mermas</h4>
        <p class="text-muted small mb-0">Control de mermas industriales y mermas extraordinarias por rotura o vencimiento.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Producción</a></li>
            <li class="breadcrumb-item active">Mermas</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-danger shadow-sm">
            <i class="ti ti-minus me-1"></i> REPORTAR INCIDENCIA
        </a>
    </div>
</div>

<div class="row">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle">
            <h5 class="m-0 fw-bold"><i class="ti ti-trash me-2 text-danger"></i>Historial de Pérdidas Operativas</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="mermasTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th class="ps-4">Fecha</th>
                            <th>Orden de Producción</th>
                            <th>Producto / Insumo</th>
                            <th>Cantidad</th>
                            <th>Causa / Justificación</th>
                            <th>Valor Contable</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(m => m.Fecha))
                        {
                            <tr>
                                <td class="ps-4 small text-muted">@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if(item.OrdenProduccion != null) {
                                        <code class="text-primary fw-bold">#@item.OrdenProduccion.NumeroOrden</code>
                                    } else {
                                        <span class="text-muted tiny">Ajuste General</span>
                                    }
                                </td>
                                <td class="fw-bold fs-13">@item.Producto?.Nombre</td>
                               <td class="fw-bold text-danger">
                                    @item.Cantidad.ToString("N2")
                                    <small class="text-muted">@item.Producto?.UnidadMedida.Codigo</small>
                                </td>
                                <td><span class="badge border border-danger text-danger small">@item.Causa</span></td>
                               <td class="fw-bold">@item.ValorContable?.ToString("C")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="avatar avatar-xl bg-light-subtle text-success rounded-circle mb-3 mx-auto">
                                        <i class="ti ti-circle-check fs-48"></i>
                                    </div>
                                    <h4 class="fw-bold">Sin mermas registradas</h4>
                                    <p class="text-muted small">No se han reportado pérdidas extraordinarias en el periodo actual.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#mermasTable').DataTable({
                language: { url: '/js/i18n/es-ES.json' },
                order: [[0, 'desc']]
            });
        });
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-13 { font-size: 0.8125rem; }
</style>
