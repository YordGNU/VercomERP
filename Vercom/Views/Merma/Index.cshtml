@model IEnumerable<Vercom.Models.Merma>
@{
    ViewBag.Title = "Registro de Mermas";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Control de Desperdicios y Mermas</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-danger">
            <i class="ti ti-minus me-1"></i> Reportar Nueva Merma
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Orden de Producción</th>
                            <th>Producto / Insumo</th>
                            <th class="text-end">Cantidad</th>
                            <th>Causa / Motivo</th>
                            <th class="text-end">Valor Contable</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td><code class="text-primary">@item.OrdenProduccion?.NumeroOrden</code></td>
                                <td class="fw-bold">@item.Producto?.Nombre</td>
                                <td class="text-end fw-bold text-danger">@item.Cantidad.ToString("N2")</td>
                                <td><span class="badge border text-dark">@item.Causa</span></td>
                                <td class="text-end">@item.ValorContable?.ToString("C")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-eye"></i></a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any()) {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted small">No hay mermas extraordinarias registradas.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
