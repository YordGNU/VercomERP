@model IEnumerable<Vercom.Models.Equipo>
@{
    ViewBag.Title = "Equipos de Planta";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Parque de Maquinaria e Inmuebles</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Añadir Equipo
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        @foreach (var item in Model)
        {
            var statusColor = item.Estado == "OPERATIVO" ? "success" : (item.Estado == "MANTENIMIENTO" ? "warning" : "danger");

            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <div>
                                <h4 class="card-title mb-0">@item.Nombre</h4>
                                <code class="text-muted small">@item.Codigo</code>
                            </div>
                            <span class="badge bg-@statusColor-subtle text-@statusColor">@item.Estado</span>
                        </div>

                        <div class="bg-light rounded p-2 mb-3 small">
                            <p class="mb-1"><i class="ti ti-calendar-check me-1"></i> Última Revisión: @(item.FechaUltimaRevision?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                            <p class="mb-0"><i class="ti ti-refresh me-1"></i> Frecuencia: Cada @item.FrecuenciaMantenimientoDias días</p>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="MantenimientoProgramado" asp-action="Create" asp-route-equipoId="@item.Id" class="btn btn-sm btn-outline-primary">Programar Mantenimiento</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


@section Scripts {
    <script>
        .ready(function () {
            #dataTable.DataTable();
        });
    </script>
}


