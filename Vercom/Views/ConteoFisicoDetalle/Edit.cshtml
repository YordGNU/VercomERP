@model Vercom.Models.ConteoFisicoDetalle

@{
    ViewData["Title"] = "Editar Detalle de Conteo Físico";
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Editar Detalle de Conteo Físico",
    Subtitle = "Modificación de detalle de conteo físico.",
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Vercom", Url = "javascript: void(0);" },
        new() { Text = "Inventario", Url = "javascript: void(0);" },
        new() { Text = "Detalle de Conteo", IsActive = true }
    }
}' />

<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Edición</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="col-md-6">
                            <label asp-for="ConteoId" class="form-label"></label>
                            <select asp-for="ConteoId" class="form-select" asp-items="ViewBag.ConteoId"></select>
                            <span asp-validation-for="ConteoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProductoId" class="form-label"></label>
                            <select asp-for="ProductoId" class="form-select select2" asp-items="ViewBag.ProductoId"></select>
                            <span asp-validation-for="ProductoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CantidadSistema" class="form-label"></label>
                            <input asp-for="CantidadSistema" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="CantidadSistema" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CantidadFisica" class="form-label"></label>
                            <input asp-for="CantidadFisica" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="CantidadFisica" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Justificacion" class="form-label"></label>
                            <input asp-for="Justificacion" class="form-control" placeholder="Justificación de la diferencia" />
                            <span asp-validation-for="Justificacion" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MovimientoAjusteId" class="form-label"></label>
                            <select asp-for="MovimientoAjusteId" class="form-select" asp-items="ViewBag.MovimientoAjusteId"></select>
                            <span asp-validation-for="MovimientoAjusteId" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}