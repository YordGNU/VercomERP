@using Microsoft.AspNetCore.Authorization
@model IEnumerable<Vercom.Models.CuentaContable>
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.Title = "Plan de Cuentas";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Plan de Cuentas Institucional</h4>
        <p class="text-muted small mb-0">Gestión del nomenclador oficial según normativas del MFP.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Contabilidad</a></li>
            <li class="breadcrumb-item active">Plan de Cuentas</li>
        </ol>
        @if ((await AuthorizationService.AuthorizeAsync(User, "CONTABILIDAD.CUENTA.CREAR")).Succeeded)
        {
            <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
                <i class="ti ti-plus"></i> NUEVA CUENTA
            </a>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="m-0 fw-bold"><i class="ti ti-list-tree me-2 text-primary"></i>Jerarquía Contable</h5>
        <div class="d-flex gap-2">
            <span class="badge badge-soft-info">@Model.Count() Cuentas</span>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="accountsTable" class="table">
                <thead>
                    <tr>
                        <th width="150">Código</th>
                        <th>Nombre de la Cuenta</th>
                        <th width="120">Clase</th>
                        <th width="120">Naturaleza</th>
                        <th width="80" class="text-center">Nivel</th>
                        <th width="100" class="text-center">Estado</th>
                        <th width="120" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderBy(c => c.Codigo))
                    {
                        var padding = (item.Nivel - 1) * 24;
                        var isHeader = !item.AceptaMovimiento;

                        <tr class="@(isHeader ? "bg-light-subtle fw-bold" : "")">
                            <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                            <td>
                                <div style="padding-left: @(padding)px;" class="d-flex align-items-center">
                                    @if (isHeader) { <i class="ti ti-folder-filled me-2 text-warning"></i> }
                                    else { <i class="ti ti-minus me-2 text-muted"></i> }
                                    @item.Nombre
                                </div>
                            </td>
                            <td><span class="badge badge-soft-secondary">@item.Clase</span></td>
                            <td><small class="text-uppercase fw-semibold">@item.Naturaleza</small></td>
                            <td class="text-center"><span class="text-muted">@item.Nivel</span></td>
                            <td class="text-center">
                                @if (item.Activo) { <span class="badge badge-soft-success">ACTIVA</span> }
                                else { <span class="badge badge-soft-danger">INACTIVA</span> }
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Ver Detalles">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Editar">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                    @if (isHeader) {
                                        <a asp-action="Create" asp-route-padreId="@item.Id" class="btn btn-sm btn-outline py-1 px-2 text-primary" title="Subcuenta">
                                            <i class="ti ti-plus"></i>
                                        </a>
                                    }
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2 text-danger" title="Eliminar">
                                        <i class="ti ti-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#accountsTable').DataTable({
                pageLength: 25,
                         language: { url: '/js/i18n/es-ES.json' },
                order: [] // Mantener orden jerárquico por código
            });
        });
    </script>
}
