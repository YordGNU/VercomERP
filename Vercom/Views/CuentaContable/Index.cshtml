@using Microsoft.AspNetCore.Authorization
@model IEnumerable<Vercom.Models.CuentaContable>
@inject IAuthorizationService AuthorizationService
@{
    ViewBag.Title = "Plan de Cuentas";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Nomenclador de Cuentas (MFP)</h4>
    </div>
    <div class="text-end">
        @if ((await AuthorizationService.AuthorizeAsync(User, "CONTABILIDAD.CUENTA.CREAR")).Succeeded)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-plus me-1"></i> Nueva Cuenta
            </a>
        }
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
            <h4 class="card-title">Estructura Contable</h4>
            <div class="d-flex gap-2">
                <span class="badge bg-success-subtle text-success">Activa</span>
                <span class="badge bg-warning-subtle text-warning">Acepta Movimiento</span>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="dataTable" class="table table-hover align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th width="120">Código</th>
                            <th>Nombre de la Cuenta</th>
                            <th>Clase</th>
                            <th>Naturaleza</th>
                            <th>Nivel</th>
                            <th class="text-center">Mov.</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(c => c.Codigo))
                        {
                            var padding = (item.Nivel - 1) * 30;
                            var rowClass = item.AceptaMovimiento ? "" : "fw-bold bg-light-subtle";

                            <tr class="@rowClass">
                                <td class="font-monospace">@item.Codigo</td>
                                <td>
                                    <div style="padding-left: @(padding)px;">
                                        @if (!item.AceptaMovimiento) { <i class="ti ti-folder me-1 text-primary"></i> }
                                        else { <i class="ti ti-file-description me-1 text-muted"></i> }
                                        @item.Nombre
                                    </div>
                                </td>
                                <td><small class="badge border text-dark">@item.Clase</small></td>
                                <td><small>@item.Naturaleza</small></td>
                                <td><span class="text-muted">Niv @item.Nivel</span></td>
                                <td class="text-center">
                                    @if (item.AceptaMovimiento) { <i class="ti ti-check text-success fs-18"></i> }
                                </td>
                                <td class="text-center">
                                    @if (item.Activo) { <span class="text-success">?</span> }
                                    else { <span class="text-danger">?</span> }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-edit"></i></a>
                                        @if (!item.AceptaMovimiento) {
                                            <a asp-action="Create" asp-route-padreId="@item.Id" class="btn btn-xs btn-light text-primary" title="Añadir Subcuenta"><i class="ti ti-plus"></i></a>
                                        }
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-xs btn-light text-danger"><i class="ti ti-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        .ready(function () {
            #dataTable.DataTable();
        });
    </script>
}
