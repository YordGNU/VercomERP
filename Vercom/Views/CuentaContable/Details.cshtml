@model Vercom.Models.CuentaContable
@inject Vercom.Services.IAccountingService AccountingService
@{
    ViewBag.Title = "Ficha de Cuenta Contable";
    var balance = await AccountingService.GetAccountBalanceAsync(Model.Id);
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Contabilidad", Title = "Cuenta: ", Subtitle = "Atributos técnicos, jerarquía y saldo actual en el Libro Mayor.", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />


            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                <i class="ti ti-edit me-1"></i> EDITAR CUENTA
            </a>
            @if(Model.AceptaMovimiento) {
                <a asp-controller="AsientoContable" asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
                    <i class="ti ti-plus me-1"></i> NUEVO ASIENTO
                </a>
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="row">
        <!-- Columna Izquierda: Tarjeta de Saldo y Jerarquía -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-status-top @(Model.Naturaleza == "DEUDORA" ? "bg-primary" : "bg-success")"></div>
                <div class="card-body text-center p-4">
                    <div class="avatar avatar-xl bg-light text-primary rounded-circle mb-3 mx-auto" style="width: 80px; height: 80px;">
                        <i class="ti ti-report-money fs-40"></i>
                    </div>
                    <h2 class="fw-bold mb-1">@balance.ToString("C")</h2>
                    <p class="text-muted small text-uppercase fw-bold mb-0">Saldo Acumulado (@Model.Moneda)</p>

                    <div class="mt-4 pt-3 border-top">
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="bg-light-subtle rounded py-2">
                                    <div class="small fw-bold">@Model.Clase</div>
                                    <div class="text-muted tiny text-uppercase">Clase</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light-subtle rounded py-2">
                                    <div class="small fw-bold">@Model.Naturaleza</div>
                                    <div class="text-muted tiny text-uppercase">Naturaleza</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold small text-uppercase">Jerarquía de la Cuenta</h5>
                </div>
                <div class="card-body">
                    <div class="p-3 border-bottom bg-light-subtle">
                        <label class="text-muted tiny fw-bold text-uppercase d-block mb-1">Cuenta Superior</label>
                        @if(Model.CuentaPadre != null) {
                            <a asp-action="Details" asp-route-id="@Model.CuentaPadreId" class="fw-bold text-primary">
                                <i class="ti ti-arrow-back-up me-1"></i> @Model.CuentaPadre.Codigo - @Model.CuentaPadre.Nombre
                            </a>
                        } else {
                            <span class="text-muted small">Nivel Raíz (Sin Padre)</span>
                        }
                    </div>
                    <div class="p-3">
                        <label class="text-muted tiny fw-bold text-uppercase d-block mb-1">Nivel en el Plan</label>
                        <div class="d-flex align-items-center">
                            @for(int i=0; i<Model.Nivel; i++) {
                                <i class="ti ti-circle-filled fs-10 text-primary me-1"></i>
                            }
                            <span class="ms-2 fw-bold">NIVEL @Model.Nivel</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Detalles Operativos y Auxiliares -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light-subtle d-flex justify-content-between">
                    <h5 class="m-0 fw-bold"><i class="ti ti-settings me-2 text-primary"></i>Configuración de Control</h5>
                </div>
                <div class="card-body">
                    <div class="row row-cards g-3">
                        <div class="col-sm-4">
                            <div class="p-3 bg-light rounded-3 text-center h-100">
                                <i class="ti @(Model.AceptaMovimiento ? "ti-check text-success" : "ti-x text-danger") fs-24 d-block mb-1"></i>
                                <span class="small fw-bold d-block">ACEPTA MOVIMIENTOS</span>
                                <p class="tiny text-muted mb-0">@(Model.AceptaMovimiento ? "Cuenta de detalle" : "Cuenta de agrupación")</p>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="p-3 bg-light rounded-3 text-center h-100">
                                <i class="ti @(Model.RequiereCentroCosto ? "ti-check text-success" : "ti-circle text-muted") fs-24 d-block mb-1"></i>
                                <span class="small fw-bold d-block">REQ. C. COSTO</span>
                                <p class="tiny text-muted mb-0">Uso obligatorio de centros</p>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="p-3 bg-light rounded-3 text-center h-100">
                                <i class="ti @(Model.RequiereTercero ? "ti-check text-success" : "ti-circle text-muted") fs-24 d-block mb-1"></i>
                                <span class="small fw-bold d-block">REQ. TERCERO</span>
                                <p class="tiny text-muted mb-0">Uso obligatorio de clientes/prov</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabs de Información Dinámica -->
            <div class="card shadow-sm border-0">
                <div class="card-header p-0">
                    <ul class="nav nav-tabs nav-tabs border-0" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active px-4 py-3 fw-bold" data-bs-toggle="tab" href="#tab-subs">CUENTAS HIJAS (@Model.InverseCuentaPadre.Count)</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-4 py-3 fw-bold" data-bs-toggle="tab" href="#tab-recent">ÚLTIMOS MOVIMIENTOS</a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content">
                        <!-- Cuentas Hijas -->
                        <div class="tab-pane fade show active" id="tab-subs">
                            @if(Model.InverseCuentaPadre.Any()) {
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Código</th>
                                                <th>Nombre de la Cuenta</th>
                                              <th>Tipo</th>
                                                <th width="50"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach(var child in Model.InverseCuentaPadre.OrderBy(x => x.Codigo)) {
                                                <tr>
                                                    <td class="font-monospace fw-bold">@child.Codigo</td>
                                                    <td>@child.Nombre</td>
                                                    <td >
                                                        <span class="badge @(child.AceptaMovimiento ? "bg-info-subtle text-info" : "bg-light") small">
                                                            @(child.AceptaMovimiento ? "DETALLE" : "AGRUP.")
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <a asp-action="Details" asp-route-id="@child.Id" class="btn btn-icon btn-sm btn-ghost-primary"><i class="ti ti-eye"></i></a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            } else {
                                <div class="text-center py-5 text-muted small">Esta cuenta no tiene sub-divisiones.</div>
                            }
                        </div>
                        <!-- Últimos Movimientos -->
                        <div class="tab-pane fade" id="tab-recent">
                            @if(Model.AsientoDetalles.Any()) {
                                <div class="table-responsive">
                                    <table class="table table-vcenter card-table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Fecha</th>
                                                <th>Comprobante</th>
                                                <th>Glosa / Detalle</th>
                                                <th>Debe</th>
                                                <th>Haber</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach(var m in Model.AsientoDetalles.OrderByDescending(x => x.Asiento.Fecha).Take(10)) {
                                                <tr>
                                                    <td class="small text-muted">@m.Asiento.Fecha.ToString("dd/MM/yyyy")</td>
                                                    <td>
                                                        <a asp-controller="AsientoContable" asp-action="Details" asp-route-id="@m.AsientoId" class="fw-bold">
                                                            #@m.Asiento.NumeroComprobante.ToString("D8")
                                                        </a>
                                                    </td>
                                                    <td class="small">@m.Glosa</td>
                                                    <td>@(m.Debe > 0 ? m.Debe.ToString("N2") : "")</td>
                                                    <td>@(m.Haber > 0 ? m.Haber.ToString("N2") : "")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            } else {
                                <div class="text-center py-5 text-muted small">Sin movimientos registrados recientemente.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
