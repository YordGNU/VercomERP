@model Vercom.Models.CuentaContable
@{
    ViewBag.Title = "Editar Cuenta";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Actualizar Cuenta Contable</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreadoEn" />

                <div class="card">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Codigo" class="form-label fw-bold">Código (MFP)</label>
                                <input asp-for="Codigo" class="form-control font-monospace" required />
                                <span asp-validation-for="Codigo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Nombre" class="form-label fw-bold">Nombre de la Cuenta</label>
                                <input asp-for="Nombre" class="form-control" required />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="CuentaPadreId" class="form-label fw-bold">Depende de (Cuenta Padre)</label>
                                <select asp-for="CuentaPadreId" class="form-select" asp-items="ViewBag.CuentaPadreId">
                                    <option value="">-- Cuenta de Nivel 1 (Raíz) --</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Clase" class="form-label fw-bold">Clase</label>
                                <select asp-for="Clase" class="form-select" asp-items="ViewBag.Clases"></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Naturaleza" class="form-label fw-bold">Naturaleza</label>
                                <select asp-for="Naturaleza" class="form-select" asp-items="ViewBag.Naturalezas"></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Nivel" class="form-label fw-bold">Nivel</label>
                                <input asp-for="Nivel" type="number" class="form-control" min="1" max="5" />
                            </div>

                            <div class="col-md-12 mt-4">
                                <div class="row bg-light rounded p-3 g-2">
                                    <div class="col-md-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" asp-for="AceptaMovimiento">
                                            <label class="form-check-label fw-bold" asp-for="AceptaMovimiento">Acepta Movimiento</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" asp-for="RequiereCentroCosto">
                                            <label class="form-check-label fw-bold" asp-for="RequiereCentroCosto">Centro Costo Req.</label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" asp-for="Activo">
                                            <label class="form-check-label fw-bold" asp-for="Activo">Estado Activa</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
