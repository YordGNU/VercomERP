@model Vercom.Models.CuentaContable

@{
    ViewData["Title"] = "Editar Cuenta Contable";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Editar Cuenta Contable</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Contabilidad</a></li>
            <li class="breadcrumb-item active">Cuentas Contables</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Edición</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="col-md-6">
                            <label asp-for="EntidadId" class="form-label"></label>
                            <select asp-for="EntidadId" class="form-select" asp-items="ViewBag.EntidadId"></select>
                            <span asp-validation-for="EntidadId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CuentaPadreId" class="form-label"></label>
                            <select asp-for="CuentaPadreId" class="form-select" asp-items="ViewBag.CuentaPadreId"></select>
                            <span asp-validation-for="CuentaPadreId" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Codigo" class="form-label"></label>
                            <input asp-for="Codigo" class="form-control" placeholder="Código de la cuenta" />
                            <span asp-validation-for="Codigo" class="text-danger"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Nombre de la cuenta" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Nivel" class="form-label"></label>
                            <input asp-for="Nivel" class="form-control" placeholder="Nivel jerárquico" />
                            <span asp-validation-for="Nivel" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Clase" class="form-label"></label>
                            <select asp-for="Clase" class="form-select">
                                <option value="">Seleccione clase</option>
                                <option value="Activo">Activo</option>
                                <option value="Pasivo">Pasivo</option>
                                <option value="Patrimonio">Patrimonio</option>
                                <option value="Ingreso">Ingreso</option>
                                <option value="Gasto">Gasto</option>
                                <option value="Orden">Cuenta de Orden</option>
                            </select>
                            <span asp-validation-for="Clase" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Naturaleza" class="form-label"></label>
                            <select asp-for="Naturaleza" class="form-select">
                                <option value="">Seleccione naturaleza</option>
                                <option value="Deudora">Deudora</option>
                                <option value="Acreedora">Acreedora</option>
                            </select>
                            <span asp-validation-for="Naturaleza" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Moneda" class="form-label"></label>
                            <select asp-for="Moneda" class="form-select">
                                <option value="">Seleccione moneda</option>
                                <option value="CUP">CUP</option>
                                <option value="MLC">MLC</option>
                                <option value="AMBAS">AMBAS</option>
                            </select>
                            <span asp-validation-for="Moneda" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CreadoEn" class="form-label"></label>
                            <input asp-for="CreadoEn" class="form-control" type="datetime-local" />
                            <span asp-validation-for="CreadoEn" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" asp-for="AceptaMovimiento" />
                                <label class="form-check-label" asp-for="AceptaMovimiento">
                                    @Html.DisplayNameFor(model => model.AceptaMovimiento)
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" asp-for="RequiereCentroCosto" />
                                <label class="form-check-label" asp-for="RequiereCentroCosto">
                                    @Html.DisplayNameFor(model => model.RequiereCentroCosto)
                                </label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" asp-for="RequiereTercero" />
                                <label class="form-check-label" asp-for="RequiereTercero">
                                    @Html.DisplayNameFor(model => model.RequiereTercero)
                                </label>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" asp-for="Activo" />
                                <label class="form-check-label" asp-for="Activo">
                                    @Html.DisplayNameFor(model => model.Activo)
                                </label>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}