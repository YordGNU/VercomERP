@model Vercom.ViewModels.AccountFormViewModel
@{
    ViewBag.Title = "Editar Cuenta Contable";
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Actualizar Cuenta: " + Model.Account.Codigo,
    Subtitle = "Modificación de descriptivos y atributos de control del Libro Mayor.",
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Vercom", Url = "javascript: void(0);" },
        new() { Text = "Contabilidad", Url = "javascript: void(0);" },
        new() { Text = "Catálogo", Url = Url.Action("Index") },
        new() { Text = "Editar", IsActive = true }
    }
}' />

<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold"><i class="ti ti-edit me-2 text-primary"></i>Datos de la Cuenta</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" class="row g-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Account.Id" name="Account.Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Código de Cuenta</label>
                            <input asp-for="Account.Codigo" name="Account.Codigo" class="form-control fw-bold bg-light" readonly />
                            <small class="text-muted">Inalterable para trazabilidad.</small>
                        </div>

                        <div class="col-md-9">
                            <label class="form-label fw-bold">Nombre / Descripción</label>
                            <input asp-for="Account.Nombre" name="Account.Nombre" class="form-control" placeholder="Ej: Efectivo en Caja" required maxlength="200" />
                            <span asp-validation-for="Account.Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Cuenta Superior (Padre)</label>
                            <select asp-for="Account.CuentaPadreId" name="Account.CuentaPadreId" class="form-control form-select w-100 select2" asp-items="Model.CuentasPadre">
                                <option value="">-- Cuenta de Primer Nivel (Raíz) --</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Clase de Cuenta</label>
                            <select asp-for="Account.Clase" name="Account.Clase" class="form-control form-select w-100" asp-items="Model.Clases" required></select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Naturaleza</label>
                            <select asp-for="Account.Naturaleza" name="Account.Naturaleza" class="form-control form-select w-100" asp-items="Model.Naturalezas" required></select>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top">
                            <h6 class="text-muted tiny fw-bold text-uppercase mb-3">Atributos de Operatividad y Control</h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="form-check form-switch p-3 bg-light rounded-3">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Account.AceptaMovimiento">
                                        <label class="form-check-label fw-bold">Acepta Asientos Directos</label>
                                        <p class="text-muted tiny mb-0 mt-1">Cuenta de último nivel (Detalle).</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check form-switch p-3 bg-light rounded-3">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Account.RequiereCentroCosto">
                                        <label class="form-check-label fw-bold">Exigir Centro de Costo</label>
                                        <p class="text-muted tiny mb-0 mt-1">Integración con producción/gastos.</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check form-switch p-3 bg-light rounded-3">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Account.Activo">
                                        <label class="form-check-label fw-bold text-success">Cuenta Habilitada</label>
                                        <p class="text-muted tiny mb-0 mt-1">Disponible para operaciones.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">DESCARTAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
