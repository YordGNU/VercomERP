@model Vercom.ViewModels.AccountFormViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">@Model.Title</h4>
        <p class="text-muted small mb-0">Definición de estructura contable según normas oficiales (RF-10).</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Contabilidad</a></li>
            <li class="breadcrumb-item active">Nueva Cuenta</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card">
                    <div class="card-header">
                        <h5 class="m-0 fw-bold"><i class="ti ti-list-details me-2 text-primary"></i>Configuración de la Cuenta</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-3">
                                <label class="form-label">Código Contable</label>
                                <input asp-for="Account.Codigo" name="Account.Codigo" class="form-control w-100 fw-bold text-primary" placeholder="ej: 101.01" required />
                            </div>
                            <div class="col-md-9">
                                <label class="form-label">Nombre o Descripción</label>
                                <input asp-for="Account.Nombre" name="Account.Nombre" class="form-control w-100" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Cuenta Superior (Jerarquía)</label>
                                <select asp-for="Account.CuentaPadreId" name="Account.CuentaPadreId" class="form-control form-select w-100 select2" asp-items="Model.CuentasPadre">
                                    <option value="">-- Cuenta de Primer Nivel (Raíz) --</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Clase de Cuenta</label>
                                <select asp-for="Account.Clase" name="Account.Clase" class="form-control form-select w-100" asp-items="Model.Clases" required></select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Naturaleza</label>
                                <select asp-for="Account.Naturaleza" name="Account.Naturaleza" class="form-control form-select w-100" asp-items="Model.Naturalezas" required></select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Moneda Base</label>
                                <select asp-for="Account.Moneda" name="Account.Moneda" class="form-control form-select w-100">
                                    <option value="CUP">CUP - Pesos Cubanos</option>
                                    <option value="USD">USD - Moneda Libremente Conv.</option>
                                </select>
                            </div>

                            <div class="col-md-4 d-flex align-items-end pb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Account.AceptaMovimiento" name="Account.AceptaMovimiento" checked>
                                    <label class="form-check-label fw-bold">Acepta Asientos Directos</label>
                                </div>
                            </div>

                            <div class="col-md-4 d-flex align-items-end pb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Account.RequiereCentroCosto" name="Account.RequiereCentroCosto">
                                    <label class="form-check-label fw-bold">Exigir Centro de Costo</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline px-4">DESCARTAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy"></i> GUARDAR CUENTA
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
