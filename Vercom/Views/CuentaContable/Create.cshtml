@model Vercom.ViewModels.AccountFormViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">@Model.Title</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <form asp-action="Create" method="post">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light-subtle">
                        <h5 class="card-title mb-0">Estructura del Nomenclador (RF-10)</h5>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="Account.Codigo" class="form-label fw-bold">Código de Cuenta</label>
                                <input asp-for="Account.Codigo" name="Account.Codigo" class="form-control" placeholder="ej: 101.01" required />
                            </div>
                            <div class="col-md-9">
                                <label asp-for="Account.Nombre" class="form-label fw-bold">Nombre / Descripción</label>
                                <input asp-for="Account.Nombre" name="Account.Nombre" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Account.CuentaPadreId" class="form-label fw-bold">Cuenta Superior (Jerarquía)</label>
                                <select asp-for="Account.CuentaPadreId" name="Account.CuentaPadreId" class="form-select select2" asp-items="Model.CuentasPadre">
                                    <option value="">-- Cuenta de Primer Nivel --</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Account.Clase" class="form-label fw-bold">Clase</label>
                                <select asp-for="Account.Clase" name="Account.Clase" class="form-select" asp-items="Model.Clases" required></select>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Account.Naturaleza" class="form-label fw-bold">Naturaleza</label>
                                <select asp-for="Account.Naturaleza" name="Account.Naturaleza" class="form-select" asp-items="Model.Naturalezas" required></select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Account.Moneda" class="form-label fw-bold">Moneda Base</label>
                                <select asp-for="Account.Moneda" name="Account.Moneda" class="form-select">
                                    <option value="CUP">CUP - Pesos Cubanos</option>
                                    <option value="USD">USD - Dólar Estadounidense</option>
                                </select>
                            </div>

                            <div class="col-md-4 d-flex align-items-end pb-1">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Account.AceptaMovimiento" name="Account.AceptaMovimiento" checked>
                                    <label class="form-check-label fw-bold" asp-for="Account.AceptaMovimiento">Acepta Asientos (Registro)</label>
                                </div>
                            </div>

                            <div class="col-md-4 d-flex align-items-end pb-1">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Account.RequiereCentroCosto" name="Account.RequiereCentroCosto">
                                    <label class="form-check-label fw-bold" asp-for="Account.RequiereCentroCosto">Exige Centro Costo</label>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Descartar</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR CUENTA
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
