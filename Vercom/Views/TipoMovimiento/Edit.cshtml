@model Vercom.Models.TipoMovimiento

@{
    ViewData["Title"] = "Edit";
}



<h4>TipoMovimiento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
       @{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Inventario", Title = "Editar TipoMovimiento", Subtitle = "", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h4 class="card-title">Formulario de Edición</h4>
                </div>
                <div class="card-body">
<form class="row g-3" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" />
                <span asp-validation-for="Codigo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Naturaleza" class="form-label"></label>
                <input asp-for="Naturaleza" class="form-control" />
                <span asp-validation-for="Naturaleza" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="AfectaCosto" /> @Html.DisplayNameFor(model => model.AfectaCosto)
                </label>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

