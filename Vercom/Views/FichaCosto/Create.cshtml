@model Vercom.ViewModels.CostSheetCreateViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">@Model.Title</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <form asp-action="Create" method="post">
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-light-subtle">
                        <h4 class="card-title">Cálculo de Costo Unitario (PPP)</h4>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="CostSheet.ProductoId" class="form-label fw-bold">Producto Elaborado</label>
                                <select asp-for="CostSheet.ProductoId" name="CostSheet.ProductoId" class="form-select" asp-items="Model.ProductosElaborados" required>
                                    <option value="">-- Seleccione Producto --</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="CostSheet.CostoMateriaPrima" class="form-label fw-bold">Materia Prima ($)</label>
                                <input asp-for="CostSheet.CostoMateriaPrima" name="CostSheet.CostoMateriaPrima" class="form-control text-end" step="0.0001" required />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="CostSheet.CostoManoObra" class="form-label fw-bold">Mano de Obra ($)</label>
                                <input asp-for="CostSheet.CostoManoObra" name="CostSheet.CostoManoObra" class="form-control text-end" step="0.0001" required />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="CostSheet.GastosIndirectos" class="form-label fw-bold">Indirectos / GIF ($)</label>
                                <input asp-for="CostSheet.GastosIndirectos" name="CostSheet.GastosIndirectos" class="form-control text-end" step="0.0001" required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CostSheet.VigenteDesde" class="form-label fw-bold">Vigente Desde</label>
                                <input asp-for="CostSheet.VigenteDesde" name="CostSheet.VigenteDesde" type="date" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CostSheet.MargenPorcentaje" class="form-label fw-bold">Margen de Utilidad (%)</label>
                                <input asp-for="CostSheet.MargenPorcentaje" name="CostSheet.MargenPorcentaje" class="form-control text-end" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">
                        <h4 class="card-title mb-0">Resumen de Formación</h4>
                    </div>
                    <div class="card-body">
                        <div class="text-center py-3">
                            <h6 class="text-muted text-uppercase small">Precio Sugerido (Venta)</h6>
                            <h2 class="fw-bold text-primary" id="lblPrecioSugerido">$ 0.00</h2>
                        </div>
                        <hr>
                        <p class="small text-muted italic">RF-40: La creación de una nueva ficha marcará la anterior como HISTÓRICA automáticamente.</p>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="ti ti-device-floppy me-1"></i> ACTIVAR FICHA
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function calculate() {
            const mp = parseFloat(document.getElementsByName('CostSheet.CostoMateriaPrima')[0].value || 0);
            const mo = parseFloat(document.getElementsByName('CostSheet.CostoManoObra')[0].value || 0);
            const gif = parseFloat(document.getElementsByName('CostSheet.GastosIndirectos')[0].value || 0);
            const margin = parseFloat(document.getElementsByName('CostSheet.MargenPorcentaje')[0].value || 0);

            const totalCost = mp + mo + gif;
            const price = totalCost * (1 + (margin / 100));

            document.getElementById('lblPrecioSugerido').innerText = price.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        }

        document.querySelectorAll('input').forEach(i => i.addEventListener('input', calculate));
        document.addEventListener('DOMContentLoaded', calculate);
    </script>
}
