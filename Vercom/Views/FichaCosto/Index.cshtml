@model IEnumerable<Vercom.Models.FichaCosto>
@{
    ViewBag.Title = "Fichas de Costo";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Ingeniería de Costos (MFP)</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Nueva Ficha de Costo
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="dataTable" class="table table-hover align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Producto Elaborado</th>
                            <th class="text-center">Versión</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Costo Estándar</th>
                            <th class="text-end">Precio Sugerido</th>
                            <th class="text-center">Margen</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Estado == "VIGENTE" ? "badge bg-success" : "badge bg-secondary-subtle text-secondary";

                            <tr>
                                <td class="fw-bold">@item.Producto.Nombre</td>
                                <td class="text-center"><span class="badge border">v.@item.Version</span></td>
                                <td class="text-center"><span class="@statusClass">@item.Estado</span></td>
                                <td class="text-end fw-bold">@item.CostoTotalUnitario?.ToString("C")</td>
                                <td class="text-end text-primary fw-bold">@item.PrecioSugerido?.ToString("C")</td>
                                <td class="text-center">@item.MargenPorcentaje%</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-eye"></i></a>
                                        @if(item.Estado == "VIGENTE") {
                                            <a asp-action="Create" asp-route-productoId="@item.ProductoId" class="btn btn-xs btn-light text-primary" title="Nueva Versión"><i class="ti ti-copy"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        .ready(function () {
            #dataTable.DataTable();
        });
    </script>
}
