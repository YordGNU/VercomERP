@model IEnumerable<VERCOM.Models.FichaCosto>
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewBag.Title = "Ingeniería de Costos"; }

@{ var canCreate = (await AuthorizationService.AuthorizeAsync(User, null, "PRODUCCION.FICHA.CREAR")).Succeeded; var headerActions = canCreate ? "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-file-analytics me-1'></i> NUEVA FICHA DE COSTO</a>" : null; var pageHeader = new VERCOM.ViewModels.PageHeaderModel { Eyebrow = "Producción", Title = "Gestión de Fichas de Costo (MFP)", Subtitle = "Definición de precios de venta basados en costos de insumos, mano de obra y gastos indirectos.", Icon = "ti-file-analytics", ActionsHtml = headerActions != null ? new Microsoft.AspNetCore.Html.HtmlString(headerActions) : null }; }
<partial name='_PageHeader' model='pageHeader' />
<div class="row">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle">
            <h5 class="m-0 fw-bold"><i class="ti ti-table me-2 text-primary"></i>Catálogo de Fichas Versionadas</h5>
        </div>
        <div class="card-body">
              <table id="costSheetsTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th>Producto Elaborado</th>
                          <th>Versión</th>
                          <th>Estado</th>
                            <th>Costo Estándar ($)</th>
                            <th>Precio Sugerido ($)</th>
                          <th>Utilidad (%)</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isVigente = item.Estado == "VIGENTE";
                            var canApprove = item.Estado == "BORRADOR" && (await AuthorizationService.AuthorizeAsync(User, null, "PRODUCCION.FICHA.APROBAR")).Succeeded;
                            <tr>
                                <td>
                                    <div class="fw-bold fs-14">@item.Producto.Nombre</div>
                                    <small class="text-muted tiny font-monospace">@item.Producto.Codigo</small>
                                </td>
                                <td >
                                    <span class="badge border border-primary text-primary px-2">v.@item.Version</span>
                                </td>
                                <td >
                                    <span class="badge @(isVigente ? "bg-success" : "bg-light text-muted") px-3 py-1">@item.Estado</span>
                                </td>
                               <td class="fw-bold">@item.CostoTotalUnitario?.ToString("N2")</td>
                               <td class="text-primary fw-bold">@item.PrecioSugerido?.ToString("N2")</td>
                                <td fw-bold text-success">@item.MargenPorcentaje%</td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Ver Detalle">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <form asp-action="BuildFromBom" asp-route-productId="@item.ProductoId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline py-1 px-2 text-info" title="Generar ficha desde BOM"><i class="ti ti-wand"></i></button>
                                        </form>
                                        @if (canApprove)
                                        {
                                            <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2" title="Aprobar ficha"><i class="ti ti-check"></i></button>
                                            </form>
                                        }
                                        @if (isVigente)
                                        {
                                            <a asp-action="Create" asp-route-productoId="@item.ProductoId" class="btn btn-sm btn-outline py-1 px-2 text-primary" title="Nueva Versión">
                                                <i class="ti ti-copy"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
           </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#costSheetsTable').DataTable({
                 pageLength: 100,
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
            });
        });
    </script>
}
