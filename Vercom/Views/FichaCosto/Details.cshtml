@model Vercom.Models.FichaCosto
@{
    ViewBag.Title = "Ficha de Costo v." + Model.Version;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Ficha de Costo Estándar: @Model.Producto.Nombre</h4>
    </div>
    <div class="text-end d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Volver al Maestro</a>
        <button onclick="window.print()" class="btn btn-sm btn-light"><i class="ti ti-printer me-1"></i> Imprimir</button>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        <!-- Resumen de Costos -->
        <div class="col-lg-4">
            <div class="card bg-primary-subtle border-0 shadow-sm mb-4">
                <div class="card-body p-4 text-center">
                    <h5 class="text-primary text-uppercase small fw-bold">Costo Total Unitario</h5>
                    <h1 class="display-5 fw-bold text-primary mb-1">@Model.CostoTotalUnitario?.ToString("C")</h1>
                    <p class="text-muted small">CUP por @Model.Producto.UnidadMedida.Nombre</p>
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Margen de Utilidad:</span>
                        <span class="fw-bold">@Model.MargenPorcentaje%</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="fs-16">Precio Sugerido:</span>
                        <span class="fw-bold text-dark fs-16">@Model.PrecioSugerido?.ToString("C")</span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h4 class="card-title">Metadatos de Ingeniería</h4></div>
                <div class="card-body small">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Versión:</span> <span class="badge border">@Model.Version</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Estado:</span> <span class="badge @(Model.Estado == "VIGENTE" ? "bg-success" : "bg-secondary")">@Model.Estado</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Vigente Desde:</span> <span>@Model.VigenteDesde.ToString("dd/MM/yyyy")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Creado Por:</span> <span class="text-muted">@Model.CreadoPor</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Desglose Metodológico MFP -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header"><h4 class="card-title">Estructura del Costo (Metodología MFP)</h4></div>
                <div class="card-body p-0">
                    <table class="table table-bordered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Componente de Gasto</th>
                                <th width="150" class="text-end">Importe Unitario</th>
                                <th width="120" class="text-center">Porcentaje</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold">1. Materias Primas y Materiales</td>
                                <td class="text-end">@Model.CostoMateriaPrima.ToString("N4")</td>
                                <td class="text-center text-muted">@((Model.CostoMateriaPrima / Model.CostoTotalUnitario * 100)?.ToString("N1"))%</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">2. Mano de Obra Directa</td>
                                <td class="text-end">@Model.CostoManoObra.ToString("N4")</td>
                                <td class="text-center text-muted">@((Model.CostoManoObra / Model.CostoTotalUnitario * 100)?.ToString("N1"))%</td>
                            </tr>
                            <tr>
                                <td class="fw-bold">3. Gastos Indirectos de Fabricación (GIF)</td>
                                <td class="text-end">@Model.GastosIndirectos.ToString("N4")</td>
                                <td class="text-center text-muted">@((Model.GastosIndirectos / Model.CostoTotalUnitario * 100)?.ToString("N1"))%</td>
                            </tr>
                        </tbody>
                        <tfoot class="table-dark fs-16">
                            <tr>
                                <td>COSTO TOTAL DE PRODUCCIÓN</td>
                                <td class="text-end">@Model.CostoTotalUnitario?.ToString("N4")</td>
                                <td class="text-center">100.0%</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Alerta Informativa -->
            <div class="alert alert-info mt-4">
                <i class="ti ti-info-circle me-1"></i> Esta ficha se utiliza como base para calcular desviaciones en las Órdenes de Producción.
            </div>
        </div>
    </div>
</div>
