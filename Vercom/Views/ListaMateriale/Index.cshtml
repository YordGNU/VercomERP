@model IEnumerable<Vercom.Models.ListaMateriale>
@{
    ViewBag.Title = "Lista de Materiales (BOM)";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Estructura de Productos (BOM)</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-binary me-1"></i> Nueva Definición de Insumos
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4 mb-4">
                <div class="card h-100 border-start border-primary border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h4 class="card-title mb-1">@item.ProductoTerminado.Nombre</h4>
                                <span class="badge @(item.Activa ? "bg-success" : "bg-light text-dark")">@(item.Activa ? "ACTIVA" : "HISTÓRICA")</span>
                            </div>
                            <div class="avatar-sm bg-light text-primary rounded d-flex align-items-center justify-content-center">
                                <i class="ti ti-manual-gearbox fs-20"></i>
                            </div>
                        </div>

                        <p class="small text-muted mb-4">
                            Versión: <strong>v.@item.Version</strong><br>
                            Definida el: @item.CreadoEn.ToString("dd/MM/yyyy")
                        </p>

                        <div class="d-grid gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Ver Explosión de Materiales</a>
                            @if(item.Activa) {
                                <a asp-controller="Production" asp-action="CreateOrder" asp-route-productId="@item.ProductoTerminadoId" class="btn btn-sm btn-light text-primary">Generar Orden de Producción</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted small">
                No hay listas de materiales definidas. Empiece definiendo la composición de sus productos elaborados.
            </div>
        }
    </div>
</div>
