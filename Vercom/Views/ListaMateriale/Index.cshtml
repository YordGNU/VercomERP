@model IEnumerable<VERCOM.Models.ListaMateriale>
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewBag.Title = "Lista de Materiales (BOM)"; }

@{ var canCreate = (await AuthorizationService.AuthorizeAsync(User, null, "PRODUCCION.BOM.CREAR")).Succeeded; var headerActions = canCreate ? "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> NUEVA LISTA</a>" : null; var pageHeader = new VERCOM.ViewModels.PageHeaderModel { Eyebrow = "Producción", Title = "Ingeniería: Estructura de Productos (BOM)", Subtitle = "Definición de composición y requerimientos de insumos para la fabricación.", Icon = "ti-layers-intersect", ActionsHtml = headerActions != null ? new Microsoft.AspNetCore.Html.HtmlString(headerActions) : null }; }
<partial name='_PageHeader' model='pageHeader' /><div class="container-xxl mt-4">
    <div class="row row-cards">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card card-sm shadow-sm border-0 border-top border-primary border-3">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h4 class="card-title fw-bold mb-1">@item.ProductoTerminado.Nombre</h4>
                                <span class="badge @(item.Activa ? "badge-soft-success" : "badge-soft-secondary") px-3">
                                    <i class="ti ti-circle-filled me-1"></i> @(item.Activa ? "VERSIÓN ACTIVA" : "HISTÓRICA")
                                </span>
                            </div>
                            <div class="avatar bg-primary-subtle text-primary rounded">
                                <i class="ti ti-assembly fs-24"></i>
                            </div>
                        </div>

                        <div class="bg-light-subtle rounded-3 p-3 mb-4 border border-dashed">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted small fw-bold">VERSIÓN:</span>
                                <span class="fw-bold">v.@item.Version</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted small fw-bold">DEFINIDA EL:</span>
                                <span class="small">@item.CreadoEn.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="ti ti-list me-1"></i> VER EXPLOSIÓN DE MATERIALES
                            </a>
                            @if ((await AuthorizationService.AuthorizeAsync(User, null, "PRODUCCION.BOM.EDITAR")).Succeeded)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="ti ti-copy me-1"></i> CREAR NUEVA VERSIÓN
                                </a>
                            }
                            @if(item.Activa) {
                                <a asp-controller="Production" asp-action="CreateOrder" asp-route-productId="@item.ProductoTerminadoId" class="btn btn-sm btn-ghost-primary">
                                    <i class="ti ti-player-play me-1"></i> GENERAR ORDEN DE TRABAJO
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            var emptyState = new VERCOM.ViewModels.EmptyStateModel { Icon = "ti-binary", Title = "No hay estructuras definidas", Description = "Empiece definiendo la composición de sus productos elaborados para controlar el consumo de insumos.", ActionHtml = new Microsoft.AspNetCore.Html.HtmlString("<a href='" + Url.Action("Create") + "' class='btn btn-primary mt-3'>CREAR MI PRIMERA BOM</a>") };
            <partial name="_EmptyState" model="emptyState" />
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Inicializar DataTables si fuera necesario en el futuro para esta vista
        });
    </script>
}
