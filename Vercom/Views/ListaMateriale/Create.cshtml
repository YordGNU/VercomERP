@model VERCOM.ViewModels.BomCreateViewModel
@{
    ViewBag.Title = Model.Title;
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> BOM</a>"; var pageHeader = new VERCOM.ViewModels.PageHeaderModel { Eyebrow = "Producción", Title = Model.Title, Subtitle = "Configuración de la hoja de ruta de materiales y normas de consumo.", Icon = "ti-file", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <form asp-action="@(Model.Bom.Id == Guid.Empty ? "Create" : "Edit")" asp-route-id="@(Model.Bom.Id == Guid.Empty ? null : Model.Bom.Id)" method="post" id="bomForm">
        @Html.AntiForgeryToken()
        @if (Model.Bom.Id != Guid.Empty)
        {
            <input type="hidden" asp-for="Bom.Id" />
        }
        <select id="bomInsumoOptions" class="d-none" asp-items="Model.InsumosDisponibles" aria-hidden="true">
            <option value="">-- Seleccione insumo --</option>
        </select>
        <div class="row">
            <!-- Encabezado de la Estructura -->
            <div class="col-lg-12 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="row g-4 align-items-end">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Producto Terminado / Elaborado</label>
                                <select asp-for="Bom.ProductoTerminadoId" name="Bom.ProductoTerminadoId" class="form-control form-select w-100 select2" asp-items="Model.ProductosElaborados" required>
                                    <option value="">-- Seleccione el producto final --</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold">Versión</label>
                                <input asp-for="Bom.Version" name="Bom.Version" class="form-control fw-bold text-center" value="1" required />
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch p-2 bg-light-subtle rounded border border-dashed">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Bom.Activa" name="Bom.Activa" checked>
                                    <label class="form-check-label fw-bold" asp-for="Bom.Activa">Activar automáticamente</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detalle de Partidas (Explosión) -->
            <div class="col-lg-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center py-3">
                        <h5 class="m-0 fw-bold"><i class="ti ti-components me-2 text-primary"></i>Materiales, Insumos y Envases</h5>
                        <button type="button" class="btn btn-sm btn-primary shadow-sm" onclick="addRow()">
                            <i class="ti ti-plus me-1"></i> AÑADIR INSUMO
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table table-hover mb-0" id="detailsTable">
                            <thead class="thead-sm text-uppercase fs-xxs">
                                    <tr>
                                        <th class="ps-4">Insumo / Materia Prima</th>
                                        <th>Cant. Neta (x 1 UN)</th>
                                        <th>Merma Est. (%)</th>
                                        <th class="pe-4">Observaciones del Componente</th>
                                        <th width="50"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var index = 0; index < Model.Bom.ListaMaterialesDetalles.Count; index++)
                                    {
                                        var detail = Model.Bom.ListaMaterialesDetalles.ElementAt(index);
                                        <tr>
                                            <td>
                                                <select name="Bom.ListaMaterialesDetalles[@index].ProductoInsumoId" class="form-select" required>
                                                    <option value="">-- Seleccione insumo --</option>
                                                    @foreach (var insumo in Model.InsumosDisponibles)
                                                    {
                                                        <option value="@insumo.Value" selected="@(insumo.Value == detail.ProductoInsumoId.ToString())">@insumo.Text</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input name="Bom.ListaMaterialesDetalles[@index].CantidadRequerida" type="number" min="0.0001" step="0.0001" value="@detail.CantidadRequerida" class="form-control" required /></td>
                                            <td><input name="Bom.ListaMaterialesDetalles[@index].PorcentajeMerma" type="number" min="0" step="0.01" value="@detail.PorcentajeMerma" class="form-control" required /></td>
                                            <td></td>
                                            <td><button type="button" class="btn btn-sm btn-outline-danger remove-row" title="Quitar insumo"><i class="ti ti-trash"></i></button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-light-subtle d-flex justify-content-between align-items-center p-4">
                        <div class="text-muted small">
                            <i class="ti ti-info-circle me-1"></i> El sistema escalará automáticamente estas cantidades al generar Órdenes de Producción.
                        </div>
                        <div class="btn-list">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR ESTRUCTURA
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function renumberRows() {
            document.querySelectorAll('#detailsTable tbody tr').forEach((row, index) => {
                row.querySelectorAll('[name]').forEach(input => {
                    input.name = input.name.replace(/Bom\.ListaMaterialesDetalles\[\d+\]/, `Bom.ListaMaterialesDetalles[${index}]`);
                });
            });
        }

        function addRow(productId = '', quantity = '', waste = '0') {
            const body = document.querySelector('#detailsTable tbody');
            const index = body.querySelectorAll('tr').length;
            const row = document.createElement('tr');
            const productCell = document.createElement('td');
            const product = document.createElement('select');
            product.className = 'form-select';
            product.name = `Bom.ListaMaterialesDetalles[${index}].ProductoInsumoId`;
            product.required = true;
            document.querySelectorAll('#bomInsumoOptions option').forEach(option => product.appendChild(option.cloneNode(true)));
            product.value = productId;
            productCell.appendChild(product);

            const quantityCell = document.createElement('td');
            const quantityInput = document.createElement('input');
            quantityInput.type = 'number';
            quantityInput.min = '0.0001';
            quantityInput.step = '0.0001';
            quantityInput.required = true;
            quantityInput.className = 'form-control';
            quantityInput.name = `Bom.ListaMaterialesDetalles[${index}].CantidadRequerida`;
            quantityInput.value = quantity;
            quantityCell.appendChild(quantityInput);

            const wasteCell = document.createElement('td');
            const wasteInput = document.createElement('input');
            wasteInput.type = 'number';
            wasteInput.min = '0';
            wasteInput.step = '0.01';
            wasteInput.required = true;
            wasteInput.className = 'form-control';
            wasteInput.name = `Bom.ListaMaterialesDetalles[${index}].PorcentajeMerma`;
            wasteInput.value = waste;
            wasteCell.appendChild(wasteInput);

            const notesCell = document.createElement('td');
            const removeCell = document.createElement('td');
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'btn btn-sm btn-outline-danger remove-row';
            remove.title = 'Quitar insumo';
            remove.innerHTML = '<i class="ti ti-trash"></i>';
            remove.addEventListener('click', () => { row.remove(); renumberRows(); });
            removeCell.appendChild(remove);

            row.append(productCell, quantityCell, wasteCell, notesCell, removeCell);
            body.appendChild(row);
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('#detailsTable tbody .remove-row').forEach(button => {
                button.addEventListener('click', () => { button.closest('tr').remove(); renumberRows(); });
            });
            if (document.querySelectorAll("#detailsTable tbody tr").length === 0) addRow();
            window.SubmitAjaxForm('bomForm');
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
