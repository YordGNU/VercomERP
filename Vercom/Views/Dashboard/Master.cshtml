@model Vercom.ViewModels.MasterDashboardViewModel
@{
    ViewBag.Title = "Monitor Maestro";
    string Money(decimal v) => v.ToString("N2");
    string AccionIcon(string a) => a switch { "LOGIN_FALLIDO" => "ti-lock-off", "ACCESO_DENEGADO" => "ti-door-exit", _ => "ti-shield" };
    string AccionCls(string a) => a switch { "LOGIN_FALLIDO" => "danger", "ACCESO_DENEGADO" => "warning", _ => "primary" };
}

@{
    var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Monitor Maestro", Subtitle = "Visión global de infraestructura, seguridad y entidades registradas en el ecosistema.", Icon = "ti-file", Tone = "primary" };
}
<partial name='_PageHeader' model='pageHeader' />

<!-- Fila 1: KPIs Globales -->
<div class="row row-cols-1 row-cols-md-2 row-cols-xxl-4 g-3 mb-3">
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold letter-spacing-1 mb-1">Empresas Activas</div>
                        <div class="fs-24 fw-bold text-primary">@Model.TotalEntidades</div>
                    </div>
                    <span class="avatar-md rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center">
                        <i class="ti ti-building-community fs-22"></i>
                    </span>
                </div>
                <hr class="my-3 opacity-50" />
                <div class="d-flex justify-content-between text-muted small">
                    <span>Ecosistema registrado</span>
                    <span class="@(Model.EntidadesPendientes > 0 ? "text-warning fw-bold" : "text-success")"><i class="ti @(Model.EntidadesPendientes > 0 ? "ti-alert-triangle" : "ti-circle-check") me-1"></i>@Model.EntidadesPendientes pendientes</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold letter-spacing-1 mb-1">Pendientes Aprobación</div>
                        <div class="fs-24 fw-bold text-warning">@Model.EntidadesPendientes</div>
                    </div>
                    <span class="avatar-md rounded-circle bg-warning bg-opacity-10 text-warning d-inline-flex align-items-center justify-content-center">
                        <i class="ti ti-clock-pause fs-22"></i>
                    </span>
                </div>
                <div class="mt-3">
                    @if (Model.EntidadesPendientes > 0)
                    {
                        <a asp-controller="Entidad" asp-action="Pending" class="btn btn-sm btn-outline-warning py-1">
                            Gestionar <i class="ti ti-arrow-right ms-1"></i>
                        </a>
                    }
                    else
                    {
                        <span class="badge badge-soft-success py-1"><i class="ti ti-circle-check me-1"></i>Sin solicitudes</span>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold letter-spacing-1 mb-1">Ventas Globales (Mes)</div>
                        <div class="fs-24 fw-bold text-success">@Money(Model.VentasGlobalesMes)</div>
                    </div>
                    <span class="avatar-md rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center">
                        <i class="ti ti-cash fs-22"></i>
                    </span>
                </div>
                <hr class="my-3 opacity-50" />
                <div class="d-flex justify-content-between text-muted small">
                    <span>Facturas emitidas</span>
                    <strong class="text-body">@Model.FacturasGlobalesMes</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold letter-spacing-1 mb-1">Sesiones POS Activas</div>
                        <div class="fs-24 fw-bold text-info">@Model.SesionesPosActivas</div>
                    </div>
                    <span class="avatar-md rounded-circle bg-info bg-opacity-10 text-info d-inline-flex align-items-center justify-content-center">
                        <i class="ti ti-device-laptop fs-22"></i>
                    </span>
                </div>
                <hr class="my-3 opacity-50" />
                <div class="d-flex justify-content-between text-muted small">
                    <span>Terminales registradas</span>
                    <strong class="text-body">@Model.DispositivosPos</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Fila 2: Salud POS -->
<div class="row row-cols-1 row-cols-md-3 g-3 mb-3">
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3 d-flex align-items-center gap-3">
                <span class="avatar-md rounded-circle @(Model.PosConflictos > 0 ? "bg-danger bg-opacity-10 text-danger" : "bg-success bg-opacity-10 text-success") d-inline-flex align-items-center justify-content-center">
                    <i class="ti ti-alert-triangle fs-22"></i>
                </span>
                <div>
                    <div class="fs-22 fw-bold @(Model.PosConflictos > 0 ? "text-danger" : "text-success")">@Model.PosConflictos</div>
                    <div class="text-muted small text-uppercase fw-bold letter-spacing-1" style="font-size: 0.7rem;">Conflictos de Sync</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3 d-flex align-items-center gap-3">
                <span class="avatar-md rounded-circle @(Model.PosPendientes > 0 ? "bg-warning bg-opacity-10 text-warning" : "bg-success bg-opacity-10 text-success") d-inline-flex align-items-center justify-content-center">
                    <i class="ti ti-refresh fs-22"></i>
                </span>
                <div>
                    <div class="fs-22 fw-bold @(Model.PosPendientes > 0 ? "text-warning" : "text-success")">@Model.PosPendientes</div>
                    <div class="text-muted small text-uppercase fw-bold letter-spacing-1" style="font-size: 0.7rem;">Ventas Pendientes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3 d-flex align-items-center gap-3">
                <span class="avatar-md rounded-circle bg-info bg-opacity-10 text-info d-inline-flex align-items-center justify-content-center">
                    <i class="ti ti-users fs-22"></i>
                </span>
                <div>
                    <div class="fs-22 fw-bold text-info">@Model.UsuariosTotales</div>
                    <div class="text-muted small text-uppercase fw-bold letter-spacing-1" style="font-size: 0.7rem;">Usuarios del Sistema</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <!-- Columna Izquierda: Ranking de Entidades + Sesiones POS -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold text-success"><i class="ti ti-trophy me-2"></i>Entidades con Mayor Volumen (Mes)</h5>
            </div>
            <div class="card-body">
                @if (Model.TopEntidades.Any())
                {
                    var maxVentas = Model.TopEntidades.Max(e => e.Ventas);
                    var medalColors = new[] { "bg-primary", "bg-info", "bg-success", "bg-secondary" };
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-hover mb-0">
                            <thead class="thead-sm text-uppercase fs-xxs text-muted">
                                <tr>
                                    <th>#</th>
                                    <th>Entidad</th>
                                    <th class="text-center">Facturas</th>
                                    <th class="text-end">Ventas</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var pos = 1; }
                                @foreach (var e in Model.TopEntidades)
                                {
                                    var pct = maxVentas > 0 ? (double)(e.Ventas / maxVentas * 100) : 0;
                                    var medal = medalColors[(pos - 1) % medalColors.Length];
                                    <tr>
                                        <td><span class="avatar-sm rounded-circle @medal text-white d-inline-flex align-items-center justify-content-center fw-bold small">@pos</span></td>
                                        <td class="fw-bold">@e.Nombre</td>
                                        <td class="text-center"><span class="badge badge-soft-info">@e.Facturas</span></td>
                                        <td class="text-end fw-bold">@Money(e.Ventas)</td>
                                    </tr>
                                    <tr class="border-0">
                                        <td colspan="4" class="pt-0 pb-2 pe-3">
                                            <div class="progress" style="height: 4px;">
                                                <div class="progress-bar bg-success" style="width: @pct.ToString("N0")%"></div>
                                            </div>
                                        </td>
                                    </tr>
                                    pos++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="ti ti-chart-bar-off fs-32 d-block mb-2 opacity-50"></i>
                        Sin ventas registradas este mes en el ecosistema.
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold text-primary"><i class="ti ti-device-laptop me-2"></i>Sesiones POS Abiertas</h5>
                <a asp-controller="PosVentaPendiente" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="ti ti-list me-1"></i> Ver Pendientes</a>
            </div>
            <div class="card-body">
                @if (Model.SesionesPos.Any())
                {
                    <div data-simplebar style="max-height: 360px;">
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table table-hover mb-0">
                                <thead class="thead-sm text-uppercase fs-xxs text-muted">
                                    <tr>
                                        <th>Entidad</th>
                                        <th>Terminal</th>
                                        <th>Cajero</th>
                                        <th class="text-center">Apertura</th>
                                        <th class="text-end">Ventas</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.SesionesPos)
                                    {
                                        <tr>
                                            <td class="small text-muted">@s.Entidad</td>
                                            <td class="fw-bold"><i class="ti ti-device-desktop me-2 text-muted"></i>@s.Dispositivo</td>
                                            <td>@s.Cajero</td>
                                            <td class="text-center small">@s.FechaApertura.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                            <td class="text-end fw-bold text-success">@Money(s.TotalVentas)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="ti ti-device-desktop-off fs-32 d-block mb-2 opacity-50"></i>
                        No hay sesiones POS abiertas.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Columna Derecha: Seguridad + Infraestructura -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold text-danger"><i class="ti ti-shield-exclamation me-2"></i>Alertas de Seguridad</h5>
                <a asp-controller="Admin" asp-action="AuditLogs" class="btn btn-sm btn-outline-secondary">Bitácora</a>
            </div>
            <div class="card-body">
                <div data-simplebar style="max-height: 260px;">
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-hover mb-0">
                            <thead class="thead-sm text-uppercase fs-xxs text-muted">
                                <tr>
                                    <th>Evento</th>
                                    <th>Usuario</th>
                                    <th>Fecha/Hora</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in Model.AlertasSeguridad)
                                {
                                    <tr>
                                        <td><span class="badge badge-soft-@(AccionCls(alert.Accion))"><i class="ti @(AccionIcon(alert.Accion)) me-1"></i>@alert.Accion</span></td>
                                        <td class="fw-bold small">@alert.NombreUsuario</td>
                                        <td class="small">@alert.OcurridoEn.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                    </tr>
                                }
                                @if (!Model.AlertasSeguridad.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted small">
                                            <i class="ti ti-shield-check fs-32 d-block mb-2 text-success opacity-50"></i>
                                            Sin incidentes críticos recientes.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h5 class="m-0 fw-bold text-primary"><i class="ti ti-database-export me-2"></i>Respaldo de Datos</h5>
            </div>
            <div class="card-body">
                @if (Model.UltimoBackup != null)
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="avatar-md rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center">
                            <i class="ti ti-check fs-22"></i>
                        </span>
                        <div>
                            <div class="fw-bold">Sistema Protegido</div>
                            <div class="text-muted small">áltimo backup: @Model.UltimoBackup.FinalizadoEn?.ToString("dd MMM, HH:mm")</div>
                        </div>
                    </div>
                    <div class="bg-light-subtle p-3 rounded mb-3 small">
                        <p class="mb-1"><strong>Archivo:</strong> @System.IO.Path.GetFileName(Model.UltimoBackup.RutaArchivo)</p>
                        <p class="mb-0"><strong>Tamaño:</strong> @((Model.UltimoBackup.TamanoBytes / 1024.0 / 1024.0)?.ToString("N2")) MB</p>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                        <i class="ti ti-alert-circle fs-20 me-2"></i>
                        <div>No hay registros de backups exitosos.</div>
                    </div>
                }
                <div class="d-grid">
                    <a asp-controller="Admin" asp-action="Backups" class="btn btn-primary py-2 shadow-sm">
                        <i class="ti ti-player-play me-1"></i> EJECUTAR RESPALDO GLOBAL
                    </a>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center gap-2">
                <h5 class="m-0 fw-bold text-warning"><i class="ti ti-clock-exclamation me-2"></i>Vencimientos Próximos</h5>
                @if (Model.AlertasVencimiento.Any())
                {
                    <span class="badge badge-soft-danger ms-auto">@Model.AlertasVencimiento.Count</span>
                }
            </div>
            <div class="card-body">
                <div data-simplebar style="max-height: 280px;">
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table small mb-0">
                            <thead class="thead-sm text-uppercase fs-xxs text-muted">
                                <tr>
                                    <th>Producto</th>
                                    <th>Vence</th>
                                    <th>Lote</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in Model.AlertasVencimiento)
                                {
                                    <tr>
                                        <td class="fw-bold">@alert.Producto?.Nombre</td>
                                        <td class="text-danger fw-bold">@alert.FechaVencimiento?.ToString("dd/MM/yyyy")</td>
                                        <td class="font-monospace tiny">@alert.Lote</td>
                                    </tr>
                                }
                                @if (!Model.AlertasVencimiento.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted small">
                                            <i class="ti ti-calendar-check fs-32 d-block mb-2 text-success opacity-50"></i>
                                            Sin alertas de caducidad.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <div class="card bg-dark text-white border-0 shadow-sm">
            <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center">
                    <i class="ti ti-rocket fs-48 text-primary me-3"></i>
                    <div>
                        <h4 class="fw-bold mb-1">Gestión de Clientes API</h4>
                        <p class="text-white-50 small mb-0">Configure tokens de acceso para aplicaciones de terceros o integraciones B2B.</p>
                    </div>
                </div>
                <a asp-controller="Api" asp-action="Index" class="btn btn-outline-light">CONFIGURAR INTEGRACIONES</a>
            </div>
        </div>
    </div>
</div>