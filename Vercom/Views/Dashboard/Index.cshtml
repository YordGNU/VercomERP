@model Vercom.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Panel de Control";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Dashboard de Gestión Inteligente</h4>
    </div>
    <div class="text-end">
        <span class="badge bg-light text-dark py-2 px-3 border">
            <i class="ti ti-calendar me-1"></i> Periodo Actual: @Model.PeriodoActual
        </span>
    </div>
</div>

<div class="container-xxl mt-4">
    <!-- Fila 1: KPIs Principales -->
    <div class="row">
        <div class="col-md-3">
            <div class="card overflow-hidden shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-1 text-primary">@Model.Liquidez.ToString("N2")</h3>
                            <p class="text-muted mb-0 small text-uppercase fw-bold">Liquidez Corriente</p>
                        </div>
                        <div class="avatar-md bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center">
                            <i class="ti ti-cash fs-24"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card overflow-hidden shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-1 text-success">@Model.Rentabilidad.ToString("N2")%</h3>
                            <p class="text-muted mb-0 small text-uppercase fw-bold">Margen de Utilidad</p>
                        </div>
                        <div class="avatar-md bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center">
                            <i class="ti ti-chart-pie fs-24"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card overflow-hidden shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-1 text-info">@Model.RotacionStock.ToString("N2")</h3>
                            <p class="text-muted mb-0 small text-uppercase fw-bold">Rotación Stock</p>
                        </div>
                        <div class="avatar-md bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center">
                            <i class="ti ti-refresh fs-24"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-1 text-white">@Model.FechaCierreCaja</h3>
                            <p class="text-white-50 mb-0 small text-uppercase fw-bold">Cierre de Caja Hoy</p>
                        </div>
                        <i class="ti ti-device-laptop fs-32 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 2: Gráficos de Tendencia BI -->
    <div class="row mt-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0">Evolución de Rentabilidad (Últimos 6 meses)</h5>
                </div>
                <div class="card-body">
                    <canvas id="profitTrendChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0">Tendencia de Liquidez</h5>
                </div>
                <div class="card-body">
                    <canvas id="liquidityTrendChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <!-- Acciones Críticas -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 text-danger">Alertas de Almacén Críticas</h5>
                    <a asp-controller="Inventory" asp-action="LowStock" class="btn btn-xs btn-outline-danger">Ver todo</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="dataTable" class="table table-hover align-middle w-100">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Actual</th>
                                    <th class="text-center">Mínimo</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.AlertasStock.Any())
                                {
                                    @foreach (var alert in Model.AlertasStock)
                                    {
                                        <tr>
                                            <td class="fw-bold">@alert.Producto.Nombre</td>
                                            <td class="text-center text-danger">@alert.Cantidad.ToString("N0")</td>
                                            <td class="text-center">@alert.StockMinimo.ToString("N0")</td>
                                            <td class="text-end">
                                                <a asp-controller="Purchase" asp-action="Create" class="btn btn-xs btn-outline-primary">Comprar</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="text-center">
                                        <td colspan="4" class="py-4 text-muted small">No se detectan faltantes críticos.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white"><h5 class="card-title mb-0">Acciones Directas</h5></div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-controller="Sales" asp-action="Create" class="btn btn-primary">
                            <i class="ti ti-plus me-1"></i> Nueva Venta Fiscal
                        </a>
                        <a asp-controller="Inventory" asp-action="CreateMovement" class="btn btn-outline-secondary">
                            <i class="ti ti-download me-1"></i> Recepción de Insumos
                        </a>
                        <a asp-controller="AsientoContable" asp-action="Create" class="btn btn-outline-info">
                            <i class="ti ti-calculator me-1"></i> Asiento Manual
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctxProfit = document.getElementById('profitTrendChart').getContext('2d');
        const profitData = @Html.Raw(Json.Serialize(Model.TrendRentabilidad));

        new Chart(ctxProfit, {
            type: 'line',
            data: {
                labels: ['M-5', 'M-4', 'M-3', 'M-2', 'M-1', 'Actual'],
                datasets: [{
                    label: 'Rentabilidad (%)',
                    data: profitData,
                    borderColor: '#22c55e',
                    backgroundColor: 'rgba(34, 197, 94, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });

        const ctxLiq = document.getElementById('liquidityTrendChart').getContext('2d');
        const liqData = @Html.Raw(Json.Serialize(Model.TrendLiquidez));

        new Chart(ctxLiq, {
            type: 'bar',
            data: {
                labels: ['M-5', 'M-4', 'M-3', 'M-2', 'M-1', 'Actual'],
                datasets: [{
                    label: 'Liquidez (Veces)',
                    data: liqData,
                    backgroundColor: '#3b82f6',
                    borderRadius: 5
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });
    </script>
}
