@model Vercom.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Panel de Control";
    string Num(decimal? v, string fmt = "N2") => v.HasValue ? v.Value.ToString(fmt) : "—";
    string Money(decimal v) => v.ToString("N2");
    string ActIcon(string a) => a switch { "INSERT" => "ti-plus", "UPDATE" => "ti-pencil", "DELETE" => "ti-trash", _ => "ti-activity" };
    string ActColor(string a) => a switch { "INSERT" => "success", "UPDATE" => "primary", "DELETE" => "danger", _ => "secondary" };
    string TablaCorta(string t) => string.IsNullOrEmpty(t) ? t : t.Substring(t.LastIndexOf('.') + 1);
}

@{
    var rangoBtns = new (string Key, string Label)[] { ("hoy", "Hoy"), ("7d", "7 días"), ("30d", "30 días"), ("mes", "Mes"), ("trimestre", "Trimestre") };
    var sbHeader = new System.Text.StringBuilder();
    sbHeader.Append("<span class=\"badge badge-soft-info py-2 px-3 me-2\"><i class=\"ti ti-calendar me-1\"></i> ").Append(Model.PeriodoActual).Append("</span>");
    sbHeader.Append("<div class=\"btn-group btn-group-sm me-2\" role=\"group\" aria-label=\"Rango de fechas\">");
    foreach (var rb in rangoBtns)
    {
        var rbUrl = Url.Action("Index", "Dashboard", new { rango = rb.Key });
        var rbActive = Model.Rango == rb.Key ? " active" : "";
        sbHeader.Append("<a class=\"btn btn-outline-secondary").Append(rbActive).Append("\" href=\"").Append(rbUrl).Append("\">").Append(rb.Label).Append("</a>");
    }
    sbHeader.Append("</div>");
    sbHeader.Append("<a href=\"").Append(Url.Action("Index", "Dashboard", new { rango = Model.Rango })).Append("\" class=\"btn btn-sm btn-outline-secondary\" title=\"Recargar datos\" data-bs-toggle=\"tooltip\"><i class=\"ti ti-refresh\"></i></a>");
    var headerActions = sbHeader.ToString();
    var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Panel", Title = "Panel de Control", Subtitle = "Indicadores clave de rendimiento y monitoreo operativo en tiempo real.", Icon = "ti-gauge", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) };
}
<partial name='_PageHeader' model='pageHeader' />



@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="ti ti-info-circle fs-20 me-2"></i>
        <div>@Model.Mensaje</div>
    </div>
}

@{
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : (hora < 19 ? "Buenas tardes" : "Buenas noches");
    var nombreUsuario = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    var entidadNombre = User.FindFirst("EntidadNombre")?.Value;
}

<!-- Resumen del día -->
<div class="card border-0 shadow-sm mb-3 overflow-hidden">
    <div class="card-body p-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-5">
                <h4 class="fw-bold mb-1">@saludo, @nombreUsuario</h4>
                <p class="text-muted mb-0">
                    @if (!string.IsNullOrWhiteSpace(entidadNombre))
                    {
                        <span><i class="ti ti-building-store me-1"></i>@entidadNombre</span>
                        <span class="mx-2 opacity-50">|</span>
                    }
                    <i class="ti ti-calendar-stats me-1"></i>@Model.PeriodoActual
                </p>
            </div>
            <div class="col-lg-7">
                <div class="row row-cols-2 row-cols-md-4 g-2">
                    <div class="col">
                        <div class="p-2 px-3 rounded bg-primary-subtle h-100">
                            <div class="text-muted small">Ventas Hoy</div>
                            <div class="fw-bold text-primary fs-16">@Money(Model.VentasHoy)</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="p-2 px-3 rounded bg-success-subtle h-100">
                            <div class="text-muted small">Facturas Hoy</div>
                            <div class="fw-bold text-success fs-16">@Model.FacturasHoy</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="p-2 px-3 rounded bg-info-subtle h-100">
                            <div class="text-muted small">Sesiones POS</div>
                            <div class="fw-bold text-info fs-16">@Model.PosSesionesAbiertas</div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="p-2 px-3 rounded @(Model.PosPendientesSync > 0 ? "bg-warning-subtle" : "bg-secondary-subtle") h-100">
                            <div class="text-muted small">Pendientes Sync</div>
                            <div class="fw-bold @(Model.PosPendientesSync > 0 ? "text-warning" : "text-secondary") fs-16">@Model.PosPendientesSync</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Fila 1: KPIs Comerciales -->
<div class="row row-cols-1 row-cols-md-2 row-cols-xxl-4 g-3 mb-3" id="bloque-comercial">
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold letter-spacing-1 mb-1">Ventas del Período</div>
                        <div class="fs-24 fw-bold text-primary">@Money(Model.VentasMes)</div>
                    </div>
                    <span class="avatar-md rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center">
                        <i class="ti ti-shopping-cart fs-22"></i>
                    </span>
                </div>
                <div class="mt-3">
                    <span class="badge @(Model.VariacionVentasPct >= 0 ? "badge-soft-success" : "badge-soft-danger") py-1">
                        <i class="ti @(Model.VariacionVentasPct >= 0 ? "ti-trending-up" : "ti-trending-down") me-1"></i>
                        @Model.VariacionVentasPct.ToString("N1")% vs período anterior
                    </span>
                </div>
                <div class="mt-2" style="height: 36px;">
                    <canvas id="ventasSparkChart"></canvas>
                </div>
                <hr class="my-3 opacity-50" />
                <div class="d-flex justify-content-between text-muted small">
                    <span>Hoy: <strong class="text-body">@Money(Model.VentasHoy)</strong></span>
                    <span>Facturas: <strong class="text-body">@Model.FacturasMes</strong></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold letter-spacing-1 mb-1">Posición de Efectivo</div>
                        <div class="fs-24 fw-bold text-success">@Money(Model.PosicionEfectivo)</div>
                    </div>
                    <span class="avatar-md rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center">
                        <i class="ti ti-wallet fs-22"></i>
                    </span>
                </div>
                <div class="mt-3">
                    <span class="badge badge-soft-light py-1"><i class="ti ti-building-bank me-1"></i>Liquidez inmediata</span>
                </div>
                <hr class="my-3 opacity-50" />
                <div class="d-flex justify-content-between text-muted small">
                    <span>Cajas: <strong class="text-body">@Money(Model.SaldoCajas)</strong></span>
                    <span>Bancos: <strong class="text-body">@Money(Model.SaldoBancos)</strong></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold letter-spacing-1 mb-1">Cuentas por Cobrar</div>
                        <div class="fs-24 fw-bold text-info">@Money(Model.PorCobrar)</div>
                    </div>
                    <span class="avatar-md rounded-circle bg-info bg-opacity-10 text-info d-inline-flex align-items-center justify-content-center">
                        <i class="ti ti-receipt fs-22"></i>
                    </span>
                </div>
                <div class="mt-3">
                    @if (Model.CxcVencido > 0)
                    {
                        <span class="badge badge-soft-danger py-1"><i class="ti ti-alert-triangle me-1"></i>Vencido: @Money(Model.CxcVencido)</span>
                    }
                    else
                    {
                        <span class="badge badge-soft-success py-1"><i class="ti ti-circle-check me-1"></i>Sin vencidos</span>
                    }
                </div>
                <hr class="my-3 opacity-50" />
                <div class="d-flex justify-content-between text-muted small">
                    <span>Por vencer: <strong class="text-body">@Money(Model.CxcPorVencer)</strong></span>
                    <span>Días cobro: <strong class="text-body">@Num(Model.DiasCobro, "N0")</strong></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold letter-spacing-1 mb-1">Cuentas por Pagar</div>
                        <div class="fs-24 fw-bold text-warning">@Money(Model.PorPagar)</div>
                    </div>
                    <span class="avatar-md rounded-circle bg-warning bg-opacity-10 text-warning d-inline-flex align-items-center justify-content-center">
                        <i class="ti ti-file-invoice fs-22"></i>
                    </span>
                </div>
                <div class="mt-3">
                    @if (Model.CxpVencido > 0)
                    {
                        <span class="badge badge-soft-danger py-1"><i class="ti ti-alert-triangle me-1"></i>Vencido: @Money(Model.CxpVencido)</span>
                    }
                    else
                    {
                        <span class="badge badge-soft-success py-1"><i class="ti ti-circle-check me-1"></i>Sin vencidos</span>
                    }
                </div>
                <hr class="my-3 opacity-50" />
                <div class="d-flex justify-content-between text-muted small">
                    <span>Por vencer: <strong class="text-body">@Money(Model.CxpPorVencer)</strong></span>
                    <span>Días pago: <strong class="text-body">@Num(Model.DiasPago, "N0")</strong></span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Fila 2: Ratios Financieros -->
<div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3 mb-3">
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="ti ti-droplet fs-18 text-primary"></i>
                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">Liquidez</span>
                </div>
                <div class="fs-22 fw-bold">@Num(Model.Liquidez)</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="ti ti-percentage fs-18 text-success"></i>
                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">Rentabilidad</span>
                </div>
                <div class="fs-22 fw-bold @(Model.Rentabilidad >= 0 ? "text-success" : "text-danger")">@Num(Model.Rentabilidad, "N1")%</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="ti ti-rotate-clockwise fs-18 text-info"></i>
                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">Rotación Stock</span>
                </div>
                <div class="fs-22 fw-bold text-info">@Num(Model.RotacionStock)</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="ti ti-scale fs-18 text-warning"></i>
                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">Solvencia</span>
                </div>
                <div class="fs-22 fw-bold text-warning">@Num(Model.Solvencia)</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="ti ti-ticket fs-18 text-purple"></i>
                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">Ticket Prom.</span>
                </div>
                <div class="fs-22 fw-bold">@Money(Model.TicketPromedio)</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="ti ti-shopping-bag fs-18 text-cyan"></i>
                    <span class="text-muted small text-uppercase fw-bold letter-spacing-1">Ventas Hoy</span>
                </div>
                <div class="fs-22 fw-bold text-cyan">@Money(Model.VentasHoy)</div>
            </div>
        </div>
    </div>
</div>

<!-- Fila 2b: Meta de Ventas + Actividad Reciente -->
<div class="row g-3 mb-3">
    <div class="col-xl-4">
        <div class="card border-0 shadow-sm card-h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between">
                <h5 class="m-0 fw-bold"><i class="ti ti-target me-2 text-primary"></i>Meta de Ventas del Mes</h5>
            </div>
            <div class="card-body pt-2">
                <div class="position-relative mx-auto" style="height: 200px; max-width: 240px;">
                    <canvas id="metaGaugeChart"></canvas>
                    <div class="position-absolute top-50 start-50 translate-middle text-center">
                        <div class="fs-28 fw-bold @(Model.AvanceMetaPct >= 100 ? "text-success" : "text-primary")">@Model.AvanceMetaPct.ToString("N0")%</div>
                        <div class="text-muted small">del objetivo</div>
                    </div>
                </div>
                <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                    <div>
                        <div class="text-muted small">Vendido</div>
                        <div class="fw-bold text-body">@Money(Model.VentasMesCalendario)</div>
                    </div>
                    <div class="text-end">
                        <div class="text-muted small">Meta</div>
                        <div class="fw-bold text-body">@Money(Model.MetaVentasMes)</div>
                    </div>
                </div>
                @if (Model.MetaVentasMes <= 0)
                {
                    <div class="alert alert-light border small mt-3 mb-0 py-2"><i class="ti ti-info-circle me-1"></i>Configure el parámetro <code>META_VENTAS_MENSUAL</code> para fijar un objetivo.</div>
                }
            </div>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm card-h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold"><i class="ti ti-history me-2 text-info"></i>Actividad Reciente</h5>
                <a asp-controller="Admin" asp-action="Audit" class="btn btn-sm btn-outline-secondary"><i class="ti ti-arrow-right me-1"></i>Ver auditoría</a>
            </div>
            <div class="card-body pt-2">
                @if (Model.ActividadReciente.Any())
                {
                    <div data-simplebar style="max-height: 320px;">
                        @foreach (var a in Model.ActividadReciente)
                        {
                            <div class="d-flex gap-3 py-2 border-bottom">
                                <span class="avatar-xs rounded-circle bg-@(ActColor(a.Accion))-subtle text-@(ActColor(a.Accion)) d-inline-flex align-items-center justify-content-center flex-shrink-0">
                                    <i class="ti @ActIcon(a.Accion)"></i>
                                </span>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="small text-truncate">
                                        <strong class="text-body">@a.Usuario</strong>
                                        <span class="text-muted">@a.Accion?.ToLower()</span>
                                        <code>@TablaCorta(a.Tabla)</code>
                                    </div>
                                    <div class="text-muted fs-xs">@a.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="ti ti-history-off fs-32 d-block mb-2 opacity-50"></i>
                        Sin actividad registrada recientemente.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Fila 3: Ventas 14 días + Ventas por Canal/Forma de Pago -->
<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold"><i class="ti ti-chart-line me-2 text-primary"></i>Ventas de los áltimos 14 Días</h5>
                <span class="badge badge-soft-primary"><i class="ti ti-coin me-1"></i>@Money(Model.VentasMes) · @Model.RangoNombre</span>
            </div>
            <div class="card-body pt-2">
                <div class="chart-box" style="height: 320px;">
                    <canvas id="ventasSerieChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="row g-3 h-100">
            <div class="col-12">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-4 px-4">
                        <h5 class="m-0 fw-bold"><i class="ti ti-chart-donut me-2 text-info"></i>Ventas por Canal</h5>
                    </div>
                    <div class="card-body pt-2">
                        <div class="chart-box" style="height: 240px;">
                            <canvas id="canalChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pt-4 px-4">
                        <h5 class="m-0 fw-bold"><i class="ti ti-credit-card me-2 text-success"></i>Ventas por Forma de Pago</h5>
                    </div>
                    <div class="card-body pt-2">
                        <div class="chart-box" style="height: 240px;">
                            <canvas id="pagoChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Fila 4: Tendencias -->
<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold"><i class="ti ti-trending-up me-2 text-success"></i>Tendencia de Rentabilidad</h5>
                <span class="badge badge-soft-success">@Num(Model.Rentabilidad, "N1")% actual</span>
            </div>
            <div class="card-body pt-2">
                <div class="chart-box" style="height: 280px;">
                    <canvas id="profitTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold"><i class="ti ti-chart-bar me-2 text-warning"></i>Índice de Liquidez Mensual</h5>
                <span class="badge badge-soft-warning">@Num(Model.Liquidez) veces</span>
            </div>
            <div class="card-body pt-2">
                <div class="chart-box" style="height: 280px;">
                    <canvas id="liquidityTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Fila 4b: Últimas Ventas + Top Clientes + Aging CxC -->
<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold"><i class="ti ti-receipt-2 me-2 text-primary"></i>Últimas Ventas</h5>
                <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="ti ti-arrow-right me-1"></i> Ver todas</a>
            </div>
            <div class="card-body pt-0">
                @if (Model.VentasRecientes.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-vcenter card-table table-hover mb-0">
                            <thead class="thead-sm text-uppercase fs-xxs text-muted">
                                <tr>
                                    <th>Factura</th>
                                    <th>Cliente</th>
                                    <th class="text-center">Canal</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in Model.VentasRecientes)
                                {
                                    <tr>
                                        <td class="fw-bold font-monospace small">@v.Numero</td>
                                        <td class="text-truncate" style="max-width: 150px;">@v.Cliente</td>
                                        <td class="text-center"><span class="badge badge-soft-info">@v.Canal</span></td>
                                        <td class="text-end fw-bold">@Money(v.Total)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="ti ti-receipt-off fs-32 d-block mb-2 opacity-50"></i>
                        Sin ventas registradas.
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold"><i class="ti ti-users me-2 text-success"></i>Top Clientes (Período)</h5>
            </div>
            <div class="card-body">
                @if (Model.TopClientes.Any())
                {
                    var maxCliente = Model.TopClientes.Max(c => c.Importe);
                    <div class="list-group list-group-flush">
                        @foreach (var c in Model.TopClientes)
                        {
                            var cpct = maxCliente > 0 ? (double)(c.Importe / maxCliente * 100) : 0;
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-truncate me-2">@c.Nombre</span>
                                    <span class="text-nowrap fw-bold">@Money(c.Importe)</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" style="width: @cpct.ToString("N0")%"></div>
                                </div>
                                <div class="text-muted small mt-1">@c.Facturas factura(s)</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="ti ti-users-off fs-32 d-block mb-2 opacity-50"></i>
                        Sin clientes con ventas este mes.
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold"><i class="ti ti-hourglass-high me-2 text-danger"></i>Aging CxC</h5>
                <span class="badge badge-soft-danger">@Money(Model.PorCobrar)</span>
            </div>
            <div class="card-body pt-2">
                <div class="chart-box" style="height: 260px;">
                    <canvas id="agingCxcChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Fila 4c: Flujo de Caja -->
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold"><i class="ti ti-cash-banknote me-2 text-primary"></i>Flujo de Caja <span class="text-muted fw-normal fs-14">· últimas 8 semanas</span></h5>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge badge-soft-success py-1"><i class="ti ti-arrow-down-left me-1"></i>Cobrado: @Money(Model.CobradoMes)</span>
                    <span class="badge badge-soft-danger py-1"><i class="ti ti-arrow-up-right me-1"></i>Pagado: @Money(Model.PagadoMes)</span>
                    <span class="badge @(Model.CobradoMes - Model.PagadoMes >= 0 ? "badge-soft-primary" : "badge-soft-warning") py-1">Neto: @Money(Model.CobradoMes - Model.PagadoMes)</span>
                </div>
            </div>
            <div class="card-body pt-2 pb-3">
                <div class="chart-box" style="height: 300px;">
                    <canvas id="flujoCajaChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Fila 5: Operación POS -->
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header border-0 bg-transparent pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold text-primary"><i class="ti ti-device-laptop me-2"></i>Operación Punto de Venta (POS)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-primary" type="button" id="pos-refresh" title="Actualizar" data-bs-toggle="tooltip"><i class="ti ti-refresh"></i></button>
                    <a asp-controller="PosVentaPendiente" asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="ti ti-list me-1"></i> Ver Pendientes</a>
                </div>
            </div>
            <div id="pos-card-container" data-pos-url="@Url.Action("PosPartial", "Dashboard")">
                <partial name="_PosCard" model="Model" />
            </div>
        </div>
    </div>
</div>

<!-- Fila 6: Top Productos + Alertas de Inventario -->
<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold text-success"><i class="ti ti-trophy me-2"></i>Productos Más Vendidos (Período)</h5>
            </div>
            <div class="card-body">
                @if (Model.TopProductos.Any())
                {
                    var maxImporte = Model.TopProductos.Max(p => p.Importe);
                    var pos = 1;
                    var medalColors = new[] { "bg-primary", "bg-info", "bg-success", "bg-secondary" };
                    <div data-simplebar style="max-height: 360px;">
                    <div class="list-group list-group-flush">
                        @foreach (var p in Model.TopProductos)
                        {
                            var pct = maxImporte > 0 ? (double)(p.Importe / maxImporte * 100) : 0;
                            var medal = medalColors[(pos - 1) % medalColors.Length];
                            <div class="list-group-item px-0">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="avatar-sm rounded-circle @medal text-white d-inline-flex align-items-center justify-content-center fw-bold small">@pos</span>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-bold text-truncate me-2">@p.Nombre</span>
                                            <span class="text-nowrap fw-bold">@Money(p.Importe)</span>
                                        </div>
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar bg-success" style="width: @pct.ToString("N0")%"></div>
                                        </div>
                                        <div class="text-muted small mt-1">@p.Cantidad.ToString("N2") unidades</div>
                                    </div>
                                </div>
                            </div>
                            pos++;
                        }
                    </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="ti ti-package-off fs-32 d-block mb-2 opacity-50"></i>
                        Sin ventas registradas este mes.
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <h5 class="m-0 fw-bold text-danger"><i class="ti ti-alert-triangle me-2"></i>Alertas Críticas de Inventario</h5>
                <a asp-controller="Inventory" asp-action="LowStock" class="btn btn-sm btn-outline-secondary">
                    <i class="ti ti-arrow-right me-1"></i> Ver Todo
                </a>
            </div>
            <div class="card-body pt-2">
                @if (Model.AlertasStock.Any())
                {
                    <div data-simplebar style="max-height: 360px;">
                        @foreach (var alert in Model.AlertasStock)
                        {
                            var agotado = alert.Cantidad <= 0;
                            var statusCls = agotado ? "badge-soft-danger" : "badge-soft-warning";
                            var statusTxt = agotado ? "Agotado" : "Bajo";
                            var iconCls = agotado ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning";
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                                <span class="avatar-md rounded @iconCls d-inline-flex align-items-center justify-content-center">
                                    <i class="ti ti-package fs-20"></i>
                                </span>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-bold text-truncate">@alert.Producto?.Nombre</div>
                                    <div class="text-muted small text-truncate">
                                        <span class="me-2"><i class="ti ti-barcode me-1"></i>@alert.Producto?.Codigo</span>
                                        <span><i class="ti ti-tag me-1"></i>@Money(alert.Producto?.PrecioVentaActual ?? 0)</span>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold @(agotado ? "text-danger" : "text-warning")">@alert.Cantidad.ToString("N0")</div>
                                    <div class="text-muted small">mín. @alert.StockMinimo.ToString("N0")</div>
                                </div>
                                <span class="badge @statusCls">@statusTxt</span>
                                <a asp-controller="Purchase" asp-action="Create" class="btn btn-sm btn-outline-primary px-2" title="Generar compra">
                                    <i class="ti ti-shopping-cart"></i>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted small">
                        <i class="ti ti-circle-check fs-32 d-block mb-2 text-success opacity-50"></i>
                        Niveles de stock óptimos en todos los almacenes.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Fila 7: Vencimientos + Contratos + Operaciones Rápidas -->
<div class="row g-3 mb-3">
    <div class="col-lg-8">
        @if (Model.AlertasVencimiento.Any())
        {
            <div class="card border-0 shadow-sm mb-3 border-start border-danger border-3">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="m-0 fw-bold text-danger"><i class="ti ti-calendar-x me-2"></i>Lotes Próximos a Vencer (30 días)</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-hover mb-0">
                            <thead class="thead-sm text-uppercase fs-xxs text-muted">
                                <tr>
                                    <th>Producto</th>
                                    <th>Almacén</th>
                                    <th>Lote</th>
                                    <th class="text-center">Vence</th>
                                    <th class="text-end">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in Model.AlertasVencimiento)
                                {
                                    <tr>
                                        <td class="fw-bold">@l.Producto?.Nombre</td>
                                        <td class="small text-muted">@l.Almacen?.Nombre</td>
                                        <td class="font-monospace small">@l.Lote</td>
                                        <td><span class="badge badge-soft-danger">@l.FechaVencimiento?.ToString("dd/MM/yyyy")</span></td>
                                        <td class="text-end">@l.Cantidad.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        @if (Model.ContratosVencer.Any())
        {
            <div class="card border-0 shadow-sm border-start border-warning border-3">
                <div class="card-header bg-transparent border-0 pt-4 px-4">
                    <h5 class="m-0 fw-bold text-warning"><i class="ti ti-calendar-clock me-2"></i>Contratos Económicos por Vencer (15 días)</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-hover mb-0">
                            <thead class="thead-sm text-uppercase fs-xxs text-muted">
                                <tr>
                                    <th>Número de Contrato</th>
                                    <th>Tercero (Cliente/Prov)</th>
                                    <th class="text-center">Vencimiento</th>
                                    <th class="text-end"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.ContratosVencer)
                                {
                                    <tr>
                                        <td class="fw-bold">@c.NumeroContrato</td>
                                        <td class="small">@(c.Cliente?.NombreRazonSocial ?? c.Proveedor?.RazonSocial)</td>
                                        <td class="text-center">
                                            <span class="badge bg-warning-subtle text-warning">@c.FechaFin?.ToString("dd/MM/yyyy")</span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="ContratoEconomico" asp-action="Details" asp-route-id="@c.Id" class="btn btn-icon btn-sm btn-ghost-warning"><i class="ti ti-edit"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        @if (!Model.AlertasVencimiento.Any() && !Model.ContratosVencer.Any())
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5 text-muted small">
                    <i class="ti ti-calendar-stats fs-32 d-block mb-2 opacity-50"></i>
                    Sin vencimientos próximos en inventario ni contratos por vencer.
                </div>
            </div>
        }
    </div>
    <div class="col-lg-4">
        <div class="card bg-primary border-0 shadow-lg h-100 overflow-hidden">
            <div class="card-header border-white border-opacity-10 bg-transparent pt-4 px-4">
                <h5 class="m-0 fw-bold text-white"><i class="ti ti-bolt me-2"></i>Operaciones Rápidas</h5>
            </div>
            <div class="card-body p-4">
                <div class="d-grid gap-3">
                    <a asp-controller="Sales" asp-action="Create" class="btn btn-light fw-bold py-3 d-flex align-items-center justify-content-between">
                        <span><i class="ti ti-plus me-2 text-primary"></i>Nueva Factura de Venta</span>
                        <i class="ti ti-chevron-right text-muted"></i>
                    </a>
                    <a asp-controller="Inventory" asp-action="CreateMovement" class="btn btn-light fw-bold py-3 d-flex align-items-center justify-content-between">
                        <span><i class="ti ti-transfer-in me-2 text-primary"></i>Entrada de Almacén</span>
                        <i class="ti ti-chevron-right text-muted"></i>
                    </a>
                    <a asp-controller="AsientoContable" asp-action="Create" class="btn btn-light fw-bold py-3 d-flex align-items-center justify-content-between">
                        <span><i class="ti ti-calculator me-2 text-primary"></i>Registrar Asiento</span>
                        <i class="ti ti-chevron-right text-muted"></i>
                    </a>
                </div>
                <div class="mt-4 pt-3 border-top border-white border-opacity-10 text-center">
                    <p class="small text-white-50 mb-0">Acceso rápido a los documentos primarios de la S.U.R.L.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/plugins/chartjs/chart.js"></script>
    <script>
        const ventasLabels = @Html.Raw(Json.Serialize(Model.VentasSerie.Select(x => x.Label)));
        const ventasValues = @Html.Raw(Json.Serialize(Model.VentasSerie.Select(x => x.Value)));
        const profitLabels = @Html.Raw(Json.Serialize(Model.TrendRentabilidad.Select(x => x.Label)));
        const profitValues = @Html.Raw(Json.Serialize(Model.TrendRentabilidad.Select(x => x.Value)));
        const liqLabels = @Html.Raw(Json.Serialize(Model.TrendLiquidez.Select(x => x.Label)));
        const liqValues = @Html.Raw(Json.Serialize(Model.TrendLiquidez.Select(x => x.Value)));
        const canalLabels = @Html.Raw(Json.Serialize(Model.VentasPorCanal.Select(x => x.Name)));
        const canalValues = @Html.Raw(Json.Serialize(Model.VentasPorCanal.Select(x => x.Value)));
        const pagoLabels = @Html.Raw(Json.Serialize(Model.VentasPorFormaPago.Select(x => x.Name)));
        const pagoValues = @Html.Raw(Json.Serialize(Model.VentasPorFormaPago.Select(x => x.Value)));
        const agingCxc = @Html.Raw(Json.Serialize(Model.AgingCxc));
        const flujoLabels = @Html.Raw(Json.Serialize(Model.FlujoCaja.Select(x => x.Label)));
        const flujoEntradas = @Html.Raw(Json.Serialize(Model.FlujoCaja.Select(x => x.Entradas)));
        const flujoSalidas = @Html.Raw(Json.Serialize(Model.FlujoCaja.Select(x => x.Salidas)));
        const metaAvancePct = @Html.Raw(Json.Serialize(Model.AvanceMetaPct));

        const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
        const gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : '#eef2f7';
        const tickColor = isDark ? '#8391a2' : '#9ba6b7';

        const palette = ['#1ab394', '#23c6c8', '#f8ac59', '#ed5565', '#7b70ef', '#1c84c6'];

        const baseScales = {
            y: { grid: { color: gridColor }, ticks: { color: tickColor, font: { size: 11 } } },
            x: { grid: { display: false }, ticks: { color: tickColor, font: { size: 11 } } }
        };

        function renderChart(id, config) {
            const el = document.getElementById(id);
            if (!el || typeof Chart === 'undefined') return null;
            Chart.getChart(el)?.destroy();
            return new Chart(el.getContext('2d'), config);
        }

        renderChart('ventasSerieChart', {
            type: 'line',
            data: {
                labels: ventasLabels,
                datasets: [{
                    label: 'Ventas',
                    data: ventasValues,
                    borderColor: '#1ab394',
                    backgroundColor: 'rgba(26, 179, 148, 0.10)',
                    pointBackgroundColor: '#1ab394',
                    pointBorderColor: '#fff',
                    pointHoverRadius: 6,
                    fill: true,
                    tension: 0.4,
                    borderWidth: 3
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: baseScales
            }
        });

        renderChart('ventasSparkChart', {
            type: 'line',
            data: {
                labels: ventasLabels,
                datasets: [{
                    data: ventasValues,
                    borderColor: '#1c84c6',
                    backgroundColor: 'rgba(28, 132, 198, 0.12)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 0
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { enabled: false } },
                scales: { x: { display: false }, y: { display: false } }
            }
        });

        renderChart('profitTrendChart', {
            type: 'line',
            data: {
                labels: profitLabels,
                datasets: [{
                    label: 'Rentabilidad (%)',
                    data: profitValues,
                    borderColor: '#0acf97',
                    backgroundColor: 'rgba(10, 207, 151, 0.08)',
                    pointBackgroundColor: '#0acf97',
                    pointBorderColor: '#fff',
                    pointHoverRadius: 6,
                    fill: true,
                    tension: 0.4,
                    borderWidth: 3
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: baseScales
            }
        });

        renderChart('liquidityTrendChart', {
            type: 'bar',
            data: {
                labels: liqLabels,
                datasets: [{
                    label: 'Liquidez (Veces)',
                    data: liqValues,
                    backgroundColor: '#f8ac59',
                    hoverBackgroundColor: '#e9972f',
                    borderRadius: 8,
                    barThickness: 30
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: baseScales
            }
        });

        const doughnutOpts = {
            responsive: true, maintainAspectRatio: false,
            cutout: '68%',
            plugins: {
                legend: { position: 'bottom', labels: { color: tickColor, boxWidth: 10, padding: 14, font: { size: 11 } } }
            }
        };

        renderChart('canalChart', {
            type: 'doughnut',
            data: {
                labels: canalLabels,
                datasets: [{
                    data: canalValues,
                    backgroundColor: palette.slice(0, Math.max(canalLabels.length, 1)),
                    borderWidth: 0
                }]
            },
            options: doughnutOpts
        });

        renderChart('pagoChart', {
            type: 'doughnut',
            data: {
                labels: pagoLabels,
                datasets: [{
                    data: pagoValues,
                    backgroundColor: palette.slice(0, Math.max(pagoLabels.length, 1)),
                    borderWidth: 0
                }]
            },
            options: doughnutOpts
        });

        const agingCtx = document.getElementById('agingCxcChart');
        if (agingCtx) {
            new Chart(agingCtx.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: ['Corriente', '1-30 días', '31-60 días', '61-90 días', '+90 días'],
                    datasets: [{
                        data: agingCxc,
                        backgroundColor: ['#1ab394', '#23c6c8', '#f8ac59', '#fd7e14', '#ed5565'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    cutout: '62%',
                    plugins: {
                        legend: { position: 'bottom', labels: { color: tickColor, boxWidth: 10, padding: 10, font: { size: 11 } } }
                    }
                }
            });
        }

        renderChart('flujoCajaChart', {
            type: 'bar',
            data: {
                labels: flujoLabels,
                datasets: [
                    { label: 'Cobros', data: flujoEntradas, backgroundColor: '#1ab394', hoverBackgroundColor: '#16997e', borderRadius: 6, barPercentage: 0.75, categoryPercentage: 0.6 },
                    { label: 'Pagos', data: flujoSalidas, backgroundColor: '#ed5565', hoverBackgroundColor: '#d13c4c', borderRadius: 6, barPercentage: 0.75, categoryPercentage: 0.6 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'top', labels: { color: tickColor, boxWidth: 12, padding: 14, font: { size: 11 }, usePointStyle: true, pointStyle: 'circle' } } },
                scales: baseScales
            }
        });

        renderChart('metaGaugeChart', {
            type: 'doughnut',
            data: {
                labels: ['Avance', 'Restante'],
                datasets: [{
                    data: [Math.min(metaAvancePct, 100), Math.max(100 - Math.min(metaAvancePct, 100), 0)],
                    backgroundColor: [metaAvancePct >= 100 ? '#1ab394' : '#1c84c6', 'rgba(0,0,0,0.06)'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                cutout: '72%',
                rotation: -90,
                circumference: 180,
                plugins: { legend: { display: false }, tooltip: { enabled: false } }
            }
        });

        const posBtn = document.getElementById('pos-refresh');
        if (posBtn) {
            const container = document.getElementById('pos-card-container');
            const url = container?.dataset.posUrl || '/Dashboard/PosPartial';
            posBtn.addEventListener('click', async function () {
                const i = posBtn.querySelector('i');
                const cls = i?.className || '';
                posBtn.disabled = true;
                if (i) i.className = 'ti ti-loader-2 ti-spin';
                try {
                    const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (res.ok) {
                        container.innerHTML = await res.text();
                    }
                } finally {
                    posBtn.disabled = false;
                    if (i) i.className = cls;
                }
            });
            if (window.bootstrap?.Tooltip) {
                new bootstrap.Tooltip(posBtn);
            }
        }
    </script>
}