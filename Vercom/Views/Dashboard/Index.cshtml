@model Dictionary<string, decimal>
@{
    ViewBag.Title = "Panel de Control";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Dashboard de Gestión</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <!-- Indicadores BI (KPIs) -->
    <div class="row">
        <div class="col-md-3">
            <div class="card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-1 text-primary">@Model["Liquidez"]</h3>
                            <p class="text-muted mb-0">Índice de Liquidez</p>
                        </div>
                        <div class="flex-shrink-0">
                            <div class="avatar-md bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center">
                                <i class="ti ti-cash fs-24"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-1 text-success">@Model["Rentabilidad"]%</h3>
                            <p class="text-muted mb-0">Rentabilidad Neta</p>
                        </div>
                        <div class="flex-shrink-0">
                            <div class="avatar-md bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center">
                                <i class="ti ti-chart-line fs-24"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h3 class="mb-1 text-info">@Model["Rotacion"]</h3>
                            <p class="text-muted mb-0">Rotación de Inventario</p>
                        </div>
                        <div class="flex-shrink-0">
                            <div class="avatar-md bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center">
                                <i class="ti ti-refresh fs-24"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card overflow-hidden text-center bg-primary text-white">
                <div class="card-body">
                    <h3 class="mb-1 text-white">@DateTime.Now.ToString("dd/MM/yyyy")</h3>
                    <p class="mb-0 op-7">Periodo Fiscal Abierto</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <!-- Alertas de Stock Bajo -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Alertas de Inventario Crítico</h4>
                    <a asp-controller="Inventory" asp-action="LowStock" class="btn btn-sm btn-outline-danger">Ver Todos</a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th>Almacén</th>
                                    <th>Actual</th>
                                    <th>Mínimo</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="text-center">
                                    <td colspan="5" class="text-muted py-4">No hay alertas críticas registradas.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Acciones Rápidas -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">
                    <h4 class="card-title">Acciones Operativas</h4>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-controller="Sales" asp-action="Create" class="btn btn-primary btn-lg">
                            <i class="ti ti-plus me-1"></i> Nueva Venta Fiscal
                        </a>
                        <a asp-controller="Production" asp-action="CreateOrder" class="btn btn-outline-primary btn-lg">
                            <i class="ti ti-settings me-1"></i> Iniciar Producción
                        </a>
                        <a asp-controller="Inventory" asp-action="CreateMovement" class="btn btn-outline-secondary btn-lg">
                            <i class="ti ti-package me-1"></i> Recepción de Mercancía
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
