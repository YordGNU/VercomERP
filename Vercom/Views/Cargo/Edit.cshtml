@model Vercom.Models.Cargo

@{
    ViewData["Title"] = "Editar Cargo";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Editar Cargo: @Model.Nombre</h4>
        <p class="text-muted small mb-0">Definición de responsabilidades y rangos salariales.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">RRHH</a></li>
            <li class="breadcrumb-item active">Cargos</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card">
                <div class="card-header border-light justify-content-between">
                    <h5 class="m-0 fw-bold"><i class="ti ti-briefcase me-2 text-primary"></i>Datos del Puesto</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" class="row g-4">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-4">
                            <label class="form-label">Código del Cargo</label>
                            <input asp-for="Codigo" class="form-control w-100 fw-bold bg-light" readonly />
                            <small class="text-muted tiny">Código no editable.</small>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Nombre del Puesto</label>
                            <input asp-for="Nombre" class="form-control w-100" placeholder="Nombre descriptivo" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Misión y Funciones del Puesto</label>
                            <textarea asp-for="Funciones" class="form-control" rows="4">@Model.Funciones</textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Salario Escala Mínimo</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="SalarioEscalaMin" class="form-control" placeholder="0.00" step="0.01" />
                            </div>
                            <span asp-validation-for="SalarioEscalaMin" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Salario Escala Máximo</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="SalarioEscalaMax" class="form-control" placeholder="0.00" step="0.01" />
                            </div>
                            <span asp-validation-for="SalarioEscalaMax" class="text-danger small"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> ACTUALIZAR CARGO
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}