@model IEnumerable<Vercom.Models.Cargo>

@{
    ViewData["Title"] = "Index";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Nomenclador de Cargos y Ocupaciones</h4>
        <p class="text-muted small mb-0">Definición de perfiles laborales y escalas salariales base.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">RRHH</a></li>
            <li class="breadcrumb-item active">Cargos</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus"></i> NUEVO CARGO
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-briefcase me-2 text-primary"></i>Cargos Registrados</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="cargosTable" class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th width="120">Código</th>
                            <th>Nombre del Cargo</th>
                            <th width="180" class="text-end">Escala Mínima ($)</th>
                            <th width="180" class="text-end">Escala Máxima ($)</th>
                            <th width="120" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td class="text-numeric">@item.SalarioEscalaMin?.ToString("N2")</td>
                                <td class="text-numeric">@item.SalarioEscalaMax?.ToString("N2")</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Ver">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#cargosTable').DataTable({
                language: { url: '/js/i18n/es-ES.json' }
            });
        });
    </script>
}
