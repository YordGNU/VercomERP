@model Vercom.Models.Sucursal
@{
    ViewBag.Title = "Nueva Sucursal";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Añadir Nueva Sucursal</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <form asp-action="Create" method="post">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Codigo" class="form-label fw-bold">Código Interno</label>
                                <input asp-for="Codigo" class="form-control" placeholder="ej: SUC_01" required />
                                <span asp-validation-for="Codigo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Nombre" class="form-label fw-bold">Nombre descriptivo</label>
                                <input asp-for="Nombre" class="form-control" placeholder="ej: Sucursal Centro" required />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Tipo" class="form-label fw-bold">Tipo de Establecimiento</label>
                                <select asp-for="Tipo" class="form-select">
                                    <option value="TIENDA">Punto de Venta / Tienda</option>
                                    <option value="ALMACEN">Almacén de Distribución</option>
                                    <option value="PLANTA">Planta de Producción</option>
                                    <option value="OFICINA">Oficina Administrativa</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Telefono" class="form-label fw-bold">Teléfono de Contacto</label>
                                <input asp-for="Telefono" class="form-control" />
                            </div>

                            <div class="col-12">
                                <label asp-for="Direccion" class="form-label fw-bold">Dirección Física</label>
                                <input asp-for="Direccion" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Municipio" class="form-label fw-bold">Municipio</label>
                                <input asp-for="Municipio" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Provincia" class="form-label fw-bold">Provincia</label>
                                <input asp-for="Provincia" class="form-control" />
                            </div>

                            <div class="col-md-12 mt-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="Activo" checked>
                                    <label class="form-check-label fw-bold" asp-for="Activo">Sucursal Habilitada</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="ti ti-device-floppy me-1"></i> REGISTRAR SUCURSAL
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
