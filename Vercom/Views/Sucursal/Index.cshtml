@model Vercom.ViewModels.SucursalPagedResult
@{
    ViewBag.Title = "Gestión de Sucursales";
    var estado = Model.Activo switch { true => "activa", false => "inactiva", _ => "" };
    var filtros = new RouteValueDictionary { ["search"] = Model.Search, ["tipo"] = Model.Tipo, ["estado"] = estado };
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Sucursales y Puntos de Venta</h4>
        <p class="text-muted small mb-0">Gestión de ubicaciones físicas, almacenes y áreas de producción.</p>
    </div>
    <div class="text-end d-flex align-items-center gap-3">
        <div class="d-none d-md-block">
            <ol class="breadcrumb m-0 py-0 mb-1 justify-content-end">
                <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
                <li class="breadcrumb-item"><a href="javascript: void(0);">Administración</a></li>
                <li class="breadcrumb-item active">Sucursales</li>
            </ol>
        </div>
        <a asp-action="Mapa" class="btn btn-outline-primary shadow-sm"><i class="ti ti-map-2 me-1"></i> VER MAPA</a>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="ti ti-plus me-1"></i> NUEVA SUCURSAL
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm mb-0">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <span class="avatar bg-primary-subtle text-primary"><i class="ti ti-building-community fs-20"></i></span>
                <div>
                    <div class="fs-5 fw-bold mb-0">@Model.TotalSucursales</div>
                    <div class="text-muted small">Sucursales</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm mb-0">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <span class="avatar bg-success-subtle text-success"><i class="ti ti-circle-check fs-20"></i></span>
                <div>
                    <div class="fs-5 fw-bold mb-0">@Model.Activas</div>
                    <div class="text-muted small">Unidades activas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm mb-0">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <span class="avatar bg-danger-subtle text-danger"><i class="ti ti-circle-x fs-20"></i></span>
                <div>
                    <div class="fs-5 fw-bold mb-0">@Model.Inactivas</div>
                    <div class="text-muted small">Unidades inactivas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm mb-0">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <span class="avatar bg-info-subtle text-info"><i class="ti ti-map-pin fs-20"></i></span>
                <div>
                    <div class="fs-5 fw-bold mb-0">@Model.Tipos.Count</div>
                    <div class="text-muted small">Tipos de establecimiento</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold mb-1">Buscar</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="ti ti-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Nombre o código..." autocomplete="off" />
                    <button type="submit" class="btn btn-primary"><i class="ti ti-arrow-right"></i></button>
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Tipo</label>
                <select name="tipo" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Todos los tipos --</option>
                    @foreach (var t in Model.Tipos)
                    {
                        <!option value="@t" @(t == Model.Tipo ? "selected" : "")>@t</!option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1">Estado</label>
                <select name="estado" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Todos --</option>
                    @if (estado == "activa")
                    {
                        <option value="activa" selected>Activas</option>
                        <option value="inactiva">Inactivas</option>
                    }
                    else if (estado == "inactiva")
                    {
                        <option value="activa">Activas</option>
                        <option value="inactiva" selected>Inactivas</option>
                    }
                    else
                    {
                        <option value="activa">Activas</option>
                        <option value="inactiva">Inactivas</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-light w-100">
                    <i class="ti ti-refresh me-1"></i> LIMPIAR
                </a>
            </div>
        </form>
    </div>
</div>

<div class="row">
    @foreach (var item in Model.Items)
    {
        var tipo = (string.IsNullOrEmpty(item.Tipo) ? "SIN TIPO" : item.Tipo).ToUpperInvariant();
        var tipoBadge = tipo switch
        {
            "TIENDA" => "bg-primary-subtle text-primary",
            "ALMACEN" => "bg-success-subtle text-success",
            "PRODUCCION" => "bg-warning-subtle text-warning",
            "OFICINA" => "bg-info-subtle text-info",
            "MIXTO" => "bg-secondary-subtle text-secondary",
            _ => "bg-light text-muted"
        };
        var ubicacion = string.Join(", ", new[] { item.Municipio, item.Provincia }.Where(x => !string.IsNullOrWhiteSpace(x)));
        <div class="col-md-6 col-xl-4 mb-4">
            <div class="card h-100 border-0 shadow-sm overflow-hidden">
                <div class="card-status-top @(item.Activo ? "bg-success" : "bg-secondary")"></div>
                <div class="card-body p-3 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex gap-2 align-items-center">
                            <span class="avatar bg-light text-primary"><i class="ti ti-building-store fs-22"></i></span>
                            <div>
                                <span class="badge @tipoBadge text-uppercase mb-1">@tipo</span>
                                <h5 class="card-title mb-0 fs-14 text-truncate" style="max-width: 210px;">@item.Nombre</h5>
                                <code class="text-muted small">@item.Codigo</code>
                            </div>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-icon btn-light border" data-bs-toggle="dropdown" type="button" title="Acciones">
                                <i class="ti ti-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><h6 class="dropdown-header small text-uppercase">Acciones</h6></li>
                                <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="ti ti-eye me-1 text-primary"></i> Detalles</a></li>
                                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="ti ti-edit me-1 text-info"></i> Editar</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Eliminar la sucursal \'@item.Nombre\'? Esta acción no se puede deshacer.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger"><i class="ti ti-trash me-1"></i> Eliminar</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="small text-muted mb-1">
                        <i class="ti ti-map-pin me-1 text-danger"></i>
                        @(string.IsNullOrEmpty(item.Direccion) ? "Sin dirección registrada" : item.Direccion)
                    </div>
                    <div class="small text-muted mb-1">
                        <i class="ti ti-building me-1 text-primary"></i>
                        @(string.IsNullOrEmpty(ubicacion) ? "Ubicación no especificada" : ubicacion)
                    </div>
                    <div class="small text-muted mb-3">
                        <i class="ti ti-phone me-1 text-success"></i>
                        @(string.IsNullOrEmpty(item.Telefono) ? "Sin teléfono" : item.Telefono)
                    </div>

                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge @(item.Activo ? "badge-soft-success" : "badge-soft-danger")">
                            <i class="ti ti-circle-filled me-1"></i> @(item.Activo ? "ACTIVA" : "INACTIVA")
                        </span>
                        <div class="btn-list">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="ti ti-eye"></i> VER</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary"><i class="ti ti-edit"></i> EDITAR</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="avatar-lg bg-light text-muted rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="ti ti-search-off fs-40"></i>
            </div>
            <h4>Sin resultados</h4>
            <p class="text-muted">@(Model.TotalItems == 0 ? "No hay sucursales registradas. Empiece creando la primera." : "Ninguna sucursal coincide con los filtros aplicados.")</p>
            <a asp-action="Create" class="btn btn-primary mt-2"><i class="ti ti-plus me-1"></i> Crear sucursal</a>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    var inicio = Math.Max(1, Model.Page - 2);
    var fin = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav class="mt-2">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tipo="@Model.Tipo" asp-route-estado="@estado" asp-route-page="@(Model.Page - 1)">Anterior</a>
            </li>
            @for (int p = inicio; p <= fin; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tipo="@Model.Tipo" asp-route-estado="@estado" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-tipo="@Model.Tipo" asp-route-estado="@estado" asp-route-page="@(Model.Page + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}

<div class="text-center text-muted small mt-2">
    Mostrando @Model.Items.Count() de @Model.TotalItems sucursales
</div>