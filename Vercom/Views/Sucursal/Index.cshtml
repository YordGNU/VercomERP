@model IEnumerable<Vercom.Models.Sucursal>
@{
    ViewBag.Title = "Gestión de Sucursales";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Sucursales y Puntos de Venta</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Nueva Sucursal
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-start border-primary border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="badge bg-primary-subtle text-primary mb-2">@item.Tipo</span>
                                <h4 class="card-title mb-1">@item.Nombre</h4>
                                <code class="text-muted small">@item.Codigo</code>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light btn-icon" data-bs-toggle="dropdown"><i class="ti ti-dots-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="ti ti-edit me-1"></i> Editar</a></li>
                                    <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="ti ti-eye me-1"></i> Detalles</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="ti ti-trash me-1"></i> Eliminar</a></li>
                                </ul>
                            </div>
                        </div>

                        <p class="small text-muted mb-3"><i class="ti ti-map-pin me-1"></i> @item.Direccion</p>

                        <div class="row text-center g-0 border-top pt-3">
                            <div class="col-6 border-end">
                                <h5 class="mb-0">@(item.Activo ? "SÍ" : "NO")</h5>
                                <small class="text-muted">Activa</small>
                            </div>
                            <div class="col-6">
                                <h5 class="mb-0">@item.Provincia</h5>
                                <small class="text-muted">Ubicación</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="avatar-lg bg-light text-muted rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="ti ti-building-store fs-40"></i>
                </div>
                <h3>No hay sucursales registradas</h3>
                <p class="text-muted">Empiece creando la sucursal principal o un almacén de distribución.</p>
                <a asp-action="Create" class="btn btn-primary mt-2">Crear mi primera sucursal</a>
            </div>
        }
    </div>
</div>
