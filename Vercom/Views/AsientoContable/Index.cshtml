@model Vercom.ViewModels.AsientoIndexViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Comprobantes y Asientos</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Nuevo Asiento Manual
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <!-- Filtro de Periodo -->
    <div class="card mb-4 bg-light-subtle shadow-sm">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-auto">
                    <label class="small fw-bold mb-0">Visualizar Periodo:</label>
                </div>
                <div class="col-auto">
                    <select name="periodId" class="form-select form-select-sm" onchange="this.form.submit()" asp-items="Model.Periods">
                        <option value="">-- Seleccione Periodo --</option>
                    </select>
                </div>
            </form>
        </div>
    </div>

<div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle w-100" id="asientosTable">
                    <thead class="table-light">
                        <tr>
                            <th>Nº Comprobante</th>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Concepto</th>
                            <th class="text-end">Debe</th>
                            <th class="text-end">Haber</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Entries)
                        {
                            var statusClass = item.Estado switch {
                                "CONTABILIZADO" => "badge bg-success",
                                "REVERTIDO" => "badge bg-danger",
                                _ => "badge bg-warning"
                            };

                            <tr>
                                <td class="fw-bold">@item.NumeroComprobante.ToString("D8")</td>
                                <td>@item.Fecha.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge border text-dark">@(item.TipoComprobante?.Codigo ?? "N/A")</span></td>
                                <td class="small">@item.Concepto</td>
                                <td class="text-end fw-bold">@item.TotalDebe.ToString("N2")</td>
                                <td class="text-end fw-bold">@item.TotalHaber.ToString("N2")</td>
                                <td class="text-center"><span class="@statusClass">@item.Estado</span></td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light" title="Detalles"><i class="ti ti-eye"></i></a>
                                        @if (item.Estado == "BORRADOR") {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-xs btn-light text-danger" title="Eliminar Borrador"><i class="ti ti-trash"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#asientosTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                order: [[1, 'desc']]
            });
        });
    </script>
}
