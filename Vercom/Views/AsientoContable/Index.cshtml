@model IEnumerable<Vercom.Models.AsientoContable>
@{
    ViewBag.Title = "Diario Contable";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Comprobantes y Asientos</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Nuevo Asiento Manual
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <!-- Filtro de Periodo -->
    <div class="card mb-4 bg-light-subtle">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-auto">
                    <label class="small fw-bold mb-0">Periodo Contable:</label>
                </div>
                <div class="col-auto">
                    <select name="periodId" class="form-select form-select-sm" onchange="this.form.submit()" asp-items="ViewBag.Periods"></select>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nº Comprobante</th>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Concepto</th>
                            <th class="text-end">Debe</th>
                            <th class="text-end">Haber</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Estado switch {
                                "CONTABILIZADO" => "badge bg-success",
                                "REVERTIDO" => "badge bg-danger",
                                _ => "badge bg-warning"
                            };

                            <tr>
                                <td class="fw-bold">@item.NumeroComprobante.ToString("D8")</td>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge border text-dark">@item.TipoComprobante.Codigo</span></td>
                                <td class="small">@item.Concepto</td>
                                <td class="text-end fw-bold">@item.TotalDebe.ToString("N2")</td>
                                <td class="text-end fw-bold">@item.TotalHaber.ToString("N2")</td>
                                <td class="text-center"><span class="@statusClass">@item.Estado</span></td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-eye"></i></a>
                                        @if (item.Estado == "BORRADOR") {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-edit"></i></a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-xs btn-light text-danger"><i class="ti ti-trash"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any()) {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted small italic">No existen asientos registrados en este periodo.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
