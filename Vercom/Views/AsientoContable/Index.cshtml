@model Vercom.ViewModels.AsientoIndexViewModel
@{
    ViewBag.Title = Model.Title;
}
<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Libro Diario de Comprobantes</h4>
        <p class="text-muted small mb-0">Registro cronológico de todas las operaciones económicas de la entidad.</p>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus"></i> NUEVO ASIENTO MANUAL
        </a>
    </div>
</div>

<div class="container-xxl">
    <!-- Filtros de Navegación -->
    <div class="card mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="form-label mb-0"><i class="ti ti-filter me-1"></i> Filtrar por Periodo:</label>
                </div>
                <div class="col-auto">
                    <select name="periodId" class="form-control form-select-sm" onchange="this.form.submit()" asp-items="Model.Periods">
                        <option value="">-- Periodo Actual --</option>
                    </select>
                </div>
                <div class="col-grow"></div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-book me-2 text-primary"></i>Asientos Registrados</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table" id="asientosTable">
                    <thead>
                        <tr>
                            <th width="140">Nº Comprobante</th>
                            <th width="120" class="text-center">Fecha</th>
                            <th width="80">Tipo</th>
                            <th>Concepto / Glosa</th>
                            <th width="130" class="text-end">Debe ($)</th>
                            <th width="130" class="text-end">Haber ($)</th>
                            <th width="120" class="text-center">Estado</th>
                            <th width="100" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Entries)
                        {
                            var statusClass = item.Estado switch {
                                "CONTABILIZADO" => "badge-soft-success",
                                "REVERTIDO" => "badge-soft-danger",
                                "BORRADOR" => "badge-soft-warning",
                                _ => "badge-soft-secondary"
                            };

                            <tr>
                                <td class="text-numeric fw-bold text-primary">@item.NumeroComprobante.ToString("D8")</td>
                                <td class="text-date">@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge badge-soft-info">@(item.TipoComprobante?.Codigo ?? "AJ")</span></td>
                                <td class="text-wrap small text-muted">@item.Concepto</td>
                                <td class="text-numeric fw-bold">@item.TotalDebe.ToString("N2")</td>
                                <td class="text-numeric fw-bold">@item.TotalHaber.ToString("N2")</td>
                                <td class="text-center"><span class="badge @statusClass">@item.Estado</span></td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Ver Detalles">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        @if (item.Estado == "BORRADOR") {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2 text-danger" title="Eliminar">
                                                <i class="ti ti-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#asientosTable').DataTable({
                         language: { url: '/js/i18n/es-ES.json' },
                order: [[1, 'desc'], [0, 'desc']]
            });
        });
    </script>
}
