@model IEnumerable<Vercom.Models.Presupuesto>

@{
    ViewData["Title"] = "Index";
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Ventas", Title = "Gestión de Presupuesto", Subtitle = "", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h4 class="card-title">Listado de Presupuesto</h4>
                </div>
                <div class="card-body">



<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="table-responsive"><table id="dataTable" class="table table-striped table-hover dt-responsive">
         <thead class="thead-sm text-uppercase fs-xxs">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.EntidadId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Anio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AprobadoPor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreadoEn)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.EntidadId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Anio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Estado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AprobadoPor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreadoEn)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table></div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
     $(document).ready(function () {
            #dataTable.DataTable();
        });
    </script>
}
