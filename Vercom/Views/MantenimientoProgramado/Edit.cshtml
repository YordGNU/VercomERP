@model Vercom.ViewModels.MantenimientoFormViewModel
@inject Vercom.Services.IEntidadDisplayService EntidadDisplay
@{
    ViewData["Title"] = "Editar Mantenimiento Programado";
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Editar Mantenimiento Programado", Subtitle = "Modificación de la programación de mantenimiento.", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h4 class="card-title">Formulario de Edición</h4>
                </div>
                <div class="card-body">
<form class="row g-3" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Mantenimiento.Id" />
            <div class="mb-3">
                <label asp-for="Mantenimiento.EquipoId" class="form-label"></label>
                <select asp-for="Mantenimiento.EquipoId" class="form-control" asp-items="ViewBag.EquipoId"></select>
                <span asp-validation-for="Mantenimiento.EquipoId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mantenimiento.FechaProgramada" class="form-label"></label>
                <input asp-for="Mantenimiento.FechaProgramada" class="form-control" />
                <span asp-validation-for="Mantenimiento.FechaProgramada" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mantenimiento.FechaEjecutada" class="form-label"></label>
                <input asp-for="Mantenimiento.FechaEjecutada" class="form-control" />
                <span asp-validation-for="Mantenimiento.FechaEjecutada" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mantenimiento.Tipo" class="form-label"></label>
                <input asp-for="Mantenimiento.Tipo" class="form-control" />
                <span asp-validation-for="Mantenimiento.Tipo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mantenimiento.Descripcion" class="form-label"></label>
                <input asp-for="Mantenimiento.Descripcion" class="form-control" />
                <span asp-validation-for="Mantenimiento.Descripcion" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mantenimiento.Costo" class="form-label"></label>
                <input asp-for="Mantenimiento.Costo" class="form-control" />
                <span asp-validation-for="Mantenimiento.Costo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mantenimiento.ResponsableId" class="form-label"></label>
                <input asp-for="Mantenimiento.ResponsableId" class="form-control" />
                <span asp-validation-for="Mantenimiento.ResponsableId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Mantenimiento.Estado" class="form-label"></label>
                <input asp-for="Mantenimiento.Estado" class="form-control" />
                <span asp-validation-for="Mantenimiento.Estado" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

