@model IEnumerable<VERCOM.Models.MantenimientoProgramado>
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{ ViewBag.Title = "Mantenimiento Programado"; }

@{ var canCreate = (await AuthorizationService.AuthorizeAsync(User, null, "PRODUCCION.MANTENIMIENTO.CREAR")).Succeeded; var headerActions = canCreate ? "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> NUEVA PROGRAMACIÓN</a>" : null; var pageHeader = new VERCOM.ViewModels.PageHeaderModel { Eyebrow = "Producción", Title = "Mantenimiento Programado", Subtitle = "Planificación y seguimiento de mantenimientos preventivos/correctivos.", Icon = "ti-tools", ActionsHtml = headerActions != null ? new Microsoft.AspNetCore.Html.HtmlString(headerActions) : null }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold"><i class="ti ti-calendar-time me-2 text-primary"></i>Calendario de Intervenciones Técnicas</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="maintenanceTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th class="ps-4">Fecha Programada</th>
                            <th>Equipo / Maquinaria</th>
                          <th>Tipo de Intervención</th>
                          <th>Estado</th>
                            <th>Costo Est. ($)</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(m => m.FechaProgramada))
                        {
                            var isLate = item.FechaProgramada < DateOnly.FromDateTime(DateTime.Now) && item.Estado == "PROGRAMADO";
                            var rowClass = isLate ? "bg-danger-subtle" : "";

                            <tr class="@rowClass">
                              <td>
                                    <div class="fw-bold @(isLate ? "text-danger" : "")">
                                        @item.FechaProgramada.ToString("dd/MM/yyyy")
                                        @if(isLate) { <i class="ti ti-alert-triangle ms-1" title="Mantenimiento Vencido"></i> }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold fs-14">@item.Equipo.Nombre</div>
                                    <small class="text-muted tiny text-uppercase">COD: @item.Equipo.Codigo</small>
                                </td>
                                <td >
                                    <span class="badge border border-primary text-primary small">@item.Tipo</span>
                                </td>
                                <td >
                                    @{
                                        var statusClass = item.Estado switch {
                                            "EJECUTADO" => "bg-success-subtle text-success",
                                            "PROGRAMADO" => "bg-warning-subtle text-warning",
                                            "CANCELADO" => "bg-danger-subtle text-danger",
                                            _ => "bg-light"
                                        };
                                    }
                                    <span class="badge @statusClass px-3">@item.Estado</span>
                                </td>
                               <td class="fw-bold">@(item.Costo?.ToString("N2") ?? "0.00")</td>
                                <td>
                                    <div class="btn-list justify-content-end">
                                        @if (item.Estado == "PROGRAMADO" && (await AuthorizationService.AuthorizeAsync(User, null, "PRODUCCION.MANTENIMIENTO.EJECUTAR")).Succeeded)
                                        {
                                            <form asp-action="Execute" asp-route-id="@item.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-icon btn-light rounded-circle text-success" title="Marcar ejecutado"><i class="ti ti-check"></i></button>
                                            </form>
                                        }
                                        else if (item.FechaEjecutada.HasValue)
                                        {
                                            <span class="text-muted small">Ejecutado @item.FechaEjecutada.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted small">
                                    <i class="ti ti-calendar-off fs-40 d-block mb-2 opacity-50"></i>
                                    No hay mantenimientos programados para el periodo actual.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if(Model.Any(m => m.FechaProgramada < DateOnly.FromDateTime(DateTime.Now) && m.Estado == "PROGRAMADO")) {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mt-4">
            <div class="d-flex align-items-center">
                <i class="ti ti-alert-octagon-filled fs-32 me-3 opacity-50"></i>
                <div>
                    <h6 class="fw-bold mb-1">Alertas de Mantenimiento Críticas</h6>
                    <p class="mb-0 small">Se han detectado equipos con fechas de mantenimiento preventivo vencidas. La falta de intervención puede afectar la vida útil de los activos y la eficiencia de la planta.</p>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#maintenanceTable').DataTable({
                language: { url: '/js/i18n/es-ES.json' },
                order: [[0, 'asc']]
            });
        });
    </script>
}

