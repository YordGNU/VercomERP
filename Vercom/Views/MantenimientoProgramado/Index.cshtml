@model IEnumerable<Vercom.Models.MantenimientoProgramado>
@{
    ViewBag.Title = "Calendario de Mantenimiento";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Planificación de Mantenimientos Preventivos</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table id="dataTable" class="table table-hover align-middle w-100">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha Programada</th>
                            <th>Equipo / Maquinaria</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th class="text-end">Costo Est.</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(m => m.FechaProgramada))
                        {
                            var rowClass = item.FechaProgramada < DateOnly.FromDateTime(DateTime.Now) && item.Estado == "PROGRAMADO" ? "table-danger" : "";

                            <tr class="@rowClass">
                                <td class="fw-bold">@item.FechaProgramada.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="fw-bold">@item.Equipo.Nombre</div>
                                    <small class="text-muted">@item.Equipo.Codigo</small>
                                </td>
                                <td><span class="badge border text-dark">@item.Tipo</span></td>
                                <td>
                                    <span class="badge @(item.Estado == "EJECUTADO" ? "bg-success" : "bg-warning")">@item.Estado</span>
                                </td>
                                <td class="text-end">@(item.Costo?.ToString("C") ?? "0.00")</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-edit"></i></a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any()) {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted small">No hay mantenimientos programados para el periodo actual.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        .ready(function () {
            #dataTable.DataTable();
        });
    </script>
}
