@model IEnumerable<Vercom.Models.SaldoVacacione>

@{
    ViewData["Title"] = "Index";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Gestión de SaldoVacacione</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">SaldoVacacione</a></li>
            <li class="breadcrumb-item active">Listado</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Listado de SaldoVacacione</h4>
                </div>
                <div class="card-body">



<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="table-responsive"><table class="table data-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Anio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiasAcumulados)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiasDisfrutados)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiasCompensados)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SaldoActual)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Empleado)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Anio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DiasAcumulados)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DiasDisfrutados)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DiasCompensados)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SaldoActual)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Empleado.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table></div>
                </div>
            </div>
        </div>
    </div>
</div>
