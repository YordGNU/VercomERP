@model Vercom.ViewModels.VacationSubledgerViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">@Model.Title (9.09%)</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table id="dataTable" class="table table-hover align-middle w-100">
                    <thead class="table-dark">
                        <tr>
                            <th>Trabajador</th>
                            <th>Año Fiscal</th>
                            <th class="text-center">Días Acumulados</th>
                            <th class="text-center">Días Disfrutados</th>
                            <th class="text-center">Días Compensados</th>
                            <th class="text-center bg-primary">SALDO ACTUAL</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Saldos)
                        {
                            <tr>
                                <td class="fw-bold">@item.Empleado.Apellidos, @item.Empleado.Nombres</td>
                                <td>@item.Anio</td>
                                <td class="text-center">@item.DiasAcumulados.ToString("N2")</td>
                                <td class="text-center">@item.DiasDisfrutados.ToString("N2")</td>
                                <td class="text-center">@item.DiasCompensados.ToString("N2")</td>
                                <td class="text-center fw-bold text-primary">@(item.SaldoActual?.ToString("N2") ?? "0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4 py-2 small border-0 shadow-sm">
        <i class="ti ti-info-circle me-1"></i> RF-21: La acumulación de vacaciones se calcula automáticamente basándose en los días efectivamente trabajados (0.0909 por día).
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                         language: { url: '/js/i18n/es-ES.json' }
            });
        });
    </script>
}
