@model Vercom.Models.FacturaVentum
@inject Vercom.Services.IEntidadDisplayService EntidadDisplay
@{
    ViewBag.Title = "Factura de Venta #" + Model.NumeroFactura;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Comprobante de Venta Fiscal</h4>
    </div>
    <div class="text-end d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Volver al Listado</a>
        <button onclick="window.print()" class="btn btn-sm btn-light"><i class="ti ti-printer me-1"></i> Imprimir</button>
        @if (Model.Estado != "ANULADA") {
            <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#cancelModal"><i class="ti ti-ban me-1"></i> Anular Factura</button>
        }
        @if (Model.AsientoId.HasValue) {
            <a asp-controller="AsientoContable" asp-action="Details" asp-route-id="@Model.AsientoId" class="btn btn-sm btn-info"><i class="ti ti-calculator me-1"></i> Ver Asiento</a>
        }
    </div>
</div>

<div class="row mt-4">
    <div class="card border-0 shadow-sm invoice-print">
        <div class="card-body p-5">
            <!-- Cabecera -->
            <div class="row mb-5">
                <div class="col-6">
                    <h2 class="fw-bold text-primary mb-1">@EntidadDisplay.Name</h2>
                    <p class="text-muted mb-0">NIT: @Model.Entidad.Nit | REEUP: @Model.Entidad.CodigoReeup</p>
                    <p class="text-muted">@Model.Entidad.DireccionLegal</p>
                </div>
                <div class="col-6 text-end">
                    <h1 class="fw-bold text-uppercase h3 mb-0">Factura de Venta</h1>
                    <h3 class="fw-bold text-primary mb-0">@Model.Serie-@Model.NumeroFactura</h3>
                    <p class="mb-0 fw-bold">Fecha: @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                    <span class="badge @(Model.Estado == "EMITIDA" ? "bg-success" : "bg-danger")">@Model.Estado</span>
                </div>
            </div>

            <!-- Datos de las Partes -->
            <div class="row mb-4">
                <div class="col-sm-6">
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Cliente:</h6>
                    <h5 class="fw-bold mb-1">@Model.Cliente.NombreRazonSocial</h5>
                    <p class="mb-1 text-muted">NIT/CI: @Model.Cliente.NitOCi</p>
                    <p class="mb-0 text-muted">Dirección: @Model.Cliente.Direccion</p>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Información Operativa:</h6>
                    <p class="mb-1"><strong>Canal de Venta:</strong> @Model.CanalVenta</p>
                    <p class="mb-1"><strong>Tipo:</strong> @Model.TipoVenta</p>
                    @if (Model.Contrato != null) {
                        <p class="mb-0 text-primary"><strong>Contrato:</strong> @Model.Contrato.NumeroContrato</p>
                    }
                </div>
            </div>

            <!-- Tabla de Artículos -->
            <div class="table-responsive mb-5">
                <table class="table table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th width="80">Cód.</th>
                            <th>Descripción del Producto / Servicio</th>
                            <th>Cantidad</th>
                           <th>Precio Unit.</th>
                            <th>Importe</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var det in Model.FacturaVentaDetalles)
                        {
                            <tr>
                                <td class="font-monospace small">@det.Producto.Codigo</td>
                                <td>
                                    <div class="fw-bold">@det.Producto.Nombre</div>
                                    <small class="text-muted">U.M: @det.Producto.UnidadMedida.Codigo</small>
                                </td>
                                <td>@det.Cantidad.ToString("N2")</td>
                                <td>@det.PrecioUnitario.ToString("C")</td>
                               <td class="fw-bold">@det.SubtotalLinea.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Totales -->
            <div class="row justify-content-end">
                <div class="col-md-5">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <th class="text-muted">Subtotal:</th>
                           <td class="fw-bold">@Model.Subtotal.ToString("C")</td>
                        </tr>
                        @if (Model.DescuentoTotal > 0)
                        {
                            <tr>
                                <th class="text-muted">Descuento:</th>
                               <td class="text-danger fw-bold">- @Model.DescuentoTotal.ToString("C")</td>
                            </tr>
                        }
                        <tr>
                            <th class="text-muted">Impuesto sobre Ventas (10%):</th>
                           <td class="fw-bold">@Model.ImpuestoVentasTotal.ToString("C")</td>
                        </tr>
                        <tr class="border-top">
                            <th class="h4 fw-bold">TOTAL A PAGAR:</th>
                            <td class="h4 text-end text-primary fw-bold">@Model.Total.ToString("C")</td>
                        </tr>
                    </table>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.MotivoAnulacion)) {
                <div class="alert alert-danger mt-4 py-2 small">
                    <strong>Motivo de Anulación:</strong> @Model.MotivoAnulacion
                </div>
            }

            <div class="row mt-5 pt-4 text-center small text-muted">
                <div class="col-12">
                    <p>Este documento es un comprobante fiscal válido emitido por el sistema ERP de yordanisvc@gmail.com</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Anulación -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="Cancel" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Anular Factura</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <p class="text-danger fw-bold">Esta acción devolverá la mercancía al inventario y revertirá los saldos contables.</p>
                    <label class="form-label">Motivo de la anulación:</label>
                    <textarea name="reason" class="form-control" required placeholder="Ej: Error en datos del cliente o devolución total..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-danger">PROCEDER CON LA ANULACIÓN</button>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    @@media print {
        .app-topbar, .sidenav-menu, .footer, .btn, .page-title-head { display: none !important; }
        .content-page { margin-left: 0 !important; padding: 0 !important; }
        .container-xxl { max-width: 100% !important; width: 100% !important; }
        .card { border: 0 !important; box-shadow: none !important; }
        body { background: white !important; }
    }
</style>
