@model Vercom.ViewModels.SalesCreateViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Emisión de Factura de Venta</h4>
        <p class="text-muted small mb-0">Registro de ingresos y generación automática de comprobante fiscal.</p>
    </div>
</div>

<div class="container-xxl">
    <form asp-action="Create" method="post" id="invoiceForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>

        <div class="row">
            <!-- Columna Principal: Datos y Partidas -->
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="m-0 fw-bold"><i class="ti ti-user-circle me-2 text-primary"></i>Datos del Cliente y Despacho</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Seleccionar Cliente</label>
                                <select asp-for="Invoice.ClienteId" class="form-control form-select w-100 select2" asp-items="Model.Clientes" required>
                                    <option value="">-- Buscar Cliente --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Contrato Económico (Si aplica)</label>
                                <select asp-for="Invoice.ContratoId" class="form-control form-select w-100" asp-items="Model.Contratos">
                                    <option value="">-- Operación sin contrato --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Punto de Venta / Almacén</label>
                                <select asp-for="Invoice.AlmacenId" class="form-control form-select w-100" asp-items="Model.Almacenes" required></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Modalidad de Venta</label>
                                <select asp-for="Invoice.TipoVenta" class="form-control form-select w-100" id="tipoVenta">
                                    <option value="MINORISTA">Minorista (Público)</option>
                                    <option value="MAYORISTA">Mayorista (Empresarial)</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Serie Fiscal</label>
                                <input asp-for="Invoice.Serie" name="Invoice.Serie" class="form-control w-100 fw-bold text-center" value="ERP" required />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="m-0 fw-bold"><i class="ti ti-shopping-cart me-2 text-primary"></i>Detalle de Artículos</h5>
                        <button type="button" class="btn btn-sm btn-outline" onclick="addRow()">
                            <i class="ti ti-plus"></i> AÑADIR ARTÍCULO
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table mb-0" id="detailsTable">
                                <thead>
                                    <tr>
                                        <th>Producto / Servicio</th>
                                        <th width="140" class="text-end">Cantidad</th>
                                        <th width="140" class="text-end">Precio Unit. ($)</th>
                                        <th width="140" class="text-end">Importe ($)</th>
                                        <th width="60"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dinámico por JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Lateral: Resumen de Cobro -->
            <div class="col-lg-4">
                <div class="card border-primary shadow-lg">
                    <div class="card-header bg-primary text-white border-0">
                        <h5 class="m-0 fw-bold">Resumen de Operación</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Subtotal Neto:</span>
                            <span class="fw-bold" id="labelSubtotal">0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 align-items-center">
                            <span class="text-muted small">Descuento Global:</span>
                            <div class="input-group input-group-sm w-50">
                                <span class="input-group-text bg-transparent border-end-0 text-danger">-</span>
                                <input asp-for="Invoice.DescuentoTotal" name="Invoice.DescuentoTotal" class="form-control text-numeric border-start-0 text-danger w-grow" value="0.00" onchange="calculateTotals()" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Impuesto Ventas (10%):</span>
                            <span class="fw-bold" id="labelTax">0.00</span>
                        </div>
                        <hr class="border-secondary opacity-25">
                        <div class="d-flex justify-content-between align-items-end mb-4">
                            <h4 class="fw-bold mb-0">TOTAL FACTURA:</h4>
                            <h2 class="fw-bold text-primary mb-0" id="labelTotal">0.00</h2>
                        </div>

                        <div class="bg-light-subtle rounded-3 p-3 border mb-4">
                            <h6 class="tiny fw-bold text-uppercase text-muted mb-3">Gestión de Cobro</h6>
                            <div class="mb-2">
                                <label class="form-label small">Monto Recibido</label>
                                <input type="number" name="Invoice.FormaPagoVenta[0].Monto" id="pagoMonto" class="form-control w-100 fw-bold text-numeric fs-5" value="0.00" step="0.01" />
                                <input type="hidden" name="Invoice.FormaPagoVenta[0].FormaPago" value="EFECTIVO" />
                            </div>
                            <div id="alertCredito" style="display:none;" class="badge badge-soft-warning w-100 py-2 mt-2">
                                <i class="ti ti-credit-card me-1"></i> CRÉDITO PENDIENTE
                            </div>
                        </div>

                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-sm btn-primary py-3 shadow" id="btnSubmit" disabled>
                                <i class="ti ti-printer"></i> EMITIR FACTURA
                            </button>
                            <a asp-action="Index" class="btn btn-sm btn-outline">DESCARTAR</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let rowCount = 0;
        const parsedProductos = @Html.Raw(Json.Serialize(Model.ProductosDisponibles));

        function addRow() {
            const tbody = document.querySelector("#detailsTable tbody");
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>
                    <select name="Invoice.FacturaVentaDetalles[${rowCount}].ProductoId" class="form-control form-select w-100 select2" onchange="updatePrice(this, ${rowCount})" required>
                        <option value="">-- Buscar Artículo --</option>
                        ${parsedProductos.map(p => `<option value="${p.id}" data-price="${p.precioVentaActual}">${p.display}</option>`).join('')}
                    </select>
                </td>
                <td><input name="Invoice.FacturaVentaDetalles[${rowCount}].Cantidad" type="number" step="0.01" class="form-control text-numeric w-100 input-qty" value="1.00" onchange="calculateTotals()" required /></td>
                <td><input name="Invoice.FacturaVentaDetalles[${rowCount}].PrecioUnitario" type="number" step="0.01" class="form-control text-numeric w-100 input-price" value="0.00" onchange="calculateTotals()" required /></td>
                <td class="text-numeric fw-bold label-line-total">0.00</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm text-danger border-0 bg-transparent" onclick="this.closest('tr').remove(); calculateTotals();">
                        <i class="ti ti-trash fs-18"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(row);
            rowCount++;
        }

        function updatePrice(select, index) {
            const option = select.options[select.selectedIndex];
            const price = option.getAttribute('data-price') || 0;
            const row = select.closest('tr');
            row.querySelector('.input-price').value = price;
            calculateTotals();
        }

        function calculateTotals() {
            let subtotal = 0;
            document.querySelectorAll("#detailsTable tbody tr").forEach(row => {
                const qty = parseFloat(row.querySelector('.input-qty').value || 0);
                const price = parseFloat(row.querySelector('.input-price').value || 0);
                const lineTotal = qty * price;
                row.querySelector('.label-line-total').innerText = lineTotal.toLocaleString('en-US', { minimumFractionDigits: 2 });
                subtotal += lineTotal;
            });

            const discount = parseFloat(document.getElementsByName('Invoice.DescuentoTotal')[0].value || 0);
            const tax = (subtotal - discount) * 0.10;
            const total = (subtotal - discount) + tax;

            document.getElementById('labelSubtotal').innerText = subtotal.toLocaleString('en-US', { minimumFractionDigits: 2 });
            document.getElementById('labelTax').innerText = tax.toLocaleString('en-US', { minimumFractionDigits: 2 });
            document.getElementById('labelTotal').innerText = total.toLocaleString('en-US', { minimumFractionDigits: 2 });

            const pagoMontoInput = document.getElementById('pagoMonto');
            if (parseFloat(pagoMontoInput.value) === 0) pagoMontoInput.value = total.toFixed(2);

            document.getElementById('alertCredito').style.display = (parseFloat(pagoMontoInput.value) < total - 0.01) ? 'block' : 'none';
            document.getElementById('btnSubmit').disabled = total <= 0;
        }

        document.addEventListener('DOMContentLoaded', () => { addRow(); });
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
