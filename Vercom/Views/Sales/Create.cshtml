@model Vercom.Models.FacturaVentum
@{
    ViewBag.Title = "Nueva Emisión Fiscal";
    var productos = ViewBag.Productos as IEnumerable<dynamic>;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Facturación de Venta</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <form asp-action="Create" method="post" id="invoiceForm">
        <div class="row">
            <!-- Datos de Cabecera -->
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header bg-light-subtle"><h4 class="card-title">Información del Cliente y Despacho</h4></div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ClienteId" class="form-label fw-bold">Cliente</label>
                                <select asp-for="ClienteId" class="form-select select2" asp-items="ViewBag.ClienteId" required>
                                    <option value="">-- Seleccione Cliente --</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ContratoId" class="form-label fw-bold">Contrato Económico (Solo Mayoristas)</label>
                                <select asp-for="ContratoId" class="form-select" asp-items="ViewBag.ContratoId">
                                    <option value="">-- Sin Contrato (Venta Minorista) --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="AlmacenId" class="form-label fw-bold">Punto de Venta (Salida)</label>
                                <select asp-for="AlmacenId" class="form-select" asp-items="ViewBag.AlmacenId" required></select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TipoVenta" class="form-label fw-bold">Tipo de Operación</label>
                                <select asp-for="TipoVenta" class="form-select" id="tipoVenta">
                                    <option value="MINORISTA">Minorista (Final)</option>
                                    <option value="MAYORISTA">Mayorista (B2B)</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Serie" class="form-label fw-bold">Serie Fiscal</label>
                                <input asp-for="Serie" class="form-control" value="A" required />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detalle de Productos -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0">Partidas de la Factura</h4>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()">
                            <i class="ti ti-plus me-1"></i> Añadir Artículo
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table mb-0" id="detailsTable">
                            <thead class="table-light">
                                <tr>
                                    <th width="45%">Producto</th>
                                    <th width="15%" class="text-end">Cantidad</th>
                                    <th width="15%" class="text-end">Precio Unit.</th>
                                    <th width="15%" class="text-end">Importe</th>
                                    <th width="50"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Resumen y Totales -->
            <div class="col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header"><h4 class="card-title">Resumen de Cobro</h4></div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal:</span>
                            <span class="fw-bold" id="labelSubtotal">0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span class="small">Descuento:</span>
                            <input asp-for="DescuentoTotal" class="form-control form-control-sm text-end w-50" value="0.00" onchange="calculateTotals()" />
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Impuesto sobre Ventas (10%):</span>
                            <span class="fw-bold" id="labelTax">0.00</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="mb-0">TOTAL:</h3>
                            <h3 class="mb-0 text-primary" id="labelTotal">0.00</h3>
                        </div>

                        <div class="mt-4 bg-light rounded p-3">
                            <h6 class="fw-bold small text-uppercase mb-3">Medio de Pago</h6>
                            <div class="mb-3">
                                <label class="form-label small">Importe en Efectivo / Transferencia</label>
                                <input type="number" name="FormaPagoVenta[0].Monto" id="pagoMonto" class="form-control fw-bold text-end" value="0.00" />
                                <input type="hidden" name="FormaPagoVenta[0].FormaPago" value="EFECTIVO" />
                            </div>
                            <div class="alert alert-warning py-2 small" id="alertCredito" style="display:none;">
                                <i class="ti ti-credit-card me-1"></i> Se generará una cuenta por cobrar por la diferencia.
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg py-3 fw-bold" id="btnSubmit" disabled>
                                <i class="ti ti-printer me-1"></i> EMITIR Y CONTABILIZAR
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Descartar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let rowCount = 0;
        const productosOptions = `@Html.Raw(Json.Serialize(productos))`;
        const parsedProductos = JSON.parse(productosOptions);

        function addRow() {
            const tbody = document.querySelector("#detailsTable tbody");
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>
                    <select name="FacturaVentaDetalles[${rowCount}].ProductoId" class="form-select prod-select" onchange="updatePrice(this, ${rowCount})" required>
                        <option value="">-- Seleccione --</option>
                        ${parsedProductos.map(p => `<option value="${p.id}" data-price="${p.precioVentaActual}">${p.codigo} - ${p.nombre}</option>`).join('')}
                    </select>
                </td>
                <td><input name="FacturaVentaDetalles[${rowCount}].Cantidad" type="number" step="0.01" class="form-control text-end input-qty" value="1.00" onchange="calculateTotals()" required /></td>
                <td><input name="FacturaVentaDetalles[${rowCount}].PrecioUnitario" type="number" step="0.01" class="form-control text-end input-price" value="0.00" onchange="calculateTotals()" required /></td>
                <td class="text-end fw-bold label-line-total">0.00</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-link text-danger" onclick="this.closest('tr').remove(); calculateTotals();">
                        <i class="ti ti-trash"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(row);
            rowCount++;
        }

        function updatePrice(select, index) {
            const option = select.options[select.selectedIndex];
            const price = option.getAttribute('data-price') || 0;
            const row = select.closest('tr');
            row.querySelector('.input-price').value = price;
            calculateTotals();
        }

        function calculateTotals() {
            let subtotal = 0;
            document.querySelectorAll("#detailsTable tbody tr").forEach(row => {
                const qty = parseFloat(row.querySelector('.input-qty').value || 0);
                const price = parseFloat(row.querySelector('.input-price').value || 0);
                const lineTotal = qty * price;
                row.querySelector('.label-line-total').innerText = lineTotal.toLocaleString('en-US', { minimumFractionDigits: 2 });
                subtotal += lineTotal;
            });

            const discount = parseFloat(document.getElementById('DescuentoTotal').value || 0);
            const tax = (subtotal - discount) * 0.10;
            const total = (subtotal - discount) + tax;

            document.getElementById('labelSubtotal').innerText = subtotal.toLocaleString('en-US', { minimumFractionDigits: 2 });
            document.getElementById('labelTax').innerText = tax.toLocaleString('en-US', { minimumFractionDigits: 2 });
            document.getElementById('labelTotal').innerText = total.toLocaleString('en-US', { minimumFractionDigits: 2 });

            const pagoMonto = document.getElementById('pagoMonto');
            if (pagoMonto.value == 0) pagoMonto.value = total.toFixed(2);

            document.getElementById('alertCredito').style.display = (parseFloat(pagoMonto.value) < total - 0.01) ? 'block' : 'none';
            document.getElementById('btnSubmit').disabled = total <= 0;
        }

        document.getElementById('tipoVenta').addEventListener('change', function() {
            const contratoSelect = document.getElementById('ContratoId');
            if (this.value === 'MAYORISTA') {
                contratoSelect.required = true;
                contratoSelect.closest('div').classList.add('border', 'border-primary', 'rounded', 'p-2');
            } else {
                contratoSelect.required = false;
                contratoSelect.closest('div').classList.remove('border', 'border-primary', 'rounded', 'p-2');
            }
        });

        document.addEventListener('DOMContentLoaded', () => { addRow(); });
    </script>
}
