<header class="app-topbar">
    <div class="container-fluid topbar-menu">
        <div class="d-flex align-items-center gap-2">
            <!-- Topbar Brand Logo -->
            <div class="logo-topbar">
                <!-- Logo light -->
                <a asp-controller="Home" asp-action="Index" class="logo-light">
                    <span class="logo-lg">
                        <img src="~/css/images/logo.svg" alt="logo" style="height: calc(.9064rem + 1.5em + 2px); width: calc(.9064rem + 1.5em + 2px);">
                    </span>
                    <span class="logo-sm">
                        <img src="~/css/images/logo-sm.svg" alt="small logo" style="height: calc(.9064rem + 1.5em + 5px); width: calc(.9064rem + 1.5em + 2px);">
                    </span>
                </a>
                <!-- Logo Dark -->
                <a asp-controller="Home" asp-action="Index" class="logo-dark">
                    <span class="logo-lg">
                        <img src="~/css/images/logo-black.png" alt="dark logo" style="height: calc(.9064rem + 1.5em + 2px); width: calc(.9064rem + 1.5em + 2px);">
                    </span>
                    <span class="logo-sm">
                        <img src="~/css/images/logo-sm.svg" alt="small logo" style="height: calc(.9064rem + 1.5em + 5px); width: calc(.9064rem + 1.5em + 2px);">
                    </span>
                </a>
            </div>
            <!-- Sidebar Menu Toggle Button -->
            <button class="sidenav-toggle-button btn btn-primary btn-icon">
                <i class="ti ti-menu-4 fs-22"></i>
            </button>
            <!-- Horizontal Menu Toggle Button -->
            <button class="topnav-toggle-button px-2" data-bs-toggle="collapse" data-bs-target="#topnav-menu-content">
                <i class="ti ti-menu-4 fs-22"></i>
            </button>
            <!-- Search -->
            <div class="app-search d-none d-xl-flex">
                <input type="search" class="form-control topbar-search" name="search" placeholder="Buscar producto o factura...">
                <i class="ti ti-search app-search-icon text-muted"></i>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Light/Dark Mode Button -->
            <div id="theme-toggler" class="topbar-item d-none d-sm-flex">
                <button class="topbar-link" id="light-dark-mode" type="button">
                    <i class="ti ti-moon topbar-link-icon mode-light-moon"></i>
                    <i class="ti ti-sun topbar-link-icon mode-light-sun"></i>
                </button>
            </div>
            <div id="fullscreen-toggler" class="topbar-item d-none d-md-flex">
                <button class="topbar-link" type="button">
                    <i class="ti ti-maximize topbar-link-icon"></i>
                    <i class="ti ti-minimize topbar-link-icon d-none"></i>
                </button>
            </div>
            <div id="monochrome-toggler" class="topbar-item d-none d-xl-flex">
                <button id="monochrome-mode" class="topbar-link" type="button">
                    <i class="ti ti-palette topbar-link-icon"></i>
                </button>
            </div>
            <!-- Feedback Button -->
            <div class="topbar-item d-none d-sm-flex">
                <button class="topbar-link" type="button" data-bs-toggle="modal" data-bs-target="#feedbackModal">
                    <i class="ti ti-message-report topbar-link-icon" title="Enviar Sugerencia"></i>
                </button>
            </div>
            <div id="notification-dropdown-alert" class="topbar-item">
                <div class="dropdown" id="notification-dropdown">
                    <button class="topbar-link dropdown-toggle drop-arrow-none" data-bs-toggle="dropdown" data-bs-auto-close="outside" type="button" aria-haspopup="false" aria-expanded="false">
                        <i class="ti ti-bell fs-xxl"></i>
                        <span class="badge badge-square text-bg-warning topbar-badge d-none" id="notification-count">0</span>
                    </button>
                    <div class="dropdown-menu p-0 dropdown-menu-end dropdown-menu-lg">
                        @Html.AntiForgeryToken()
                        <div class="px-3 py-2 border-bottom d-flex align-items-center justify-content-between gap-2">
                            <h6 class="m-0 fs-md fw-semibold">Notificaciones</h6>
                            <button type="button" class="btn btn-icon btn-sm btn-ghost-primary" id="notification-mark-all" title="Marcar todas como leídas">
                                <i class="ti ti-checks"></i>
                            </button>
                        </div>
                        <div class="px-2 pt-2 border-bottom">
                            <div class="btn-group w-100" role="group" aria-label="Filtro de estado">
                                <button type="button" class="btn btn-sm btn-light notification-filter active" data-filtro="all">Todas</button>
                                <button type="button" class="btn btn-sm btn-light notification-filter" data-filtro="noleidas"><i class="ti ti-bell-pause me-1"></i>No leídas</button>
                            </div>
                            <div class="d-flex gap-1 my-2" role="group" aria-label="Filtro por tipo">
                                <button type="button" class="btn btn-sm btn-icon btn-outline-secondary notification-type-filter" data-tipo="" title="Todos los tipos"><i class="ti ti-list"></i></button>
                                <button type="button" class="btn btn-sm btn-icon btn-outline-info notification-type-filter" data-tipo="info" title="Información"><i class="ti ti-info-circle"></i></button>
                                <button type="button" class="btn btn-sm btn-icon btn-outline-success notification-type-filter" data-tipo="success" title="Éxito"><i class="ti ti-circle-check"></i></button>
                                <button type="button" class="btn btn-sm btn-icon btn-outline-warning notification-type-filter" data-tipo="warning" title="Advertencia"><i class="ti ti-alert-triangle"></i></button>
                                <button type="button" class="btn btn-sm btn-icon btn-outline-danger notification-type-filter" data-tipo="danger" title="Crítico"><i class="ti ti-alert-octagon"></i></button>
                            </div>
                        </div>
                        <div style="max-height: 340px; overflow-y: auto;">
                            <div id="notification-stock">
                                <!-- Dinámico -->
                            </div>
                        </div>
                        <a href="@Url.Action("Index", "Notificacion")" class="dropdown-item text-center text-reset text-decoration-underline link-offset-2 fw-bold notify-item border-top border-light py-2">Ver todas</a>
                    </div>
                </div>
            </div>            
            <div class="topbar-item d-none d-sm-flex">
                <button class="topbar-link btn-theme-setting" data-bs-toggle="offcanvas" data-bs-target="#theme-settings-offcanvas" type="button">
                    <i class="ti ti-settings topbar-link-icon"></i>
                </button>
            </div>
            <!-- User Dropdown -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="topbar-item nav-user">
                    <div class="dropdown">
                        <a class="topbar-link dropdown-toggle drop-arrow-none px-2" data-bs-toggle="dropdown" href="#!" aria-haspopup="false" aria-expanded="false">
                            <img src="~/css/images/users/user.png" width="32" class="rounded-circle me-lg-2 d-flex" alt="user-image">
                            <div class="d-lg-flex align-items-center gap-1 d-none">
                                <h5 class="my-0">@User.Identity.Name</h5>
                                <i class="ti ti-chevron-down align-middle"></i>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <div class="dropdown-header noti-title">
                                <h6 class="text-overflow m-0">Bienvenido!</h6>
                            </div>
                            <a asp-controller="Entidad" asp-action="Details" class="dropdown-item">
                                <i class="ti ti-building me-2 fs-17 align-middle"></i>
                                <span class="align-middle">Mi Entidad</span>
                            </a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="dropdown-item text-danger fw-semibold" type="submit">
                                    <i class="ti ti-logout-2 me-2 fs-17 align-middle"></i>
                                    <span class="align-middle">Salir</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</header>

<!-- Global Feedback Modal -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header border-0 bg-primary text-white p-4">
                <h5 class="modal-title fw-bold">¿En qué podemos mejorar?</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formFeedback">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="text-muted small mb-4">Sus sugerencias y reportes nos ayudan a construir un mejor ERP Vercom Elite.</p>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tipo de Comunicación</label>
                        <select id="fbTipo" class="form-select" required>
                            <option value="SUGERENCIA">Sugerencia de Mejora</option>
                            <option value="ERROR">Reportar un Error / Bug</option>
                            <option value="FELICITACION">Felicitación</option>
                            <option value="SOPORTE">Solicitud de Soporte Técnico</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-bold">Su mensaje</label>
                        <textarea id="fbMensaje" class="form-control" rows="4" placeholder="Escriba aquí..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" class="btn btn-primary px-4 shadow" onclick="submitGlobalFeedback()">
                        <i class="ti ti-send me-1"></i> ENVIAR AHORA
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function submitGlobalFeedback() {
        const msg = document.getElementById('fbMensaje').value;
        if (!msg) return;

        const data = {
            tipo: document.getElementById('fbTipo').value,
            mensaje: msg,
            metadata: JSON.stringify({
                url: window.location.href,
                agent: navigator.userAgent,
                screen: `${window.innerWidth}x${window.innerHeight}`
            })
        };

        const formData = new FormData();
        formData.append("tipo", data.tipo);
        formData.append("mensaje", data.mensaje);
        formData.append("metadata", data.metadata);
        formData.append("__RequestVerificationToken", document.querySelector('#formFeedback input[name="__RequestVerificationToken"]').value);

        fetch('/Feedback/Send', {
            method: 'POST',
            body: formData
        }).then(res => res.json()).then(res => {
            if (res.success) {
                bootstrap.Modal.getInstance(document.getElementById('feedbackModal')).hide();
                document.getElementById('fbMensaje').value = '';
                window.SwalAlert('success', "Su mensaje ha sido enviado al equipo de soporte.", "¡Gracias!");
            }
        });
    }
</script>
