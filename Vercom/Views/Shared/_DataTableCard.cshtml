@model Vercom.ViewModels.DataTableCardModel
@{
    var tableId = Model.TableId ?? "dataTable";
    var showCreate = Model.CreateAction != null;
    var showFilters = Model.Filters?.Any() == true;
}
<div class="row justify-content-center">
    <div class="@(Model.ColumnClass ?? "col-xxl-12")">
        <div class="card border-0 shadow-sm">
            @if (!string.IsNullOrEmpty(Model.Title) || showCreate)
            {
                <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
                    @if (!string.IsNullOrEmpty(Model.Title))
                    {
                        <h5 class="card-title m-0 fw-bold">@Model.Title</h5>
                    }
@if (showCreate)
            {
                var createUrl = Url.Action(Model.CreateAction.Action, Model.CreateAction.Controller);
                if (!string.IsNullOrEmpty(Model.CreateAction.Id))
                {
                    createUrl += $"?id={Model.CreateAction.Id}";
                }
                <a href="@createUrl" class="btn btn-sm btn-primary shadow-sm">
                    <i class="ti ti-plus me-1"></i> @Model.CreateAction.Text
                </a>
            }
                </div>
            }
            <div class="card-body p-0">
                @if (showFilters)
                {
                    <div class="card-body p-3 border-bottom bg-light-subtle">
                        <form method="get" class="row g-2 align-items-end" id="@($"{tableId}-filters")">
                            @foreach (var filter in Model.Filters)
                            {
                                <div class="@filter.ColumnClass">
                                    <label class="form-label small fw-bold mb-1">@filter.Label</label>
@if (filter.Options != null)
                                    {
                                        var onchange = filter.AutoSubmit ? "this.form.submit()" : "";
                                        <select name="@filter.Name" class="form-select form-select-sm" asp-items="filter.Options">
                                            <option value="">@(filter.Placeholder ?? "-- Todos --")</option>
                                        </select>
                                        @if (!string.IsNullOrEmpty(onchange))
                                        {
                                            <script>
                                                $(function() {
                                                    $('select[name="@filter.Name"]').on('change', function() { @onchange; });
                                                });
                                            </script>
                                        }
                                    }
                                    else
                                    {
                                        <input type="@(filter.Type ?? "text")" name="@filter.Name" value="@filter.Value" class="form-control form-control-sm" placeholder="@filter.Placeholder" @filter.Attributes />
                                    }
                                </div>
                            }
                            @if (Model.ShowClearButton)
                            {
                                <div class="col-auto">
                                    <a href="@Model.ClearUrl" class="btn btn-light w-100"><i class="ti ti-refresh me-1"></i> LIMPIAR</a>
                                </div>
                            }
                        </form>
                    </div>
                }
                <div class="table-responsive">
                    <table id="@tableId" class="table table-striped table-hover dt-responsive mb-0" style="width:100%">
                        <thead class="thead-light text-uppercase fs-xxs">
                            <tr>
                                @foreach (var col in Model.Columns)
                                {
                                    <th scope="col" @if (!string.IsNullOrEmpty(col.Width)) { <text>style="width:@col.Width"</text> }>@col.Header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Rows?.Any() == true)
                            {
                                @foreach (var row in Model.Rows)
                                {
                                    <tr @row.Attributes>
                                        @foreach (var col in Model.Columns)
                                        {
                                            var value = row.GetValue(col.Key);
                                            <td @col.TdAttributes>@(col.Template != null ? col.Template(value, row) : value)</td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@Model.Columns.Count" class="text-center py-4 text-muted">
                                        @(Model.EmptyMessage ?? "Sin registros")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#@tableId').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[@Model.SortColumnIndex, '@Model.SortDirection']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
                responsive: true
            });
        });
    </script>
}