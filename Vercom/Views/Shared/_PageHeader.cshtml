@model VERCOM.ViewModels.PageHeaderModel
<div class="page-title-head d-flex align-items-center">
    @if (!string.IsNullOrWhiteSpace(Model.Icon))
    {
        <span class="ux-header-icon"><i class="ti @Model.Icon"></i></span>
    }
    <div class="ux-header-text">
        @if (!string.IsNullOrWhiteSpace(Model.Eyebrow))
        {
            <span class="ux-eyebrow">@Model.Eyebrow</span>
        }
        <h4 class="ux-header-title">@Model.Title</h4>
        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <p class="ux-header-subtitle">@Model.Subtitle</p>
        }
    </div>
    <div class="ux-header-actions">
        @if (!string.IsNullOrWhiteSpace(Model.BadgeText))
        {
            <span class="badge">@Model.BadgeText</span>
        }
        @if (Model.ActionsHtml != null)
        {
            @Model.ActionsHtml
        }
    </div>  
</div>
