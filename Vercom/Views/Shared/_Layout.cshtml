<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>VERCOM ELITE | @ViewBag.Title</title>
    <!-- App favicon -->
    <link rel="shortcut icon" href="assets/images/favicon.ico">
    <!-- Datatables css -->
    <link href="~/css/plugins/datatables/responsive.bootstrap5.min.css" rel="stylesheet" type="text/css">
    <!-- Theme Config Js -->
    <script src="~/js/config.js"></script>
    <!-- Vendor css -->
    <link href="~/css/vendors.min.css" rel="stylesheet" type="text/css">
    <!-- App css -->
    <link href="~/css/app.min.css" rel="stylesheet" type="text/css">
    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", required: false)
    }
    </head>
    <body>
    <div class="wrapper">
        <partial name="_TopBar" />
        <partial name="_SideNav" />
        <div class="content-page">
            <div class="container-fluid">
                @RenderBody()
            </div>
            <partial name="_Footer" />
        </div>
    </div>
    <partial name="_Theme" />
    <!-- Vendor js -->
    <script src="~/js/vendors.min.js"></script>
    <!-- App js -->
    <script src="~/js/app.js"></script>
    <!-- Datatables js -->
    <script src="~/js/plugins/datatables/dataTables.min.js"></script>
    <script src="~/js/plugins/datatables/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/plugins/datatables/dataTables.responsive.min.js"></script>
    <script src="~/js/plugins/datatables/responsive.bootstrap5.min.js"></script>    
    <!-- Page js -->
    <script src="~/js/pages/datatables-ajax.js"></script>
    @*     <script>
        // Global SignalR Integration
        if (typeof signalR !== 'undefined') {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/notifications")
                .withAutomaticReconnect()
                .build();

            connection.on("NotificationReceived", (data) => {
                console.log("Sync Alert:", data);
            });

            connection.start().catch(err => console.log("SignalR hub connection deferred."));
        }
    </script> *@
    @RenderSection("Scripts", required: false)
</body>
</html>
