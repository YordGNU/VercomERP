<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>VERCOM ELITE | @ViewBag.Title</title>
       <!-- App favicon -->
    <link rel="shortcut icon" href="~/Content/images/favicon.ico">
    <!-- Theme Config Js -->
    <script src="~/js/config_1.js"></script>
    <!-- Vendor css -->
    <link href="~/css/vendors.min.css" rel="stylesheet" type="text/css">
    <!-- App css -->
    <link id="app-style" href="~/css/app.min.css" rel="stylesheet" type="text/css">
    <link href="~/js/plugins/dataTables/dataTables.bootstrap5.min.js" rel="stylesheet" />

    <link href="~/css/animate.css" rel="stylesheet" type="text/css">
    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", required: false)
    }
</head>
<body>
    <div id="global-loader">
        <div class="spinner"></div>
    </div>
    <div class="wrapper">
        <partial name="_TopBar" />
        <partial name="_SideNav" />
        <div class="content-page">
            <div class="container-fluid">
                @RenderBody()
            </div>
            <partial name="_Footer" />
        </div>
    </div>
    <partial name="_Theme" />
    <!-- Scripts -->
    <!-- Vendor js -->
    <script src="~/js/vendors.min.js"></script>
    <script src="~/js/plugins/dataTables/jquery.dataTables.min.js"></script>
    <script src="~/js/plugins/dataTables/dataTables.bootstrap5.min.js"></script>
    <!-- App js -->
    <script src="~/js/app.js"></script>
    <!-- Dashboard js -->
    <script src="~/js/config.js"></script>
    <script src="~/js/plugins/sweetalert/sweetalert2@11.js"></script>
    <script src="~/js/ajax/ajax.js"></script>
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script>
        // Global SignalR
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/notifications")
            .withAutomaticReconnect()
            .build();

        connection.on("NotificationReceived", (data) => {
            console.log("Sync Alert:", data);
        });

        connection.start().catch(err => console.log("SignalR not active yet."));
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
