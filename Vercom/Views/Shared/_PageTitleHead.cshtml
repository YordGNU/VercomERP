@model VERCOM.ViewModels.PageTitleHeadModel
@{
    var showBreadcrumb = Model.ShowBreadcrumb;
    var primaryActionUrl = "";
    if (Model.PrimaryAction is { } primaryAction)
    {
        primaryActionUrl = Url.Action(primaryAction.Action, primaryAction.Controller) ?? "#";
        if (!string.IsNullOrEmpty(primaryAction.Id))
        {
            primaryActionUrl += $"?id={primaryAction.Id}";
        }
    }
}
<div class="page-title-head d-flex align-items-center @(Model.Padding ? "p-3" : "") mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">@Model.Title</h4>
        @if (!string.IsNullOrEmpty(Model.Subtitle))
        {
            <p class="text-muted small mb-0">@Model.Subtitle</p>
        }
    </div>
    <div class="text-end d-flex align-items-center gap-3">
        @if (Model.PrimaryAction is { } action)
        {
            <a href="@primaryActionUrl" class="btn btn-primary shadow-sm">
            @if (!string.IsNullOrEmpty(action.Icon)) { <i class="@action.Icon me-1"></i> }
            @action.Text
            </a>
        }
        @if (showBreadcrumb && Model.BreadcrumbItems?.Any() == true)
        {
            <ol class="breadcrumb m-0 py-0">
                @foreach (var item in Model.BreadcrumbItems)
                {
                    if (item.IsActive)
                    {
                        <li class="breadcrumb-item active" aria-current="page">@item.Text</li>
                    }
                    else if (!string.IsNullOrEmpty(item.Url))
                    {
                        <li class="breadcrumb-item"><a href="@item.Url">@item.Text</a></li>
                    }
                    else
                    {
                        <li class="breadcrumb-item">@item.Text</li>
                    }
                }
            </ol>
        }
    </div>
</div>