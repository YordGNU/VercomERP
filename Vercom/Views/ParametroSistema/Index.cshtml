@model IEnumerable<Vercom.Models.ParametroSistema>
@{
    ViewBag.Title = "Parámetros del Sistema";
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Administración", Title = "Configuración: Parámetros del ERP", Subtitle = "Control de tasas impositivas, escalas salariales y reglas de negocio globales.", Icon = "ti-settings-plus me-1", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light-subtle">
                <h5 class="m-0 fw-bold"><i class="ti ti-adjustments-horizontal me-2 text-primary"></i>Variables de Entorno y Fiscalidad</h5>
            </div>
            <div class="card-body">
                <table id="paramsTable" class="table table-striped table-hover dt-responsive">
                    <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th class="ps-4">Código / Clave</th>
                            <th>Descripción</th>
                            <th>Valor Actual</th>
                            <th>Tipo</th>
                            <th>Vigente Desde</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(p => p.Codigo))
                        {
                            var isExpired = item.VigenteHasta != null && item.VigenteHasta < DateOnly.FromDateTime(DateTime.Now);
                            <tr>
                                <td>
                                    <code class="fw-bold fs-13 text-primary">@item.Codigo</code>
                                </td>
                                <td class="small">@item.Descripcion</td>
                                <td>
                                    <span class="badge border border-primary text-primary px-3 py-1 fs-13">@item.Valor</span>
                                </td>
                                <td small text-muted">@item.TipoDato</td>
                                <td small">
                                    @item.VigenteDesde.ToString("dd/MM/yyyy")
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-danger-subtle text-danger ms-1">CADUCADO</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-list justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle">
                                            <i class="ti ti-history"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card mt-4 border-info-subtle bg-info-subtle bg-opacity-10">
            <div class="card-body">
                <h5 class="fw-bold text-info mb-2 small text-uppercase">Directriz de Control Interno</h5>
                <p class="text-muted small mb-0">
                    Los parámetros versionados permiten que el ERP conserve la validez histórica de cálculos pasados.
                    <strong>No modifique parámetros vigentes</strong> a menos que sea una corrección de error; para cambios normativos, cree una nueva versión con fecha futura.
                </p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#paramsTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },                
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
            });
        });
    </script>
}
