@model Vercom.ViewModels.ParametroFormViewModel
@{
    ViewBag.Title = "Editar Parámetro del Sistema";
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Administración", Title = "Editar Parámetro del Sistema", Subtitle = "Modificación de tasas, escalas y reglas de negocio globales.", Icon = "ti-settings", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light-subtle py-3 d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold text-primary"><i class="ti ti-edit me-2"></i>Modificar Parámetro</h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="ti ti-arrow-left me-1"></i> VOLVER
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" class="row g-3" id="editParametroForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Parametro.Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                    <div class="col-md-12">
                        <label asp-for="Parametro.EntidadId" class="form-label fw-bold"></label>
                        <input asp-for="Parametro.EntidadId" class="form-control" readonly />
                        <span asp-validation-for="Parametro.EntidadId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Parametro.Codigo" class="form-label fw-bold"></label>
                        <input asp-for="Parametro.Codigo" class="form-control fw-bold text-uppercase" required />
                        <span asp-validation-for="Parametro.Codigo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Parametro.TipoDato" class="form-label fw-bold"></label>
                        <input asp-for="Parametro.TipoDato" class="form-control" required />
                        <span asp-validation-for="Parametro.TipoDato" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Parametro.Valor" class="form-label fw-bold"></label>
                        <input asp-for="Parametro.Valor" class="form-control" required />
                        <span asp-validation-for="Parametro.Valor" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Parametro.Descripcion" class="form-label fw-bold"></label>
                        <input asp-for="Parametro.Descripcion" class="form-control" />
                        <span asp-validation-for="Parametro.Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Parametro.VigenteDesde" class="form-label fw-bold"></label>
                        <input asp-for="Parametro.VigenteDesde" class="form-control" />
                        <span asp-validation-for="Parametro.VigenteDesde" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Parametro.VigenteHasta" class="form-label fw-bold"></label>
                        <input asp-for="Parametro.VigenteHasta" class="form-control" />
                        <span asp-validation-for="Parametro.VigenteHasta" class="text-danger small"></span>
                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2 mt-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-sm btn-outline px-4">CANCELAR</a>
                        <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                            <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('editParametroForm');
        });
    </script>
}
