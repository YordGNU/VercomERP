@model Vercom.Models.AnalisisDesviacion

@{
    ViewData["Title"] = "Crear Análisis de Desviación";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Crear Análisis de Desviación</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Producción</a></li>
            <li class="breadcrumb-item active">Análisis de Desviación</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Creación</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-md-6">
                            <label asp-for="OrdenProduccionId" class="form-label"></label>
                            <select asp-for="OrdenProduccionId" class="form-select" asp-items="ViewBag.OrdenProduccionId"></select>
                            <span asp-validation-for="OrdenProduccionId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Componente" class="form-label"></label>
                            <input asp-for="Componente" class="form-control" placeholder="Componente o material" />
                            <span asp-validation-for="Componente" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CostoEstandar" class="form-label"></label>
                            <input asp-for="CostoEstandar" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="CostoEstandar" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CostoReal" class="form-label"></label>
                            <input asp-for="CostoReal" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="CostoReal" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}