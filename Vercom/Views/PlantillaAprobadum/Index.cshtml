@model Vercom.ViewModels.PlantillaStatusViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Plantilla de Cargos (RF-26)</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h4 class="card-title mb-0">Comparativo Aprobada vs. Cubierta</h4>
            <span class="badge bg-primary">Tiempo Real</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="dataTable" class="table table-hover align-middle w-100">
                    <thead class="table-dark">
                        <tr>
                            <th>Cargo / Ocupación</th>
                            <th>Unidad / Sucursal</th>
                            <th class="text-center">Aprobadas</th>
                            <th class="text-center">Cubiertas</th>
                            <th class="text-center">Disponibles</th>
                            <th width="200">Estado de Cobertura</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var colorClass = row.PorcentajeOcupacion >= 100 ? "bg-success" : (row.PorcentajeOcupacion > 50 ? "bg-warning" : "bg-danger");
                            <tr>
                                <td class="fw-bold">@row.Cargo</td>
                                <td>@row.Sucursal</td>
                                <td class="text-center">@row.Aprobadas</td>
                                <td class="text-center fw-bold">@row.Cubiertas</td>
                                <td class="text-center text-muted">@row.Disponibles</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar @colorClass" role="progressbar" style="width: @row.PorcentajeOcupacion%"></div>
                                        </div>
                                        <span class="small fw-bold">@row.PorcentajeOcupacion.ToString("N0")%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                    language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'asc']]
            });
        });
    </script>
}
