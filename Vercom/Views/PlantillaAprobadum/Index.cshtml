@using Vercom.Security
@inject IEntidadProvider EntidadProvider
@model Vercom.ViewModels.PlantillaStatusViewModel
@inject Vercom.Services.IEntidadDisplayService EntidadDisplay
@{
    ViewBag.Title = "Plantilla de Cargos";
    var isMaster = EntidadProvider.IsMaster;
}
<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Plantilla de Cargos y Ocupaciones</h4>
        <p class="text-muted small mb-0">Control de plazas aprobadas vs. cubiertas por unidad organizativa</p>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus me-1"></i> GESTIONAR PLAZAS
        </a>
    </div>
</div>
<!-- Barra de Filtros -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold">Unidad / Sucursal</label>
                <select name="sucursalId" class="form-select select2" asp-items="ViewBag.SucursalId" onchange="this.form.submit()">
                    <option value="">-- Todas las Unidades --</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-bold">Buscar por Cargo</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="ti ti-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Escriba el nombre del puesto..." value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">APLICAR FILTROS</button>
                <a asp-action="Index" class="btn btn-light" title="Limpiar"><i class="ti ti-refresh"></i></a>
            </div>
        </form>
    </div>
</div>
<div class="card">
    <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
        <h5 class="m-0 fw-bold"><i class="ti ti-users-group me-2 text-primary"></i>Estado de Cobertura de Plantilla (@Model.Rows.Count)</h5>
        <span class="badge badge-soft-success">Sincronizado en Tiempo Real</span>
    </div>
    <div class="card-body">
        <table id="plantillaTable" class="table table-striped table-hover dt-responsive">
              <thead class="thead-sm text-uppercase fs-xxs">
                <tr>
                    <th>Cargo / Puesto</th>
                    @if (isMaster)
                    {
                        <th>Entidad</th>
                    }
                    <th>Unidad / Sucursal</th>
                    <th>Aprobadas</th>
                    <th>Cubiertas</th>
                    <th>Disponibles</th>
                    <th>Cobertura</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    var isFull = row.PorcentajeCobertura >= 100;
                    var isCritical = row.PorcentajeCobertura < 50;
                    var colorClass = isFull ? "bg-success" : (isCritical ? "bg-danger" : "bg-warning");

                    <tr>
                      <td>
                            <div class="fw-bold fs-14">@row.Cargo</div>
                            @if (isMaster)
                            {
                                <small class="text-muted tiny">ID: @row.Id.ToString().Substring(0, 8)</small>
                            }
                        </td>
                        @if (isMaster)
                        {
                            <td><small class="fw-bold text-uppercase">@EntidadDisplay.Name</small></td>
                        }
                        <td>
                            <span class="badge badge-outline text-muted">@row.Sucursal</span>
                        </td>
                        <td class="fw-semibold">@row.Aprobadas</td>
                        <td class="fw-bold text-primary">@row.Cubiertas</td>
                       <td>
                            <span class="badge @(row.Vacantes > 0 ? "bg-info-subtle text-info" : "bg-light text-muted")">
                                @row.Vacantes
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar @colorClass" role="progressbar" style="width: @(Math.Min(row.PorcentajeCobertura, 100))%"></div>
                                </div>
                                <span class="small fw-bold">@row.PorcentajeCobertura.ToString("N0")%</span>
                            </div>
                        </td>
                        <td>
                            <div class="btn-list justify-content-end">
                                <a asp-controller="Empleado" asp-action="Index" asp-route-cargoId="@row.CargoId" asp-route-sucursalId="@row.SucursalId" class="btn btn-sm btn-icon btn-light rounded-circle" title="Ver Personal">
                                    <i class="ti ti-users"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@row.Id" class="btn btn-sm btn-icon btn-light rounded-circle" title="Editar Plazas">
                                    <i class="ti ti-edit"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-icon btn-light rounded-circle text-danger" onclick="deletePlaza('@row.Id', '@row.Cargo')" title="Eliminar">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function() {
            $('#plantillaTable').DataTable({
                pageLength: 100,
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
                responsive: true,
            });
        });
        function deletePlaza(id, cargo) {
            Swal.fire({
                title: '¿Eliminar plaza?',
                text: `Se eliminará la configuración de plazas para el cargo: ${cargo}`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'SÍ, ELIMINAR'
            }).then((result) => {
                if (result.isConfirmed) {
                    const formData = new FormData();
                    formData.append("id", id);
                    formData.append("__RequestVerificationToken", $('input[name="__RequestVerificationToken"]').val());

                    fetch('/PlantillaAprobadum/Delete', {
                        method: 'POST',
                        body: formData
                    }).then(res => res.json()).then(data => {
                        if (data.success) {
                            window.SwalAlert('success', data.message);
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    });
                }
            });
        }
    </script>
    <style>
        .fs-14 {
            font-size: 0.875rem;
        }
    </style>
}


