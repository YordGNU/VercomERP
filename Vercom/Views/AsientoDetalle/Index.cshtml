@model IEnumerable<Vercom.Models.AsientoDetalle>

@{
    ViewData["Title"] = "Index";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Gestión de AsientoDetalle</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">AsientoDetalle</a></li>
            <li class="breadcrumb-item active">Listado</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Listado de AsientoDetalle</h4>
                </div>
                <div class="card-body">



<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="table-responsive"><table class="table data-table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Linea)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TerceroTipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TerceroId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Debe)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Haber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Glosa)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Asiento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CentroCosto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cuenta)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Linea)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TerceroTipo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TerceroId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Debe)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Haber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Glosa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Asiento.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CentroCosto.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cuenta.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table></div>
                </div>
            </div>
        </div>
    </div>
</div>
