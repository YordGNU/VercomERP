@model IEnumerable<Vercom.Models.MovimientoInventario>
@{
    ViewBag.Title = "Registro de Movimientos";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Bitácora de Almacén</h4>
    </div>
    <div class="text-end">
        <a asp-action="CreateMovement" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Registrar Operación
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Nº Documento</th>
                            <th>Tipo Movimiento</th>
                            <th>Origen</th>
                            <th>Destino</th>
                            <th class="text-center">Canal</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var typeClass = item.TipoMovimiento.Naturaleza == "ENTRADA" ? "text-success" : (item.TipoMovimiento.Naturaleza == "SALIDA" ? "text-danger" : "text-primary");

                            <tr>
                                <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold">@item.NumeroDocumento</td>
                                <td class="fw-bold @typeClass">@item.TipoMovimiento.Nombre</td>
                                <td>@(item.AlmacenOrigen?.Nombre ?? "-")</td>
                                <td>@(item.AlmacenDestino?.Nombre ?? "-")</td>
                                <td class="text-center">
                                    <span class="badge @(item.Canal == "POS" ? "bg-info" : "bg-dark")">@item.Canal</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light" title="Ver Documento Primario">
                                        <i class="ti ti-file-text"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
