@model Vercom.Models.MovimientoInventario
@{
    ViewBag.Title = "Nueva Operación de Almacén";
    var productos = ViewBag.Productos as IEnumerable<dynamic>;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Emisión de Documento Primario</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <form asp-action="CreateMovement" method="post" id="movementForm">
        <div class="row">
            <!-- Datos de Cabecera -->
            <div class="col-lg-12 mb-4">
                <div class="card">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label asp-for="TipoMovimientoId" class="form-label fw-bold">Tipo de Operación</label>
                                <select asp-for="TipoMovimientoId" class="form-select" asp-items="ViewBag.TipoMovimientoId" required></select>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="NumeroDocumento" class="form-label fw-bold">Nº de Vale / Informe</label>
                                <input asp-for="NumeroDocumento" class="form-control" placeholder="Ej: REC-2026-001" required />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Fecha" class="form-label fw-bold">Fecha Operación</label>
                                <input asp-for="Fecha" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Responsable</label>
                                <input type="text" class="form-control" value="@User.Identity.Name" readonly />
                            </div>

                            <div class="col-md-6" id="divOrigen">
                                <label asp-for="AlmacenOrigenId" class="form-label fw-bold">Almacén de Salida (Origen)</label>
                                <select asp-for="AlmacenOrigenId" class="form-select" asp-items="ViewBag.Almacenes">
                                    <option value="">-- No aplica --</option>
                                </select>
                            </div>
                            <div class="col-md-6" id="divDestino">
                                <label asp-for="AlmacenDestinoId" class="form-label fw-bold">Almacén de Entrada (Destino)</label>
                                <select asp-for="AlmacenDestinoId" class="form-select" asp-items="ViewBag.Almacenes">
                                    <option value="">-- No aplica --</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label asp-for="Observaciones" class="form-label fw-bold">Observaciones / Justificación</label>
                                <textarea asp-for="Observaciones" class="form-control" rows="2" placeholder="Describa el motivo del movimiento..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabla de Productos -->
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="card-title mb-0">Listado de Artículos</h4>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRow()">
                            <i class="ti ti-plus me-1"></i> Añadir Producto
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table mb-0" id="detailsTable">
                            <thead class="table-light">
                                <tr>
                                    <th width="40%">Producto</th>
                                    <th width="15%">Cantidad</th>
                                    <th width="15%">Costo Unitario ($)</th>
                                    <th>Lote / Vencimiento</th>
                                    <th width="50"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Dinámico -->
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer d-flex justify-content-end gap-2">
                        <a asp-action="Movements" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary btn-lg px-5" id="btnSubmit">
                            <i class="ti ti-device-floppy me-1"></i> REGISTRAR MOVIMIENTO
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let rowCount = 0;
        const productosOptions = `@Html.Raw(Json.Serialize(productos))`;
        const parsedProductos = JSON.parse(productosOptions);

        function addRow() {
            const tbody = document.querySelector("#detailsTable tbody");
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>
                    <select name="MovimientoInventarioDetalles[${rowCount}].ProductoId" class="form-select select2" required>
                        <option value="">-- Seleccione Articulo --</option>
                        ${parsedProductos.map(p => `<option value="${p.id}">${p.display}</option>`).join('')}
                    </select>
                </td>
                <td><input name="MovimientoInventarioDetalles[${rowCount}].Cantidad" type="number" step="0.0001" class="form-control text-end" value="1.0000" required /></td>
                <td><input name="MovimientoInventarioDetalles[${rowCount}].CostoUnitario" type="number" step="0.01" class="form-control text-end" placeholder="Opcional" /></td>
                <td>
                    <div class="input-group input-group-sm">
                        <input name="MovimientoInventarioDetalles[${rowCount}].Lote" class="form-control" placeholder="Lote" />
                        <input name="MovimientoInventarioDetalles[${rowCount}].FechaVencimiento" type="date" class="form-control" />
                    </div>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-link text-danger" onclick="this.closest('tr').remove();">
                        <i class="ti ti-trash"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(row);
            rowCount++;
        }

        // Al iniciar, añadir una fila
        document.addEventListener('DOMContentLoaded', () => {
            addRow();
        });
    </script>
}
