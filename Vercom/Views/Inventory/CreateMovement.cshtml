@model Vercom.ViewModels.InventoryMovementCreateViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Emisión de Documento Primario de Almacén</h4>
        <p class="text-muted small mb-0">Registro oficial de vales de recepción, entrega o transferencias (RF-30).</p>
    </div>
</div>

<div class="container-xxl">
    <form asp-action="CreateMovement" method="post" id="movementForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>

        <div class="row">
            <!-- Columna Izquierda: Datos del Documento -->
            <div class="col-lg-12">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="m-0 fw-bold"><i class="ti ti-file-certificate me-2 text-primary"></i>Datos de la Operación</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-3">
                                <label class="form-label">Tipo de Movimiento</label>
                                <select asp-for="Movement.TipoMovimientoId" name="Movement.TipoMovimientoId" class="form-control form-select w-100" asp-items="Model.TiposMovimiento" required></select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Nº de Documento (Vale)</label>
                                <input asp-for="Movement.NumeroDocumento" name="Movement.NumeroDocumento" class="form-control w-100 fw-bold text-primary text-center" placeholder="REC-0001" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Fecha de Ejecución</label>
                                <input asp-for="Movement.Fecha" name="Movement.Fecha" type="datetime-local" class="form-control w-100" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Ejecutante</label>
                                <input type="text" class="form-control w-100 bg-light-subtle" value="@User.Identity.Name" readonly />
                            </div>

                            <div class="col-md-6" id="divOrigen">
                                <label class="form-label">Almacén de Origen (Salida)</label>
                                <select asp-for="Movement.AlmacenOrigenId" name="Movement.AlmacenOrigenId" class="form-control form-select w-100" asp-items="Model.Almacenes">
                                    <option value="">-- Procedencia Externa --</option>
                                </select>
                            </div>
                            <div class="col-md-6" id="divDestino">
                                <label class="form-label">Almacén de Destino (Entrada)</label>
                                <select asp-for="Movement.AlmacenDestinoId" name="Movement.AlmacenDestinoId" class="form-control form-select w-100" asp-items="Model.Almacenes">
                                    <option value="">-- Salida Definitiva --</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Observaciones / Justificación de la Operación</label>
                                <textarea asp-for="Movement.Observaciones" name="Movement.Observaciones" class="form-control w-100" rows="2" placeholder="Describa el motivo..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="m-0 fw-bold"><i class="ti ti-list-check me-2 text-primary"></i>Artículos y Cantidades</h5>
                        <button type="button" class="btn btn-sm btn-outline" onclick="addRow()">
                            <i class="ti ti-plus"></i> AÑADIR PARTIDA
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table mb-0" id="detailsTable">
                                <thead>
                                    <tr>
                                        <th>Producto / Insumo</th>
                                        <th width="160" class="text-end">Cantidad</th>
                                        <th width="160" class="text-end">Costo Unitario ($)</th>
                                        <th width="250">Lote / Vencimiento</th>
                                        <th width="60"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 mb-5">
                    <a asp-action="Movements" class="btn btn-sm btn-outline px-5">DESCARTAR</a>
                    <button type="submit" class="btn btn-sm btn-primary px-5 py-3 shadow">
                        <i class="ti ti-device-floppy"></i> REGISTRAR DOCUMENTO
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let rowCount = 0;
        const parsedProductos = @Html.Raw(Json.Serialize(Model.ProductosDisponibles));

        function addRow() {
            const tbody = document.querySelector("#detailsTable tbody");
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>
                    <select name="Movement.MovimientoInventarioDetalles[${rowCount}].ProductoId" class="form-control form-select w-100 select2" required>
                        <option value="">-- Buscar Artículo --</option>
                        ${parsedProductos.map(p => `<option value="${p.id}">${p.display}</option>`).join('')}
                    </select>
                </td>
                <td><input name="Movement.MovimientoInventarioDetalles[${rowCount}].Cantidad" type="number" step="0.0001" class="form-control text-numeric w-100" value="1.0000" required /></td>
                <td><input name="Movement.MovimientoInventarioDetalles[${rowCount}].CostoUnitario" type="number" step="0.01" class="form-control text-numeric w-100" placeholder="0.00" /></td>
                <td>
                    <div class="input-group">
                        <input name="Movement.MovimientoInventarioDetalles[${rowCount}].Lote" class="form-control w-50" placeholder="Lote" />
                        <input name="Movement.MovimientoInventarioDetalles[${rowCount}].FechaVencimiento" type="date" class="form-control w-50" />
                    </div>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm text-danger border-0 bg-transparent" onclick="this.closest('tr').remove();">
                        <i class="ti ti-trash fs-18"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(row);
            rowCount++;
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (document.querySelectorAll("#detailsTable tbody tr").length === 0) {
                addRow();
            }
        });
    </script>
}
