@model IEnumerable<Vercom.Models.Existencium>
@{
    ViewBag.Title = "Control de Inventario";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Submayor de Existencias</h4>
        <p class="text-muted small mb-0">Visualización en tiempo real del stock disponible y valorización de inventario.</p>
    </div>
    <div class="text-end">
        <a asp-action="CreateMovement" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-arrows-transfer-down"></i> NUEVO MOVIMIENTO
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-package me-2 text-primary"></i>Resumen de Almacén</h5>
            <div class="d-flex gap-2">
                <span class="badge badge-soft-info">@Model.Count() Productos en Stock</span>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="inventoryTable"  class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Producto / Insumo</th>
                            <th width="100">Código</th>
                            <th width="150">Almacén</th>
                            <th width="120" class="text-end">Cantidad</th>
                            <th width="130" class="text-end">Costo Prom ($)</th>
                            <th width="140" class="text-end">Valor Total ($)</th>
                            <th width="120" class="text-center">Estado</th>
                            <th width="80" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isLowStock = item.Cantidad <= item.StockMinimo;
                            var statusClass = isLowStock ? "badge-soft-danger" : "badge-soft-success";
                            var statusText = isLowStock ? "STOCK BAJO" : "EN STOCK";

                            <tr>
                                <td class="fw-bold">@item.Producto.Nombre</td>
                                <td><span class="text-numeric text-primary small">@item.Producto.Codigo</span></td>
                                <td><i class="ti ti-map-pin me-1 text-muted"></i>@item.Almacen.Nombre</td>
                                <td class="text-numeric fw-bold @(isLowStock ? "text-danger" : "")">@item.Cantidad.ToString("N2")</td>
                                <td class="text-numeric">@item.CostoPromedio.ToString("N4")</td>
                                <td class="text-numeric fw-bold text-success">@((item.Cantidad * item.CostoPromedio).ToString("N2"))</td>
                                <td class="text-center"><span class="badge @statusClass">@statusText</span></td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Movements" asp-route-productId="@item.ProductoId" class="btn btn-sm btn-outline py-1 px-2" title="Kardex">
                                            <i class="ti ti-history"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#inventoryTable').DataTable({
                    language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'asc']]
            });
        });
    </script>
}
