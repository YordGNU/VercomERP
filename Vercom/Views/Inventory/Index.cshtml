@model IEnumerable<Vercom.Models.Existencium>
@{
    ViewBag.Title = "Control de Inventario";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Existencias en Almacén</h4>
    </div>
    <div class="text-end">
        <a asp-action="CreateMovement" class="btn btn-primary">
            <i class="ti ti-plus me-1"></i> Nuevo Movimiento
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th>Código</th>
                            <th>Almacén</th>
                            <th>Cantidad</th>
                            <th>Costo Promedio</th>
                            <th>Valor Total</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Cantidad <= item.StockMinimo ? "badge bg-danger-subtle text-danger" : "badge bg-success-subtle text-success";
                            var statusText = item.Cantidad <= item.StockMinimo ? "Stock Bajo" : "Disponible";

                            <tr>
                                <td class="fw-bold">@item.Producto.Nombre</td>
                                <td><code class="text-primary">@item.Producto.Codigo</code></td>
                                <td>@item.Almacen.Nombre</td>
                                <td>@item.Cantidad.ToString("N2")</td>
                                <td>@item.CostoPromedio.ToString("C")</td>
                                <td>@((item.Cantidad * item.CostoPromedio).ToString("C"))</td>
                                <td><span class="@statusClass">@statusText</span></td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-light" title="Ver Historial"><i class="ti ti-history"></i></button>
                                        <button class="btn btn-sm btn-light" title="Editar Límites"><i class="ti ti-edit"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
