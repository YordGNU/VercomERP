@model IEnumerable<Vercom.Models.Existencium>
@{
    ViewBag.Title = "Alertas de Inventario";
}

@{ var headerActions = "<a href='" + Url.Action("Create", "Purchase") + "' class='btn btn-sm btn-outline-danger'><i class='ti ti-shopping-cart-plus me-1'></i> GENERAR ORDEN DE COMPRA</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Alertas de Inventario", Title = "Stock Crítico y Seguridad", Subtitle = "Existencias por agotarse y mínimos de seguridad.", Icon = "ti-alert-triangle", Tone = "danger", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row mt-4">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card border-start border-danger border-3 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="badge bg-danger-subtle text-danger mb-2">AGOTÁNDOSE</span>
                                <h4 class="card-title mb-1">@item.Producto.Nombre</h4>
                                <code class="text-muted small">@item.Producto.Codigo</code>
                            </div>
                            <div class="avatar-sm bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center">
                                <i class="ti ti-alert-triangle fs-20"></i>
                            </div>
                        </div>

                        <p class="small text-muted mb-3"><i class="ti ti-building-warehouse me-1"></i> Ubicación: @item.Almacen.Nombre</p>

                        <div class="row text-center g-0 bg-light rounded p-3 mb-3">
                            <div class="col-6 border-end">
                                <h3 class="mb-0 fw-bold text-danger">@item.Cantidad.ToString("N0")</h3>
                                <small class="text-muted">Actual</small>
                            </div>
                            <div class="col-6">
                                <h3 class="mb-0">@item.StockMinimo.ToString("N0")</h3>
                                <small class="text-muted">Mínimo Req.</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center small">
                            <span class="text-muted">Déficit: <strong class="text-danger">@((item.StockMinimo - item.Cantidad).ToString("N0"))</strong> unidades</span>
                            <a asp-controller="Inventory" asp-action="Movements" class="text-decoration-none">Ver Historial <i class="ti ti-chevron-right ms-1"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="avatar-lg bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                    <i class="ti ti-checks fs-40"></i>
                </div>
                <h3>¡Inventario Saludable!</h3>
                <p class="text-muted">No se detectan productos por debajo del stock mínimo de seguridad.</p>
                <a asp-action="Index" class="btn btn-outline-success mt-2">Volver al Submayor</a>
            </div>
        }
    </div>
</div>
