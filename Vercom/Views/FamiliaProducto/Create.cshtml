@model Vercom.ViewModels.FamiliaFormViewModel
@{
    ViewBag.Title = "Nueva Familia de Productos";
}
<!-- ============================================================ -->
<!-- HEADER CON BREADCRUMB -->
<!-- ============================================================ -->
<div class="page-title-head d-flex align-items-center p-3 mb-4 rounded-3">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold d-flex align-items-center gap-2">
            <i class="ti ti-category-plus text-primary"></i>
            Nueva Familia de Productos
        </h4>
        <p class="text-muted small mb-0">
            Agrupación lógica para el análisis de inventario y ventas.
        </p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Familias</a></li>
            <li class="breadcrumb-item active">Nueva</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <!-- ============================================================ -->
                <!-- CARD HEADER -->
                <!-- ============================================================ -->
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary">
                        <i class="ti ti-folder-plus me-2"></i>
                        Registrar Nueva Familia
                    </h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-3" id="createFamilyForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" 
                             class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <!-- ============================================================ -->
                        <!-- INFORMACIÓN DE BIENVENIDA -->
                        <!-- ============================================================ -->
                        <div class="col-12">
                            <div class="alert alert-info py-2 px-3 small border-0 mb-0 d-flex align-items-start gap-2">
                                <i class="ti ti-info-circle fs-5 mt-1"></i>
                                <div>
                                    <strong>¿Qué es una Familia de Productos?</strong>
                                    <div class="text-muted mt-1">
                                        Una agrupación lógica de productos similares. Por ejemplo:
                                        <code>Lácteos</code>, <code>Cárnicos</code>, <code>Bebidas</code>.
                                        Las familias ayudan a organizar el inventario y a generar reportes por categoría.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ============================================================ -->
                        <!-- DATOS DE LA FAMILIA -->
                        <!-- ============================================================ -->
                        <div class="col-12 mt-3">
                            <h6 class="text-muted fw-bold mb-2 pb-1 border-bottom">
                                <i class="ti ti-tag me-1"></i> Datos de la Familia
                            </h6>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Familia.Codigo" class="form-label fw-bold">
                                Código <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-hash"></i></span>
                                <input asp-for="Familia.Codigo" class="form-control" 
                                       placeholder="LACT" maxlength="20" required />
                            </div>
                            <span asp-validation-for="Familia.Codigo" class="text-danger small"></span>
                            <small class="form-text text-muted">
                                Código único dentro de la entidad (ej: LACT, CARN, BEB).
                            </small>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Familia.Nombre" class="form-label fw-bold">
                                Nombre <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-text-size"></i></span>
                                <input asp-for="Familia.Nombre" class="form-control" 
                                       placeholder="Ej: Lácteos, Cárnicos, Bebidas..." 
                                       maxlength="100" required />
                            </div>
                            <span asp-validation-for="Familia.Nombre" class="text-danger small"></span>
                            <small class="form-text text-muted">
                                Nombre descriptivo que verán los usuarios en el sistema.
                            </small>
                        </div>

                        <!-- ============================================================ -->
                        <!-- JERARQUÍA (FAMILIA PADRE) -->
                        <!-- ============================================================ -->
                        <div class="col-12 mt-3">
                            <h6 class="text-muted fw-bold mb-2 pb-1 border-bottom">
                                <i class="ti ti-hierarchy-2 me-1"></i> Jerarquía (Opcional)
                            </h6>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Familia.FamiliaPadreId" class="form-label fw-bold">
                                Categoría Superior
                            </label>
                            <select asp-for="Familia.FamiliaPadreId" 
                                    class="form-select select2" 
                                    asp-items="Model.FamiliasPadre">
                                <option value="">— Sin categoría superior (Familia raíz) —</option>
                            </select>
                            <span asp-validation-for="Familia.FamiliaPadreId" class="text-danger small"></span>
                            <small class="form-text text-muted">
                                <i class="ti ti-info-circle me-1"></i>
                                Seleccione una familia padre si desea crear una subcategoría. 
                                Deje vacío si esta familia es de nivel superior.
                            </small>
                        </div>

                        <!-- ============================================================ -->
                        <!-- EJEMPLO VISUAL DE JERARQUÍA -->
                        <!-- ============================================================ -->
                        <div class="col-12">
                            <div class="border rounded-3 p-3 bg-light-subtle">
                                <h6 class="small text-muted fw-bold mb-2">
                                    <i class="ti ti-sitemap me-1"></i> Ejemplo de estructura jerárquica:
                                </h6>
                                <div class="d-flex align-items-center gap-3 small">
                                    <div class="d-flex align-items-center gap-1">
                                        <i class="ti ti-folder text-warning"></i>
                                        <span class="fw-semibold">Alimentos</span>
                                        <span class="text-muted">(familia raíz)</span>
                                    </div>
                                    <i class="ti ti-arrow-right text-muted"></i>
                                    <div class="d-flex align-items-center gap-1">
                                        <i class="ti ti-folder text-info"></i>
                                        <span class="fw-semibold">Lácteos</span>
                                        <span class="text-muted">(subcategoría)</span>
                                    </div>
                                    <i class="ti ti-arrow-right text-muted"></i>
                                    <div class="d-flex align-items-center gap-1">
                                        <i class="ti ti-package text-success"></i>
                                        <span class="text-muted">Productos...</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ============================================================ -->
                        <!-- BOTONES DE ACCIÓN -->
                        <!-- ============================================================ -->
                        <div class="col-12 d-flex justify-content-between align-items-center gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="ti ti-x me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary px-5 shadow">
                                <i class="ti ti-device-floppy me-1"></i> CREAR FAMILIA
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // ✅ Envío del formulario por AJAX (si tienes la función global)
            if (typeof window.SubmitAjaxForm === 'function') {
                window.SubmitAjaxForm('createFamilyForm');
            }
        });
    </script>
}