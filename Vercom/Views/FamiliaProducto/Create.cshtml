@model Vercom.ViewModels.FamiliaFormViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">@Model.Title</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form asp-action="Create" method="post" class="row g-3">
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>

                        <div class="col-md-4">
                            <label asp-for="Familia.Codigo" class="form-label fw-bold">Código</label>
                            <input asp-for="Familia.Codigo" name="Familia.Codigo" class="form-control" placeholder="ej: LACT" required />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Familia.Nombre" class="form-label fw-bold">Nombre</label>
                            <input asp-for="Familia.Nombre" name="Familia.Nombre" class="form-control" required />
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Familia.FamiliaPadreId" class="form-label fw-bold">Categoría Superior (Opcional)</label>
                            <select asp-for="Familia.FamiliaPadreId" name="Familia.FamiliaPadreId" class="form-select" asp-items="Model.FamiliasPadre">
                                <option value="">-- Sin Padre (Nivel Raíz) --</option>
                            </select>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR FAMILIA
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
