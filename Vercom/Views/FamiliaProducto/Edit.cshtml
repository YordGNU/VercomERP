@model Vercom.ViewModels.FamiliaFormViewModel
@{
    ViewBag.Title = Model.Title;
    var esNueva = Model.Familia.Id == Guid.Empty;
}

<!-- ============================================================ -->
<!-- HEADER CON BREADCRUMB DINÁMICO -->
<!-- ============================================================ -->
@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Familias</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Inventario", Title = Model.Title, Subtitle = "Agrupación lógica para el análisis de inventario y ventas.", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <!-- ============================================================ -->
                <!-- CARD HEADER -->
                <!-- ============================================================ -->
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary">
                        <i class="ti ti-edit me-2"></i>
                        @(esNueva ? "Nueva Familia de Productos" : "Modificar Familia de Productos")
                    </h5>
                    <div class="d-flex gap-2">
                        @if (!esNueva)
                        {
                            <a asp-action="Details" asp-route-id="@Model.Familia.Id"
                               class="btn btn-outline-info btn-sm">
                                <i class="ti ti-eye me-1"></i> Ver
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="ti ti-arrow-left me-1"></i> Volver
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="@(esNueva ? "Create" : "Edit")" method="post" 
                          class="row g-3" id="familiaForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" 
                             class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <!-- ✅ Campo oculto con el ID de la familia (CRÍTICO para Edit) -->
                        <input type="hidden" asp-for="Familia.Id" />

                        <!-- ============================================================ -->
                        <!-- INFORMACIÓN DE AUDITORÍA -->
                        <!-- ============================================================ -->
                        @if (!esNueva)
                        {
                            <div class="col-12">
                                <div class="alert alert-light border py-2 px-3 small d-flex justify-content-between align-items-center mb-0">
                                    <span>
                                        <i class="ti ti-info-circle me-1 text-muted"></i>
                                        <strong>Editando:</strong> 
                                        <code class="text-primary">@Model.Familia.Codigo</code> - 
                                        @Model.Familia.Nombre
                                    </span>
                                    <span class="badge bg-primary bg-opacity-10 text-primary">
                                        ID: @Model.Familia.Id.ToString().Substring(0, 8)
                                    </span>
                                </div>
                            </div>
                        }

                        <!-- ============================================================ -->
                        <!-- DATOS DE LA FAMILIA -->
                        <!-- ============================================================ -->
                        <div class="col-12">
                            <h6 class="text-muted fw-bold mb-2 pb-1 border-bottom">
                                <i class="ti ti-tag me-1"></i> Datos de la Familia
                            </h6>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Familia.Codigo" class="form-label fw-bold">
                                Código <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-hash"></i></span>
                                <input asp-for="Familia.Codigo" class="form-control" 
                                       placeholder="ej: LACT" maxlength="20" required />
                            </div>
                            <span asp-validation-for="Familia.Codigo" class="text-danger small"></span>
                            <small class="form-text text-muted">Código único dentro de la entidad.</small>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Familia.Nombre" class="form-label fw-bold">
                                Nombre <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-text-size"></i></span>
                                <input asp-for="Familia.Nombre" class="form-control" 
                                       placeholder="Ej: Lácteos, Cárnicos, Bebidas..." 
                                       maxlength="100" required />
                            </div>
                            <span asp-validation-for="Familia.Nombre" class="text-danger small"></span>
                        </div>

                        <!-- ============================================================ -->
                        <!-- JERARQUÍA (FAMILIA PADRE) -->
                        <!-- ============================================================ -->
                        <div class="col-12 mt-3">
                            <h6 class="text-muted fw-bold mb-2 pb-1 border-bottom">
                                <i class="ti ti-hierarchy-2 me-1"></i> Jerarquía (Opcional)
                            </h6>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Familia.FamiliaPadreId" class="form-label fw-bold">
                                Categoría Superior
                            </label>
                            <select asp-for="Familia.FamiliaPadreId" 
                                    class="form-select select2" 
                                    asp-items="Model.FamiliasPadre">
                                <option value="">— Sin categoría superior (Familia raíz) —</option>
                            </select>
                            <span asp-validation-for="Familia.FamiliaPadreId" class="text-danger small"></span>
                            <small class="form-text text-muted">
                                <i class="ti ti-info-circle me-1"></i>
                                Deje vacío si esta familia es de nivel superior (sin padre).
                            </small>
                        </div>

                        <!-- ============================================================ -->
                        <!-- ADVERTENCIA DE JERARQUÍA -->
                        <!-- ============================================================ -->
                        @if (!esNueva)
                        {
                            <div class="col-12">
                                <div class="alert alert-warning py-2 px-3 small border-0 mb-0">
                                    <i class="ti ti-alert-triangle me-1"></i>
                                    <strong>Importante:</strong> Una familia no puede ser padre de sí misma 
                                    ni crear ciclos en la jerarquía.
                                </div>
                            </div>
                        }

                        <!-- ============================================================ -->
                        <!-- BOTONES DE ACCIÓN -->
                        <!-- ============================================================ -->
                        <div class="col-12 d-flex justify-content-between align-items-center gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="ti ti-x me-1"></i> Cancelar
                            </a>
                            <div class="d-flex gap-2">
                                @if (!esNueva)
                                {
                                    <a asp-action="Details" asp-route-id="@Model.Familia.Id" 
                                       class="btn btn-outline-info px-4">
                                        <i class="ti ti-eye me-1"></i> Ver
                                    </a>
                                }
                                <button type="submit" class="btn btn-primary px-5 shadow">
                                    <i class="ti ti-device-floppy me-1"></i>
                                    @(esNueva ? "CREAR FAMILIA" : "GUARDAR CAMBIOS")
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {  
            // ✅ Envío del formulario (usa la función global si existe)
            if (typeof window.SubmitAjaxForm === 'function') {
                window.SubmitAjaxForm('familiaForm');
            }
        });
    </script>
}