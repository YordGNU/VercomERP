@model Vercom.Models.FacturaVentum

@{
    ViewData["Title"] = "Crear Factura de Venta";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Crear Factura de Venta</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Ventas</a></li>
            <li class="breadcrumb-item active">Facturas de Venta</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Creación</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-md-6">
                            <label asp-for="EntidadId" class="form-label"></label>
                            <select asp-for="EntidadId" class="form-select" asp-items="ViewBag.EntidadId"></select>
                            <span asp-validation-for="EntidadId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SucursalId" class="form-label"></label>
                            <select asp-for="SucursalId" class="form-select" asp-items="ViewBag.SucursalId"></select>
                            <span asp-validation-for="SucursalId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NumeroFactura" class="form-label"></label>
                            <input asp-for="NumeroFactura" class="form-control" placeholder="Número de factura" />
                            <span asp-validation-for="NumeroFactura" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ClienteId" class="form-label"></label>
                            <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId"></select>
                            <span asp-validation-for="ClienteId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContratoId" class="form-label"></label>
                            <select asp-for="ContratoId" class="form-select" asp-items="ViewBag.ContratoId"></select>
                            <span asp-validation-for="ContratoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AlmacenId" class="form-label"></label>
                            <select asp-for="AlmacenId" class="form-select" asp-items="ViewBag.AlmacenId"></select>
                            <span asp-validation-for="AlmacenId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DispositivoPosId" class="form-label"></label>
                            <select asp-for="DispositivoPosId" class="form-select" asp-items="ViewBag.DispositivoPosId"></select>
                            <span asp-validation-for="DispositivoPosId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SesionCajaPosId" class="form-label"></label>
                            <select asp-for="SesionCajaPosId" class="form-select" asp-items="ViewBag.SesionCajaPosId"></select>
                            <span asp-validation-for="SesionCajaPosId" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Subtotal" class="form-label"></label>
                            <input asp-for="Subtotal" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Subtotal" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="DescuentoTotal" class="form-label"></label>
                            <input asp-for="DescuentoTotal" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="DescuentoTotal" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ImpuestoVentasTotal" class="form-label"></label>
                            <input asp-for="ImpuestoVentasTotal" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="ImpuestoVentasTotal" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Total" class="form-label"></label>
                            <input asp-for="Total" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Total" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MotivoAnulacion" class="form-label"></label>
                            <input asp-for="MotivoAnulacion" class="form-control" placeholder="Motivo de anulación" />
                            <span asp-validation-for="MotivoAnulacion" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AsientoId" class="form-label"></label>
                            <select asp-for="AsientoId" class="form-select" asp-items="ViewBag.AsientoId"></select>
                            <span asp-validation-for="AsientoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CuentaPorCobrarId" class="form-label"></label>
                            <select asp-for="CuentaPorCobrarId" class="form-select" asp-items="ViewBag.CuentaPorCobrarId"></select>
                            <span asp-validation-for="CuentaPorCobrarId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CreadoPor" class="form-label"></label>
                            <input asp-for="CreadoPor" class="form-control" placeholder="Usuario creador" />
                            <span asp-validation-for="CreadoPor" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}