@model Vercom.Models.UsuarioRol

@{
    ViewData["Title"] = "Edit";
}



<h4>UsuarioRol</h4>
<hr />
<div class="row">
    <div class="col-md-4">
       @{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Editar UsuarioRol", Subtitle = "", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h4 class="card-title">Formulario de Edición</h4>
                </div>
                <div class="card-body">
<form class="row g-3" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UsuarioId" />
            <input type="hidden" asp-for="RolId" />
            <input type="hidden" asp-for="SucursalId" />
            <div class="mb-3">
                <label asp-for="AsignadoEn" class="form-label"></label>
                <input asp-for="AsignadoEn" class="form-control" />
                <span asp-validation-for="AsignadoEn" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AsignadoPor" class="form-label"></label>
                <select asp-for="AsignadoPor" class="form-control" asp-items="ViewBag.AsignadoPor"></select>
                <span asp-validation-for="AsignadoPor" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

