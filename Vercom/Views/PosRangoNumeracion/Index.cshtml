@model IEnumerable<Vercom.Models.PosRangoNumeracion>
@{
    ViewBag.Title = "Rangos de Numeración POS";
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Gestión de Folios Offline",
    Subtitle = "Control de bloques de numeración reservados para facturación sin conexión.",
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Vercom", Url = "javascript: void(0);" },
        new() { Text = "Ventas", Url = "javascript: void(0);" },
        new() { Text = "Rangos", IsActive = true }
    }
}' />

<div class="row">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light-subtle">
                <h5 class="m-0 fw-bold"><i class="ti ti-numbers me-2 text-primary"></i>Bloques Asignados</h5>
            </div>
            <div class="card-body">
                <table id="rangesTable" class="table table-striped table-hover dt-responsive">
                    <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th class="ps-4">Terminal</th>
                            <th>Documento</th>
                            <th>Serie</th>
                            <th class="text-center">Rango (Desde-Hasta)</th>
                            <th class="text-center">Siguiente</th>
                            <th>Progreso</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(x => x.AsignadoEn))
                        {
                            var total = item.NumeroHasta - item.NumeroDesde + 1;
                            var consumidos = item.NumeroSiguienteLocal - item.NumeroDesde;
                            var porcentaje = (total > 0) ? (decimal)consumidos / total * 100 : 0;
                            var color = porcentaje > 90 ? "danger" : (porcentaje > 70 ? "warning" : "success");

                            <tr>
                                <td>
                                    <div class="fw-bold text-primary">@item.DispositivoPos.Nombre</div>
                                    <small class="text-muted tiny">Asignado: @item.AsignadoEn.ToString("dd/MM/yy")</small>
                                </td>
                                <td class="small fw-bold">@item.TipoDocumento</td>
                                <td><span class="badge bg-light text-dark">@item.Serie</span></td>
                                <td class="text-center font-monospace small">@item.NumeroDesde - @item.NumeroHasta</td>
                                <td class="text-center fw-bold">@item.NumeroSiguienteLocal</td>
                                <td width="150">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar bg-@color" style="width: @porcentaje%"></div>
                                        </div>
                                        <span class="tiny fw-bold">@porcentaje.ToString("N0")%</span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Agotado)
                                    {
                                        <span class="badge bg-danger px-3">AGOTADO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success px-3">DISPONIBLE</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#rangesTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'asc']],
                dom: 'rtip'
            });
        });
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
