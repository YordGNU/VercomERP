@model Vercom.Models.PosRangoNumeracion
@inject Vercom.Services.IEntidadDisplayService EntidadDisplay
@{
    ViewData["Title"] = "Editar Rango de Numeración POS";
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Editar Rango de Numeración POS",
    Subtitle = "Modificación de rango de numeración para facturación offline.",
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Vercom", Url = "javascript: void(0);" },
        new() { Text = "Ventas", Url = "javascript: void(0);" },
        new() { Text = "Rangos", Url = Url.Action("Index") },
        new() { Text = "Editar", IsActive = true }
    }
}' />
            <li class="breadcrumb-item active">Editar</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h4 class="card-title">Formulario de Edición</h4>
                </div>
                <div class="card-body">
<form class="row g-3" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="DispositivoPosId" class="form-label"></label>
                <select asp-for="DispositivoPosId" class="form-control" asp-items="ViewBag.DispositivoPosId"></select>
                <span asp-validation-for="DispositivoPosId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TipoDocumento" class="form-label"></label>
                <input asp-for="TipoDocumento" class="form-control" />
                <span asp-validation-for="TipoDocumento" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Serie" class="form-label"></label>
                <input asp-for="Serie" class="form-control" />
                <span asp-validation-for="Serie" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NumeroDesde" class="form-label"></label>
                <input asp-for="NumeroDesde" class="form-control" />
                <span asp-validation-for="NumeroDesde" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NumeroHasta" class="form-label"></label>
                <input asp-for="NumeroHasta" class="form-control" />
                <span asp-validation-for="NumeroHasta" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NumeroSiguienteLocal" class="form-label"></label>
                <input asp-for="NumeroSiguienteLocal" class="form-control" />
                <span asp-validation-for="NumeroSiguienteLocal" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AsignadoEn" class="form-label"></label>
                <input asp-for="AsignadoEn" class="form-control" />
                <span asp-validation-for="AsignadoEn" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Agotado" /> @Html.DisplayNameFor(model => model.Agotado)
                </label>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

