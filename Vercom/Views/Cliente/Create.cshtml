@model Vercom.ViewModels.ClientFormViewModel

@{
    ViewData["Title"] = "Crear Cliente";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Crear Cliente</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Ventas</a></li>
            <li class="breadcrumb-item active">Clientes</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Creación</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="col-md-4">
                            <label asp-for="Client.TipoPersona" class="form-label">Tipo de Cliente</label>
                            <select asp-for="Client.TipoPersona" class="form-select">
                                <option value="JURIDICA">Persona Jurídica (Empresa)</option>
                                <option value="NATURAL">Persona Natural (Particular)</option>
                            </select>
                            <span asp-validation-for="Client.TipoPersona" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Client.NitOCi" class="form-label">NIT o Carnet Identidad</label>
                            <input asp-for="Client.NitOCi" class="form-control" placeholder="NIT / CI" maxlength="20" />
                            <span asp-validation-for="Client.NitOCi" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Client.Segmento" class="form-label">Segmento Comercial</label>
                            <select asp-for="Client.Segmento" class="form-select">
                                <option value="MINORISTA">Minorista (Público)</option>
                                <option value="MAYORISTA">Mayorista (B2B)</option>
                            </select>
                            <span asp-validation-for="Client.Segmento" class="text-danger"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Client.NombreRazonSocial" class="form-label">Nombre / Razón Social</label>
                            <input asp-for="Client.NombreRazonSocial" class="form-control" placeholder="Nombre completo o nombre de empresa" maxlength="255" required />
                            <span asp-validation-for="Client.NombreRazonSocial" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Client.ListaPrecioId" class="form-label">Lista de Precios</label>
                            <select asp-for="Client.ListaPrecioId" class="form-select" asp-items="ViewBag.ListaPrecioId">
                                <option value="">-- Usar General --</option>
                            </select>
                            <span asp-validation-for="Client.ListaPrecioId" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Client.Direccion" class="form-label"></label>
                            <input asp-for="Client.Direccion" class="form-control" placeholder="Dirección completa" />
                            <span asp-validation-for="Client.Direccion" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Client.Telefono" class="form-label"></label>
                            <input asp-for="Client.Telefono" class="form-control" placeholder="Teléfono de contacto" />
                            <span asp-validation-for="Client.Telefono" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Client.Email" class="form-label"></label>
                            <input asp-for="Client.Email" class="form-control" placeholder="Correo electrónico" />
                            <span asp-validation-for="Client.Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Client.LimiteCredito" class="form-label"></label>
                            <input asp-for="Client.LimiteCredito" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Client.LimiteCredito" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Client.CuentaContableId" class="form-label"></label>
                            <select asp-for="Client.CuentaContableId" class="form-select" asp-items="Model.CuentasContables"></select>
                            <span asp-validation-for="Client.CuentaContableId" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}