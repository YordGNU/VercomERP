@model IEnumerable<Vercom.Models.Cliente>
@{
    ViewBag.Title = "Cartera de Clientes";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión Comercial: Cartera de Clientes</h4>
        <p class="text-muted small mb-0">Directorio unificado de clientes corporativos y consumidores finales.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Comercial</a></li>
            <li class="breadcrumb-item active">Clientes</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-user-plus"></i> REGISTRAR CLIENTE
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-users me-2 text-primary"></i>Listado de Clientes</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="clientsTable"  class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Nombre / Razón Social</th>
                            <th width="140">NIT / CI</th>
                            <th width="120">Segmento</th>
                            <th width="120" class="text-center">Teléfono</th>
                            <th width="140" class="text-end">Límite Crédito ($)</th>
                            <th width="100" class="text-center">Estado</th>
                            <th width="100" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.NombreRazonSocial</td>
                                <td class="text-numeric small">@item.NitOCi</td>
                                <td><span class="badge badge-soft-secondary">@item.Segmento</span></td>
                                <td class="text-center">@item.Telefono</td>
                                <td class="text-numeric">@item.LimiteCredito.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @(item.Activo ? "badge-soft-success" : "badge-soft-danger")">@(item.Activo ? "ACTIVO" : "INACTIVO")</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Expediente">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#clientsTable').DataTable({
                         language: { url: '/js/i18n/es-ES.json' }
            });
        });
    </script>
}
