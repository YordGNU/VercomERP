@model IEnumerable<Vercom.Models.Cliente>
@{
    ViewBag.Title = "Cartera de Clientes";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión Comercial: Cartera de Clientes</h4>
        <p class="text-muted small mb-0">Directorio unificado de clientes corporativos y consumidores finales.</p>
    </div>
    <div class="text-end">      
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-user-plus"></i> REGISTRAR CLIENTE
        </a>
    </div>
</div>

<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-users me-2 text-primary"></i>Listado de Clientes</h5>
        </div>
        <div class="card-body">
            <table id="clientsTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th>Nombre / Razón Social</th>
                        <th> NIT / CI</th>
                        <th >Segmento</th>
                        <th  class="text-center">Teléfono</th>
                       <th>Límite Crédito ($)</th>
                      <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.NombreRazonSocial</td>
                            <td class="text-numeric small">@item.NitOCi</td>
                            <td><span class="badge badge-soft-secondary">@item.Segmento</span></td>
                            <td >@item.Telefono</td>
                            <td class="text-numeric">@item.LimiteCredito.ToString("N2")</td>
                            <td >
                                <span class="badge @(item.Activo ? "badge-soft-success" : "badge-soft-danger")">@(item.Activo ? "ACTIVO" : "INACTIVO")</span>
                            </td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Expediente">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Editar">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#clientsTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
            });
        });
    </script>
}
