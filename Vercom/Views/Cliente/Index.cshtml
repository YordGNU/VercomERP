@model IEnumerable<Vercom.Models.Cliente>
@{
    ViewBag.Title = "Cartera de Clientes";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Gestión Comercial: Clientes</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-user-plus me-1"></i> Nuevo Cliente
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre / Razón Social</th>
                            <th>NIT / CI</th>
                            <th>Segmento</th>
                            <th>Teléfono</th>
                            <th class="text-end">Límite Crédito</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.NombreRazonSocial</td>
                                <td><code>@item.NitOCi</code></td>
                                <td><span class="badge border text-dark">@item.Segmento</span></td>
                                <td>@item.Telefono</td>
                                <td class="text-end">@(item.LimiteCredito.ToString("C") ?? "0.00")</td>
                                <td class="text-center">
                                    <span class="badge @(item.Activo ? "bg-success" : "bg-danger")">@(item.Activo ? "Activo" : "Inactivo")</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-edit"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
