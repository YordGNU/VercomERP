@model Vercom.ViewModels.ClientListViewModel
@{ ViewData["Title"] = "Cartera de Clientes"; var estado = Model.Activo switch { true => "activa", false => "inactiva", _ => "" }; var desde = Model.TotalItems == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1; var hasta = Math.Min(Model.Page * Model.PageSize, Model.TotalItems); }

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-user-plus me-1'></i> REGISTRAR CLIENTE</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Gestión Comercial", Title = "Cartera de Clientes", Subtitle = "Directorio unificado de clientes corporativos y consumidores finales.", Icon = "ti-users", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



@{ var kpiTotal = new Vercom.ViewModels.KpiCardModel { Label = "Clientes", Value = Model.Total.ToString(), Icon = "ti-users", Tone = "primary" }; var kpiActivos = new Vercom.ViewModels.KpiCardModel { Label = "Clientes activos", Value = Model.Activos.ToString(), Icon = "ti-circle-check", Tone = "success" }; var kpiInactivos = new Vercom.ViewModels.KpiCardModel { Label = "Clientes inactivos", Value = Model.Inactivos.ToString(), Icon = "ti-circle-x", Tone = "danger" }; var kpiSegmento = new Vercom.ViewModels.KpiCardModel { Label = "Minoristas / Mayoristas", Value = Model.Minoristas + " / " + Model.Mayoristas, Icon = "ti-chart-donut", Tone = "info" }; }
<div class='row g-2 mb-3'>
    <div class='col-md-3 col-6'>
        <partial name='_KpiCard' model='kpiTotal' />
    </div>
    <div class='col-md-3 col-6'>
        <partial name='_KpiCard' model='kpiActivos' />
    </div>
    <div class='col-md-3 col-6'>
        <partial name='_KpiCard' model='kpiInactivos' />
    </div>
    <div class='col-md-3 col-6'>
        <partial name='_KpiCard' model='kpiSegmento' />
    </div>
</div>

<section class="client-filter-panel mb-3" aria-label="Filtros de clientes">
    <form asp-action="Index" method="get" class="client-filter-grid">
        <div class="client-search-field">
            <label for="client-search" class="form-label small fw-semibold mb-1">Buscar cliente</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="ti ti-search" aria-hidden="true"></i></span>
                <input id="client-search" type="search" name="search" value="@Model.Search" class="form-control" placeholder="Razón social o NIT/CI" autocomplete="off" aria-describedby="client-search-hint" />
                <button type="submit" class="btn btn-primary client-filter-submit" aria-label="Aplicar búsqueda"><i class="ti ti-arrow-right" aria-hidden="true"></i></button>
            </div>
            <span id="client-search-hint" class="form-text">Busca por nombre, NIT o CI.</span>
        </div>
        <div>
            <label for="client-segment" class="form-label small fw-semibold mb-1">Segmento</label>
            <select id="client-segment" name="segment" class="form-select">
                <option value="">Todos los segmentos</option>
                @if (Model.Segmento == "MINORISTA")
                {
                    <option value="MINORISTA" selected>Minorista</option>
                    <option value="MAYORISTA">Mayorista</option>
                }
                else if (Model.Segmento == "MAYORISTA")
                {
                    <option value="MINORISTA">Minorista</option>
                    <option value="MAYORISTA" selected>Mayorista</option>
                }
                else
                {
                    <option value="MINORISTA">Minorista</option>
                    <option value="MAYORISTA">Mayorista</option>
                }
            </select>
        </div>
        <div>
            <label for="client-status" class="form-label small fw-semibold mb-1">Estado</label>
            <select id="client-status" name="estado" class="form-select">
                <option value="">Todos los estados</option>
                @if (estado == "activa")
                {
                    <option value="activa" selected>Activos</option>
                    <option value="inactiva">Inactivos</option>
                }
                else if (estado == "inactiva")
                {
                    <option value="activa">Activos</option>
                    <option value="inactiva" selected>Inactivos</option>
                }
                else
                {
                    <option value="activa">Activos</option>
                    <option value="inactiva">Inactivos</option>
                }
            </select>
        </div>
        <div class="client-filter-actions">
            <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1" aria-hidden="true"></i>Filtrar</button>
            <a asp-action="Index" class="btn btn-light border" aria-label="Limpiar filtros"><i class="ti ti-refresh me-1" aria-hidden="true"></i>Limpiar</a>
        </div>
    </form>
</section>

<div class="client-results-summary" aria-live="polite">
    <div><strong>@desde–@hasta</strong><span> de @Model.TotalItems clientes</span></div>
    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Segmento) || Model.Activo.HasValue)
    {
        <span class="client-filter-state"><i class="ti ti-adjustments-horizontal me-1" aria-hidden="true"></i>Filtros aplicados</span>
    }
</div>

<div class="row g-3">
    @foreach (var item in Model.Items)
    {
        var seg = (string.IsNullOrEmpty(item.Segmento) ? "SIN SEGMENTO" : item.Segmento).ToUpperInvariant();
        var tipo = (string.IsNullOrEmpty(item.TipoPersona) ? "SIN TIPO" : item.TipoPersona).ToUpperInvariant();
        var tipoBadge = tipo == "JURIDICA" ? "bg-primary-subtle text-primary" : "bg-info-subtle text-info";
        <div class="col-md-6 col-xl-4">
            <article class="card h-100 border-0 shadow-sm overflow-hidden">
                <div class="card-status-top @(item.Activo ? "bg-success" : "bg-secondary")"></div>
                <div class="card-body p-3 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <div class="d-flex gap-2 align-items-center min-w-0">
                            <span class="avatar bg-light text-primary flex-shrink-0" aria-hidden="true"><i class="ti ti-user fs-22"></i></span>
                            <div class="min-w-0">
                                <div class="d-flex flex-wrap gap-1 mb-1">
                                    <span class="badge @(seg == "MAYORISTA" ? "bg-info-subtle text-info" : "bg-success-subtle text-success")">@seg</span>
                                    <span class="badge @tipoBadge">@tipo</span>
                                </div>
                                <h2 class="card-title mb-0 fs-14 fw-bold text-break">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="link-body-emphasis text-decoration-none">@item.NombreRazonSocial</a>
                                </h2>
                                <span class="text-muted small">@(string.IsNullOrWhiteSpace(item.NitOCi) ? "Sin NIT/CI" : $"NIT/CI: {item.NitOCi}")</span>
                            </div>
                        </div>
                        <div class="dropdown flex-shrink-0">
                            <button class="btn btn-sm btn-icon btn-light border" data-bs-toggle="dropdown" type="button" title="Acciones" aria-label="Acciones para @item.NombreRazonSocial" aria-expanded="false">
                                <i class="ti ti-dots-vertical" aria-hidden="true"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><h3 class="dropdown-header small">Acciones</h3></li>
                                <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="ti ti-eye me-1 text-primary" aria-hidden="true"></i>Ver detalles</a></li>
                                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="ti ti-edit me-1 text-info" aria-hidden="true"></i>Editar cliente</a></li>
                                <li><a class="dropdown-item" asp-controller="Sales" asp-action="Create" asp-route-clienteId="@item.Id"><i class="ti ti-receipt me-1" aria-hidden="true"></i>Nueva venta</a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="small text-muted mb-2">
                        @if (!string.IsNullOrWhiteSpace(item.Telefono))
                        {
                            <div class="d-flex align-items-center gap-2 mb-1"><i class="ti ti-phone text-success" aria-hidden="true"></i><span>@item.Telefono</span></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Email))
                        {
                            <div class="d-flex align-items-center gap-2"><i class="ti ti-mail text-primary" aria-hidden="true"></i><span class="text-break">@item.Email</span></div>
                        }
                        @if (string.IsNullOrWhiteSpace(item.Telefono) && string.IsNullOrWhiteSpace(item.Email))
                        {
                            <div><i class="ti ti-info-circle me-1" aria-hidden="true"></i>Sin datos de contacto</div>
                        }
                    </div>

                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <span class="badge @(item.Activo ? "badge-soft-success" : "badge-soft-danger")">
                                <i class="ti ti-circle-filled me-1" aria-hidden="true"></i>@(item.Activo ? "ACTIVO" : "INACTIVO")
                            </span>
                            <div class="small text-muted mt-1">Límite de crédito</div>
                            <strong class="small text-nowrap">$@item.LimiteCredito.ToString("N2")</strong>
                        </div>
                        <div class="btn-list flex-shrink-0">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" aria-label="Ver cliente @item.NombreRazonSocial"><i class="ti ti-eye" aria-hidden="true"></i></a>
                            <a asp-controller="Sales" asp-action="Create" asp-route-clienteId="@item.Id" class="btn btn-sm btn-primary"><i class="ti ti-receipt me-1" aria-hidden="true"></i>Nueva venta</a>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="col-12 text-center py-5">
            <span class="avatar-lg bg-light text-muted rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;" aria-hidden="true">
                <i class="ti ti-users fs-40"></i>
            </span>
            <h2 class="h4">@(Model.TotalItems == 0 ? "Sin clientes registrados" : "Sin resultados")</h2>
            <p class="text-muted">@(Model.TotalItems == 0 ? "Registra el primer cliente para comenzar la facturación." : "Ningún cliente coincide con los filtros aplicados.")</p>
            @if (Model.TotalItems == 0)
            {
                <a asp-action="Create" class="btn btn-primary mt-2"><i class="ti ti-user-plus me-1" aria-hidden="true"></i>Registrar cliente</a>
            }
        </div>
    }
</div>

<style>
    .client-filter-panel { background: #fff; border: 1px solid #e5e9ef; border-radius: 6px; }
    .client-filter-panel { padding: 16px; }
    .client-filter-grid { display: grid; grid-template-columns: minmax(250px, 2fr) minmax(145px, 1fr) minmax(135px, 1fr) auto; gap: 12px; align-items: end; }
    .client-filter-submit { min-height: 44px; min-width: 44px; }
    .client-search-field .input-group > .form-control, .client-search-field .input-group > .input-group-text, .client-filter-grid .form-select { min-height: 44px; }
    .client-filter-actions { display: flex; gap: 8px; }
    .client-filter-actions .btn { min-height: 44px; white-space: nowrap; }
    .client-results-summary { display: flex; justify-content: space-between; align-items: center; gap: 12px; color: #667085; font-size: .875rem; margin: 0 2px 10px; }
    .client-results-summary strong { color: #182230; font-variant-numeric: tabular-nums; }
    .client-filter-state { color: #536273; }
    @@media (max-width: 767.98px) {
        .client-filter-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
        .client-search-field, .client-filter-actions { grid-column: 1 / -1; }
        .client-filter-actions .btn { flex: 1; }
    }
    @@media (max-width: 575.98px) {
        .client-filter-panel { padding: 12px; }
    }
</style>

@if (Model.TotalPages > 1)
{
    var inicio = Math.Max(1, Model.Page - 2);
    var fin = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav class="mt-2" aria-label="Paginación de clientes">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-segment="@Model.Segmento" asp-route-estado="@estado" asp-route-page="@(Model.Page - 1)">Anterior</a>
            </li>
            @for (int p = inicio; p <= fin; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" aria-current="@(p == Model.Page ? "page" : null)" aria-label="Página @p" asp-action="Index" asp-route-search="@Model.Search" asp-route-segment="@Model.Segmento" asp-route-estado="@estado" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-segment="@Model.Segmento" asp-route-estado="@estado" asp-route-page="@(Model.Page + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}

