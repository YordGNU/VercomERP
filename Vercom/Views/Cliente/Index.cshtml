@model Vercom.ViewModels.ClientListViewModel
@{ ViewData["Title"] = "Cartera de Clientes"; var estado = Model.Activo switch { true => "activa", false => "inactiva", _ => "" }; var desde = Model.TotalItems == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1; var hasta = Math.Min(Model.Page * Model.PageSize, Model.TotalItems); }

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-user-plus me-1'></i> REGISTRAR CLIENTE</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Gestión Comercial", Title = "Cartera de Clientes", Subtitle = "Directorio unificado de clientes corporativos y consumidores finales.", Icon = "ti-users", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



@{ var kpiTotal = new Vercom.ViewModels.KpiCardModel { Label = "Clientes", Value = Model.Total.ToString(), Icon = "ti-users", Tone = "primary" }; var kpiActivos = new Vercom.ViewModels.KpiCardModel { Label = "Clientes activos", Value = Model.Activos.ToString(), Icon = "ti-circle-check", Tone = "success" }; var kpiInactivos = new Vercom.ViewModels.KpiCardModel { Label = "Clientes inactivos", Value = Model.Inactivos.ToString(), Icon = "ti-circle-x", Tone = "danger" }; var kpiSegmento = new Vercom.ViewModels.KpiCardModel { Label = "Minoristas / Mayoristas", Value = Model.Minoristas + " / " + Model.Mayoristas, Icon = "ti-chart-donut", Tone = "info" }; }
<div class='row g-2 mb-3'>
    <div class='col-md-3 col-6'>
        <partial name='_KpiCard' model='kpiTotal' />
    </div>
    <div class='col-md-3 col-6'>
        <partial name='_KpiCard' model='kpiActivos' />
    </div>
    <div class='col-md-3 col-6'>
        <partial name='_KpiCard' model='kpiInactivos' />
    </div>
    <div class='col-md-3 col-6'>
        <partial name='_KpiCard' model='kpiSegmento' />
    </div>
</div>

<section class="client-filter-panel mb-3" aria-label="Filtros de clientes">
    <form asp-action="Index" method="get" class="client-filter-grid">
        <div class="client-search-field">
            <label for="client-search" class="form-label small fw-semibold mb-1">Buscar cliente</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="ti ti-search" aria-hidden="true"></i></span>
                <input id="client-search" type="search" name="search" value="@Model.Search" class="form-control" placeholder="Razón social o NIT/CI" autocomplete="off" aria-describedby="client-search-hint" />
                <button type="submit" class="btn btn-primary client-filter-submit" aria-label="Aplicar búsqueda"><i class="ti ti-arrow-right" aria-hidden="true"></i></button>
            </div>
            <span id="client-search-hint" class="form-text">Busca por nombre, NIT o CI.</span>
        </div>
        <div>
            <label for="client-segment" class="form-label small fw-semibold mb-1">Segmento</label>
            <select id="client-segment" name="segment" class="form-select">
                <option value="">Todos los segmentos</option>
                @if (Model.Segmento == "MINORISTA")
                {
                    <option value="MINORISTA" selected>Minorista</option>
                    <option value="MAYORISTA">Mayorista</option>
                }
                else if (Model.Segmento == "MAYORISTA")
                {
                    <option value="MINORISTA">Minorista</option>
                    <option value="MAYORISTA" selected>Mayorista</option>
                }
                else
                {
                    <option value="MINORISTA">Minorista</option>
                    <option value="MAYORISTA">Mayorista</option>
                }
            </select>
        </div>
        <div>
            <label for="client-status" class="form-label small fw-semibold mb-1">Estado</label>
            <select id="client-status" name="estado" class="form-select">
                <option value="">Todos los estados</option>
                @if (estado == "activa")
                {
                    <option value="activa" selected>Activos</option>
                    <option value="inactiva">Inactivos</option>
                }
                else if (estado == "inactiva")
                {
                    <option value="activa">Activos</option>
                    <option value="inactiva" selected>Inactivos</option>
                }
                else
                {
                    <option value="activa">Activos</option>
                    <option value="inactiva">Inactivos</option>
                }
            </select>
        </div>
        <div class="client-filter-actions">
            <button type="submit" class="btn btn-primary"><i class="ti ti-filter me-1" aria-hidden="true"></i>Filtrar</button>
            <a asp-action="Index" class="btn btn-light border" aria-label="Limpiar filtros"><i class="ti ti-refresh me-1" aria-hidden="true"></i>Limpiar</a>
        </div>
    </form>
</section>

<div class="client-results-summary" aria-live="polite">
    <div><strong>@desde–@hasta</strong><span> de @Model.TotalItems clientes</span></div>
    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Segmento) || Model.Activo.HasValue)
    {
        <span class="client-filter-state"><i class="ti ti-adjustments-horizontal me-1" aria-hidden="true"></i>Filtros aplicados</span>
    }
</div>

<div class="table-responsive client-table-wrap">
    <table class="table align-middle client-table mb-0">
        <caption class="visually-hidden">Cartera de clientes con perfil, contacto, límite de crédito y estado.</caption>
        <thead>
            <tr>
                <th scope="col">Cliente</th>
                <th scope="col" class="d-none d-md-table-cell">Perfil</th>
                <th scope="col" class="d-none d-lg-table-cell">Contacto</th>
                <th scope="col" class="d-none d-sm-table-cell text-end">Límite de crédito</th>
                <th scope="col">Estado</th>
                <th scope="col" class="text-end"><span class="visually-hidden">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model.Items)
    {
        var seg = (string.IsNullOrEmpty(item.Segmento) ? "SIN SEGMENTO" : item.Segmento).ToUpperInvariant();
        var tipo = (string.IsNullOrEmpty(item.TipoPersona) ? "SIN TIPO" : item.TipoPersona).ToUpperInvariant();
        var segBadge = seg == "MAYORISTA" ? "client-segment-wholesale" : "client-segment-retail";
        <tr>
            <td>
                <div class="client-identity">
                    <span class="client-avatar" aria-hidden="true"><i class="ti ti-user"></i></span>
                    <div class="client-identity-copy">
                        <a asp-action="Details" asp-route-id="@item.Id" class="client-name">@item.NombreRazonSocial</a>
                        <span class="client-identifier">@(string.IsNullOrWhiteSpace(item.NitOCi) ? "Sin NIT/CI" : $"NIT/CI: {item.NitOCi}")</span>
                        @if (!string.IsNullOrWhiteSpace(item.Telefono))
                        {
                            <span class="client-mobile-contact d-lg-none"><i class="ti ti-phone" aria-hidden="true"></i> @item.Telefono</span>
                        }
                    </div>
                </div>
            </td>
            <td class="d-none d-md-table-cell">
                <span class="client-segment @segBadge">@seg</span>
                <span class="client-person-type">@tipo</span>
            </td>
            <td class="d-none d-lg-table-cell">
                @if (!string.IsNullOrWhiteSpace(item.Telefono) || !string.IsNullOrWhiteSpace(item.Email))
                {
                    @if (!string.IsNullOrWhiteSpace(item.Telefono))
                    {
                        <div class="client-contact-line"><i class="ti ti-phone" aria-hidden="true"></i>@item.Telefono</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Email))
                    {
                        <div class="client-contact-line client-email"><i class="ti ti-mail" aria-hidden="true"></i>@item.Email</div>
                    }
                }
                else
                {
                    <span class="client-muted">Sin datos de contacto</span>
                }
            </td>
            <td class="d-none d-sm-table-cell text-end text-nowrap"><span class="client-credit">$@item.LimiteCredito.ToString("N2")</span></td>
            <td>
                <span class="client-status @(item.Activo ? "client-status-active" : "client-status-inactive")">
                    <span class="client-status-dot" aria-hidden="true"></span>@(item.Activo ? "Activo" : "Inactivo")
                </span>
            </td>
            <td>
                <div class="client-actions" role="group" aria-label="Acciones para @item.NombreRazonSocial">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light border" title="Ver cliente" aria-label="Ver cliente: @item.NombreRazonSocial"><i class="ti ti-eye" aria-hidden="true"></i></a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light border" title="Editar cliente" aria-label="Editar cliente: @item.NombreRazonSocial"><i class="ti ti-edit" aria-hidden="true"></i></a>
                    <a asp-controller="Sales" asp-action="Create" asp-route-clienteId="@item.Id" class="btn btn-light border client-sale-action" title="Nueva venta" aria-label="Nueva venta para @item.NombreRazonSocial"><i class="ti ti-receipt" aria-hidden="true"></i></a>
                </div>
            </td>
        </tr>
    }

    @if (!Model.Items.Any())
    {
        <tr>
            <td colspan="6">
                <div class="client-empty-state">
                    <span class="client-empty-icon" aria-hidden="true"><i class="ti ti-users"></i></span>
                    <h2>@(Model.TotalItems == 0 ? "Sin clientes registrados" : "Sin resultados")</h2>
                    <p>@(Model.TotalItems == 0 ? "Registre el primer cliente para comenzar la facturación." : "Ningún cliente coincide con los filtros aplicados.")</p>
                    @if (Model.TotalItems == 0)
                    {
                        <a asp-action="Create" class="btn btn-primary"><i class="ti ti-user-plus me-1" aria-hidden="true"></i>Registrar cliente</a>
                    }
                </div>
            </td>
        </tr>
    }
        </tbody>
    </table>
</div>

<style>
    .client-filter-panel, .client-table-wrap { background: #fff; border: 1px solid #e5e9ef; border-radius: 6px; }
    .client-filter-panel { padding: 16px; }
    .client-filter-grid { display: grid; grid-template-columns: minmax(250px, 2fr) minmax(145px, 1fr) minmax(135px, 1fr) auto; gap: 12px; align-items: end; }
    .client-filter-submit { min-height: 44px; min-width: 44px; }
    .client-search-field .input-group > .form-control, .client-search-field .input-group > .input-group-text, .client-filter-grid .form-select { min-height: 44px; }
    .client-filter-actions { display: flex; gap: 8px; }
    .client-filter-actions .btn { min-height: 44px; white-space: nowrap; }
    .client-results-summary { display: flex; justify-content: space-between; align-items: center; gap: 12px; color: #667085; font-size: .875rem; margin: 0 2px 10px; }
    .client-results-summary strong { color: #182230; font-variant-numeric: tabular-nums; }
    .client-filter-state { color: #536273; }
    .client-table { color: #344054; }
    .client-table thead th { background: #f6f8fa; border-bottom: 1px solid #e5e9ef; color: #667085; font-size: .75rem; font-weight: 700; padding: 12px 14px; text-transform: uppercase; white-space: nowrap; }
    .client-table tbody td { border-bottom: 1px solid #edf0f3; padding: 12px 14px; }
    .client-table tbody tr:last-child td { border-bottom: 0; }
    .client-table tbody tr:hover { background: #f9fbfc; }
    .client-identity { align-items: center; display: flex; gap: 10px; min-width: 0; }
    .client-avatar { align-items: center; background: #edf5f2; border-radius: 6px; color: #24745f; display: inline-flex; flex: 0 0 38px; height: 38px; justify-content: center; }
    .client-identity-copy { display: flex; flex-direction: column; min-width: 0; }
    .client-name { color: #182230; font-size: .9rem; font-weight: 650; line-height: 1.35; overflow-wrap: anywhere; text-decoration: none; }
    .client-name:hover { color: #176b59; text-decoration: underline; }
    .client-identifier, .client-person-type, .client-muted { color: #667085; font-size: .75rem; }
    .client-segment { border-radius: 3px; display: inline-block; font-size: .75rem; font-weight: 700; padding: 4px 6px; white-space: nowrap; }
    .client-segment-wholesale { background: #e8eef3; color: #344054; }
    .client-segment-retail { background: #e9f4f1; color: #176b59; }
    .client-person-type { display: block; margin-top: 4px; }
    .client-contact-line { align-items: center; color: #475467; display: flex; font-size: .8rem; gap: 7px; line-height: 1.5; }
    .client-contact-line i, .client-mobile-contact i { color: #667085; flex: 0 0 auto; }
    .client-email { overflow-wrap: anywhere; }
    .client-credit { color: #182230; font-size: .875rem; font-variant-numeric: tabular-nums; font-weight: 600; }
    .client-status { align-items: center; border-radius: 999px; display: inline-flex; font-size: .75rem; font-weight: 600; gap: 6px; white-space: nowrap; }
    .client-status-active { color: #176b59; }
    .client-status-inactive { color: #667085; }
    .client-status-dot { background: currentColor; border-radius: 50%; height: 7px; width: 7px; }
    .client-actions { display: flex; gap: 5px; justify-content: flex-end; }
    .client-actions .btn { align-items: center; display: inline-flex; height: 44px; justify-content: center; min-width: 44px; padding: 0; }
    .client-sale-action { color: #176b59; }
    .client-actions .btn:hover { background: #edf5f2; border-color: #c6dcd4; color: #145c4c; }
    .client-empty-state { padding: 44px 16px; text-align: center; }
    .client-empty-icon { align-items: center; background: #edf5f2; border-radius: 8px; color: #24745f; display: inline-flex; font-size: 1.5rem; height: 48px; justify-content: center; margin-bottom: 12px; width: 48px; }
    .client-empty-state h2 { color: #182230; font-size: 1.1rem; font-weight: 650; margin: 0 0 6px; }
    .client-empty-state p { color: #667085; margin: 0 0 16px; }
    @@media (max-width: 767.98px) {
        .client-filter-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
        .client-search-field, .client-filter-actions { grid-column: 1 / -1; }
        .client-filter-actions .btn { flex: 1; }
    }
    @@media (max-width: 575.98px) {
        .client-filter-panel { padding: 12px; }
        .client-table thead th, .client-table tbody td { padding-left: 8px; padding-right: 8px; }
        .client-avatar { flex-basis: 32px; height: 32px; }
        .client-name { font-size: .82rem; }
        .client-actions { gap: 3px; }
        .client-actions .btn { height: 44px; min-width: 44px; }
    }
</style>

@if (Model.TotalPages > 1)
{
    var inicio = Math.Max(1, Model.Page - 2);
    var fin = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav class="mt-2" aria-label="Paginación de clientes">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-segment="@Model.Segmento" asp-route-estado="@estado" asp-route-page="@(Model.Page - 1)">Anterior</a>
            </li>
            @for (int p = inicio; p <= fin; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" aria-current="@(p == Model.Page ? "page" : null)" aria-label="Página @p" asp-action="Index" asp-route-search="@Model.Search" asp-route-segment="@Model.Segmento" asp-route-estado="@estado" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-segment="@Model.Segmento" asp-route-estado="@estado" asp-route-page="@(Model.Page + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}

<div class="text-center text-muted small mt-2" aria-live="polite">
    Mostrando @desde–@hasta de @Model.TotalItems clientes
</div>
