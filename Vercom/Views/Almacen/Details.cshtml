@model Vercom.Models.Almacen
@{
    ViewBag.Title = "Detalles de Almacén";
    var stockItems = Model.Existencia.Count;
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Almacén: " + Model.Nombre,
    Subtitle = "Ubicación, tipo de depósito y resumen de existencias locales.",
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Vercom", Url = "javascript: void(0);" },
        new() { Text = "Inventario", Url = "javascript: void(0);" },
        new() { Text = "Almacenes", Url = Url.Action("Index") },
        new() { Text = "Detalle", IsActive = true }
    }
}' />
        </a>
    </div>
</div>

<div class="row">
    <div class="row">
        <!-- Columna Izquierda: Identidad y Capacidad -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-status-top bg-primary"></div>
                <div class="card-body text-center p-4">
                    <div class="avatar avatar-xl bg-primary-subtle text-primary rounded-circle mb-3 mx-auto" style="width: 80px; height: 80px;">
                        <i class="ti ti-building-warehouse fs-40"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.Nombre</h3>
                    <code class="fs-13 text-primary fw-bold">@Model.Codigo</code>

                    <div class="mt-4 pt-3 border-top">
                        <div class="row g-2">
                            <div class="col-12">
                                <div class="bg-light-subtle rounded py-3">
                                    <div class="h2 fw-bold mb-0 text-primary">@stockItems</div>
                                    <div class="text-muted tiny fw-bold text-uppercase">Productos con Stock</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <span class="badge @(Model.Activo ? "badge-soft-success" : "badge-soft-danger") fs-12 px-3 py-2">
                            <i class="ti ti-circle-filled me-1"></i> @(Model.Activo ? "ALMACÉN OPERATIVO" : "DESACTIVADO")
                        </span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold small text-uppercase">Información Logística</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted tiny fw-bold text-uppercase d-block mb-1">Sucursal Asociada</label>
                        <div class="d-flex align-items-center">
                            <i class="ti ti-building-community me-2 text-muted"></i>
                            <span class="fw-bold">@Model.Sucursal.Nombre</span>
                        </div>
                    </div>
                    <div class="mb-0">
                        <label class="text-muted tiny fw-bold text-uppercase d-block mb-1">Punto de Venta (POS)</label>
                        @if(Model.EsPuntoVenta) {
                            <span class="badge bg-success-subtle text-success fw-bold"><i class="ti ti-check me-1"></i> HABILITADO PARA POS</span>
                        } else {
                            <span class="badge bg-light text-muted fw-bold"><i class="ti ti-x me-1"></i> SOLO DEPÓSITO</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Inventario Detallado -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Inventario en Tiempo Real</h5>
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                        <input type="text" id="stockSearch" class="form-control form-control-sm" placeholder="Filtrar productos...">
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table id="warehouseStockTable" class="table table-vcenter card-table table-hover">
                            <thead class="sticky-top bg-white shadow-sm">
                                <tr>
                                    <th>Producto</th>
                                  <th>Existencia</th>
                                  <th>Costo PPP</th>
                                    <th>Valorizado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var ex in Model.Existencia.OrderByDescending(x => x.Cantidad)) {
                                    <tr>
                                        <td>
                                            <div class="fw-bold fs-13">@ex.Producto.Nombre</div>
                                            <div class="text-muted tiny font-monospace">@ex.Producto.Codigo</div>
                                        </td>
                                        <td >
                                            <span class="badge @(ex.Cantidad <= ex.StockMinimo ? "bg-danger" : "bg-success")">@ex.Cantidad.ToString("N2")</span>
                                        </td>
                                        <td small font-monospace">@ex.CostoPromedio.ToString("N4")</td>
                                       <td class="fw-bold text-primary">
                                            @((ex.Cantidad * ex.CostoPromedio).ToString("C"))
                                        </td>
                                    </tr>
                                }
                                @if(!Model.Existencia.Any()) {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted small">Este almacén no tiene existencias registradas.</td>
                                    </tr>
                                }
                            </tbody>
                            @if(Model.Existencia.Any()) {
                                <tfoot class="bg-light-subtle fw-bold">
                                    <tr>
                                        <td colspan="3" class="text-end">VALOR TOTAL DEL INVENTARIO:</td>
                                       <td class="text-primary fs-15">@Model.Existencia.Sum(x => x.Cantidad * x.CostoPromedio).ToString("C")</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="ti ti-arrow-left me-1"></i> VOLVER AL LISTADO
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('stockSearch').addEventListener('keyup', function() {
            const val = this.value.toLowerCase();
            const rows = document.querySelectorAll('#warehouseStockTable tbody tr');
            rows.forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(val) ? '' : 'none';
            });
        });
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-12 { font-size: 0.75rem; }
    .fs-13 { font-size: 0.8125rem; }
    .fs-15 { font-size: 1rem; }
</style>
