@model IEnumerable<Vercom.Models.Almacen>
@{
    ViewBag.Title = "Almacenes y Depósitos";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Nomenclador de Almacenes y Depósitos</h4>
        <p class="text-muted small mb-0">Ubicaciones físicas y puntos de venta para el control logístico.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Inventario</a></li>
            <li class="breadcrumb-item active">Almacenes</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus"></i> NUEVO ALMACÉN
        </a>
    </div>
</div>

<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-building-warehouse me-2 text-primary"></i>Ubicaciones Configuradas</h5>
        </div>
        <div class="card-body">
            <table id="warehousesTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                           <th>Código</th>
                        <th>Nombre del Almacén</th>
                        <th>Sucursal Asociada</th>
                        <th  class="text-center">Punto de Venta</th>
                        <th  class="text-center">Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td><i class="ti ti-building me-1 text-muted"></i> @(item.Sucursal?.Nombre ?? "Central")</td>
                            <td >
                                @if (item.EsPuntoVenta)
                                {
                                    <span class="badge badge-soft-info"><i class="ti ti-device-desktop me-1"></i> SÍ</span>
                                }
                                else
                                {

                                    <span class="text-muted small">NO</span>
                                }
                            </td>
                            <td >
                                @if (item.Activo)
                                {
                                    <span class="badge badge-soft-success">ACTIVO</span>
                                }
                                else
                                {

                                    <span class="badge badge-soft-danger">INACTIVO</span>
                                }
                            </td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Detalles">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Configurar">
                                        <i class="ti ti-settings"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#warehousesTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
            });
        });
    </script>
}
