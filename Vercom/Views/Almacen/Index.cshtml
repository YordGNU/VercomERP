@model IEnumerable<Vercom.Models.Almacen>
@{
    ViewBag.Title = "Almacenes y Depósitos";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Nomenclador de Almacenes y Depósitos</h4>
        <p class="text-muted small mb-0">Ubicaciones físicas y puntos de venta para el control logístico.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Inventario</a></li>
            <li class="breadcrumb-item active">Almacenes</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus"></i> NUEVO ALMACÉN
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-building-warehouse me-2 text-primary"></i>Ubicaciones Configuradas</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="warehousesTable"  class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th width="150">Código</th>
                            <th>Nombre del Almacén</th>
                            <th width="200">Sucursal Asociada</th>
                            <th width="150" class="text-center">Punto de Venta</th>
                            <th width="120" class="text-center">Estado</th>
                            <th width="100" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td><i class="ti ti-building me-1 text-muted"></i> @(item.Sucursal?.Nombre ?? "Central")</td>
                                <td class="text-center">
                                    @if (item.EsPuntoVenta) { <span class="badge badge-soft-info"><i class="ti ti-device-desktop me-1"></i> SÍ</span> }
                                    else { <span class="text-muted small">NO</span> }
                                </td>
                                <td class="text-center">
                                    @if (item.Activo) { <span class="badge badge-soft-success">ACTIVO</span> }
                                    else { <span class="badge badge-soft-danger">INACTIVO</span> }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Detalles">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Configurar">
                                            <i class="ti ti-settings"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#warehousesTable').DataTable({
                         language: { url: '/js/i18n/es-ES.json' }
            });
        });
    </script>
}
