@model Vercom.ViewModels.AlmacenFormViewModel
@{
    ViewBag.Title = "Editar Almacén";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Actualizar Configuración de Almacén</h4>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form asp-action="Edit" method="post" class="row g-3">
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                        <input type="hidden" asp-for="Almacen.Id" name="Almacen.Id" />

                        <div class="col-md-4">
                            <label asp-for="Almacen.Codigo" class="form-label fw-bold">Código Interno</label>
                            <input asp-for="Almacen.Codigo" name="Almacen.Codigo" class="form-control" readonly />
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Almacen.Nombre" class="form-label fw-bold">Nombre del Almacén</label>
                            <input asp-for="Almacen.Nombre" name="Almacen.Nombre" class="form-control" required />
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Almacen.SucursalId" class="form-label fw-bold">Sucursal Responsable</label>
                            <select asp-for="Almacen.SucursalId" name="Almacen.SucursalId" class="form-select" asp-items="Model.Sucursales" required></select>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="Almacen.EsPuntoVenta" name="Almacen.EsPuntoVenta">
                                <label class="form-check-label fw-bold">Punto de Venta</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="Almacen.Activo" name="Almacen.Activo">
                                <label class="form-check-label fw-bold">Activo</label>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
