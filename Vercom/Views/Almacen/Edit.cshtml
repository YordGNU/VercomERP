@model Vercom.ViewModels.AlmacenFormViewModel
@{
    ViewBag.Title = "Editar Almacén";
}

<partial name="_PageTitleHead" model='new Vercom.ViewModels.PageTitleHeadModel {
    Title = "Actualizar Almacén: " + Model.Almacen.Nombre,
    Subtitle = "Gestión de parámetros operativos y ubicación de inventario.",
    BreadcrumbItems = new List<Vercom.ViewModels.BreadcrumbItem> {
        new() { Text = "Vercom", Url = "javascript: void(0);" },
        new() { Text = "Inventario", Url = "javascript: void(0);" },
        new() { Text = "Almacenes", Url = Url.Action("Index") },
        new() { Text = "Editar", IsActive = true }
    }
}' />

<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold"><i class="ti ti-edit me-2 text-primary"></i>Configuración de Depósito</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" class="row g-4" id="editWarehouseForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Almacen.Id" name="Almacen.Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Código Interno</label>
                            <input asp-for="Almacen.Codigo" name="Almacen.Codigo" class="form-control bg-light" readonly />
                        </div>

                        <div class="col-md-8">
                            <label class="form-label fw-bold">Nombre del Almacén</label>
                            <input asp-for="Almacen.Nombre" name="Almacen.Nombre" class="form-control" placeholder="Ej: Almacén de Insumos Secos" required maxlength="150" />
                            <span asp-validation-for="Almacen.Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Sucursal Responsable</label>
                            <select asp-for="Almacen.SucursalId" name="Almacen.SucursalId" class="form-control form-select w-100 select2" asp-items="Model.Sucursales" required></select>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="form-check form-switch p-3 bg-light rounded-3">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Almacen.EsPuntoVenta">
                                        <label class="form-check-label fw-bold">Habilitar para Punto de Venta (POS)</label>
                                        <p class="text-muted tiny mb-0 mt-1">Permite facturar mercancía desde esta ubicación.</p>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch p-3 bg-light rounded-3">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Almacen.Activo">
                                        <label class="form-check-label fw-bold text-success">Almacén Operativo</label>
                                        <p class="text-muted tiny mb-0 mt-1">Habilitado para recepciones y despachos.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('editWarehouseForm');
        });
    </script>
}
