@model VERCOM.Models.PlanProduccion
@{
    ViewBag.Title = "Detalle del plan";
    var meses = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti ti-arrow-left me-1'></i> VOLVER</a>"; var pageHeader = new VERCOM.ViewModels.PageHeaderModel { Eyebrow = "Producción", Title = "Detalle del plan de producción", Subtitle = "Resumen del período planificado y el volumen de materiales asociados.", Icon = "ti ti-list-details", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-light-subtle">
                <h5 class="m-0 fw-bold"><i class="ti ti-calendar-event me-2 text-primary"></i>Resumen</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <div class="text-muted small text-uppercase">Periodo</div>
                    <h4 class="fw-bold mb-0">@meses[Model.Mes ?? 1] @Model.Anio</h4>
                </div>
                <div class="mb-3">
                    <div class="text-muted small text-uppercase">Estado</div>
                    <span class="badge @(Model.Estado == "BORRADOR" ? "bg-warning-subtle text-warning" : Model.Estado == "APROBADO" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") px-3 py-2">@Model.Estado</span>
                </div>
                <div class="mb-3">
                    <div class="text-muted small text-uppercase">Presupuesto</div>
                    <div class="fw-semibold">@(Model.Presupuesto?.Nombre ?? "Sin presupuesto")</div>
                </div>
                <div>
                    <div class="text-muted small text-uppercase">Creado</div>
                    <div>@Model.CreadoEn.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold"><i class="ti ti-box me-2 text-primary"></i>Artículos del plan</h5>
                <a asp-controller="PlanProduccion" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary"><i class="ti ti-edit me-1"></i>EDITAR</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light-subtle">
                            <tr>
                                <th class="ps-4">Producto</th>
                                <th>Cantidad planificada</th>
                                <th>Cantidad ejecutada</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PlanProduccionDetalles.Any())
                            {
                                @foreach (var detalle in Model.PlanProduccionDetalles)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold">@detalle.Producto.Nombre</div>
                                            <small class="text-muted">@detalle.Producto.Codigo</small>
                                        </td>
                                        <td>@detalle.CantidadPlanificada.ToString("N2")</td>
                                        <td>@detalle.CantidadEjecutada.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-5 text-muted">
                                        <i class="ti ti-package-off fs-30 d-block mb-2 opacity-50"></i>
                                        No hay artículos asociados a este plan.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
