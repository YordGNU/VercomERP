@model Vercom.Models.Rol
@{
    ViewBag.Title = "Detalle del Rol de Usuario";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Rol: @Model.Nombre</h4>
        <p class="text-muted small mb-0">Código Interno: <span class="fw-bold font-monospace">@Model.Codigo</span></p>
    </div>
    <div class="text-end d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i> VOLVER
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
            <i class="ti ti-edit me-1"></i> EDITAR NOMBRE
        </a>
        <a asp-action="ManagePermissions" asp-route-id="@Model.Id" class="btn btn-sm btn-warning">
            <i class="ti ti-lock me-1"></i> GESTIONAR PERMISOS
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="m-0 fw-bold"><i class="ti ti-info-circle me-2 text-primary"></i>Definición</h5>
                </div>
                <div class="card-body">
                    <label class="text-muted small text-uppercase fw-bold d-block">Descripción</label>
                    <p class="fs-15">@(Model.Descripcion ?? "Sin descripción asignada.")</p>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small fw-bold text-uppercase">Protegido por Sistema</span>
                        @if(Model.EsSistema) { <span class="badge bg-danger">SÍ</span> }
                        else { <span class="badge bg-success">NO</span> }
                    </div>
                </div>
            </div>

            <div class="card bg-primary-subtle border-0">
                <div class="card-body text-center py-4">
                    <div class="text-muted small text-uppercase fw-bold mb-1">Usuarios con este Rol</div>
                    <div class="fs-32 fw-bold text-primary">@Model.UsuarioRols.Count</div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="m-0 fw-bold"><i class="ti ti-shield-lock me-2 text-primary"></i>Matriz de Permisos Habilitados</h5>
                </div>
                <div class="card-body">
                    @if (Model.Permisos.Any())
                    {
                        var groups = Model.Permisos.GroupBy(p => p.Modulo).OrderBy(g => g.Key);
                        <div class="row g-3">
                            @foreach (var g in groups)
                            {
                                <div class="col-md-6">
                                    <div class="bg-light p-2 px-3 rounded-3 mb-2">
                                        <h6 class="m-0 fw-bold text-primary small text-uppercase">Módulo: @g.Key</h6>
                                    </div>
                                    <ul class="list-unstyled ps-3 mb-4">
                                        @foreach (var p in g.OrderBy(x => x.Modulo))
                                        {
                                            <li class="mb-1">
                                                <i class="ti ti-check text-success me-2"></i>
                                                <span class="fs-13">@p.Modulo</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning border-0">
                            <i class="ti ti-alert-triangle me-2"></i>
                            Este rol no tiene permisos asignados. Los usuarios asociados no podrán realizar acciones en el sistema.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
