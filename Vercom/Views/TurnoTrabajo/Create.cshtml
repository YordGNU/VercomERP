@model Vercom.Models.TurnoTrabajo
@{
    ViewBag.Title = "Nuevo Turno de Trabajo";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Crear Turno de Trabajo</h4>
        <p class="text-muted small mb-0">Defina el intervalo horario y las tolerancias permitidas.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Codigo" class="form-label fw-bold small">Código</label>
                        <input asp-for="Codigo" class="form-control" placeholder="Ej. T-01" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-bold small">Nombre del Turno</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Matutino 8am - 5pm" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoraEntrada" class="form-label fw-bold small">Hora de Entrada</label>
                            <input asp-for="HoraEntrada" type="time" class="form-control text-center font-monospace" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HoraSalida" class="form-label fw-bold small">Hora de Salida</label>
                            <input asp-for="HoraSalida" type="time" class="form-control text-center font-monospace" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ToleranciaMinutos" class="form-label fw-bold small">Tolerancia (Minutos)</label>
                            <input asp-for="ToleranciaMinutos" type="number" class="form-control" value="15" required />
                        </div>
                        <div class="col-md-6 mb-3 d-flex align-items-center">
                            <div class="form-check form-switch mt-4">
                                <input asp-for="EsNocturno" class="form-check-input" type="checkbox" />
                                <label asp-for="EsNocturno" class="form-check-label fw-bold small">Turno Nocturno</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light-subtle d-flex justify-content-between p-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">CANCELAR</a>
                    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i> GUARDAR TURNO</button>
                </div>
            </form>
        </div>
    </div>
</div>
