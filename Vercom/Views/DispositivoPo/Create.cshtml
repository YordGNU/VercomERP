@model VERCOM.ViewModels.DispositivoPosFormViewModel
@{
    ViewBag.Title = "Registrar Terminal POS";
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Terminales</a>"; var pageHeader = new VERCOM.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Alta de Dispositivo de Venta", Subtitle = "Configuración de hardware y vinculación de caja para operaciones de campo.", Icon = "ti-file", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle py-3">
                    <h5 class="m-0 fw-bold"><i class="ti ti-device-mobile me-2 text-primary"></i>Configuración de Terminal</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-4">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Código Interno</label>
                            <input asp-for="Dispositivo.Codigo" name="Dispositivo.Codigo" class="form-control fw-bold text-primary text-uppercase" placeholder="Ej: POS-01" required maxlength="30" />
                            <span asp-validation-for="Dispositivo.Codigo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-9">
                            <label class="form-label fw-bold">Nombre del Dispositivo / Ubicación</label>
                            <input asp-for="Dispositivo.Nombre" name="Dispositivo.Nombre" class="form-control" placeholder="Ej: Tablet Ventas Matanzas" required maxlength="100" />
                            <span asp-validation-for="Dispositivo.Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Sucursal Responsable</label>
                            <select asp-for="Dispositivo.SucursalId" name="Dispositivo.SucursalId" class="form-control form-select w-100 select2" asp-items="Model.Sucursales" required>
                                <option value="">-- Seleccione Sucursal --</option>
                            </select>
                            @if (!string.IsNullOrWhiteSpace(Model.EntidadNombre))
                            {
                                <small class="text-muted">Entidad: @Model.EntidadNombre. La caja y el almacén se filtran por la sucursal elegida.</small>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Caja Asociada (Tesorería)</label>
                            <select asp-for="Dispositivo.CajaId" name="Dispositivo.CajaId" class="form-control form-select w-100 select2" asp-items="Model.Cajas" required>
                                <option value="">-- Seleccione Caja --</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Almacén / Inventario de Venta</label>
                            <select asp-for="Dispositivo.AlmacenId" name="Dispositivo.AlmacenId" class="form-control form-select w-100 select2" asp-items="Model.Almacenes" required>
                                <option value="">-- Seleccione Almacén --</option>
                            </select>
                            <small class="text-muted">El dispositivo descuenta de este almacén el stock de sus ventas.</small>
                        </div>

                        <div class="col-12 d-none" id="posUbicacionAviso">
                            <div class="alert alert-warning py-2 small border-0 mb-0"></div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Identificador de Hardware (MAC/UUID/IMEI)</label>
                            <input asp-for="Dispositivo.IdentificadorHardware" name="Dispositivo.IdentificadorHardware" class="form-control font-monospace" placeholder="ID único del dispositivo físico" maxlength="100" />
                            <small class="text-muted">Se utiliza para el blindaje de seguridad y evitar clones de terminales.</small>
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Estado Operativo</label>
                                    <select asp-for="Dispositivo.Estado" name="Dispositivo.Estado" class="form-select">
                                        <option value="ACTIVO">ACTIVO</option>
                                        <option value="BLOQUEADO">BLOQUEADO</option>
                                        <option value="MANTENIMIENTO">MANTENIMIENTO</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Versión de App Requerida</label>
                                    <input asp-for="Dispositivo.VersionAppPos" name="Dispositivo.VersionAppPos" class="form-control" value="1.0.0" />
                                </div>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> REGISTRAR TERMINAL
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(function () {
            const url = '@Url.Action("Ubicaciones", "DispositivoPo")';
            const sucursal = $('#Dispositivo_SucursalId');
            const almacen = $('#Dispositivo_AlmacenId');
            const caja = $('#Dispositivo_CajaId');

            function rellenar(select, items, placeholder) {
                if (select.hasClass('select2-hidden-accessible')) select.select2('destroy');
                select.empty().append(new Option(placeholder, ''));
                (items || []).forEach(function (i) { select.append(new Option(i.text, i.value)); });
                select.prop('disabled', !items || items.length === 0);
                select.select2({ width: '100%', placeholder: placeholder, allowClear: true });
            }

            function limpiar() {
                rellenar(caja, [], '-- Seleccione Caja --');
                rellenar(almacen, [], '-- Seleccione Almacén --');
                $('#posUbicacionAviso').addClass('d-none');
            }

            function avisar(data) {
                const faltan = [];
                if (!data.cajas || !data.cajas.length) faltan.push('cajas activas');
                if (!data.almacenes || !data.almacenes.length) faltan.push('almacenes activos');
                const aviso = $('#posUbicacionAviso');
                if (faltan.length) {
                    aviso.removeClass('d-none').find('.alert').text(
                        'La sucursal seleccionada no tiene ' + faltan.join(' ni ') +
                        '. Créelos (Tesorería / Almacenes) antes de registrar el terminal.');
                } else {
                    aviso.addClass('d-none');
                }
            }

            async function cargar(valores) {
                const sucursalId = sucursal.val();
                if (!sucursalId) { limpiar(); return; }

                try {
                    const res = await fetch(url + '?sucursalId=' + encodeURIComponent(sucursalId), { headers: { Accept: 'application/json' } });
                    if (!res.ok) throw new Error('No se pudieron cargar las cajas y almacenes.');
                    const data = await res.json();

                    rellenar(caja, data.cajas, '-- Seleccione Caja --');
                    rellenar(almacen, data.almacenes, '-- Seleccione Almacén --');
                    avisar(data);

                    if (valores) {
                        if (valores.caja) caja.val(valores.caja).trigger('change.select2');
                        if (valores.almacen) almacen.val(valores.almacen).trigger('change.select2');
                    }
                } catch (e) {
                    Swal.fire({ icon: 'error', title: 'Caja y almacén', text: e.message });
                }
            }

            sucursal.on('change', function () { cargar(); });

            if (sucursal.val()) {
                cargar({ caja: '@Model.Dispositivo.CajaId', almacen: '@Model.Dispositivo.AlmacenId' });
            } else {
                limpiar();
            }
        });
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
