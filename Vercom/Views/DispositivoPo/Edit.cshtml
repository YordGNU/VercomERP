@model Vercom.ViewModels.DispositivoPosFormViewModel
@{
    ViewBag.Title = "Editar Terminal POS";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Configuración de Hardware: @Model.Dispositivo.Nombre</h4>
        <p class="text-muted small mb-0">Gestión de parámetros operativos y vinculación de fondos.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Ventas</a></li>
            <li class="breadcrumb-item active">Editar Terminal</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                 <div class="card-header bg-light-subtle py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary"><i class="ti ti-settings me-2"></i>Parámetros de Dispositivo</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> VOLVER
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" id="editDeviceForm" class="row g-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Dispositivo.Id" name="Dispositivo.Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Código Interno</label>
                            <input asp-for="Dispositivo.Codigo" name="Dispositivo.Codigo" class="form-control fw-bold bg-light" readonly />
                        </div>

                        <div class="col-md-9">
                            <label class="form-label fw-bold">Nombre del Dispositivo</label>
                            <input asp-for="Dispositivo.Nombre" name="Dispositivo.Nombre" class="form-control" placeholder="Ej: Tablet Ventas" required maxlength="100" />
                            <span asp-validation-for="Dispositivo.Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Sucursal</label>
                            <select asp-for="Dispositivo.SucursalId" name="Dispositivo.SucursalId" class="form-control form-select select2" asp-items="Model.Sucursales" required></select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Caja (Fondos)</label>
                            <select asp-for="Dispositivo.CajaId" name="Dispositivo.CajaId" class="form-control form-select select2" asp-items="Model.Cajas" required></select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Almacén / Inventario de Venta</label>
                            <select asp-for="Dispositivo.AlmacenId" name="Dispositivo.AlmacenId" class="form-control form-select select2" asp-items="Model.Almacenes" required></select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Identificador de Hardware (MAC/UUID/IMEI)</label>
                            <input asp-for="Dispositivo.IdentificadorHardware" name="Dispositivo.IdentificadorHardware" class="form-control font-monospace" placeholder="ID único del dispositivo físico" maxlength="100" />
                            <small class="text-muted">Debe coincidir con el MAC WiFi que envía la app al auto-configurarse.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Versión de App POS</label>
                            <input asp-for="Dispositivo.VersionAppPos" name="Dispositivo.VersionAppPos" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Estado Operativo</label>
                            <select asp-for="Dispositivo.Estado" name="Dispositivo.Estado" class="form-select">
                                <option value="ACTIVO">ACTIVO</option>
                                <option value="BLOQUEADO">BLOQUEADO</option>
                                <option value="MANTENIMIENTO">MANTENIMIENTO</option>
                            </select>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">DESCARTAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('editDeviceForm');
        });
    </script>
}
