@model IEnumerable<Vercom.Models.DispositivoPo>
@using System.Linq
@{
    ViewBag.Title = "Dispositivos POS";
    var sesiones = (Dictionary<Guid, Vercom.Models.SesionCajaPo>?)ViewBag.SesionesActivas ?? new();
    var now = DateTimeOffset.Now;
    var total = Model.Count();
    var online = Model.Count(d => d.Estado == "ACTIVO" && d.UltimaSincronizacion.HasValue && d.UltimaSincronizacion.Value > now.AddMinutes(-30));
    var desconectados = Model.Count(d => d.Estado == "ACTIVO" && !(d.UltimaSincronizacion.HasValue && d.UltimaSincronizacion.Value > now.AddMinutes(-30)));
    var noActivos = Model.Count(d => d.Estado != "ACTIVO");
    var turnosAbiertos = Model.Select(d => d.CajaId).Distinct().Count(c => sesiones.ContainsKey(c));
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Terminales de Venta (POS)</h4>
        <p class="text-muted small mb-0">Administración de hardware, licencias y sincronización de dispositivos móviles.</p>
    </div>
    <div class="text-end">
            <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-device-laptop me-1"></i> REGISTRAR DISPOSITIVO
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card card-sm border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="bg-primary-subtle text-primary p-2 rounded-circle"><i class="ti ti-devices fs-24"></i></div>
                    <div>
                        <div class="fs-4 fw-bold lh-1">@total</div>
                        <div class="tiny text-muted fw-bold mt-1">TERMINALES</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-sm border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="bg-success-subtle text-success p-2 rounded-circle"><i class="ti ti-wifi fs-24"></i></div>
                    <div>
                        <div class="fs-4 fw-bold lh-1">@online</div>
                        <div class="tiny text-muted fw-bold mt-1">ONLINE</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-sm border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="bg-warning-subtle text-warning p-2 rounded-circle"><i class="ti ti-wifi-off fs-24"></i></div>
                    <div>
                        <div class="fs-4 fw-bold lh-1">@desconectados</div>
                        <div class="tiny text-muted fw-bold mt-1">DESCONECTADOS</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card card-sm border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="bg-danger-subtle text-danger p-2 rounded-circle"><i class="ti ti-shield-lock fs-24"></i></div>
                    <div>
                        <div class="fs-4 fw-bold lh-1">@noActivos</div>
                        <div class="tiny text-muted fw-bold mt-1">BLOQUEADOS</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card card-sm border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex align-items-center gap-3">
                    <div class="bg-info-subtle text-info p-2 rounded-circle"><i class="ti ti-cash-register fs-24"></i></div>
                    <div>
                        <div class="fs-4 fw-bold lh-1">@turnosAbiertos</div>
                        <div class="tiny text-muted fw-bold mt-1">TURNOS ABIERTOS</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="ti ti-search"></i></span>
                        <input type="text" id="txtBuscar" class="form-control" placeholder="Buscar por nombre, código o MAC..." autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="btn-group btn-group-sm w-100 d-flex" role="group">
                        <button type="button" class="btn btn-primary btn-estado" data-estado="TODOS">TODOS</button>
                        <button type="button" class="btn btn-outline-secondary btn-estado" data-estado="ONLINE">ONLINE</button>
                        <button type="button" class="btn btn-outline-secondary btn-estado" data-estado="DESCONECTADO">DESCONECTADO</button>
                        <button type="button" class="btn btn-outline-secondary btn-estado" data-estado="BLOQUEADO">BLOQUEADO</button>
                        <button type="button" class="btn btn-outline-secondary btn-estado" data-estado="MANTENIMIENTO">MANTENIMIENTO</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cards" id="devicesRow">
        @foreach (var item in Model)
        {
            var isOnline = item.UltimaSincronizacion.HasValue && item.UltimaSincronizacion.Value > DateTimeOffset.Now.AddMinutes(-30);
            var state = item.Estado == "ACTIVO" ? (isOnline ? "ONLINE" : "DESCONECTADO") : item.Estado;
            var statusColor = state switch { "ONLINE" => "success", "MANTENIMIENTO" => "secondary", "BLOQUEADO" => "danger", _ => "warning" };
            var search = (item.Nombre + " " + item.Codigo + " " + item.IdentificadorHardware).ToLowerInvariant();
            var sesion = sesiones.ContainsKey(item.CajaId) ? sesiones[item.CajaId] : null;

            <div class="col-md-6 col-lg-4 dev-col" data-search="@search" data-estado="@state">
                <div class="card card-sm shadow-sm border-0 h-100">
                    <div class="card-status-top bg-@statusColor"></div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="bg-@statusColor-subtle text-@statusColor p-3 rounded-circle">
                                <i class="ti ti-device-mobile fs-28"></i>
                            </div>
                            <span class="badge badge-soft-@statusColor px-3 py-1">
                                @state
                            </span>
                        </div>

                        <h4 class="fw-bold mb-1">@item.Nombre</h4>
                        <code class="text-primary tiny fw-bold">CÓDIGO: @item.Codigo</code>

                        <div class="bg-light-subtle rounded-3 p-3 mt-4 mb-2 border border-dashed small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted tiny fw-bold">SINCRO:</span>
                                <span class="fw-bold">@(item.UltimaSincronizacion?.ToString("dd MMM, HH:mm") ?? "Nunca")</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted tiny fw-bold">APP VER:</span>
                                <span class="small">v@(item.VersionAppPos ?? "1.0.0")</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.IdentificadorHardware))
                            {
                                <div class="d-flex justify-content-between mt-1">
                                    <span class="text-muted tiny fw-bold">MAC:</span>
                                    <span class="small font-monospace">@item.IdentificadorHardware</span>
                                </div>
                            }
                        </div>

                        @if (sesion != null)
                        {
                            <div class="bg-warning-subtle rounded-3 p-3 mb-4 border border-warning">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="tiny fw-bold text-dark"><i class="ti ti-cash-register me-1 text-warning"></i>TURNO ABIERTO</span>
                                    <a asp-controller="SesionCajaPo" asp-action="Details" asp-route-id="@sesion.Id" class="btn btn-icon btn-sm btn-ghost-warning" title="Ver turno">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                </div>
                                <div class="row text-center">
                                    <div class="col-6">
                                        <div class="fs-5 fw-bold lh-1">@sesion.TotalVentas.ToString("N2")</div>
                                        <div class="tiny text-muted fw-bold mt-1">VENTAS ($)</div>
                                    </div>
                                    <div class="col-6">
                                        <div class="fs-5 fw-bold lh-1">@sesion.CantidadFacturas</div>
                                        <div class="tiny text-muted fw-bold mt-1">FACTURAS</div>
                                    </div>
                                </div>
                                <div class="small text-muted mt-2 text-center">Desde @sesion.FechaApertura.ToString("dd MMM, HH:mm")</div>
                            </div>
                        }
                        else
                        {
                            <div class="bg-light-subtle rounded-3 p-2 mb-4 border border-dashed small text-center">
                                <span class="text-muted tiny fw-bold">SIN TURNO ABIERTO</span>
                            </div>
                        }

                        <div class="d-grid gap-2">
                            <div class="row g-2">
                                <div class="col-6">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary w-100">DETALLES</a>
                                </div>
                                <div class="col-6">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary w-100">CONFIGURAR</a>
                                </div>
                            </div>
                            <a asp-controller="PosVentaPendiente" asp-action="Index" asp-route-deviceId="@item.Id" class="btn btn-sm btn-ghost-primary">
                                <i class="ti ti-cloud-download me-1"></i> VER VENTAS PENDIENTES
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any()) {
            <div class="col-12 text-center py-5">
                <div class="avatar avatar-xl bg-light-subtle text-muted rounded-circle mb-3 mx-auto">
                    <i class="ti ti-devices fs-48"></i>
                </div>
                <h3 class="fw-bold">No hay terminales registradas</h3>
                <p class="text-muted">Inscriba los dispositivos móviles para comenzar a facturar desde el terreno.</p>
                <a asp-action="Create" class="btn btn-primary mt-2">REGISTRAR DISPOSITIVO</a>
            </div>
        }
        <div id="sinResultados" class="col-12 text-center py-5 d-none">
            <div class="avatar avatar-xl bg-light-subtle text-muted rounded-circle mb-3 mx-auto">
                <i class="ti ti-search-off fs-48"></i>
            </div>
            <h3 class="fw-bold">Sin coincidencias</h3>
            <p class="text-muted">Ninguna terminal coincide con el filtro aplicado.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function aplicarFiltro() {
                var q = ($('#txtBuscar').val() || '').toLowerCase().trim();
                var estado = $('.btn-estado.active').length ? $('.btn-estado.active').data('estado') : 'TODOS';
                var visibles = 0;
                $('.dev-col').each(function () {
                    var ok = (!q || ($(this).data('search') || '').toLowerCase().indexOf(q) >= 0)
                          && (estado === 'TODOS' || $(this).data('estado') === estado);
                    $(this).toggle(ok);
                    if (ok) visibles++;
                });
                $('#sinResultados').toggleClass('d-none', visibles > 0 || @total === 0);
            }

            $(document).ready(function () {
                $('.btn-estado').on('click', function () {
                    $('.btn-estado').removeClass('btn-primary').addClass('btn-outline-secondary');
                    $(this).addClass('btn-primary').removeClass('btn-outline-secondary');
                    aplicarFiltro();
                }).first().addClass('btn-primary').removeClass('btn-outline-secondary');

                $('#txtBuscar').on('input', aplicarFiltro);
            });
        })();
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>