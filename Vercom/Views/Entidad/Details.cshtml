@model Vercom.Models.Entidad
@inject Vercom.Services.IEntidadDisplayService EntidadDisplay
@{
    ViewBag.Title = "Perfil de la Entidad";
    var isMaster = User.Identity?.Name == "master";
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Volver al Listado</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Administración", Title = "Información Legal", Subtitle = "Entidad: @EntidadDisplay.Name", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />


<div class="row mt-4">
    <div class="row">
        <!-- Resumen General -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body text-center">
                    <div class="avatar-xl bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="ti ti-building-community fs-40"></i>
                    </div>
                    <h4 class="mb-1">@EntidadDisplay.Name</h4>
                    <p class="text-muted">@EntidadDisplay.Name</p>
                    <span class="badge @(Model.Activo ? "bg-success" : "bg-danger") mb-3">@(Model.Activo ? "OPERATIVA" : "SUSPENDIDA")</span>

                    <div class="border-top pt-3 text-start small">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">NIT:</span>
                            <span class="fw-bold">@Model.Nit</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">REEUP:</span>
                            <span class="fw-bold">@Model.CodigoReeup</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Moneda Base:</span>
                            <span class="badge bg-dark">@Model.MonedaBase</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                 <div class="card-header border-light justify-content-between"><h5 class="card-title mb-0">Contacto Directo</h5></div>
                <div class="card-body small">
                    <p class="mb-2"><i class="ti ti-phone me-2 text-primary"></i> @Model.Telefono</p>
                    <p class="mb-2"><i class="ti ti-mail me-2 text-primary"></i> @Model.Email</p>
                    <p class="mb-0"><i class="ti ti-map-pin me-2 text-primary"></i> @Model.Municipio, @Model.Provincia</p>
                </div>
            </div>
        </div>

        <!-- Detalles Fiscales y Operativos -->
        <div class="col-lg-8">
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h4 class="card-title">Datos Registrales y Fiscales</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="text-muted small d-block mb-1">Forma Jurídica</label>
                            <span class="fw-bold fs-15">@Model.FormaJuridica</span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="text-muted small d-block mb-1">Fecha de Constitución</label>
                            <span>@Model.FechaConstitucion?.ToString("dd 'de' MMMM, yyyy")</span>
                        </div>
                        <div class="col-12 mb-4">
                            <label class="text-muted small d-block mb-1">Dirección Legal (Fiscal)</label>
                            <p class="mb-0">@Model.DireccionLegal</p>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="text-muted small d-block mb-1">Licencia de Actividad</label>
                            <code class="text-primary">@Model.LicenciaActividad</code>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="text-muted small d-block mb-1">ID del Sistema</label>
                            <small class="text-muted">@Model.Id</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Auditoría del Registro -->
            <div class="card mt-4 bg-light-subtle">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <span class="small text-muted"><i class="ti ti-history me-1"></i> Creado el: @Model.CreadoEn.ToString("g")</span>
                    <span class="small text-muted"><i class="ti ti-refresh me-1"></i> Último cambio: @Model.ActualizadoEn.ToString("g")</span>
                </div>
            </div>
        </div>
    </div>
</div>
