@model Vercom.Models.Entidad

@{
    ViewData["Title"] = "Editar Entidad";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Editar Entidad</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Administración</a></li>
            <li class="breadcrumb-item active">Entidades</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Edición</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="col-md-8">
                            <label asp-for="RazonSocial" class="form-label"></label>
                            <input asp-for="RazonSocial" class="form-control" placeholder="Razón social" />
                            <span asp-validation-for="RazonSocial" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="NombreComercial" class="form-label"></label>
                            <input asp-for="NombreComercial" class="form-control" placeholder="Nombre comercial" />
                            <span asp-validation-for="NombreComercial" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Nit" class="form-label"></label>
                            <input asp-for="Nit" class="form-control" placeholder="NIT" />
                            <span asp-validation-for="Nit" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CodigoReeup" class="form-label"></label>
                            <input asp-for="CodigoReeup" class="form-control" placeholder="Código REEUP" />
                            <span asp-validation-for="CodigoReeup" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FormaJuridica" class="form-label"></label>
                            <select asp-for="FormaJuridica" class="form-select">
                                <option value="">Seleccione forma jurídica</option>
                                <option value="SURL">S.U.R.L.</option>
                                <option value="MIPYME">MIPYME</option>
                                <option value="Estatal">Empresa Estatal</option>
                                <option value="CNA">Cooperativa No Agropecuaria</option>
                            </select>
                            <span asp-validation-for="FormaJuridica" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MonedaBase" class="form-label"></label>
                            <select asp-for="MonedaBase" class="form-select">
                                <option value="">Seleccione moneda</option>
                                <option value="CUP">CUP</option>
                                <option value="MLC">MLC</option>
                            </select>
                            <span asp-validation-for="MonedaBase" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="DireccionLegal" class="form-label"></label>
                            <input asp-for="DireccionLegal" class="form-control" placeholder="Dirección legal" />
                            <span asp-validation-for="DireccionLegal" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Municipio" class="form-label"></label>
                            <input asp-for="Municipio" class="form-control" placeholder="Municipio" />
                            <span asp-validation-for="Municipio" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Provincia" class="form-label"></label>
                            <input asp-for="Provincia" class="form-control" placeholder="Provincia" />
                            <span asp-validation-for="Provincia" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label"></label>
                            <input asp-for="Telefono" class="form-control" placeholder="Teléfono" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" placeholder="Correo electrónico" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaConstitucion" class="form-label"></label>
                            <input asp-for="FechaConstitucion" class="form-control" type="date" />
                            <span asp-validation-for="FechaConstitucion" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LicenciaActividad" class="form-label"></label>
                            <input asp-for="LicenciaActividad" class="form-control" placeholder="Licencia de actividad" />
                            <span asp-validation-for="LicenciaActividad" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CreadoEn" class="form-label"></label>
                            <input asp-for="CreadoEn" class="form-control" type="datetime-local" />
                            <span asp-validation-for="CreadoEn" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ActualizadoEn" class="form-label"></label>
                            <input asp-for="ActualizadoEn" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ActualizadoEn" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" asp-for="Activo" />
                                <label class="form-check-label" asp-for="Activo">
                                    @Html.DisplayNameFor(model => model.Activo)
                                </label>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}