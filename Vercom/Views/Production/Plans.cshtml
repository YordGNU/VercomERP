@model IEnumerable<VERCOM.Models.PlanProduccion>
@{
    ViewBag.Title = "Planificación de Producción";
    var meses = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
    var activePlans = Model.Count();
    var draftPlans = Model.Count(p => p.Estado == "BORRADOR");
}

@{ var headerActions = "<button type='button' class='btn btn-sm btn-primary me-2' data-bs-toggle='modal' data-bs-target='#suggestPlanModal'><i class='ti ti-wand me-1'></i> GENERAR SUGERENCIA</button><a asp-controller='PlanProduccion' asp-action='Create' class='btn btn-sm btn-outline-primary'><i class='ti ti-plus me-1'></i> NUEVO PLAN</a>"; var pageHeader = new VERCOM.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Planes de Producción (B2M)", Subtitle = "Gestión de metas de fabricación y proyección de necesidades de stock (RF-44).", Icon = "ti-file", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small text-uppercase">Total de planes</div>
                    <h3 class="fw-bold mb-0">@activePlans</h3>
                </div>
                <div class="avatar avatar-md bg-primary-subtle text-primary rounded-circle"><i class="ti ti-calendar-event"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small text-uppercase">Borradores</div>
                    <h3 class="fw-bold mb-0">@draftPlans</h3>
                </div>
                <div class="avatar avatar-md bg-warning-subtle text-warning rounded-circle"><i class="ti ti-pencil"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small text-uppercase">Cobertura</div>
                    <h3 class="fw-bold mb-0">@((activePlans > 0 ? Math.Min(100, activePlans * 25) : 0))%</h3>
                </div>
                <div class="avatar avatar-md bg-success-subtle text-success rounded-circle"><i class="ti ti-target"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="card shadow-sm border-0">
         <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold"><i class="ti ti-calendar-event me-2 text-primary"></i>Historial de Planes</h5>
        </div>
        <div class="card-body">
            <table id="plansTable" class="table table-vcenter card-table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs bg-light-subtle">
                    <tr>
                        <th class="ps-4">Periodo</th>
                        <th>Estado</th>
                        <th class="text-center">Artículos</th>
                        <th>Presupuesto</th>
                        <th>Creado</th>
                        <th class="pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderByDescending(p => p.Anio).ThenByDescending(p => p.Mes))
                    {
                        var statusClass = item.Estado == "BORRADOR" ? "bg-warning-subtle text-warning" : item.Estado == "APROBADO" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary";
                        <tr>
                            <td class="fw-bold">@meses[item.Mes ?? 1] @item.Anio</td>
                            <td><span class="badge @statusClass px-3">@item.Estado</span></td>
                            <td class="text-center">@item.PlanProduccionDetalles.Count</td>
                            <td class="small">@(item.Presupuesto?.Nombre ?? "N/A")</td>
                            <td class="text-muted">@item.CreadoEn.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="btn-list justify-content-end">
                                    <a asp-controller="PlanProduccion" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-outline-primary rounded-circle" title="Ver detalle"><i class="ti ti-eye"></i></a>
                                    <a asp-controller="PlanProduccion" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-outline-secondary rounded-circle" title="Editar"><i class="ti ti-edit"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Generar Plan Sugerido -->
<div class="modal fade" id="suggestPlanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white p-4">
                <h5 class="modal-title fw-bold"><i class="ti ti-wand me-2"></i>Generador de Plan Inteligente</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="GenerateSuggestedPlan" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="text-muted small mb-4">
                        El sistema analizará el inventario actual y calculará las cantidades necesarias para completar el
                        <strong>Stock Máximo</strong> de todos los productos terminados y elaborados.
                    </p>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Año Fiscal</label>
                            <input type="number" name="year" class="form-control" value="@DateTime.Now.Year" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Mes del Plan</label>
                            <select name="month" class="form-select" required>
                                @for(int i=1; i<=12; i++) {
                                    <!option value="@i" @(i == DateTime.Now.Month ? "selected" : "")>@meses[i]</!option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">CANCELAR</button>
                    <button type="submit" class="btn btn-primary px-4 shadow">
                        <i class="ti ti-rocket me-1"></i> GENERAR SUGERENCIA
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#plansTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'desc']],
                dom: 'rtip'
            });
        });
    </script>
}
