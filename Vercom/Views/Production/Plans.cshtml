@model IEnumerable<Vercom.Models.PlanProduccion>
@{
    ViewBag.Title = "Planificación de Producción";
    var meses = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Planes de Producción (B2M)</h4>
        <p class="text-muted small mb-0">Gestión de metas de fabricación y proyección de necesidades de stock (RF-44).</p>
    </div>
    <div class="text-end">
        <button type="button" class="btn btn-sm btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#suggestPlanModal">
            <i class="ti ti-wand me-1"></i> SUGERIR PLAN INTELIGENTE
        </button>
    </div>
</div>

<div class="row">
    <div class="card shadow-sm border-0">
         <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold"><i class="ti ti-calendar-event me-2 text-primary"></i>Historial de Planes</h5>
        </div>
        <div class="card-body">
            <table id="plansTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th>Periodo</th>
                        <th>Estado</th>
                        <th class="text-center">Artículos</th>
                        <th>Presupuesto</th>
                        <th>Creado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.Estado == "BORRADOR" ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success";
                        <tr>
                            <td class="fw-bold">@meses[item.Mes ?? 1] @item.Anio</td>
                            <td><span class="badge @statusClass">@item.Estado</span></td>
                            <td>@item.PlanProduccionDetalles.Count</td>
                            <td class="small">@(item.Presupuesto?.Nombre ?? "N/A")</td>
                            <td class="text-muted">@item.CreadoEn.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="btn-list justify-content-center">
                                    <a asp-action="PlanDetails" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle"><i class="ti ti-eye"></i></a>
                                    <a asp-action="EditPlan" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle"><i class="ti ti-edit"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Generar Plan Sugerido -->
<div class="modal fade" id="suggestPlanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white p-4">
                <h5 class="modal-title fw-bold"><i class="ti ti-wand me-2"></i>Generador de Plan Inteligente</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="GenerateSuggestedPlan" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="text-muted small mb-4">
                        El sistema analizará el inventario actual y calculará las cantidades necesarias para completar el
                        <strong>Stock Máximo</strong> de todos los productos terminados y elaborados.
                    </p>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Año Fiscal</label>
                            <input type="number" name="year" class="form-control" value="@DateTime.Now.Year" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Mes del Plan</label>
                            <select name="month" class="form-select" required>
                                @for(int i=1; i<=12; i++) {
                                    <!option value="@i" @(i == DateTime.Now.Month ? "selected" : "")>@meses[i]</!option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">CANCELAR</button>
                    <button type="submit" class="btn btn-primary px-4 shadow">
                        <i class="ti ti-rocket me-1"></i> GENERAR SUGERENCIA
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#plansTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'desc']],
                dom: 'rtip'
            });
        });
    </script>
}
