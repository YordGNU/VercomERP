@model IEnumerable<VERCOM.Models.AnalisisDesviacion>
@{
    ViewBag.Title = "Análisis de Eficiencia";
}

@{ var pageHeader = new VERCOM.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Desviaciones de Producción", Subtitle = "Análisis de eficiencia: costo estándar vs real.", Icon = "ti-chart-area-line"}; }
<partial name='_PageHeader' model='pageHeader' />

@if (!Model.Any())
{
    var emptyState = new VERCOM.ViewModels.EmptyStateModel { Icon = "ti-chart-area-line", Title = "Sin desviaciones registradas", Description = "Las desviaciones se generan al finalizar órdenes de producción.", ActionHtml = new Microsoft.AspNetCore.Html.HtmlString("<a href='" + Url.Action("Index", "Production") + "' class='btn btn-primary mt-2'>VER ÓRDENES</a>") };
    <partial name="_EmptyState" model="emptyState" />
}
else
{



<div class="row mt-4">
    <div class="row">
        <!-- Resumen Estadístico -->
        <div class="col-md-3">
            <div class="card bg-danger-subtle border-0">
                <div class="card-body text-center">
                    <h5 class="text-danger small fw-bold">Ineficiencia Total</h5>
                    <h2 class="fw-bold">@Model.Where(d => d.Desviacion > 0).Sum(d => d.Desviacion)?.ToString("C")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success-subtle border-0">
                <div class="card-body text-center">
                    <h5 class="text-success small fw-bold">Ahorro Total</h5>
                    <h2 class="fw-bold">@Math.Abs(Model.Where(d => d.Desviacion < 0).Sum(d => d.Desviacion) ?? 0).ToString("C")</h2>
                </div>
            </div>
        </div>
    </div>

        <div class="card shadow-sm border-0 mt-4">
            <div class="card-header bg-light-subtle">
                <h5 class="m-0 fw-bold"><i class="ti ti-chart-area-line me-2 text-primary"></i>Anǭlisis de Eficiencia</h5>
            </div>
            <div class="card-body">
                <table class="table table-vcenter card-table table-hover align-middle">
                <thead class="thead-sm text-uppercase fs-xxs bg-light-subtle">
                        <tr>
                            <th class="ps-4">Fecha</th>
                            <th>Orden / Producto</th>
                            <th>Costo Estǭndar</th>
                            <th>Costo Real</th>
                            <th>Desviación ($)</th>
                          <th class="pe-4">Estado</th>
                        </tr>
                    </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var impactColor = item.Desviacion > 0 ? "text-danger" : "text-success";
                        var impactIcon = item.Desviacion > 0 ? "ti-trending-up" : "ti-trending-down";

                        <tr>
                            <td class="small">@item.AnalizadoEn.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="fw-bold">@item.OrdenProduccion.NumeroOrden</div>
                                <small class="text-muted">@item.OrdenProduccion.ProductoTerminado.Nombre</small>
                            </td>
                            <td>@item.CostoEstandar.ToString("C")</td>
                            <td>@item.CostoReal.ToString("C")</td>
                           <td class="fw-bold @impactColor">
                                <i class="ti @impactIcon me-1"></i>
                                @item.Desviacion?.ToString("N2")
                            </td>
                            <td >
                                <span class="badge @(item.Desviacion > 0 ? "bg-danger" : "bg-success")">
                                    @(item.Desviacion > 0 ? "EXCESO" : "EFICIENTE")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
}
