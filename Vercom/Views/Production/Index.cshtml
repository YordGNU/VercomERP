@model IEnumerable<Vercom.Models.OrdenProduccion>
@{
    ViewBag.Title = "Monitor de Producción";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Órdenes de Producción</h4>
    </div>
    <div class="text-end">
        <a asp-action="CreateOrder" class="btn btn-primary">
            <i class="ti ti-settings me-1"></i> Nueva Orden (OP)
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        @foreach (var item in Model)
        {
            var progress = item.CantidadPlanificada > 0 ? (item.CantidadProducida / item.CantidadPlanificada) * 100 : 0;
            var statusColor = item.Estado == "FINALIZADA" ? "success" : (item.Estado == "EN_PROCESO" ? "info" : "warning");

            <div class="col-md-6 col-xl-4">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <h5 class="card-title text-muted small">@item.NumeroOrden</h5>
                            <span class="badge bg-@statusColor-subtle text-@statusColor">@item.Estado</span>
                        </div>
                        <h4 class="mb-1">@item.ProductoTerminadoId</h4> <!-- Aquí debería ir el nombre del producto joineado -->
                        <p class="text-muted small">Planificado: @item.CantidadPlanificada.ToString("N0") unidades</p>

                        <div class="mt-3">
                            <div class="d-flex justify-content-between mb-1 small text-muted">
                                <span>Progreso</span>
                                <span>@progress.ToString("N0")%</span>
                            </div>
                            <div class="progress progress-sm">
                                <div class="progress-bar bg-@statusColor" role="progressbar" style="width: @progress%" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <div class="mt-4 pt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="small text-muted"><i class="ti ti-calendar-event me-1"></i> @item.FechaInicioPlan?.ToString("dd MMM")</span>
                            <div>
                                @if (item.Estado == "PLANIFICADA")
                                {
                                    <form asp-action="Start" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary">Iniciar</button>
                                    </form>
                                }
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light">Ver Ficha</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
