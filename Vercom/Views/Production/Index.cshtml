@model IEnumerable<Vercom.Models.OrdenProduccion>
@{
    ViewBag.Title = "Monitor de Planta";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Monitor de Planta: Órdenes de Producción</h4>
        <p class="text-muted small mb-0">Seguimiento en tiempo real del flujo de fabricación y cumplimiento de metas.</p>
    </div>
    <div class="text-end d-flex gap-2 flex-column align-items-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Producción</a></li>
            <li class="breadcrumb-item active">Monitor</li>
        </ol>
        <div class="btn-list">
            <a asp-action="Plans" class="btn btn-sm btn-outline-primary">
                <i class="ti ti-calendar-event me-1"></i> PLANES DE PRODUCCIÓN
            </a>
            <a asp-action="CreateOrder" class="btn btn-sm btn-primary shadow-sm">
                <i class="ti ti-settings-plus me-1"></i> NUEVA ORDEN DE TRABAJO
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="row row-cards">
        @foreach (var item in Model.OrderByDescending(o => o.CreadoEn))
        {
            var statusColor = item.Estado switch {
                "TERMINADA" => "success",
                "EN_PROCESO" => "info",
                "CANCELADA" => "danger",
                _ => "warning"
            };

            <div class="col-md-6 col-xl-4">
                <div class="card card-sm shadow-sm border-0 h-100 transition-all hover-shadow">
                    <div class="card-status-top bg-@statusColor"></div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="text-muted tiny fw-bold text-uppercase mb-1">Orden #@item.NumeroOrden</h5>
                                <h4 class="fw-bold mb-0">@item.ProductoTerminado.Nombre</h4>
                            </div>
                            <span class="badge badge-soft-@statusColor px-3 py-1">@item.Estado</span>
                        </div>

                        <div class="bg-light-subtle rounded-3 p-3 mb-4 border border-dashed">
                            <div class="row g-2">
                                <div class="col-6">
                                    <span class="text-muted tiny fw-bold d-block">META PLAN:</span>
                                    <span class="fw-bold text-primary">@item.CantidadPlanificada.ToString("N0") <small>UN</small></span>
                                </div>
                                <div class="col-6 border-start ps-3">
                                    <span class="text-muted tiny fw-bold d-block">PRODUCIDO:</span>
                                    <span class="fw-bold text-success">@item.CantidadProducida.ToString("N0") <small>UN</small></span>
                                </div>
                            </div>
                            @if(item.Estado == "EN_PROCESO") {
                                <div class="progress progress-xs mt-3">
                                    @{ var progress = (item.CantidadPlanificada > 0) ? (item.CantidadProducida / item.CantidadPlanificada * 100) : 0; }
                                    <div class="progress-bar bg-info" style="width: @progress%"></div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="small text-muted">
                                <i class="ti ti-calendar-event me-1"></i> @(item.FechaInicioPlan?.ToString("dd MMM") ?? "-")
                            </div>
                            <div class="small text-muted">
                                <i class="ti ti-building-warehouse me-1"></i> @item.AlmacenInsumos.Nombre
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <div class="row g-2">
                                <div class="col-6">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary w-100">
                                        <i class="ti ti-eye me-1"></i> VER HOJA
                                    </a>
                                </div>
                                <div class="col-6">
                                    @if (item.Estado == "PLANIFICADA")
                                    {
                                        <form asp-action="Start" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-primary w-100">
                                                <i class="ti ti-player-play me-1"></i> INICIAR
                                            </button>
                                        </form>
                                    }
                                    @if (item.Estado == "EN_PROCESO")
                                    {
                                        <a asp-action="Finish" asp-route-id="@item.Id" class="btn btn-sm btn-success w-100">
                                            <i class="ti ti-check me-1"></i> REPORTAR
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any()) {
            <div class="col-12 text-center py-5">
                <div class="avatar avatar-xl bg-light-subtle text-muted rounded-circle mb-3 mx-auto">
                    <i class="ti ti-assembly fs-48"></i>
                </div>
                <h3 class="fw-bold">Sin actividad de planta</h3>
                <p class="text-muted">No existen órdenes de producción activas en este periodo.</p>
                <a asp-action="CreateOrder" class="btn btn-primary mt-2">PLANIFICAR TRABAJO</a>
            </div>
        }
    </div>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .hover-shadow:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }
</style>
