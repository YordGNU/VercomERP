@model IEnumerable<Vercom.Models.OrdenProduccion>
@{
    ViewBag.Title = "Monitor de Planta";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Órdenes de Producción (OP)</h4>
    </div>
    <div class="text-end">
        <a asp-action="CreateOrder" class="btn btn-primary">
            <i class="ti ti-settings me-1"></i> Nueva Orden de Trabajo
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="row">
        @foreach (var item in Model)
        {
            var statusColor = item.Estado switch {
                "FINALIZADA" => "success",
                "EN_PROCESO" => "info",
                "CANCELADA" => "danger",
                _ => "warning"
            };

            <div class="col-md-6 col-xl-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <h5 class="card-title text-muted small">@item.NumeroOrden</h5>
                            <span class="badge bg-@statusColor-subtle text-@statusColor">@item.Estado</span>
                        </div>
                        <h4 class="mb-1">@item.ProductoTerminado.Nombre</h4>
                        <p class="text-muted small">Meta: @item.CantidadPlanificada.ToString("N0") unidades</p>

                        <div class="mt-4 pt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="small text-muted"><i class="ti ti-calendar-event me-1"></i> @item.FechaInicioPlan?.ToString("dd MMM")</span>
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light">Ver Hoja</a>
                                @if (item.Estado == "PLANIFICADA")
                                {
                                    <form asp-action="Start" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary">Iniciar</button>
                                    </form>
                                }
                                @if (item.Estado == "EN_PROCESO")
                                {
                                    <a asp-action="Finish" asp-route-id="@item.Id" class="btn btn-sm btn-success">Finalizar</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any()) {
            <div class="col-12 text-center py-5 text-muted">No existen órdenes de producción activas.</div>
        }
    </div>
</div>


@section Scripts {
    <script>
        .ready(function () {
            #dataTable.DataTable();
        });
    </script>
}


