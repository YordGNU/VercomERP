@model Vercom.Models.OrdenProduccion
@{
    ViewBag.Title = "Reporte de Cierre de Trabajo";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold text-success">Reporte de Cierre: @Model.NumeroOrden</h4>
        <p class="text-muted small mb-0">Captación de resultados reales y liquidación contable del lote de producción.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Producción</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Monitor</a></li>
            <li class="breadcrumb-item active">Cierre</li>
        </ol>
    </div>
</div>

<div class="row">
    <form asp-action="Finish" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="row">
            <!-- Resumen de Meta vs Real -->
            <div class="col-lg-12 mb-4">
                <div class="card shadow-sm border-0 border-start border-success border-4 bg-success-subtle bg-opacity-10">
                    <div class="card-body p-4">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <h3 class="mb-1 fw-bold text-success">@Model.ProductoTerminado.Nombre</h3>
                                <p class="mb-0 text-muted">Planificado: <strong>@Model.CantidadPlanificada.ToString("N0")</strong> @Model.ProductoTerminado.UnidadMedida.Codigo</p>
                            </div>
                            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                                <label class="fw-bold d-block mb-2 text-uppercase tiny">Cantidad Final Realmente Producida:</label>
                                <div class="input-group input-group-lg float-md-end" style="max-width: 250px;">
                                    <input type="number" name="actualQuantity" class="form-control text-center fw-bold text-success" value="@Model.CantidadPlanificada.ToString("F2")" step="0.01" required />
                                    <span class="input-group-text bg-success text-white fw-bold">@Model.ProductoTerminado.UnidadMedida.Codigo</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Captación de Consumos Reales -->
            <div class="col-lg-12">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light-subtle py-3">
                        <h5 class="m-0 fw-bold"><i class="ti ti-test-pipe me-2 text-primary"></i>Conciliación de Consumo de Insumos</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover dt-responsive">
                            <thead class="thead-sm text-uppercase fs-xxs">
                                    <tr>
                                        <th class="ps-4">Material / Insumo</th>
                                        <th>Planificado</th>
                                        <th class="text-center" width="220">Consumo Real (Ajuste)</th>
                                        <th width="100">U.M.</th>
                                        <th class="pe-4">Diferencia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int i = 0; }
                                    @foreach (var c in Model.OrdenProduccionConsumos)
                                    {
                                        <tr>
                                          <td>
                                                <input type="hidden" name="actualConsumptions[@i].ProductoInsumoId" value="@c.ProductoInsumoId" />
                                                <div class="fw-bold fs-13">@c.ProductoInsumo.Nombre</div>
                                                <small class="text-muted tiny">COD: @c.ProductoInsumo.Codigo</small>
                                            </td>
                                           <td class="fw-semibold">@c.CantidadPlanificada.ToString("N4")</td>
                                            <td>
                                                <input type="number" name="actualConsumptions[@i].CantidadReal"
                                                       class="form-control form-control-sm text-end fw-bold input-actual"
                                                       value="@c.CantidadPlanificada.ToString("F4")"
                                                       data-plan="@c.CantidadPlanificada"
                                                       step="0.0001" required />
                                            </td>
                                            <td class="small text-muted">@c.ProductoInsumo.UnidadMedida?.Codigo</td>
                                            <td class="pe-4 text-end">
                                                <span class="label-diff badge bg-light text-dark">0.0000</span>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-light-subtle d-flex justify-content-between align-items-center p-4">
                        <div class="d-flex align-items-center text-muted small">
                            <i class="ti ti-info-circle fs-20 me-2 text-info"></i>
                            <div>
                                <p class="mb-0">El sistema calculará las variaciones de costo basadas en estas diferencias.</p>
                                <p class="mb-0">Se generará un Comprobante de Diario por la liquidación de la orden.</p>
                            </div>
                        </div>
                        <div class="btn-list">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-success px-5 py-2 shadow-lg">
                                <i class="ti ti-circle-check me-1"></i> FINALIZAR Y LIQUIDAR ORDEN
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function updateDiffs() {
            document.querySelectorAll('.input-actual').forEach(input => {
                const actual = parseFloat(input.value || 0);
                const plan = parseFloat(input.getAttribute('data-plan') || 0);
                const diff = actual - plan;
                const badge = input.closest('tr').querySelector('.label-diff');

                badge.innerText = (diff > 0 ? "+" : "") + diff.toFixed(4);
                badge.className = "label-diff badge " + (diff === 0 ? "bg-light text-dark" : (diff > 0 ? "bg-danger" : "bg-success"));
            });
        }

        document.querySelectorAll('.input-actual').forEach(i => i.addEventListener('input', updateDiffs));
        document.addEventListener('DOMContentLoaded', updateDiffs);
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-13 { font-size: 0.8125rem; }
</style>
