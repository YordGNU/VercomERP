@model IEnumerable<Vercom.Models.TipoComprobante>
@{
    ViewBag.Title = "Tipos de Comprobante";
}

<div class="page-title-head d-flex align-items-center mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Nomenclador de Comprobantes Contables</h4>
        <p class="text-muted small mb-0">Definición de series para la clasificación de asientos (Ingresos, Egresos, Ajustes).</p>
    </div>
</div>

<div class="container-xxl">
    <div class="card">
        <div class="card-header">
            <h5 class="m-0 fw-bold"><i class="ti ti-bookmarks me-2 text-primary"></i>Tipos Registrados</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="voucherTable"  class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th width="150">Código</th>
                            <th>Descripción del Tipo de Comprobante</th>
                            <th width="100" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#voucherTable').DataTable({
                         language: { url: '/js/i18n/es-ES.json' }
            });
        });
    </script>
}
