@model IEnumerable<Vercom.Models.RegistroSalarioTiempoServicio>
@{
    ViewBag.Title = "Modelo SC-4-08";
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Recursos Humanos", Title = "Registro de Salarios y Tiempo de Servicio (SC-4-08)", Subtitle = "", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row mt-4">
    <div class="card">
        <div class="card-body">
            <div class="alert alert-info py-2 small mb-4">
                <i class="ti ti-info-circle me-1"></i> Este registro constituye la base probatoria para la jubilación y seguridad social según la normativa del MTSS.
            </div>
            <table id="dataTable" class="table table-striped table-hover dt-responsive">
                <thead class="table-light small">
                    <tr>
                        <th rowspan="2">Empleado</th>
                        <th rowspan="2">Año</th>
                        <th colspan="12">Meses (Salario Devengado / Días Trabajados)</th>
                    </tr>
                    <tr>
                        @for (int i = 1; i <= 12; i++)
                        {
                            <th>@i</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in Model.GroupBy(m => m.EmpleadoId))
                    {
                        var emp = group.First().Empleado;
                        <tr>
                            <td class="text-start fw-bold">@emp.Nombres @emp.Apellidos</td>
                            <td>@group.First().Anio</td>
                            @for (int m = 1; m <= 12; m++)
                            {
                                var data = group.FirstOrDefault(x => x.Mes == m);
                                <td class="small">
                                    @if (data != null)
                                    {
                                        <div class="fw-bold">@data.SalarioDevengado.ToString("N0")</div>
                                        <div class="text-muted">(@data.DiasTrabajados.ToString("N0"))</div>
                                    }
                                    else
                                    {

                                        <span>-</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
     $(document).ready(function () {
            #dataTable.DataTable();
        });
    </script>
}
