@model IEnumerable<Vercom.Models.DeclaracionJuradum>
@{
    ViewBag.Title = "Obligaciones Fiscales ONAT";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Declaraciones Juradas (DJ)</h4>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="ti ti-file-analytics me-1"></i> Generar Nueva DJ
        </a>
    </div>
</div>

<div class="container-xxl mt-4">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>F. Presentación</th>
                            <th>Obligación</th>
                            <th>Periodo</th>
                            <th class="text-end">Base Imponible</th>
                            <th class="text-end">Impuesto Calc.</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@(item.FechaPresentacion?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="fw-bold text-primary">@item.TipoObligacion.Codigo</td>
                                <td>@item.Periodo.Mes / @item.Periodo.Anio</td>
                                <td class="text-end">@item.BaseImponible.ToString("N2")</td>
                                <td class="text-end fw-bold">@item.MontoCalculado.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @(item.Estado == "PAGADA" ? "bg-success" : "bg-warning")">@item.Estado</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-xs btn-light"><i class="ti ti-eye"></i></a>
                                        @if(item.AsientoId.HasValue) {
                                            <a asp-controller="AsientoContable" asp-action="Details" asp-route-id="@item.AsientoId" class="btn btn-xs btn-light text-info" title="Ver Asiento"><i class="ti ti-calculator"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any()) {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted small">No se han generado declaraciones todavía.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
