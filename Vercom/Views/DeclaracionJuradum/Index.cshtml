@model IEnumerable<Vercom.Models.DeclaracionJuradum>
@{
    ViewBag.Title = "Obligaciones Fiscales ONAT";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Cumplimiento Fiscal: Declaraciones Juradas</h4>
        <p class="text-muted small mb-0">Control de obligaciones ante la ONAT y el Ministerio de Finanzas y Precios (DJ-08/02).</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Finanzas</a></li>
            <li class="breadcrumb-item active">Fiscalidad</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-file-analytics me-1"></i> GENERAR NUEVA DJ
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold"><i class="ti ti-book me-2 text-primary"></i>Libro de Registro de Obligaciones</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="djTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th class="ps-4">F. Presentación</th>
                            <th>Impuesto / Obligación</th>
                          <th>Periodo Fiscal</th>
                            <th>Base Imponible</th>
                            <th>Impuesto Calc.</th>
                          <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model.OrderByDescending(x => x.Periodo.Anio).ThenByDescending(x => x.Periodo.Mes))
                            {
                                <tr>
                                    <td class="ps-4 small text-muted">@(item.FechaPresentacion?.ToString("dd/MM/yyyy") ?? "Pendiente")</td>
                                    <td>
                                        <div class="fw-bold text-primary">@item.TipoObligacion.Codigo</div>
                                        <small class="text-muted tiny">@item.TipoObligacion.Nombre</small>
                                    </td>
                                    <td class="fw-semibold">@item.Periodo.Mes.ToString("D2") / @item.Periodo.Anio</td>
                                    <td>@item.BaseImponible.ToString("N2")</td>
                                    <td class="text-end fw-bold text-danger">@item.MontoCalculado.ToString("N2")</td>
                                    <td >
                                        @{
                                            var statusClass = item.Estado == "PAGADA" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning";
                                        }
                                        <span class="badge @statusClass px-3">@item.Estado</span>
                                    </td>
                                    <td>
                                        <div class="btn-list justify-content-end">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            @if (item.AsientoId.HasValue)
                                            {
                                                <a asp-controller="AsientoContable" asp-action="Details" asp-route-id="@item.AsientoId" class="btn btn-sm btn-icon btn-light rounded-circle text-info" title="Ver Comprobante">
                                                    <i class="ti ti-calculator"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="alert alert-info border-0 shadow-sm rounded-3 mt-4">
        <div class="d-flex align-items-center">
            <i class="ti ti-info-square-filled fs-32 me-3 opacity-50"></i>
            <div>
                <h6 class="fw-bold mb-1">Nota sobre Integridad Fiscal</h6>
                <p class="mb-0 small">Todas las declaraciones juradas generadas desde este módulo se vinculan automáticamente con el Libro Diario para garantizar la trazabilidad ante auditorías de la ONAT.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#djTable').DataTable({
                language: { url: '/js/i18n/es-ES.json' },
                order: [[2, 'desc']]
            });
        });
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
