# ============================================================
# VercomERP – Plantilla de variables de entorno
# Copiar a .env y rellenar con valores reales.
# NUNCA subir .env al repo (ya está en .gitignore).
# ============================================================

# ------------------------------------------------------------
# BASE DE DATOS
# ------------------------------------------------------------
# Contraseña del usuario 'sa' de SQL Server (política: 8+ chars, mayús, minús, dígito, símbolo)
MSSQL_SA_PASSWORD=Vercom#2026!StrongPass

# Edición de SQL Server: Developer (dev/test) | Standard | Enterprise (prod)
MSSQL_PID=Developer

# ------------------------------------------------------------
# APLICACIÓN
# ------------------------------------------------------------
APP_VERSION=2.0.0
ASPNETCORE_ENVIRONMENT=Production

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
# El secreto se carga desde ./secrets/jwt_key.txt (Docker Secrets)
# Estos valores NO son secretos, son identificadores:
JWT_ISSUER=VercomERP
JWT_AUDIENCE=VercomERPClientes