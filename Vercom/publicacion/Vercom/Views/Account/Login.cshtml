@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutAuth";
}

<div class="auth-page">
    <section class="auth-hero" aria-label="Presentación del sistema">
        <div class="auth-hero-content">
            <div class="auth-brand">
                <img src="~/css/images/logo.svg" alt="Logo Vercom" class="auth-logo" />
                <h1 class="auth-title">Tierra Prometida</h1>
                <p class="auth-tagline">Gestión empresarial, contable y operativa.</p>
            </div>
        </div>

        <div class="auth-hero-footer">
            <p>Acceso exclusivo para personal autorizado</p>
        </div>
    </section>

    <section class="auth-panel" aria-label="Formulario de acceso">
        <div class="auth-form-wrap">
            <form asp-action="Login" method="post" class="auth-form">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="auth-form-header">
                    <h2>Inicia sesión</h2>
                    <p>Accede a tu espacio de trabajo.</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert" aria-live="assertive" tabindex="-1"></div>
                }

                <div class="auth-field">
                    <label for="username" class="auth-label">Usuario</label>
                    <div class="auth-input">
                        <i class="ti ti-user auth-input-icon" aria-hidden="true"></i>
                        <input 
                            type="text" 
                            id="username" 
                            name="username" 
                            placeholder="nombre.usuario"
                            autocomplete="username"
                            required 
                            autofocus
                            aria-describedby="username-hint" />
                    </div>
                            <small id="username-hint" class="auth-hint">Usa el nombre de usuario asignado a tu cuenta.</small>
                </div>

                <div class="auth-field">
                    <div class="auth-label-row">
                        <label for="password" class="auth-label">Contraseña</label>
                    </div>
                    <div class="auth-input">
                        <i class="ti ti-lock auth-input-icon" aria-hidden="true"></i>
                        <input 
                            type="password" 
                            id="password" 
                            name="password" 
                            class="auth-password-input"
                            placeholder="••••••••"
                            autocomplete="current-password"
                            required
                            aria-describedby="password-hint" />
                        <button 
                            class="auth-eye" 
                            type="button" 
                            id="togglePassword"
                            aria-label="Mostrar contraseña"
                            aria-pressed="false">
                            <i class="ti ti-eye icon-eye" aria-hidden="true"></i>
                            <i class="ti ti-eye-off icon-eye-off" aria-hidden="true" style="display: none;"></i>
                        </button>
                    </div>
                    <small id="password-hint" class="auth-hint">La contraseña distingue mayúsculas y minúsculas.</small>
                </div>

                <label class="auth-remember">
                    <input 
                        type="checkbox" 
                        id="rememberMe" 
                        name="rememberMe" 
                        value="true" />
                    Recordarme en este equipo
                </label>

                <button type="submit" class="auth-submit">
                    <span class="btn-text">Entrar</span>
                    <span class="btn-loading" style="display: none;">
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        Autenticando...
                    </span>
                </button>

                <div class="auth-foot">
                    <p>¿Problemas para entrar? <a href="mailto:yordanisvc@gmail.com">Contacta con soporte</a></p>
                    <small>&copy; 2026 Tierra Prometida</small>
                </div>
            </form>
        </div>
    </section>
</div>

@section Styles {
    <link href="~/css/login.style.css" rel="stylesheet" type="text/css">
}

@section Scripts {
    <script>
        const authAlert = document.querySelector('.auth-alert');
        if (authAlert) authAlert.focus();

        const togglePasswordBtn = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');

        if (togglePasswordBtn && passwordInput) {
            const eyeIcon = togglePasswordBtn.querySelector('.icon-eye');
            const eyeOffIcon = togglePasswordBtn.querySelector('.icon-eye-off');

            togglePasswordBtn.addEventListener('click', function (e) {
                e.preventDefault();
                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';
                eyeIcon.style.display = isPassword ? 'none' : 'block';
                eyeOffIcon.style.display = isPassword ? 'block' : 'none';
                this.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
                this.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
            });
        }

        const loginForm = document.querySelector('.auth-form');
        if (loginForm) {
            loginForm.addEventListener('submit', function (e) {
                const submitBtn = loginForm.querySelector('button[type="submit"]');
                const btnText = submitBtn.querySelector('.btn-text');
                const btnLoading = submitBtn.querySelector('.btn-loading');

                if (btnText && btnLoading) {
                    submitBtn.disabled = true;
                    btnText.style.display = 'none';
                    btnLoading.style.display = 'block';
                }
            });
        }
    </script>
}