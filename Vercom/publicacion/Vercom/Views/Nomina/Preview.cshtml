@model Vercom.ViewModels.PayrollPreviewViewModel
@{
    ViewBag.Title = Model.Title;
    var meses = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold"><i class="ti ti-chart-dots me-2"></i>Simulador de Nómina: @meses[Model.Mes] @Model.Anio</h4>
        <p class="text-muted small mb-0">Vista previa volátil basada en asistencia y contratos actuales. No genera registros contables.</p>
    </div>
    <div class="text-end d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="ti ti-arrow-left"></i> VOLVER</a>
        <form asp-action="Calculate" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="anio" value="@Model.Anio" />
            <input type="hidden" name="mes" value="@Model.Mes" />
            <button type="submit" class="btn btn-sm btn-primary shadow">
                <i class="ti ti-device-floppy"></i> GENERAR NÓMINA OFICIAL
            </button>
        </form>
    </div>
</div>

<div class="row">
    <!-- Resumen de Simulación -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card card-sm border-0 shadow-sm bg-primary text-white">
                <div class="card-body">
                    <div class="small fw-bold text-uppercase opacity-75">Total Devengado</div>
                    <h2 class="fw-bold mb-0">@Model.TotalDevengado.ToString("C2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-sm border-0 shadow-sm bg-danger text-white">
                <div class="card-body">
                    <div class="small fw-bold text-uppercase opacity-75">Retenciones Est.</div>
                    <h2 class="fw-bold mb-0">@Model.TotalDeducciones.ToString("C2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-sm border-0 shadow-sm bg-success text-white">
                <div class="card-body">
                    <div class="small fw-bold text-uppercase opacity-75">Neto a Pagar</div>
                    <h2 class="fw-bold mb-0">@Model.TotalNeto.ToString("C2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-sm border-0 shadow-sm">
                <div class="card-body">
                    <div class="small fw-bold text-uppercase text-muted">Trabajadores</div>
                    <h2 class="fw-bold mb-0">@Model.TotalTrabajadores</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold"><i class="ti ti-users me-2 text-primary"></i>Desglose por Trabajador (Sucursal: @Model.SucursalNombre)</h5>
            <div class="badge bg-info-subtle text-info">SIMULACIÓN EN TIEMPO REAL</div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="previewTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Trabajador</th>
                            <th>Cargo</th>
                            <th class="text-center">Días</th>
                            <th class="text-center">H. Extra</th>
                            <th class="text-end">Devengado ($)</th>
                            <th class="text-end text-danger">Retenciones ($)</th>
                            <th class="text-end fw-bold pe-4">Neto ($)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@row.NombreCompleto</div>
                                    <small class="text-muted">@row.Sucursal</small>
                                </td>
                                <td class="small">@row.Cargo</td>
                                <td>@row.DiasTrabajados.ToString("N1")</td>
                                <td>@row.HorasExtra.ToString("N1")</td>
                                <td class="text-numeric text-end">@row.Devengado.ToString("N2")</td>
                                <td class="text-numeric text-end text-danger">
                                    <span title="SS: @row.RetencionSS.ToString("N2") | IRP: @row.RetencionIRP.ToString("N2")">
                                        @row.Deducciones.ToString("N2")
                                    </span>
                                </td>
                                <td class="text-numeric text-end fw-bold pe-4 text-primary">@row.Neto.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#previewTable').DataTable({
                pageLength: 50,
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                dom: 'rtip'
            });
        });
    </script>
}
