@model Vercom.ViewModels.AttendanceConsoleViewModel
@{
    ViewBag.Title = "Consola de Asistencia";
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Control de Jornada: " + Model.Date.ToString("dddd, dd MMMM yyyy"), Subtitle = "Captación de incidencias, horas extra y cumplimiento de jornada laboral (RF-21).", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />


<div class="row">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form asp-action="Console" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Fecha de Jornada</label>
                    <input type="date" name="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Unidad / Sucursal</label>
                    <select name="sucursalId" class="form-select select2" asp-items="ViewBag.SucursalId" onchange="this.form.submit()">
                        <option value="">-- Todas las Unidades --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold">Cargo</label>
                    <select name="cargoId" class="form-select select2" asp-items="ViewBag.CargoId" onchange="this.form.submit()">
                        <option value="">-- Todos --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Buscar por Nombre/CI</label>
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="Escriba aquí..." value="@ViewBag.CurrentSearch" />
                        <button type="submit" class="btn btn-primary"><i class="ti ti-search"></i></button>
                    </div>
                </div>
                <div class="col-md-1">
                    <a asp-action="Console" class="btn btn-light w-100" title="Limpiar"><i class="ti ti-refresh"></i></a>
                </div>
            </form>
        </div>
    </div>

    <form asp-action="SaveConsole" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
        <div class="card shadow-sm border-0">
            <div class="card-header justify-content-between bg-light-subtle">
                <h5 class="m-0 fw-bold"><i class="ti ti-users me-2 text-primary"></i>Listado de Plantilla Activa (@Model.Rows.Count)</h5>
               </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover dt-responsive">
                        <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th class="ps-4">Empleado</th>
                                <th class="text-center" width="160">Turno</th>
                                <th class="text-center" width="140">Hora Entrada</th>
                                <th class="text-center" width="140">Hora Salida</th>
                                <th class="text-center" width="120">Horas Extra</th>
                                <th>Incidencia / Ausencia (RF-21)</th>
                                <th class="pe-4">Observaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                var row = Model.Rows[i];
                                var ausente = row.Record.TipoAusenciaId.HasValue;
                                <tr class="@(row.EsIncapacidad ? "table-warning" : (row.RetardoMinutos > 0 || row.SalidaTempranaMinutos > 0 ? "table-danger bg-opacity-10" : ""))">
                                  <td>
                                        <input type="hidden" name="logs[@i].EmpleadoId" value="@row.EmpleadoId" />
                                        <input type="hidden" name="logs[@i].Fecha" value="@Model.Date.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="logs[@i].TurnoTrabajoId" value="@row.TurnoTrabajoId" />
                                        <div class="fw-bold fs-13">@row.NombreCompleto</div>
                                        <small class="text-muted tiny text-uppercase">@row.Cargo</small>
                                        @if (row.EsIncapacidad)
                                        {
                                            <span class="badge bg-warning text-dark ms-1" title="Certificado médico activo"><i class="ti ti-first-aid-kit"></i> INCAPACIDAD @(row.PorcentajeSubsidio?.ToString("0"))%</span>
                                        }
                                        else if (row.RetardoMinutos > 0)
                                        {
                                            <span class="badge bg-danger ms-1">RETARDO @row.RetardoMinutos min</span>
                                        }
                                        @if (!row.EsIncapacidad && row.SalidaTempranaMinutos > 0)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">SALIDA TEMPRANA @row.SalidaTempranaMinutos min</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(row.TurnoNombre))
                                        {
                                            <div class="fw-bold fs-13">@row.TurnoNombre</div>
                                            <small class="text-muted font-monospace">@row.TurnoHoraEntrada?.ToString("HH:mm") - @row.TurnoHoraSalida?.ToString("HH:mm")</small>
                                            @if (row.EsNocturno)
                                            {
                                                <span class="badge bg-dark ms-1" title="Turno nocturno"><i class="ti ti-moon"></i></span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Sin turno</span>
                                        }
                                    </td>
                                    <td>
                                        <input type="time" name="logs[@i].HoraEntrada" class="form-control form-control-sm text-center font-monospace" value="@row.Record.HoraEntrada?.ToString("HH:mm")" disabled="@(row.EsIncapacidad ? "disabled" : null)" />
                                    </td>
                                    <td>
                                        <input type="time" name="logs[@i].HoraSalida" class="form-control form-control-sm text-center font-monospace" value="@row.Record.HoraSalida?.ToString("HH:mm")" disabled="@(row.EsIncapacidad ? "disabled" : null)" />
                                    </td>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="number" step="0.5" name="logs[@i].HorasExtra" class="form-control text-center" value="@row.Record.HorasExtra" disabled="@(row.EsIncapacidad ? "disabled" : null)" />
                                            <span class="input-group-text bg-light">h</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (row.EsIncapacidad)
                                        {
                                            <input type="hidden" name="logs[@i].TipoAusenciaId" value="@row.Record.TipoAusenciaId" />
                                            <select class="form-select form-select-sm fw-bold text-warning-emphasis" disabled>
                                                @foreach (var ta in Model.TiposAusencia)
                                                {
                                                    <!option value="@ta.Id" @(row.Record.TipoAusenciaId == ta.Id ? "selected" : "")>@ta.Nombre</!option>
                                                }
                                            </select>
                                            <small class="text-muted tiny">Bloqueado por certificado médico vigente.</small>
                                        }
                                        else
                                        {
                                            <select name="logs[@i].TipoAusenciaId" class="form-select form-select-sm fw-bold @(ausente ? "text-danger" : "")">
                                                <option value="">-- Presente --</option>
                                                @foreach (var ta in Model.TiposAusencia)
                                                {
                                                    <!option value="@ta.Id" @(row.Record.TipoAusenciaId == ta.Id ? "selected" : "")>@ta.Nombre</!option>
                                                }
                                            </select>
                                        }
                                    </td>
                                    <td class="pe-4">
                                        <input name="logs[@i].Observaciones" class="form-control form-control-sm" value="@row.Record.Observaciones" placeholder="Justificación..." maxlength="200" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-light-subtle d-flex justify-content-between align-items-center p-4">
                <div class="text-muted small italic">
                    <i class="ti ti-info-circle me-1"></i> Los retardos y salidas tempranas se calculan según el turno asignado. Las filas con certificado médico vigente quedan bloqueadas como Incapacidad. Los cambios impactarán automáticamente el acumulado de vacaciones (9.09%).
                </div>
                <div class="btn-list">
                    <a asp-action="Index" class="btn btn-outline-secondary">CANCELAR</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i> GUARDAR ASISTENCIA DEL DÍA
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-13 { font-size: 0.8125rem; }
</style>
