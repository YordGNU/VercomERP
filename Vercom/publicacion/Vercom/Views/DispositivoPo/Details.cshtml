@model Vercom.Models.DispositivoPo
@{
    ViewBag.Title = "Ficha de Terminal POS";
    var isOnline = Model.UltimaSincronizacion.HasValue && Model.UltimaSincronizacion.Value > DateTimeOffset.Now.AddMinutes(-30);
    var statusColor = Model.Estado == "ACTIVO" ? (isOnline ? "success" : "warning") : "danger";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Hardware: @Model.Nombre</h4>
        <p class="text-muted small mb-0">Especificaciones técnicas y registro de actividad de la terminal móvil.</p>
    </div>
    <div class="text-end d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i> VOLVER
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
            <i class="ti ti-settings me-1"></i> CONFIGURAR
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4 overflow-hidden">
            <div class="card-status-top bg-@statusColor"></div>
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="avatar-xl bg-@statusColor-subtle text-@statusColor rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="ti ti-device-tablet fs-40"></i>
                    </div>
                    <h4 class="fw-bold mb-1">@Model.Nombre</h4>
                    <span class="badge badge-soft-@statusColor px-4 py-1">
                        @(isOnline ? "CONECTADO (ONLINE)" : "DESCONECTADO")
                    </span>
                </div>

                <div class="list-group list-group-flush border-top pt-3">
                    <div class="list-group-item bg-transparent d-flex justify-content-between px-0">
                        <span class="text-muted small fw-bold">CÓDIGO:</span>
                        <span class="fw-bold text-primary">@Model.Codigo</span>
                    </div>
                    <div class="list-group-item bg-transparent d-flex justify-content-between px-0">
                        <span class="text-muted small fw-bold">UUID:</span>
                        <span class="small font-monospace">@Model.IdentificadorHardware</span>
                    </div>
                    <div class="list-group-item bg-transparent d-flex justify-content-between px-0">
                        <span class="text-muted small fw-bold">VERSIÓN APP:</span>
                        <span class="badge bg-light text-dark">v@(Model.VersionAppPos ?? "1.0.0")</span>
                    </div>
                    <div class="list-group-item bg-transparent d-flex justify-content-between px-0">
                        <span class="text-muted small fw-bold">ÚLTIMA SINCRO:</span>
                        <span class="fw-bold">@(Model.UltimaSincronizacion?.ToString("dd/MM HH:mm") ?? "Nunca")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-light-subtle">
                <h5 class="m-0 fw-bold small">Entorno Operativo</h5>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <label class="text-muted extra-small fw-bold d-block mb-1">SUCURSAL:</label>
                    <div class="fw-bold d-flex align-items-center">
                        <i class="ti ti-building me-2 text-primary"></i> @Model.Sucursal.Nombre
                    </div>
                </div>
                <div>
                    <label class="text-muted extra-small fw-bold d-block mb-1">CAJA (ARCA):</label>
                    <div class="fw-bold d-flex align-items-center">
                        <i class="ti ti-cash me-2 text-success"></i> @Model.Caja.Nombre
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold text-primary"><i class="ti ti-history me-2"></i>Historial de Turnos / Sesiones</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-vcenter card-table table-hover mb-0">
                        <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th>Fecha Apertura</th>
                                <th>Cierre</th>
                                <th class="text-end">Ventas ($)</th>
                                <th>Estado</th>
                                <th width="50"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in ViewBag.Sesiones)
                            {
                                <tr>
                                    <td class="small fw-bold">@s.FechaApertura.ToString("dd MMM yyyy, HH:mm")</td>
                                    <td class="small">@(s.FechaCierre?.ToString("HH:mm") ?? "-")</td>
                                    <td class="text-end fw-bold">@s.TotalVentas.ToString("N2")</td>
                                    <td>
                                        <span class="badge @(s.Estado == "ABIERTA" ? "bg-success" : "bg-secondary")">@s.Estado</span>
                                    </td>
                                    <td>
                                        <a asp-controller="SesionCajaPo" asp-action="Details" asp-route-id="@s.Id" class="btn btn-icon btn-sm btn-ghost-primary">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .extra-small { font-size: 0.7rem; letter-spacing: 0.05em; }
    .card-status-top { height: 4px; border-radius: 0.375rem 0.375rem 0 0; }
</style>
