@model IEnumerable<Vercom.Models.SaldoVacacione>
@{
    ViewBag.Title = "Control de Vacaciones";
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> RRHH</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Recursos Humanos", Title = "Gestión de Descanso y Vacaciones (9.09%)", Subtitle = "Seguimiento de saldos acumulados y días disfrutados por el personal.", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />


<div class="row row-cards">
    @foreach (var item in Model)
    {
        var isCritical = item.SaldoActual > 30;
        var isHigh = item.SaldoActual > 22;
        var statusColor = isCritical ? "danger" : (isHigh ? "warning" : "success");
        <div class="col-md-6 col-lg-4" data-saldo-id="@item.Id">
            <div class="card card-sm shadow-sm border-0 h-100 transition-all hover-shadow">
                <div class="card-status-top bg-@statusColor"></div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h4 class="fw-bold mb-0 empleado-nombre">@item.Empleado.Nombres @item.Empleado.Apellidos</h4>
                            <small class="text-muted text-uppercase tiny fw-bold">Periodo Fiscal @item.Anio</small>
                        </div>
                        <div class="avatar bg-@statusColor-subtle text-@statusColor rounded-circle">
                            <i class="ti ti-beach fs-48"></i>
                        </div>
                    </div>

                    <div class="row text-center bg-light-subtle rounded-3 p-3 g-0 mb-4 border">
                        <div class="col-4 border-end">
                            <h3 class="mb-0 fw-bold dias-acumulados">@item.DiasAcumulados.ToString("N1")</h3>
                            <small class="text-muted tiny fw-bold text-uppercase">Ganados</small>
                        </div>
                        <div class="col-4 border-end">
                            <h3 class="mb-0 text-danger fw-bold dias-disfrutados">@item.DiasDisfrutados.ToString("N1")</h3>
                            <small class="text-muted tiny fw-bold text-uppercase">Gozados</small>
                        </div>
                        <div class="col-4">
                            <h3 class="mb-0 text-primary fw-bold saldo-actual">@(item.SaldoActual?.ToString("N1") ?? "0.0")</h3>
                            <small class="text-muted tiny fw-bold text-uppercase">Saldo</small>
                        </div>
                    </div>

                    @if (isCritical)
                    {
                        <div class="alert alert-danger py-2 px-3 small mb-3 border-0 alerta-critical">
                            <i class="ti ti-alert-circle me-1"></i> <strong>ALERTA:</strong> Acumulado excede el límite legal de 30 días.
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-sm btn-primary btn-registrar-disfrute"
                                data-id="@item.Id"
                                data-empleado="@item.Empleado.Nombres @item.Empleado.Apellidos"
                                data-saldo="@item.SaldoActual"
                                data-toggle="modal"
                                data-target="#modalDisfrute">
                            <i class="ti ti-calendar me-1"></i> REGISTRAR DISFRUTE
                        </button>
                        <a asp-controller="Empleado" asp-action="File" asp-route-id="@item.EmpleadoId" class="btn btn-sm btn-outline-secondary">
                            <i class="ti ti-user-search me-1"></i> EXPEDIENTE
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="avatar avatar-xl bg-light text-muted rounded-circle mb-3 mx-auto">
                <i class="ti ti-calendar-cancel fs-48"></i>
            </div>
            <h3 class="fw-bold">Sin registros de saldos</h3>
            <p class="text-muted small">Los saldos de vacaciones se calculan automáticamente con el cierre de nómina mensual.</p>
        </div>
    }
</div>
<!-- ============================================================ -->
<!-- MODAL PARA REGISTRAR DISFRUTE -->
<!-- ============================================================ -->
<div class="modal fade" id="modalDisfrute" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="ti ti-calendar-check me-2"></i> Registrar Disfrute de Vacaciones
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form id="formDisfrute" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Empleado</label>
                        <p class="form-control-plaintext fw-semibold" id="modalEmpleadoNombre">-</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Saldo disponible</label>
                        <p class="form-control-plaintext text-success fw-bold" id="modalSaldoDisponible">-</p>
                    </div>
                    <div class="mb-3">
                        <label for="diasDisfrute" class="form-label fw-bold">Días a disfrutar <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="diasDisfrute" name="dias" step="0.5" min="0.5" placeholder="Ej. 5, 7.5, 15" required />
                        <div class="invalid-feedback">Ingrese un número válido (mínimo 0.5 días).</div>
                        <small class="text-muted">Puede registrar medios días (0.5, 1.5, etc.)</small>
                    </div>
                    <div class="mb-3">
                        <label for="observacionesDisfrute" class="form-label fw-bold">Observaciones (opcional)</label>
                        <input type="text" class="form-control" id="observacionesDisfrute" name="observaciones"
                               placeholder="Ej. Vacaciones aprobadas del 01/08 al 15/08" />
                    </div>
                    <input type="hidden" id="saldoIdDisfrute" name="id" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="ti ti-x me-1"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" id="btnGuardarDisfrute">
                        <i class="ti ti-check me-1"></i> Registrar Disfrute
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .tiny {
            font-size: 0.65rem;
            letter-spacing: 0.05em;
        }

        .hover-shadow:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
        }

        .card-status-top {
            height: 4px;
            border-radius: 0.375rem 0.375rem 0 0;
        }

        .bg-danger-subtle {
            background-color: rgba(220, 53, 69, 0.1);
        }

        .bg-warning-subtle {
            background-color: rgba(255, 193, 7, 0.1);
        }

        .bg-success-subtle {
            background-color: rgba(25, 135, 84, 0.1);
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // ============================================================
            // 1. ABRIR MODAL Y CARGAR DATOS
            // ============================================================
            $('.btn-registrar-disfrute').on('click', function() {
                var id = $(this).data('id');
                var empleado = $(this).data('empleado');
                var saldo = $(this).data('saldo');

                $('#saldoIdDisfrute').val(id);
                $('#modalEmpleadoNombre').text(empleado);
                $('#modalSaldoDisponible').text(saldo.toFixed(1) + ' días');

                // Limpiar campos del formulario
                $('#diasDisfrute').val('').removeClass('is-invalid');
                $('#observacionesDisfrute').val('');
                $('#formDisfrute').removeClass('was-validated');

                // Establecer máximo permitido
                $('#diasDisfrute').attr('max', saldo);

                // Abrir modal
                $('#modalDisfrute').modal('show');
            });

            // ============================================================
            // 2. ENVIAR FORMULARIO (AJAX)
            // ============================================================
            $('#formDisfrute').on('submit', function(e) {
                e.preventDefault();

                // Validar el campo de días
                var diasInput = $('#diasDisfrute');
                var dias = parseFloat(diasInput.val());
                var saldoDisponible = parseFloat($('#modalSaldoDisponible').text());

                if (isNaN(dias) || dias <= 0) {
                    diasInput.addClass('is-invalid');
                    window.SwalAlert('warning', 'Ingrese un número válido de días (mínimo 0.5).');
                    return;
                }

                if (dias > saldoDisponible) {
                    diasInput.addClass('is-invalid');
                    window.SwalAlert('warning', 'No hay suficiente saldo. Disponible: ' + saldoDisponible.toFixed(1) + ' días.');
                    return;
                }

                diasInput.removeClass('is-invalid');

                // Preparar datos
                var formData = $(this).serialize();
                var $btn = $('#btnGuardarDisfrute');

                // Deshabilitar botón durante el envío
                $btn.prop('disabled', true).html(
                    '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Procesando...'
                );

                $.ajax({
                    url: '@Url.Action("RecordDisfrute", "SaldoVacaciones")',
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        if (response.success) {
                            window.SwalAlert('success', response.message);

                            // Actualizar la tarjeta correspondiente
                            var saldoId = $('#saldoIdDisfrute').val();
                            var card = $('[data-saldo-id="' + saldoId + '"]');

                            // Obtener valores actuales de la tarjeta
                            var diasDisfrutadosSpan = card.find('.dias-disfrutados');
                            var saldoActualSpan = card.find('.saldo-actual');
                            var alertaCritical = card.find('.alerta-critical');

                            // Calcular nuevos valores
                            var diasDisfrutadosActual = parseFloat(diasDisfrutadosSpan.text()) || 0;
                            var saldoActual = parseFloat(saldoActualSpan.text()) || 0;
                            var nuevosDisfrutados = diasDisfrutadosActual + dias;
                            var nuevoSaldo = saldoActual - dias;

                            // Actualizar la tarjeta
                            diasDisfrutadosSpan.text(nuevosDisfrutados.toFixed(1));
                            saldoActualSpan.text(nuevoSaldo.toFixed(1));

                            // Actualizar data-saldo del botón
                            card.find('.btn-registrar-disfrute').data('saldo', nuevoSaldo);

                            // Si el saldo baja de 30, quitar alerta crítica
                            if (nuevoSaldo <= 30 && alertaCritical.length > 0) {
                                alertaCritical.remove();
                            }

                            // Cerrar modal y recargar (opcional: recargar después de 1.5s)
                            setTimeout(function() {
                                $('#modalDisfrute').modal('hide');
                                // Recargar para refrescar todos los datos (incluyendo alertas)
                                location.reload();
                            }, 1500);

                        } else {
                            Swal.fire('Error', response.message, 'error');
                            $btn.prop('disabled', false).html(
                                '<i class="ti ti-check me-1"></i> Registrar Disfrute'
                            );
                        }
                    },
                    error: function(xhr) {
                        var errorMsg = 'Error al registrar el disfrute.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }
                        Swal.fire('Error', errorMsg, 'error');
                        $btn.prop('disabled', false).html(
                            '<i class="ti ti-check me-1"></i> Registrar Disfrute'
                        );
                    }
                });
            });

            // ============================================================
            // 3. LIMPIAR VALIDACIÓN AL ESCRIBIR
            // ============================================================
            $('#diasDisfrute').on('input', function() {
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}
