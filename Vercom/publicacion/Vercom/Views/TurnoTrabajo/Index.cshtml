@model IEnumerable<Vercom.Models.TurnoTrabajo>
@{ ViewBag.Title = "Turnos de Trabajo"; }

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> NUEVO TURNO</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Recursos Humanos", Title = "Turnos de Trabajo", Subtitle = "Configuración de jornadas para control de retardos y asistencia.", Icon = "ti-clock", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th class="ps-4">Código</th>
                        <th>Nombre del Turno</th>
                        <th class="text-center">Hora Entrada</th>
                        <th class="text-center">Hora Salida</th>
                        <th class="text-center">Tolerancia</th>
                        <th class="text-center">Nocturno</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Codigo</td>
                            <td>@item.Nombre</td>
                            <td class="text-center font-monospace">@item.HoraEntrada.ToString("HH:mm")</td>
                            <td class="text-center font-monospace">@item.HoraSalida.ToString("HH:mm")</td>
                            <td>@item.ToleranciaMinutos min</td>
                            <td>
                                @if (item.EsNocturno)
                                {
                                    <span class="badge bg-dark">SÍ</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">NO</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
