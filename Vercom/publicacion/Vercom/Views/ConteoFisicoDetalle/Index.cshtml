@model IEnumerable<Vercom.Models.ConteoFisicoDetalle>
@{ ViewBag.Title = "Detalle de Conteo Físico"; }

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> NUEVO CONTEO</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Inventario", Title = "Detalle de Conteo Físico", Subtitle = "Listado de detalles de conteo físico de inventario.", Icon = "ti-file-description", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h4 class="card-title">Listado de ConteoFisicoDetalle</h4>
                </div>
                <div class="card-body">



<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="table-responsive"><table id="dataTable" class="table table-striped table-hover dt-responsive">
         <thead class="thead-sm text-uppercase fs-xxs">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CantidadSistema)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CantidadFisica)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Diferencia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Justificacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Conteo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MovimientoAjuste)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Producto)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CantidadSistema)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CantidadFisica)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Diferencia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Justificacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Conteo.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MovimientoAjuste.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Producto.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table></div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
     $(document).ready(function () {
            #dataTable.DataTable();
        });
    </script>
}
