@model Vercom.Models.OrdenProduccion
@{
    ViewBag.Title = "Hoja de Ruta: " + Model.NumeroOrden;
    var isFinalized = Model.Estado == "TERMINADA";
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Monitor</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Hoja de Ruta: " + Model.NumeroOrden, Subtitle = "Control técnico de transformación de @Model.ProductoTerminado.Nombre.", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <!-- Columna Izquierda: Estatus de la Orden -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-status-top @(isFinalized ? "bg-success" : "bg-warning")"></div>
                <div class="card-body p-4 text-center">
                    <div class="avatar avatar-xl bg-light text-primary rounded-circle mb-3 mx-auto" style="width: 80px; height: 80px;">
                        <i class="ti ti-settings-automation fs-40"></i>
                    </div>
                    <h4 class="fw-bold mb-1">@Model.ProductoTerminado.Nombre</h4>
                    <code class="fs-12 text-primary fw-bold">@Model.ProductoTerminado.Codigo</code>

                    <div class="mt-4 pt-3 border-top">
                        <div class="row g-2 text-start">
                            <div class="col-6 mb-2">
                                <span class="text-muted tiny fw-bold text-uppercase d-block">ESTADO:</span>
                                <span class="badge @(isFinalized ? "badge-soft-success" : "badge-soft-warning") w-100">@Model.Estado</span>
                            </div>
                            <div class="col-6 mb-2">
                                <span class="text-muted tiny fw-bold text-uppercase d-block">U.M. BASE:</span>
                                <span class="fw-bold">@Model.ProductoTerminado.UnidadMedida.Codigo</span>
                            </div>
                            <div class="col-12 mb-3">
                                <span class="text-muted tiny fw-bold text-uppercase d-block">CUMPLIMIENTO:</span>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="progress progress-sm flex-grow-1">
                                        @{ var progress = (Model.CantidadPlanificada > 0) ? (Model.CantidadProducida / Model.CantidadPlanificada * 100) : 0; }
                                        <div class="progress-bar bg-primary" style="width: @progress.ToString("N0")%"></div>
                                    </div>
                                    <span class="fw-bold small">@progress.ToString("N0")%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (isFinalized && Model.CostoRealTotal.HasValue) {
                <div class="card bg-primary text-white border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h6 class="text-white-50 tiny fw-bold text-uppercase mb-3">VALORACIÓN CONTABLE</h6>
                        <div class="d-flex justify-content-between align-items-end mb-2">
                            <span class="small">Costo Total Real:</span>
                            <h3 class="fw-bold mb-0">@Model.CostoRealTotal?.ToString("C")</h3>
                        </div>
                        <div class="d-flex justify-content-between align-items-end">
                            <span class="small text-white-50">Costo Unitario Real:</span>
                            <span class="fw-bold h4 mb-0">@((Model.CostoRealTotal / Model.CantidadProducida)?.ToString("C"))</span>
                        </div>
                    </div>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold small text-uppercase">Trazabilidad de Tiempos</h5>
                </div>
                <div class="card-body">
                    <table class="table table-vcenter card-table small">
                        <tbody>
                            <tr>
                                <td class="text-muted fw-bold">PLANIFICADO</td>
                                <td>@Model.FechaInicioPlan?.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-bold">INICIO REAL</td>
                                <td>@(Model.FechaInicioReal?.ToString("dd/MM HH:mm") ?? "-")</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-bold">FIN REAL</td>
                                <td>@(Model.FechaFinReal?.ToString("dd/MM HH:mm") ?? "-")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Explosión de Consumos y Eficiencia -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold"><i class="ti ti-components me-2 text-primary"></i>Insumos y Materias Primas Consumidas</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-hover">
                            <thead>
                                <tr class="bg-light-subtle">
                                    <th class="ps-4">Componente</th>
                                    <th>Planificado</th>
                                    <th>Real Utilizado</th>
                                  <th>Eficiencia</th>
                                    <th width="50"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.OrdenProduccionConsumos)
                                {
                                    var eficiencia = c.CantidadReal > 0 ? (c.CantidadPlanificada / c.CantidadReal * 100) : 0;
                                    var colorClass = (eficiencia < 90) ? "text-danger" : (eficiencia > 100 ? "text-success" : "text-primary");

                                    <tr>
                                      <td>
                                            <div class="fw-bold fs-13">@c.ProductoInsumo.Nombre</div>
                                            <small class="text-muted tiny font-monospace">@c.ProductoInsumo.Codigo</small>
                                        </td>
                                        <td>@c.CantidadPlanificada.ToString("N2")</td>
                                       <td class="fw-bold">@(c.CantidadReal > 0 ? c.CantidadReal.ToString("N2") : "-")</td>
                                        <td >
                                            @if (c.CantidadReal > 0)
                                            {
                                                <span class="badge @(eficiencia < 90 ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success") px-2">@eficiencia.ToString("N1")%</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic">Pendiente</span>
                                            }
                                        </td>
                                        <td>
                                            @if(c.MovimientoInventarioId != null) {
                                                <i class="ti ti-package-export text-success" title="Consumo Contabilizado"></i>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 border-start border-info border-3 mb-4">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h4 class="fw-bold text-info mb-1"><i class="ti ti-alert-triangle me-2"></i>Gestión de Incidencias y Mermas</h4>
                        <p class="text-muted small mb-0">¿Hubo roturas o desperdicios extraordinarios fuera de la BOM estándar?</p>
                    </div>
                    <a asp-controller="Merma" asp-action="Create" asp-route-opId="@Model.Id" class="btn btn-outline-info btn-sm px-4">
                        <i class="ti ti-minus me-1"></i> REPORTAR MERMA
                    </a>
                </div>
            </div>

            <div class="alert alert-secondary border-0 small p-4 bg-light-subtle">
                <h6 class="fw-bold mb-2">Resumen de Operación</h6>
                <p class="mb-0">Esta hoja de ruta certifica el proceso de transformación industrial. Al finalizar, el sistema generará automáticamente la entrada de almacén del Producto Terminado y el asiento contable de liquidación de producción.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-12 { font-size: 0.75rem; }
    .fs-13 { font-size: 0.8125rem; }
    .fs-15 { font-size: 1rem; }
</style>
