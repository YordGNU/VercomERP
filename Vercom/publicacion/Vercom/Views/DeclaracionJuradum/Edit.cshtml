@model Vercom.Models.DeclaracionJuradum

@{
    ViewData["Title"] = "Editar Declaración Jurada";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Editar Declaración Jurada</h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Fiscal</a></li>
            <li class="breadcrumb-item active">Declaraciones Juradas</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Edición</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="col-md-6">
                            <label asp-for="EntidadId" class="form-label"></label>
                            <select asp-for="EntidadId" class="form-select" asp-items="ViewBag.EntidadId"></select>
                            <span asp-validation-for="EntidadId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TipoObligacionId" class="form-label"></label>
                            <select asp-for="TipoObligacionId" class="form-select" asp-items="ViewBag.TipoObligacionId"></select>
                            <span asp-validation-for="TipoObligacionId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PeriodoId" class="form-label"></label>
                            <select asp-for="PeriodoId" class="form-select" asp-items="ViewBag.PeriodoId"></select>
                            <span asp-validation-for="PeriodoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NumeroDj" class="form-label"></label>
                            <input asp-for="NumeroDj" class="form-control" placeholder="Número de DJ" />
                            <span asp-validation-for="NumeroDj" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="BaseImponible" class="form-label"></label>
                            <input asp-for="BaseImponible" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="BaseImponible" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MontoCalculado" class="form-label"></label>
                            <input asp-for="MontoCalculado" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="MontoCalculado" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="MontoPagado" class="form-label"></label>
                            <input asp-for="MontoPagado" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="MontoPagado" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaLimite" class="form-label"></label>
                            <input asp-for="FechaLimite" class="form-control" type="date" />
                            <span asp-validation-for="FechaLimite" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaPresentacion" class="form-label"></label>
                            <input asp-for="FechaPresentacion" class="form-control" type="date" />
                            <span asp-validation-for="FechaPresentacion" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Estado" class="form-label"></label>
                            <select asp-for="Estado" class="form-select">
                                <option value="">Seleccione estado</option>
                                <option value="Borrador">Borrador</option>
                                <option value="Presentada">Presentada</option>
                                <option value="Pagada">Pagada</option>
                                <option value="Vencida">Vencida</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AsientoId" class="form-label"></label>
                            <select asp-for="AsientoId" class="form-select" asp-items="ViewBag.AsientoId"></select>
                            <span asp-validation-for="AsientoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GeneradoPor" class="form-label"></label>
                            <input asp-for="GeneradoPor" class="form-control" placeholder="Usuario generador" />
                            <span asp-validation-for="GeneradoPor" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CreadoEn" class="form-label"></label>
                            <input asp-for="CreadoEn" class="form-control" type="datetime-local" />
                            <span asp-validation-for="CreadoEn" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}