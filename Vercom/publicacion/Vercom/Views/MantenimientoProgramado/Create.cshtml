@model Vercom.Models.MantenimientoProgramado
@{
    ViewBag.Title = "Programar Mantenimiento";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Planificación de Servicio Técnico</h4>
        <p class="text-muted small mb-0">Programación de intervenciones preventivas o correctivas sobre activos productivos.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Producción</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Mantenimiento</a></li>
            <li class="breadcrumb-item active">Nuevo</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle py-3">
                    <h5 class="m-0 fw-bold"><i class="ti ti-calendar-time me-2 text-primary"></i>Datos de la Intervención</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-4">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Equipo / Maquinaria</label>
                            <select asp-for="EquipoId" class="form-control form-select w-100 select2" asp-items="ViewBag.EquipoId" required>
                                <option value="">-- Seleccione Maquinaria --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Fecha Programada</label>
                            <input asp-for="FechaProgramada" type="date" class="form-control" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="FechaProgramada" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tipo de Mantenimiento</label>
                            <select asp-for="Tipo" class="form-select" required>
                                <option value="PREVENTIVO">Mantenimiento Preventivo</option>
                                <option value="CORRECTIVO">Mantenimiento Correctivo (Rotura)</option>
                                <option value="REVISIÓN">Revisión Técnica / Calibración</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Descripción del Trabajo a Realizar</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Ej: Cambio de filtros, lubricación de ejes..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Costo Estimado ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Costo" class="form-control text-end" placeholder="0.00" step="0.01" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Responsable Técnico</label>
                            <input asp-for="ResponsableId" class="form-control" placeholder="Nombre del técnico o proveedor..." />
                            <small class="text-muted tiny">Persona encargada de la ejecución.</small>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> PROGRAMAR SERVICIO
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
