@model Vercom.ViewModels.BankAccountFormViewModel
@{
    ViewBag.Title = Model.Title;
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "", Subtitle = "Alta de cuentas en instituciones financieras para la gestión de tesorería.", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <form asp-action="Create" method="post" id="createBankAccountForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card">
                     <div class="card-header border-light justify-content-between">
                        <h5 class="m-0 fw-bold"><i class="ti ti-building-bank me-2 text-primary"></i>Datos de la Institución</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label">Banco / Institución</label>
                                <select asp-for="BankAccount.Banco" name="BankAccount.Banco" class="form-control form-select w-100" required>
                                    <option value="">-- Seleccione Banco --</option>
                                    <option value="BPA">Banco Popular de Ahorro (BPA)</option>
                                    <option value="BANDEC">Banco de Crédito y Comercio (BANDEC)</option>
                                    <option value="BFI">Banco Financiero Internacional (BFI)</option>
                                    <option value="BICSA">Banco Internacional de Comercio S.A. (BICSA)</option>
                                    <option value="Metropolitano">Banco Metropolitano</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tipo de Cuenta</label>
                                <select asp-for="BankAccount.TipoCuenta" name="BankAccount.TipoCuenta" class="form-control form-select w-100" required>
                                    <option value="FISCAL">Cuenta Fiscal</option>
                                    <option value="CORRIENTE">Cuenta Corriente</option>
                                    <option value="AHORRO">Cuenta de Ahorro</option>
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">Número de Cuenta (IBAN/Estandarizado)</label>
                                <input asp-for="BankAccount.NumeroCuenta" name="BankAccount.NumeroCuenta" class="form-control w-100 fw-bold text-primary" placeholder="0000 0000 0000 0000" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Cuenta Mayor Asociada</label>
                                <select asp-for="BankAccount.CuentaContableId" name="BankAccount.CuentaContableId" class="form-control form-select w-100 select2-cuenta" asp-items="Model.CuentasContables" required></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Saldo de Apertura ($)</label>
                                <input asp-for="BankAccount.SaldoActual" name="BankAccount.SaldoActual" type="number" step="0.01" class="form-control w-100 text-numeric" value="0.00" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Moneda</label>
                                <select asp-for="BankAccount.Moneda" name="BankAccount.Moneda" class="form-control form-select w-100" required>
                                    <option value="CUP">CUP Peso Cubanos</option>
                                    <option value="MLC">MLC Moneda libremente conv.</option>                               
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline px-4">DESCARTAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy"></i> REGISTRAR CUENTA
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('createBankAccountForm');
        });
    </script>
}
