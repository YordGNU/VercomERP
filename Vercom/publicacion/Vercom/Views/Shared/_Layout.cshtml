<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>VERCOM ELITE | @ViewBag.Title</title>
    <!-- App favicon -->
    <link rel="shortcut icon" href="assets/images/favicon.ico">
    <!-- Datatables css -->
    <link href="~/css/plugins/datatables/responsive.bootstrap5.min.css" rel="stylesheet" type="text/css">
    <!-- SweetAlert2 -->
    <script src="~/js/plugins/sweetalert/sweetalert2@11.js"></script>
    <!-- Select2 css -->
    <link href="~/css/plugins/select2/select2.min.css" rel="stylesheet" type="text/css">
    <!-- Theme Config Js -->
    <script src="~/js/config.js"></script>
    <!-- Vendor css -->
    <link href="~/css/vendors.min.css" rel="stylesheet" type="text/css">
    <!-- App css -->
    <link href="~/css/app.min.css" rel="stylesheet" type="text/css">
    <!-- UX design system css -->
    <link href="~/css/ux.css" rel="stylesheet" type="text/css">
    <!-- SweetAlert2 Fixes -->
    <link rel="stylesheet" href="~/css/plugins/sweetalert/sweetalert2.min.css">
    <style>
        .swal2-container { z-index: 10000 !important; }
        /* Evitar que el tema rompa el checkmark de éxito */
        .swal2-icon.swal2-success .swal2-success-ring { box-sizing: content-box !important; }
        .swal2-icon.swal2-success [class^='swal2-success-line'] { box-sizing: content-box !important; }
        .swal2-toast { box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important; border: 1px solid rgba(0,0,0,0.05) !important; }
    </style>
    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", required: false)
    }
    </head>
    <body>
    <div class="wrapper">
        <partial name="_TopBar" />
        <partial name="_SideNav" />
        <div class="content-page">
            <div class="container-fluid">
                @RenderBody()
            </div>
            <partial name="_Footer" />
        </div>
    </div>
    <partial name="_Theme" />
    <!-- Vendor js -->
    <script src="~/js/vendors.min.js"></script>
    <!-- App js -->
    <script src="~/js/app.js"></script>
    <!-- Datatables js -->
    <script src="~/js/plugins/datatables/dataTables.min.js"></script>
    <script src="~/js/plugins/datatables/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/plugins/datatables/dataTables.responsive.min.js"></script>
    <script src="~/js/plugins/datatables/responsive.bootstrap5.min.js"></script>
    <!-- Select2 js -->
    <script src="~/js/plugins/select2/select2.min.js"></script>
    <!-- Page js -->
    <script src="~/js/pages/datatables-ajax.js"></script>

    <!-- SignalR Client -->
    <script src="~/js/signalr.min.js"></script>
    <script>
        // Función global para notificaciones modernas
        window.SwalAlert = function(type, message, title = '') {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer)
                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                }
            });

            Toast.fire({
                icon: type,
                title: title || (type.charAt(0).toUpperCase() + type.slice(1)),
                text: message
            });
        };

        // Motor AJAX Universal para Formularios
        window.SubmitAjaxForm = function(formId, callback = null) {
            const $form = $('#' + formId);
            if (!$form.length) return;

            $form.on('submit', function(e) {
                e.preventDefault();

                // Validar si jquery validation está presente
                if ($form.data('validator') && !$form.valid()) return;

                const $btn = $form.find('button[type="submit"]');
                const originalHtml = $btn.html();

                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Procesando...');

                const formData = new FormData(this);

                $.ajax({
                    url: $form.attr('action'),
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        if (res.success) {
                            window.SwalAlert('success', res.message);
                            if (callback) {
                                callback(res);
                            } else if (res.redirectUrl) {
                                setTimeout(() => window.location.href = res.redirectUrl, 1500);
                            }
                        } else {
                            $btn.prop('disabled', false).html(originalHtml);

                            let errorContent = res.message;
                            if (res.errors && res.errors.length > 0) {
                                errorContent += '<ul class="text-start mt-3 small">' +
                                    res.errors.map(e => `<li>${e}</li>`).join('') +
                                    '</ul>';
                            }

                            Swal.fire({
                                icon: 'error',
                                title: 'Error en la operación',
                                html: errorContent,
                                confirmButtonColor: '#3085d6'
                            });
                        }
                    },
                    error: function() {
                        $btn.prop('disabled', false).html(originalHtml);
                        window.SwalAlert('error', 'Ocurrió un error inesperado en el servidor.');
                    }
                });
            });
        };

        // ===== Panel de Notificaciones (campana) =====
        const notifToken = () => {
            const el = document.querySelector('#notification-dropdown input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        };

        const notifTipoIcono = (tipo) =>
            tipo === 'success' ? 'ti-circle-check' :
            tipo === 'warning' ? 'ti-alert-triangle' :
            tipo === 'danger' ? 'ti-alert-octagon' : 'ti-info-circle';

        const notifBadge = (tipo) =>
            tipo === 'success' ? 'success' :
            tipo === 'warning' ? 'warning' :
            tipo === 'danger' ? 'danger' : 'info';

        let notifCache = [];
        const notifEstado = { filtro: 'all', tipo: '' };

        function notifItemHtml(item) {
            const badge = notifBadge(item.tipo);
            const icono = notifTipoIcono(item.tipo);
            const destino = item.enlace || '/Notificacion';
            const noLeida = item.leida ? '' : 'bg-primary bg-opacity-10';
            return `
                <div class="dropdown-item d-flex py-3 border-bottom border-light notification-item ${noLeida}" data-id="${item.id}">
                    <div class="avatar-xs bg-${badge}-subtle text-${badge} rounded-circle me-3 d-flex align-items-center justify-content-center" style="width:32px; height:32px; flex-shrink:0; font-size:17px; line-height:1;">
                        <i class="ti ${icono}"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0" style="cursor:pointer;" onclick="notifNavegar('${destino}')">
                        <h6 class="mb-1 text-truncate ${item.leida ? 'fw-semibold text-body' : 'fw-bold'}">${item.titulo}</h6>
                        <p class="mb-0 small text-muted text-truncate">${item.mensaje}</p>
                        <small class="tiny text-muted mt-1">${item.tiempo}${item.leida ? '' : ' · <span class="text-warning fw-bold">nueva</span>'}</small>
                    </div>
                    ${item.id && !item.leida ? `<button type="button" class="btn btn-icon btn-sm btn-ghost-success notification-read" data-id="${item.id}" title="Marcar como leída" style="flex-shrink:0;"><i class="ti ti-circle-check"></i></button>` : ''}
                </div>`;
        }

        function notifRender(container) {
            if (!container) return;
            container.innerHTML = '';
            if (!notifCache.length) {
                container.innerHTML = '<div class="dropdown-item py-3 text-center text-muted small"><i class="ti ti-bell-off fs-24 d-block mb-2 opacity-50"></i>Sin notificaciones</div>';
                return;
            }
            notifCache.forEach(item => container.insertAdjacentHTML('beforeend', notifItemHtml(item)));
        }

        async function notifCargar() {
            const container = document.getElementById("notification-stock");
            if (!container) return;
            const params = new URLSearchParams({ n: '15' });
            if (notifEstado.filtro === 'noleidas') params.set('soloNoLeidas', 'true');
            if (notifEstado.tipo) params.set('tipo', notifEstado.tipo);
            try {
                const res = await fetch(`/Notificacion/Ultimas?${params.toString()}`);
                if (!res.ok) return;
                notifCache = await res.json();
                notifRender(container);
            } catch (err) {
                console.error("Error cargando notificaciones:", err);
            }
        }

        async function notifContador() {
            const countEl = document.getElementById("notification-count");
            const navBadge = document.getElementById("sidenav-notification-count");
            const markAll = document.getElementById("notification-mark-all");
            try {
                const res = await fetch('/Notificacion/Contador');
                if (!res.ok) return;
                const data = await res.json();
                const pendientes = data.pendientes || 0;
                if (countEl) {
                    countEl.innerText = pendientes;
                    countEl.classList.toggle('d-none', pendientes === 0);
                }
                if (navBadge) {
                    navBadge.innerText = pendientes;
                    navBadge.classList.toggle('d-none', pendientes === 0);
                }
                if (markAll) markAll.classList.toggle('d-none', pendientes === 0);
            } catch (err) {
                console.error("Error contador notificaciones:", err);
            }
        }

        async function notifMarcarLeida(id) {
            const fd = new FormData();
            fd.append('id', id);
            fd.append('__RequestVerificationToken', notifToken());
            try {
                const res = await fetch('/Notificacion/MarcarLeida', { method: 'POST', body: fd });
                if (!res.ok) return;
                const item = notifCache.find(x => x.id === id);
                if (item) item.leida = true;
                if (notifEstado.filtro === 'noleidas') notifCargar();
                else notifRender(document.getElementById("notification-stock"));
                notifContador();
            } catch (err) {
                console.error("Error marcando notificación:", err);
            }
        }

        async function notifMarcarTodas() {
            const fd = new FormData();
            fd.append('__RequestVerificationToken', notifToken());
            try {
                const res = await fetch('/Notificacion/MarcarTodasLeidas', { method: 'POST', body: fd });
                if (!res.ok) return;
                notifCache.forEach(x => x.leida = true);
                if (notifEstado.filtro === 'noleidas') notifCargar();
                else notifRender(document.getElementById("notification-stock"));
                notifContador();
            } catch (err) {
                console.error("Error marcando todas:", err);
            }
        }

        function notifNavegar(destino) {
            window.location.href = destino;
        }

        document.addEventListener('click', (e) => {
            const btnLeer = e.target.closest('.notification-read');
            if (btnLeer) {
                e.preventDefault();
                e.stopPropagation();
                notifMarcarLeida(btnLeer.dataset.id);
                return;
            }
            const btnFiltro = e.target.closest('.notification-filter');
            if (btnFiltro) {
                document.querySelectorAll('.notification-filter').forEach(b => b.classList.remove('active'));
                btnFiltro.classList.add('active');
                notifEstado.filtro = btnFiltro.dataset.filtro;
                notifCargar();
                return;
            }
            const btnTipo = e.target.closest('.notification-type-filter');
            if (btnTipo) {
                document.querySelectorAll('.notification-type-filter').forEach(b => b.classList.remove('active'));
                btnTipo.classList.add('active');
                notifEstado.tipo = btnTipo.dataset.tipo;
                notifCargar();
                return;
            }
            if (e.target.closest('#notification-mark-all')) {
                notifMarcarTodas();
            }
        });

        const notifDropdownEl = document.getElementById("notification-dropdown");
        if (notifDropdownEl) {
            notifDropdownEl.addEventListener('show.bs.dropdown', notifCargar);
            notifDropdownEl.addEventListener('shown.bs.dropdown', notifContador);
        }

        // ===== SignalR: notificaciones en vivo =====
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveNotification", (data) => {
            notifContador();
            const container = document.getElementById("notification-stock");
            if (container) {
                const item = {
                    id: '',
                    titulo: data.title,
                    mensaje: data.message,
                    tipo: data.type || 'info',
                    leida: false,
                    enlace: '',
                    tiempo: data.time || new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                };
                notifCache.unshift(item);
                notifCache = notifCache.slice(0, 15);
                notifRender(container);
            }
            window.SwalAlert(data.type, data.message, data.title);
        });

        connection.start().catch(err => console.error("SignalR Error:", err));

        // Carga inicial
        notifCargar();
        notifContador();
    </script>

    <!-- TempData Notifications -->
    <script>
        $(document).ready(function() {
            @if (TempData["Success"] != null) {
                <text>window.SwalAlert('success', "@TempData["Success"]");</text>
            }
            @if (TempData["Error"] != null) {
                <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Error en la operación',
                        text: "@TempData["Error"]",
                        confirmButtonColor: '#3085d6'
                    });
                </text>
            }
            @if (TempData["Warning"] != null) {
                <text>window.SwalAlert('warning', "@TempData["Warning"]");</text>
            }
            @if (TempData["Info"] != null) {
                <text>window.SwalAlert('info', "@TempData["Info"]");</text>
            }

            // Inicializar Select2 globalmente
            $('.select2, .select2-cuenta').each(function() {
                $(this).select2({
                    width: '100%',              
                    placeholder: $(this).data('placeholder') || '-- Seleccione --',
                    allowClear: true,
                    language: {
                        noResults: function() { return "No se encontraron resultados"; },
                        searching: function() { return "Buscando..."; }
                    },
                    dropdownParent: $(this).closest('.modal').length ? $(this).closest('.modal') : $(document).body
                });
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
