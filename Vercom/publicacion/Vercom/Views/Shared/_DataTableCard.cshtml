@model Vercom.ViewModels.DataTableCardModel
@{
    var tableId = Model.TableId ?? "dataTable";
    var showCreate = Model.CreateAction != null;
    var showFilters = Model.Filters?.Any() == true;
}
<div class="row justify-content-center">
    <div class="@(Model.ColumnClass ?? "col-xxl-12")">
        <div class="card border-0 shadow-sm">
            @if (!string.IsNullOrEmpty(Model.Title) || showCreate)
            {
                <div class="ux-toolbar">
                    @if (!string.IsNullOrEmpty(Model.Title))
                    {
                        <h5 class="ux-toolbar-title">
                            <i class="ti ti-list-numbers"></i>
                            @Model.Title
                            @if (Model.Rows?.Any() == true)
                            {
                                <span class="ux-badge ux-tone-primary">@Model.Rows.Count</span>
                            }
                        </h5>
                    }
                    @if (showCreate)
                    {
                        var createUrl = Url.Action(Model.CreateAction.Action, Model.CreateAction.Controller);
                        if (!string.IsNullOrEmpty(Model.CreateAction.Id))
                        {
                            createUrl += $"?id={Model.CreateAction.Id}";
                        }
                        <a href="@createUrl" class="btn btn-sm btn-primary">
                            <i class="ti ti-plus me-1"></i> @Model.CreateAction.Text
                        </a>
                    }
                </div>
            }
            <div class="card-body p-0">
                @if (showFilters)
                {
                    <div class="ux-filters">
                        <form method="get" class="d-flex flex-wrap align-items-end gap-2 w-100" id="@($"{tableId}-filters")">
                            @foreach (var filter in Model.Filters)
                            {
                                <div class="@filter.ColumnClass">
                                    <label class="form-label" for="@filter.Name">@filter.Label</label>
                                    @if (filter.Options != null)
                                    {
                                        var onchange = filter.AutoSubmit ? "this.form.submit()" : "";
                                        <select id="@filter.Name" name="@filter.Name" class="form-select form-select-sm" asp-items="filter.Options">
                                            <option value="">@(filter.Placeholder ?? "-- Todos --")</option>
                                        </select>
                                        @if (!string.IsNullOrEmpty(onchange))
                                        {
                                            <script>
                                                $(function() {
                                                    $('select[name="@filter.Name"]').on('change', function() { @onchange; });
                                                });
                                            </script>
                                        }
                                    }
                                    else
                                    {
                                        <input id="@filter.Name" type="@(filter.Type ?? "text")" name="@filter.Name" value="@filter.Value" class="form-control form-control-sm" placeholder="@filter.Placeholder" @filter.Attributes />
                                    }
                                </div>
                            }
                            @if (Model.ShowClearButton)
                            {
                                <div class="ms-auto">
                                    <a href="@Model.ClearUrl" class="btn btn-sm btn-ghost-secondary">
                                        <i class="ti ti-refresh me-1"></i> Limpiar
                                    </a>
                                </div>
                            }
                        </form>
                    </div>
                }
                <div class="table-responsive">
                    <table id="@tableId" class="table table-hover dt-responsive mb-0 w-100">
                        <thead>
                            <tr>
                                @foreach (var col in Model.Columns)
                                {
                                    <th scope="col" @if (!string.IsNullOrEmpty(col.Width)) { <text>style="width:@col.Width"</text> }>@col.Header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Rows?.Any() == true)
                            {
                                @foreach (var row in Model.Rows)
                                {
                                    <tr @row.Attributes>
                                        @foreach (var col in Model.Columns)
                                        {
                                            var value = row.GetValue(col.Key);
                                            <td @col.TdAttributes>@(col.Template != null ? col.Template(value, row) : value)</td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <partial name="_EmptyState" model='new Vercom.ViewModels.EmptyStateModel
                                {
                                    Icon = "ti-inbox",
                                    Title = Model.EmptyMessage ?? "Sin registros",
                                    Description = "No hay información que coincida con los criterios seleccionados.",
                                    InTable = true,
                                    Colspan = Model.Columns.Count
                                }' />
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#@tableId').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[@Model.SortColumnIndex, '@Model.SortDirection']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
                responsive: true
            });
        });
    </script>
}