@model Vercom.ViewModels.FormCardModel
@{
    var formId = Model.FormId ?? "formCard";
    var showHeader = !string.IsNullOrEmpty(Model.Title);
}
<div class="row justify-content-center">
    <div class="@(Model.ColumnClass ?? "col-lg-10")">
        <div class="card border-0 shadow-sm">
            @if (showHeader)
            {
                <div class="ux-toolbar">
                    <h5 class="ux-toolbar-title">
                        @if (Model.Icon != null)
                        {
                            <i class="@Model.Icon"></i>
                        }
                        @Model.Title
                    </h5>
                    @if (!string.IsNullOrEmpty(Model.BackUrl))
                    {
                        <a href="@Model.BackUrl" class="btn btn-sm btn-ghost-secondary">
                            <i class="ti ti-arrow-left me-1"></i> Volver
                        </a>
                    }
                </div>
            }
            <div class="card-body p-4">
                <form asp-controller="@Model.Controller" asp-action="@Model.Action" method="post" class="row g-3" id="@formId">
                    @Html.AntiForgeryToken()
                    @if (Model.ShowValidationSummary)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger col-12"></div>
                    }
                    @foreach (var field in Model.Fields)
                    {
                        <div class="@field.ColumnClass">
                            @if (string.IsNullOrWhiteSpace(field.Label))
                            {
                                <label asp-for="@field.Expression" class="ux-label"></label>
                            }
                            else
                            {
                                <label asp-for="@field.Expression" class="ux-label">@field.Label</label>
                            }
                            @field.InputHtml
                            <span asp-validation-for="@field.Expression" class="text-danger small"></span>
                        </div>
                    }
                    @if (Model.FooterFields?.Any() == true)
                    {
                        <div class="col-12">
                            <hr class="ux-divider" />
                            @foreach (var field in Model.FooterFields)
                            {
                                <div class="@field.ColumnClass">@field.InputHtml</div>
                            }
                        </div>
                    }
                    <div class="col-12 d-flex flex-wrap justify-content-end gap-2 mt-2 pt-3 border-top">
                        @if (!string.IsNullOrEmpty(Model.BackUrl))
                        {
                            <a href="@Model.BackUrl" class="btn btn-light">Descartar</a>
                        }
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="@(Model.SubmitIcon ?? "ti ti-device-floppy") me-1"></i> @Model.SubmitText
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            window.SubmitAjaxForm('@formId');
            @if (Model.InitializeSelect2) {
                <text>
                $('.select2, .select2-cuenta').each(function() {
                    $(this).select2({
                        width: '100%',
                        placeholder: $(this).data('placeholder') || '-- Seleccione --',
                        allowClear: true,
                        language: {
                            noResults: function() { return "No se encontraron resultados"; },
                            searching: function() { return "Buscando..."; }
                        },
                        dropdownParent: $(this).closest('.modal').length ? $(this).closest('.modal') : $(document).body
                    });
                });
                </text>
            }
        });
    </script>
}