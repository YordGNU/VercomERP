@model Vercom.ViewModels.EquipoFormViewModel
@{
    ViewBag.Title = "Registrar Maquinaria";
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Equipos</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Producción", Title = "Alta de Equipos y Maquinaria", Subtitle = "Registro de activos productivos para el control de mantenimiento y disponibilidad.", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle py-3">
                    <h5 class="m-0 fw-bold"><i class="ti ti-tool me-2 text-primary"></i>Especificaciones Técnicas del Equipo</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-4" id="createEquipmentForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-3">
                            <label class="form-label fw-bold">Código de Inventario</label>
                            <input asp-for="Equipo.Codigo" class="form-control fw-bold text-primary text-uppercase" placeholder="Ej: MQ-001" required maxlength="30" />
                            <span asp-validation-for="Equipo.Codigo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-9">
                            <label class="form-label fw-bold">Nombre del Equipo / Maquinaria</label>
                            <input asp-for="Equipo.Nombre" class="form-control" placeholder="Ej: Horno Industrial Rotativo" required maxlength="150" />
                            <span asp-validation-for="Equipo.Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ubicación (Sucursal)</label>
                            <select asp-for="Equipo.SucursalId" class="form-control form-select w-100" asp-items="ViewBag.SucursalId" required></select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Activo Fijo Vinculado (Contabilidad)</label>
                            <select asp-for="Equipo.ActivoFijoId" class="form-control form-select w-100 select2" asp-items="ViewBag.ActivoFijoId">
                                <option value="">-- No vincular a Activos Fijos --</option>
                            </select>
                            <small class="text-muted tiny">Permite integrar el mantenimiento con la depreciación contable.</small>
                        </div>

                        <div class="col-md-6 mt-4 pt-3 border-top">
                            <label class="form-label fw-bold">Frecuencia de Mantenimiento (Días)</label>
                            <div class="input-group">
                                <input asp-for="Equipo.FrecuenciaMantenimientoDias" class="form-control text-center fw-bold" placeholder="30" required />
                                <span class="input-group-text bg-light">Días</span>
                            </div>
                            <small class="text-muted tiny">Intervalo recomendado para revisiones preventivas.</small>
                        </div>

                        <div class="col-md-6 mt-4 pt-3 border-top">
                            <label class="form-label fw-bold">Última Revisión Técnica</label>
                            <input asp-for="Equipo.FechaUltimaRevision" class="form-control" type="date" />
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR EQUIPO
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('createEquipmentForm');
        });
    </script>
}
