@model Vercom.ViewModels.EquipoFormViewModel

@{
    ViewData["Title"] = "Editar Equipo";
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Producción", Title = "Editar Equipo", Subtitle = "", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Formulario de Edición</h4>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> Volver
                    </a>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" class="row g-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Equipo.Id" />

                        <div class="col-md-6">
                            <label asp-for="Equipo.EntidadId" class="form-label"></label>
                            <select asp-for="Equipo.EntidadId" class="form-select" asp-items="ViewBag.EntidadId"></select>
                            <span asp-validation-for="Equipo.EntidadId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Equipo.SucursalId" class="form-label"></label>
             <select asp-for="Equipo.SucursalId" class="form-select" asp-items="ViewBag.SucursalId"></select>
                            <span asp-validation-for="Equipo.SucursalId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Equipo.ActivoFijoId" class="form-label"></label>
                            <select asp-for="Equipo.ActivoFijoId" class="form-select" asp-items="ViewBag.ActivoFijoId"></select>
                            <span asp-validation-for="Equipo.ActivoFijoId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Equipo.Codigo" class="form-label"></label>
                            <input asp-for="Equipo.Codigo" class="form-control" placeholder="Código del equipo" />
                            <span asp-validation-for="Equipo.Codigo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Equipo.Nombre" class="form-label"></label>
                            <input asp-for="Equipo.Nombre" class="form-control" placeholder="Nombre del equipo" />
                            <span asp-validation-for="Equipo.Nombre" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Equipo.FechaUltimaRevision" class="form-label"></label>
                            <input asp-for="Equipo.FechaUltimaRevision" class="form-control" type="date" />
                            <span asp-validation-for="Equipo.FechaUltimaRevision" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Equipo.FrecuenciaMantenimientoDias" class="form-label"></label>
                            <input asp-for="Equipo.FrecuenciaMantenimientoDias" class="form-control" placeholder="Días de frecuencia" />
                            <span asp-validation-for="Equipo.FrecuenciaMantenimientoDias" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Equipo.Estado" class="form-label"></label>
                            <select asp-for="Equipo.Estado" class="form-select">
                                <option value="">Seleccione estado</option>
                                <option value="Operativo">Operativo</option>
                                <option value="Mantenimiento">Mantenimiento</option>
                                <option value="Averiado">Averiado</option>
                                <option value="Baja">Baja</option>
                            </select>
                            <span asp-validation-for="Equipo.Estado" class="text-danger"></span>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-device-floppy me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}