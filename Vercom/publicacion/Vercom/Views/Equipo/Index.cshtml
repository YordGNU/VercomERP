@model IEnumerable<Vercom.Models.Equipo>
@{ ViewBag.Title = "Equipos de Planta"; }

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> NUEVO EQUIPO</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Producción", Title = "Gestión de Equipos y Maquinaria", Subtitle = "Monitoreo de activos productivos, estado operativo y mantenimiento preventivo.", Icon = "ti-settings", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' /><div class="row">
    <div class="row row-cards">
        @foreach (var item in Model)
        {
            var statusColor = item.Estado == "OPERATIVO" ? "success" : (item.Estado == "MANTENIMIENTO" ? "warning" : "danger");

            <div class="col-md-6 col-lg-4">
                <div class="card card-sm shadow-sm border-0 h-100">
                    <div class="card-status-top bg-@statusColor"></div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="bg-@statusColor-subtle text-@statusColor p-3 rounded-circle">
                                <i class="ti ti-tool fs-28"></i>
                            </div>
                            <span class="badge badge-soft-@statusColor px-3 py-1">@item.Estado</span>
                        </div>

                        <h4 class="fw-bold mb-1">@item.Nombre</h4>
                        <code class="text-primary tiny fw-bold">CÓDIGO: @item.Codigo</code>

                        <div class="bg-light-subtle rounded-3 p-3 mt-4 mb-4 border border-dashed">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted tiny fw-bold">ÚLTIMA REVISIÓN:</span>
                                <span class="small fw-bold">@(item.FechaUltimaRevision?.ToString("dd MMM yyyy") ?? "N/A")</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted tiny fw-bold">FRECUENCIA (DÍAS):</span>
                                <span class="small">Cada @item.FrecuenciaMantenimientoDias</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="MantenimientoProgramado" asp-action="Create" asp-route-equipoId="@item.Id" class="btn btn-sm btn-primary">
                                <i class="ti ti-calendar-plus me-1"></i> PROGRAMAR MANTENIMIENTO
                            </a>
                            <div class="row g-2">
                                <div class="col-6">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary w-100">DETALLES</a>
                                </div>
                                <div class="col-6">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary w-100">EDITAR</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any()) {
            <div class="col-12 text-center py-5">
                <div class="avatar avatar-xl bg-light-subtle text-muted rounded-circle mb-3 mx-auto">
                    <i class="ti ti-manual-gearbox fs-48"></i>
                </div>
                <h3 class="fw-bold">No hay equipos registrados</h3>
                <p class="text-muted">Añada sus activos productivos para gestionar el mantenimiento y la disponibilidad.</p>
                <a asp-action="Create" class="btn btn-primary mt-2">REGISTRAR EQUIPO</a>
            </div>
        }
    </div>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
