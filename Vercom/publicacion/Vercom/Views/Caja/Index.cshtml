@model IEnumerable<Vercom.Models.Caja>
@{
    ViewBag.Title = "Gestión de Arcas";
}
<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Disponibilidad de Efectivo en Arcas</h4>
        <p class="text-muted small mb-0">Control de saldos en efectivo por unidad y puntos de venta.</p>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus"></i> NUEVA CAJA
        </a>
    </div>
</div>
<div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="card h-100 transition-all hover-shadow">
                    <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">@item.Nombre</h5>
                            <small class="text-muted text-uppercase fw-semibold tiny">Unidad: @(item.Sucursal?.Nombre ?? "Central")</small>
                        </div>               
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline py-1 px-2 border-0" data-bs-toggle="dropdown" aria-expanded="false"><i class="ti ti-dots-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="">
                                <li><a asp-action="Details" asp-route-id="@item.Id" class="dropdown-item py-2"><i class="ti ti-list-search me-1"></i> Ver movimientos</a></li>
                                <li><a asp-action ="Edit" asp-route-id="@item.Id" class="dropdown-item py-2"><i class="ti ti-edit me-2 text-info"></i> Editar Datos</a></li>                               
                            </ul>
                        </div>
                    </div>
                    <div class="text-center py-3 bg-light-subtle border rounded-3 mb-2">
                        <h2 class="fw-bold text-success mb-0 text-numeric">@item.SaldoActual.ToString("N2")</h2>
                        <p class="small text-muted text-uppercase mb-0 fw-bold">Saldo en CUP</p>
                    </div>
                    <div class="bg-light-subtle border rounded-3 p-1 mb-2">
                        <div class="row g-0 text-center">
                            <div class="col-6 border-end">
                                <span>Cuenta Mayor:</span>
                                <span class="fw-semibold text-primary">@item.CuentaContable.Codigo</span>
                            </div>
                            <div class="col-6">
                                <span>Límite Efectivo:</span>
                                <span class="text-dark fw-bold">@(item.LimiteEfectivo?.ToString("N2") ?? "Ilimitado")</span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge @(item.Activa ? "badge-soft-success" : "badge-soft-danger")">
                            <i class="ti ti-circle-filled fs-8 me-1"></i> @(item.Activa ? "OPERATIVA" : "INACTIVA")
                        </span>
                    </div>                   
                    </div>
                </div>
            </div>      
        }
        @if (!Model.Any()) {
            <div class="col-12 text-center py-5">
                <div class="avatar-xl bg-light-subtle rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 100px; height: 100px;">
                    <i class="ti ti-cash fs-48 text-muted"></i>
                </div>
                <h3 class="fw-bold">No hay cajas configuradas</h3>
                <p class="text-muted">Inicie la configuración de tesorería registrando su primera caja física.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary mt-3">CONFIGURAR CAJA</a>
            </div>
        }
 </div>
