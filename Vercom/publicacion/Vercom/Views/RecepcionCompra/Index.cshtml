@model IEnumerable<Vercom.Models.RecepcionCompra>
@{ ViewData["Title"] = "Recepciones de Compra"; }

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Compras", Title = "Recepciones de Compra", Subtitle = "Control de recepción de mercancías y servicios.", Icon = "ti-package-import", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />

<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h4 class="card-title">Listado de RecepcionCompra</h4>
                </div>
                <div class="card-body">

<p>
    <a asp-action="Create">Create New</a>
</p>
<div class="table-responsive"><table id="dataTable" class="table table-striped table-hover dt-responsive">
         <thead class="thead-sm text-uppercase fs-xxs">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MovimientoInventarioId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CuentaPorPagarId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Fecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumeroInformeRecepcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RecibidoPor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrdenCompra)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MovimientoInventarioId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CuentaPorPagarId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Fecha)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NumeroInformeRecepcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RecibidoPor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrdenCompra.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
     $(document).ready(function () {
            #dataTable.DataTable();
        });
    </script>
}
