@model Vercom.Models.ContratoEconomico
@{
    ViewBag.Title = "Detalle de Contrato: " + Model.NumeroContrato;
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Contabilidad", Title = "Ficha de Instrumento Jurídico", Subtitle = "Control de vigencia y trazabilidad de convenios comerciales (RF-50).", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />
<div class="row">
    <div class="row">
        <!-- Columna Izquierda: Información General -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                 <div class="card-header bg-light-subtle py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary"><i class="ti ti-file-text me-2"></i>Términos del Contrato</h5>
                    <span class="badge @(Model.Estado == "VIGENTE" ? "bg-success" : "bg-danger") px-3">@Model.Estado</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold d-block">Número de Contrato</label>
                            <span class="fs-18 fw-bold text-primary">@Model.NumeroContrato</span>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold d-block">Tipo de Operación</label>
                            <span class="badge badge-outline text-muted">@Model.TerceroTipo</span>
                        </div>
                        <div class="col-md-12">
                            <label class="text-muted small text-uppercase fw-bold d-block">Objeto Contractual</label>
                            <div class="bg-light p-3 rounded-3 border">
                                <p class="mb-0 fs-15 italic">"@Model.Objeto"</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold d-block">Fecha Firma</label>
                            <div class="d-flex align-items-center mt-1">
                                <i class="ti ti-calendar-event text-muted me-2 fs-18"></i>
                                <span>@Model.FechaFirma.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold d-block">Inicio Vigencia</label>
                            <div class="d-flex align-items-center mt-1">
                                <i class="ti ti-clock-play text-success me-2 fs-18"></i>
                                <span>@Model.FechaInicio.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold d-block">Vencimiento Pactado</label>
                            <div class="d-flex align-items-center mt-1">
                                <i class="ti ti-calendar-x me-2 fs-18"></i>
                                <span>@((Model.FechaFinOriginal ?? Model.FechaFin)?.ToString("dd MMM yyyy") ?? "INDETERMINADO")</span>
                            </div>
                        </div>
                    </div>
                    @if (Model.Suplementos.Any(s => s.Estado == "VIGENTE"))
                    {
                        <div class="row g-4 mt-0">
                            <div class="col-md-12">
                                <div class="alert alert-success d-flex align-items-center mb-0" role="alert">
                                    <i class="ti ti-calendar-check fs-24 me-3"></i>
                                    <div>
                                        <strong>Vigencia ampliada por suplemento.</strong>
                                        <div class="small">
                                            El vencimiento original se conserva como referencia y la vigencia efectiva es la del último suplemento vigente.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Suplementos -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light-subtle py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold"><i class="ti ti-file-plus me-2"></i>Suplementos</h5>
                    <a asp-action="SuplementoCreate" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                        <i class="ti ti-plus me-1"></i> REGISTRAR SUPLEMENTO
                    </a>
                </div>
                @if (Model.Suplementos.Count == 0)
                {
                    <div class="card-body p-4 text-center text-muted">
                        <i class="ti ti-file-off fs-32 mb-2 d-block"></i>
                        Este contrato no tiene suplementos registrados.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">N.º</th>
                                    <th>Firma</th>
                                    <th>Vigencia desde</th>
                                    <th>Vigencia hasta</th>
                                    <th>Monto pactado</th>
                                    <th>Estado</th>
                                    <th>Documento</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sup in Model.Suplementos.OrderByDescending(s => s.NumeroSuplemento))
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">@sup.NumeroSuplemento</td>
                                        <td>@sup.FechaFirma.ToString("dd/MM/yyyy")</td>
                                        <td>@(sup.FechaInicio?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td class="fw-bold">@(sup.FechaFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@(sup.MontoTotalNuevo.HasValue ? sup.MontoTotalNuevo.Value.ToString("C2") : "—")</td>
                                        <td>
                                            <span class="badge @(sup.Estado == "VIGENTE" ? "bg-success" : "bg-secondary")">@sup.Estado</span>
                                            @if (!string.IsNullOrEmpty(sup.MotivoAnulacion))
                                            {
                                                <div class="small text-muted fst-italic mt-1">@sup.MotivoAnulacion</div>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(sup.DocumentoUrl))
                                            {
                                                <a href="@sup.DocumentoUrl" target="_blank" class="btn btn-sm btn-light">
                                                    <i class="ti ti-download"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Sin documento</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            @if (sup.Estado == "VIGENTE")
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#anular-@sup.Id" aria-expanded="false">
                                                    <i class="ti ti-file-x me-1"></i> ANULAR
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                    @if (sup.Estado == "VIGENTE")
                                    {
                                        <tr class="collapse" id="anular-@sup.Id">
                                            <td colspan="8" class="bg-light-subtle">
                                                <form asp-action="SuplementoAnular" asp-route-id="@Model.Id" id="anularForm-@sup.Id" class="d-flex gap-2 align-items-center py-2">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="suplementoId" value="@sup.Id" />
                                                    <input type="text" name="motivo" class="form-control form-control-sm" placeholder="Motivo de la anulacion (obligatorio)" maxlength="400" required />
                                                    <button type="submit" class="btn btn-sm btn-danger text-nowrap">
                                                        <i class="ti ti-check me-1"></i> CONFIRMAR ANULACION
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Trazabilidad Operativa -->
            <div class="card shadow-sm border-0">
                 <div class="card-header bg-light-subtle py-3">
                    <h5 class="m-0 fw-bold"><i class="ti ti-history me-2"></i>Impacto Operativo Acumulado</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row text-center g-4">
                        <div class="col-md-6 border-end">
                            <h2 class="fw-bold mb-0">@Model.FacturaVenta.Count</h2>
                            <p class="text-muted small text-uppercase fw-bold mb-0">Facturas de Venta</p>
                        </div>
                        <div class="col-md-6">
                            <h2 class="fw-bold mb-0">@Model.OrdenCompras.Count</h2>
                            <p class="text-muted small text-uppercase fw-bold mb-0">Órdenes de Compra</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Contraparte y Montos -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="m-0 fw-bold">Contraparte B2B</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.TerceroTipo == "CLIENTE" && Model.Cliente != null)
                    {
                        <div class="d-flex align-items-center mb-3">
                            <div class="avatar bg-primary-subtle text-primary rounded-circle me-3"><i class="ti ti-user fs-20"></i></div>
                            <div>
                                <h5 class="fw-bold mb-0">@Model.Cliente.NombreRazonSocial</h5>
                                <small class="text-muted">NIT/CI: @Model.Cliente.NitOCi</small>
                            </div>
                        </div>
                        <a asp-controller="Cliente" asp-action="Details" asp-route-id="@Model.ClienteId" class="btn btn-sm btn-light w-100 mt-2">
                            <i class="ti ti-external-link me-1"></i> VER FICHA DE CLIENTE
                        </a>
                    }
                    else if (Model.TerceroTipo == "PROVEEDOR" && Model.Proveedor != null)
                    {
                        <div class="d-flex align-items-center mb-3">
                            <div class="avatar bg-primary-subtle text-primary rounded-circle me-3"><i class="ti ti-truck fs-20"></i></div>
                            <div>
                                <h5 class="fw-bold mb-0">@Model.Proveedor.RazonSocial</h5>
                                <small class="text-muted">NIT: @Model.Proveedor.Nit</small>
                            </div>
                        </div>
                        <a asp-controller="Proveedor" asp-action="Details" asp-route-id="@Model.ProveedorId" class="btn btn-sm btn-light w-100 mt-2">
                            <i class="ti ti-external-link me-1"></i> VER FICHA DE PROVEEDOR
                        </a>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4 bg-primary bg-opacity-10">
                <div class="card-body p-4 text-center">
                    <label class="text-muted small text-uppercase fw-bold d-block mb-2">Monto Total Vigente</label>
                    <h1 class="fw-bold text-primary mb-0">
                        @(Model.MontoTotal?.ToString("C2") ?? "SIN LÍMITE")
                    </h1>
                    @if (Model.MontoTotalOriginal != Model.MontoTotal)
                    {
                        <div class="small mt-2">
                            <span class="text-muted">Pactado original:</span>
                            <strong>@(Model.MontoTotalOriginal?.ToString("C2") ?? "SIN LÍMITE")</strong>
                            @{
                                var supMonto = Model.Suplementos
                                    .Where(s => s.Estado == "VIGENTE" && s.MontoTotalNuevo.HasValue)
                                    .OrderByDescending(s => s.NumeroSuplemento)
                                    .FirstOrDefault();
                            }
                            @if (supMonto != null)
                            {
                                <div class="text-muted fst-italic mt-1">Modificado por suplemento N.º @supMonto.NumeroSuplemento</div>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.DocumentoUrl))
            {
                <div class="card shadow-sm border-0 border-dashed">
                    <div class="card-body p-4 text-center">
                        <i class="ti ti-file-certificate fs-32 text-muted mb-2"></i>
                        <h6 class="fw-bold mb-3">Documento Digitalizado</h6>
                        <a href="@Model.DocumentoUrl" target="_blank" class="btn btn-primary w-100">
                            <i class="ti ti-download me-1"></i> DESCARGAR CONTRATO
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('form[id^="anularForm-"]').each(function() {
                window.SubmitAjaxForm(this.id);
            });
        });
    </script>
}
