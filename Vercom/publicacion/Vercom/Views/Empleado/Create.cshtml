@model Vercom.ViewModels.EmployeeCreateViewModel
@{
    ViewBag.Title = Model.Title;
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Recursos Humanos", Title = Model.Title, Subtitle = "Alta formal de trabajador con activación de contrato legal (RF-20).", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />


<form asp-action="Create" method="post" enctype="multipart/form-data" id="createEmployeeForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>
    <input type="hidden" asp-for="Empleado.Estado" value="ACTIVO" />
    <div class="row">
        <!-- SECCIÓN 1: DATOS PERSONALES -->
        <div class="col-lg-12 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary bg-opacity-10 py-3">
                    <h5 class="m-0 fw-bold"><i class="ti ti-user-plus me-2 text-primary"></i>1. Identificación del Trabajador</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-3">
                            <label asp-for="Empleado.CarnetIdentidad" class="form-label fw-bold">Carnet de Identidad (11 dígitos)</label>
                            <input asp-for="Empleado.CarnetIdentidad" class="form-control fw-bold fs-5 text-primary" maxlength="11" id="txtCI" placeholder="00000000000" required />
                            <span asp-validation-for="Empleado.CarnetIdentidad" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Empleado.Nombres" class="form-label fw-bold">Nombres</label>
                            <input asp-for="Empleado.Nombres" id="txtNombres" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Empleado.Apellidos" class="form-label fw-bold">Apellidos</label>
                            <input asp-for="Empleado.Apellidos" id="txtApellidos" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Empleado.Sexo" class="form-label fw-bold">Sexo</label>
                            <select asp-for="Empleado.Sexo" class="form-select" id="ddlSexo" required>
                                <option value="">-- Seleccione --</option>
                                <option value="M">MASCULINO</option>
                                <option value="F">FEMENINO</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Empleado.FechaNacimiento" class="form-label fw-bold">Fecha Nacimiento</label>
                            <input asp-for="Empleado.FechaNacimiento" type="date" class="form-control" id="txtFechaNac" required />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Empleado.Telefono" class="form-label fw-bold">Teléfono</label>
                            <input asp-for="Empleado.Telefono" class="form-control" placeholder="+53 5..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Empleado.Direccion" class="form-label fw-bold">Dirección Particular</label>
                            <input asp-for="Empleado.Direccion" class="form-control" placeholder="Calle, #, entre..." />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SECCIÓN 2: UBICACIÓN Y CONTRATO -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-success bg-opacity-10 py-3">
                    <h5 class="m-0 fw-bold"><i class="ti ti-file-certificate me-2 text-success"></i>2. Primer Contrato Laboral (Activación Inmediata)</h5>
                    <input type="hidden" asp-for="Contrato.Estado" value="VIGENTE" />
                </div>
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Empleado.SucursalId" class="form-label fw-bold">Unidad / Sucursal</label>
                            <select asp-for="Empleado.SucursalId" class="form-select select2" asp-items="Model.Sucursales" required></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Contrato.CargoId" class="form-label fw-bold">Cargo / Ocupación</label>
                            <select asp-for="Contrato.CargoId" class="form-select select2" id="ddlCargo" asp-items="Model.Cargos" required>
                                <option value="">-- Seleccione Cargo --</option>
                            </select>
                            <div id="scaleInfo" class="mt-1 small text-info fw-bold" style="display:none;">
                                <i class="ti ti-info-circle"></i> Escala: $<span id="lblMin"></span> - $<span id="lblMax"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Contrato.TipoContrato" class="form-label fw-bold">Modalidad</label>
                            <select asp-for="Contrato.TipoContrato" class="form-select" id="ddlTipoContrato" asp-items="Model.TiposContrato" required></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Contrato.SalarioPactado" class="form-label fw-bold">Salario Mensual ($)</label>
                            <input asp-for="Contrato.SalarioPactado" type="number" step="0.01" id="txtSalario" class="form-control fw-bold text-success fs-5 text-end" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Contrato.FechaInicio" class="form-label fw-bold">Fecha Inicio</label>
                            <input asp-for="Contrato.FechaInicio" type="date" class="form-control" id="txtFechaInicio" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Contrato.FechaFin" class="form-label fw-bold">Fecha Término</label>
                            <input asp-for="Contrato.FechaFin" type="date" class="form-control" id="txtFechaFin" />
                            <small class="text-muted tiny" id="lblFechaFinHelp">Obligatorio para contratos a término.</small>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Contrato.JornadaHorasSemana" class="form-label fw-bold">Jornada Semanal (Horas)</label>
                            <input asp-for="Contrato.JornadaHorasSemana" type="number" class="form-control" value="44" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Empleado.TurnoTrabajoId" class="form-label fw-bold">Turno de Trabajo</label>
                            <select asp-for="Empleado.TurnoTrabajoId" class="form-select select2" asp-items="Model.Turnos">
                                <option value="">-- Sin turno asignado --</option>
                            </select>
                            <small class="text-muted tiny">Define el horario base para el control de retardos.</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Adjuntar Contrato Digitalizado (Word/PDF)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="ti ti-upload"></i></span>
                                <input type="file" asp-for="DocumentoContrato" class="form-control" accept=".doc,.docx,.pdf" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA: EXTRAS -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h5 class="m-0 fw-bold">Otros Datos</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label asp-for="Empleado.Email" class="form-label fw-bold">Email Institucional</label>
                        <input asp-for="Empleado.Email" id="txtEmail" class="form-control" placeholder="nombre.apellido@@tierraprometida.cu" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Empleado.NivelEscolaridad" class="form-label fw-bold">Escolaridad</label>
                        <select asp-for="Empleado.NivelEscolaridad" class="form-select">
                            <option value="UNIVERSITARIO">Universitario</option>
                            <option value="TECNICO_MEDIO">Técnico Medio</option>
                            <option value="PREUNIVERSITARIO">Preuniversitario</option>
                            <option value="BACHILLER">Bachiller</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Empleado.Calificacion" class="form-label fw-bold">Título / Especialidad</label>
                        <input asp-for="Empleado.Calificacion" class="form-control" placeholder="Ej: Lic. en Contabilidad" />
                    </div>
                    <div class="mb-0">
                        <label asp-for="Empleado.CuentaBancariaPago" class="form-label fw-bold">Cuenta Bancaria</label>
                        <input asp-for="Empleado.CuentaBancariaPago" class="form-control font-monospace" placeholder="92..." />
                    </div>
                </div>
            </div>

            <div class="d-grid gap-3 mt-4">
                <button type="submit" class="btn btn-primary btn-lg py-3 shadow">
                    <i class="ti ti-device-floppy me-1"></i> REGISTRAR ALTA
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">CANCELAR</a>
            </div>
        </div>
    </div>
</form>
@section Scripts {
    <script>
        $(document).ready(function() {
            // 1. Lógica de parseo de CI Cubano
            $('#txtCI').on('input', function() {
                const ci = $(this).val();
                if (ci.length === 11) {
                    // Año, Mes, Día
                    let anio = ci.substring(0, 2);
                    const mes = ci.substring(2, 4);
                    const dia = ci.substring(4, 6);

                    const actualAnio = new Date().getFullYear() % 100;
                    anio = (parseInt(anio) <= actualAnio) ? "20" + anio : "19" + anio;

                    const fechaNac = `${anio}-${mes}-${dia}`;
                    $('#txtFechaNac').val(fechaNac);

                    // Sexo (Décimo dígito: Par = Femenino, Impar = Masculino)
                    const sexDigit = parseInt(ci.substring(9, 10));
                    $('#ddlSexo').val(sexDigit % 2 === 0 ? "M" : "F");
                }
            });

            // 2. Sugerencia de Email Institucional
            const updateEmail = () => {
                const nombres = $('#txtNombres').val().trim().split(' ')[0].toLowerCase();
                const apellidos = $('#txtApellidos').val().trim().split(' ')[0].toLowerCase();
                if (nombres && apellidos) {
                    const emailInput = $('#txtEmail');
                    if (!emailInput.val()) {
                        emailInput.val(`${nombres}.${apellidos}@@tierraprometida.cu`);
                    }
                }
            };
            $('#txtNombres, #txtApellidos').on('blur', updateEmail);

            // 3. Información de Escala Salarial
            $('#ddlCargo').on('change', function() {
                const cargoId = $(this).val();
                if (cargoId) {
                    fetch(`/Cargo/GetScale?id=${cargoId}`)
                        .then(res => res.json())
                        .then(data => {
                            if (data.min || data.max) {
                                $('#lblMin').text(data.min ? data.min.toLocaleString() : '0');
                                $('#lblMax').text(data.max ? data.max.toLocaleString() : 'N/A');
                                $('#scaleInfo').fadeIn();

                                // Sugerir el mínimo en el salario pactado si está vacío
                                if (!$('#txtSalario').val() || $('#txtSalario').val() == "0") {
                                    $('#txtSalario').val(data.min);
                                }
                            } else {
                                $('#scaleInfo').hide();
                            }
                        });
                } else {
                    $('#scaleInfo').hide();
                }
            });

            // 4. Lógica de Periodo de Contrato según Tipo
            $('#ddlTipoContrato, #txtFechaInicio').on('change', function() {
                const tipo = $('#ddlTipoContrato').val();
                const fInicioStr = $('#txtFechaInicio').val();
                if (!fInicioStr) return;

                const fInicio = new Date(fInicioStr + 'T00:00:00');
                let fFin = new Date(fInicio);

                if (tipo === 'PRUEBA') {
                    fFin.setMonth(fFin.getMonth() + 3);
                    $('#txtFechaFin').val(fFin.toISOString().split('T')[0]).prop('disabled', false).prop('required', true);
                    $('#lblFechaFinHelp').text("Sugerencia: 3 meses de prueba.");
                } else if (tipo === 'DETERMINADO') {
                    fFin.setFullYear(fFin.getFullYear() + 1);
                    $('#txtFechaFin').val(fFin.toISOString().split('T')[0]).prop('disabled', false).prop('required', true);
                    $('#lblFechaFinHelp').text("Sugerencia: 1 año determinado.");
                } else if (tipo === 'INDETERMINADO') {
                    $('#txtFechaFin').val('').prop('disabled', true).prop('required', false);
                    $('#lblFechaFinHelp').text("Sin fecha de término definida.");
                }
            });

            // Disparar lógica inicial del contrato
            $('#ddlTipoContrato').trigger('change');

            // 5. Inicializar envío AJAX
            window.SubmitAjaxForm('createEmployeeForm');
        });
    </script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
