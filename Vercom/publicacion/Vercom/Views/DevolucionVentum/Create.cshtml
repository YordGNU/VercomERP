@model Vercom.ViewModels.SalesReturnFormViewModel
@{
    ViewBag.Title = "Nueva Devolución de Venta";
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Devoluciones</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Ventas", Title = "Registrar Devolución de Venta", Subtitle = "Anulación parcial o total de facturas y reingreso de mercancía al inventario.", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 border-start border-danger border-4">
                <div class="card-header bg-danger-subtle py-3">
                    <h5 class="m-0 fw-bold text-danger"><i class="ti ti-arrow-back-up me-2"></i>Detalle del Retorno Comercial</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-4">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-7">
                            <label class="form-label fw-bold">Factura de Venta Original</label>
                            <input type="hidden" asp-for="Return.FacturaId" />
                            <input class="form-control bg-light fw-bold" value="@Model.InvoiceNumber" readonly />
                            <small class="text-muted">La devolución se aplicará sobre este documento.</small>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label fw-bold">Fecha de Operación</label>
                            <input asp-for="Return.Fecha" type="date" class="form-control" required />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Motivo de la Devolución</label>
                            <select asp-for="Return.Motivo" class="form-select" required>
                                <option value="CALIDAD">Problemas de Calidad / Defecto</option>
                                <option value="ERROR_ENVIO">Error en Envío / Referencia</option>
                                <option value="DESISTIMIENTO">Desistimiento del Cliente</option>
                                <option value="VENCIMIENTO">Producto Próximo a Vencer</option>
                                <option value="OTRO">Otros Motivos (Especificar)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Importe a Devolver ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Return.TotalDevuelto" type="number" step="0.01" class="form-control fw-bold text-danger text-end" required />
                            </div>
                            <span asp-validation-for="Return.TotalDevuelto" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Usuario Autorizador</label>
                            <input asp-for="Return.AutorizadoPor" class="form-control" placeholder="Nombre o ID del Supervisor" required />
                        </div>

                        <div class="col-12 mt-4 pt-3 border-top">
                            <div class="alert alert-info border-0 py-3 small mb-0">
                                <i class="ti ti-info-circle me-1"></i>
                                Al procesar esta devolución, el sistema generará automáticamente:
                                <ul class="mb-0 mt-2">
                                    <li>Un <strong>Movimiento de Entrada</strong> al almacén original.</li>
                                    <li>Un <strong>Asiento Contable</strong> de ajuste de ingresos e inventario.</li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-danger px-5 py-2 shadow">
                                <i class="ti ti-check me-1"></i> PROCESAR DEVOLUCIÓN
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
