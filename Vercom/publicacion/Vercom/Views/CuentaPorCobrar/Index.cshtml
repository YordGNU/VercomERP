@model IEnumerable<Vercom.Models.CuentaPorCobrar>
@{
    ViewBag.Title = "Cuentas por Cobrar (Aging)";
    var today = DateOnly.FromDateTime(DateTime.Now);
    var overdueAmount = Model.Where(c => c.FechaVencimiento < today && c.Estado != "PAGADA").Sum(c => c.SaldoPendiente);
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Cartera: Cuentas por Cobrar</h4>
        <p class="text-muted small mb-0">Control de créditos comerciales y análisis de antigüedad de deuda (Aging).</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Finanzas</a></li>
            <li class="breadcrumb-item active">CxC</li>
        </ol>
        <div class="bg-danger-subtle text-danger px-3 py-2 rounded-3 border border-danger border-opacity-10 d-inline-block">
            <span class="small fw-bold">MOROSIDAD TOTAL:</span>
            <span class="h4 m-0 fw-bold ms-2">@overdueAmount.ToString("C")</span>
        </div>
    </div>
</div>

<div class="container-xxl">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold"><i class="ti ti-report-money me-2 text-primary"></i>Listado Cronológico de Vencimientos</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="cxcTable" class="table table-striped dt-responsive mb-0">
                <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th class="ps-4">Vencimiento</th>
                            <th>Cliente</th>
                            <th>Doc. Origen</th>
                            <th class="text-end">Monto Original</th>
                            <th class="text-end">Saldo Pendiente</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(c => c.FechaVencimiento))
                        {
                            var isOverdue = item.FechaVencimiento < today && item.Estado != "PAGADA";
                            var rowClass = isOverdue ? "bg-danger-subtle bg-opacity-10" : "";

                            <tr class="@rowClass">
                                <td class="ps-4">
                                    <div class="fw-bold @(isOverdue ? "text-danger" : "")">
                                        @item.FechaVencimiento.ToString("dd/MM/yyyy")
                                        @if (isOverdue) { <i class="ti ti-alert-triangle ms-1" title="DEUDA VENCIDA"></i> }
                                    </div>
                                    <small class="text-muted tiny">Emisión: @item.FechaEmision.ToString("dd/MM")</small>
                                </td>
                                <td>
                                    <div class="fw-semibold fs-13">@item.Cliente.NombreRazonSocial</div>
                                    <small class="text-muted tiny">NIT: @item.Cliente.NitOCi</small>
                                </td>
                                <td>
                                    <span class="badge badge-outline text-muted small">@item.DocumentoOrigenTipo</span>
                                </td>
                                <td class="text-end small">@item.MontoOriginal.ToString("N2")</td>
                                <td class="text-end fw-bold @(isOverdue ? "text-danger" : "text-primary")">
                                    @item.SaldoPendiente.ToString("N2")
                                </td>
                                <td >
                                    @{
                                        var statusClass = item.Estado switch {
                                            "PENDIENTE" => "bg-warning-subtle text-warning",
                                            "PARCIAL" => "bg-info-subtle text-info",
                                            "PAGADA" => "bg-success-subtle text-success",
                                            _ => "bg-light"
                                        };
                                    }
                                    <span class="badge @statusClass px-3">@item.Estado</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-list justify-content-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle" title="Aplicar Cobro">
                                            <i class="ti ti-receipt-2"></i>
                                        </a>
                                        <a asp-controller="Cliente" asp-action="Details" asp-route-id="@item.ClienteId" class="btn btn-sm btn-icon btn-light rounded-circle" title="Ficha Cliente">
                                            <i class="ti ti-user-star"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#cxcTable').DataTable({
                language: { url: '/js/i18n/es-ES.json' },
                order: [[0, 'asc']]
            });
        });
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-13 { font-size: 0.8125rem; }
</style>
