@model IEnumerable<Vercom.Models.MovimientoInventario>
@{
    ViewBag.Title = "Registro de Movimientos";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Bitácora y Trazabilidad de Almacén</h4>
        <p class="text-muted small mb-0">Historial completo de entradas, salidas y transferencias internas.</p>
    </div>
    <div class="text-end">
        <a asp-action="CreateMovement" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus"></i> REGISTRAR OPERACIÓN
        </a>
    </div>
</div>

<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-list-check me-2 text-primary"></i>Movimientos de Inventario</h5>
        </div>
        <div class="card-body">
            <table id="movementsTable" class="table table-striped dt-responsive mb-0">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th width="160" class="text-center">Fecha / Hora</th>
                        <th> Nº Documento</th>
                        <th>Tipo de Operación</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th class="text-center">Canal</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var typeClass = item.TipoMovimiento.Naturaleza switch
                        {
                            "ENTRADA" => "text-success",
                            "SALIDA" => "text-danger",
                            _ => "text-primary"
                        };

                        <tr>
                            <td class="text-date text-muted">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-numeric fw-bold text-primary">@item.NumeroDocumento</td>
                            <td class="fw-bold @typeClass">
                                <i class="ti @(item.TipoMovimiento.Naturaleza == "ENTRADA" ? "ti-arrow-down-left" : "ti-arrow-up-right") me-1"></i>
                                @item.TipoMovimiento.Nombre
                            </td>
                            <td><small class="text-muted">@(item.AlmacenOrigen?.Nombre ?? "EXTERNO")</small></td>
                            <td><small class="text-muted">@(item.AlmacenDestino?.Nombre ?? "EXTERNO")</small></td>
                            <td >
                                <span class="badge @(item.Canal == "POS" ? "badge-soft-info" : "badge-soft-secondary")">@item.Canal</span>
                            </td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Ver Documento">
                                        <i class="ti ti-file-text"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#movementsTable').DataTable({
                    language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'desc']]
            });
        });
    </script>
}
