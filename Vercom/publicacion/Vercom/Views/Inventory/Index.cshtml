@model IEnumerable<Vercom.Models.Existencium>
@{ ViewBag.Title = "Control de Inventario"; }

@{ var headerActions = "<a href='" + Url.Action("CreateMovement") + "' class='btn btn-sm btn-primary'><i class='ti ti-arrows-transfer-down me-1'></i> NUEVO MOVIMIENTO</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Inventario", Title = "Submayor de Existencias", Subtitle = "Visualización en tiempo real del stock disponible y valorización de inventario.", Icon = "ti-box", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />

<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-package me-2 text-primary"></i>Resumen de Almacén</h5>
            <div class="d-flex gap-2">
                <span class="badge badge-soft-info">@Model.Count() Productos en Stock</span>
            </div>
        </div>
        <div class="card-body">
            <table id="inventoryTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th>Producto / Insumo</th>
                        <th width="100">Código</th>
                           <th>Almacén</th>
                        <th>Cantidad</th>
                      <th>Costo Prom ($)</th>
                       <th>Valor Total ($)</th>
                        <th>Estado</th>
                        <th width="80" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isLowStock = item.Cantidad <= item.StockMinimo;
                        var statusClass = isLowStock ? "badge-soft-danger" : "badge-soft-success";
                        var statusText = isLowStock ? "STOCK BAJO" : "EN STOCK";

                        <tr>
                            <td class="fw-bold">@item.Producto.Nombre</td>
                            <td><span class="text-numeric text-primary small">@item.Producto.Codigo</span></td>
                            <td><i class="ti ti-map-pin me-1 text-muted"></i>@item.Almacen.Nombre</td>
                            <td class="text-numeric fw-bold @(isLowStock ? "text-danger" : "")">@item.Cantidad.ToString("N2")</td>
                            <td class="text-numeric">@item.CostoPromedio.ToString("N4")</td>
                            <td class="text-numeric fw-bold text-success">@((item.Cantidad * item.CostoPromedio).ToString("N2"))</td>
                            <td ><span class="badge @statusClass">@statusText</span></td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Movements" asp-route-productId="@item.ProductoId" class="btn btn-light btn-icon btn-sm rounded-circle"title="Kardex">
                                        <i class="ti ti-history"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#inventoryTable').DataTable({
                    language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'asc']]
            });
        });
    </script>
}
