@model Vercom.Models.MovimientoInventario
@{
    ViewBag.Title = "Detalle de Operación";
    var isEntrada = Model.TipoMovimiento.Naturaleza == "ENTRADA";
    var docName = isEntrada ? "Informe de Recepción" : (Model.TipoMovimiento.Naturaleza == "SALIDA" ? "Vale de Entrega / Salida" : "Transferencia de Mercancía");
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Documento Primario de Almacén</h4>
    </div>
    <div class="text-end d-flex gap-2">
        <a asp-action="Movements" class="btn btn-sm btn-outline-secondary">Volver al Registro</a>
        <button onclick="window.print()" class="btn btn-sm btn-light"><i class="ti ti-printer me-1"></i> Imprimir</button>
        @if (Model.AsientoId.HasValue)
        {
            <a asp-controller="AsientoContable" asp-action="Details" asp-route-id="@Model.AsientoId" class="btn btn-sm btn-info">
                <i class="ti ti-calculator me-1"></i> Ver Asiento
            </a>
        }
    </div>
</div>

<div class="row mt-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-5">
            <!-- Cabecera del Documento -->
            <div class="row mb-5">
                <div class="col-6">
                    <h2 class="fw-bold text-primary mb-1">@Model.Entidad.RazonSocial</h2>
                    <p class="text-muted mb-0">NIT: @Model.Entidad.Nit</p>
                    <p class="text-muted">@Model.Entidad.DireccionLegal</p>
                </div>
                <div class="col-6 text-end">
                    <h5 class="text-muted text-uppercase small mb-0">@docName</h5>
                    <h3 class="fw-bold mb-0">№ @Model.NumeroDocumento</h3>
                    <p class="mb-0 fw-bold">Fecha: @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>

            <!-- Datos de Almacén -->
            <div class="row bg-light rounded p-4 mb-4">
                <div class="col-sm-4 border-end">
                    <h6 class="text-muted text-uppercase small">Tipo de Operación</h6>
                    <h5 class="fw-bold">@Model.TipoMovimiento.Nombre</h5>
                </div>
                <div class="col-sm-4 border-end px-4">
                    <h6 class="text-muted text-uppercase small">Almacén Origen</h6>
                    <h5 class="fw-bold text-danger">@(Model.AlmacenOrigen?.Nombre ?? "N/A - Externo")</h5>
                </div>
                <div class="col-sm-4 px-4">
                    <h6 class="text-muted text-uppercase small">Almacén Destino</h6>
                    <h5 class="fw-bold text-success">@(Model.AlmacenDestino?.Nombre ?? "N/A - Externo")</h5>
                </div>
            </div>

            <!-- Tabla de Artículos -->
            <div class="table-responsive mb-5">
                <table class="table table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th width="80">Cód.</th>
                            <th>Descripción del Producto</th>
                            <th class="text-center">U.M.</th>
                            <th>Cantidad</th>
                           <th>Costo Unit.</th>
                            <th>Importe Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var det in Model.MovimientoInventarioDetalles)
                        {
                            var importe = det.Cantidad * (det.CostoUnitario ?? 0);
                            <tr>
                                <td class="font-monospace small">@det.Producto.Codigo</td>
                                <td>
                                    <div class="fw-bold">@det.Producto.Nombre</div>
                                    @if(!string.IsNullOrEmpty(det.Lote)) { <small class="text-muted">Lote: @det.Lote</small> }
                                </td>
                                <td >@det.Producto.UnidadMedida.Codigo</td>
                                <td class="text-end fw-bold">@det.Cantidad.ToString("N4")</td>
                                <td>@(det.CostoUnitario?.ToString("C") ?? "-")</td>
                                <td class="text-end fw-bold">@importe.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fs-16 fw-bold">
                        <tr>
                            <td colspan="5" class="text-end">VALOR TOTAL DEL DOCUMENTO:</td>
                            <td class="text-end text-primary">@Model.MovimientoInventarioDetalles.Sum(d => d.Cantidad * (d.CostoUnitario ?? 0)).ToString("C")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="row mt-4">
                <div class="col-12 mb-4">
                    <h6 class="fw-bold">Observaciones:</h6>
                    <p class="border p-3 rounded bg-light-subtle">@(Model.Observaciones ?? "Sin observaciones adicionales.")</p>
                </div>
            </div>

            <!-- Firmas -->
            <div class="row mt-5 pt-4 text-center">
                <div class="col-4">
                    <div class="border-top pt-2">Entrega (Firma y Nombre)</div>
                </div>
                <div class="col-4 offset-4">
                    <div class="border-top pt-2">Recibe (Firma y Nombre)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .app-topbar, .sidenav-menu, .footer, .btn, .page-title-head { display: none !important; }
        .content-page { margin-left: 0 !important; padding: 0 !important; }
        .container-xxl { max-width: 100% !important; width: 100% !important; }
        .card { border: 0 !important; box-shadow: none !important; }
        body { background: white !important; }
    }
</style>
