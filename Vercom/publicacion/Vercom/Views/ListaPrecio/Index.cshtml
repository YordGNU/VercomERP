@model IEnumerable<Vercom.Models.ListaPrecio>

@{
    ViewData["Title"] = "Listas de Precios";
}

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> Nueva Lista</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Ventas", Title = "Listas de Precios", Subtitle = "Gestión de tarifas y condiciones comerciales personalizadas.", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />

<div class="row mt-4">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="dataTable" class="table table-striped table-hover dt-responsive">
                        <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th>Nombre</th>
                                <th>Canal</th>
                                <th>Vigente Desde</th>
                                <th>Vigente Hasta</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@Html.DisplayFor(modelItem => item.Nombre)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Canal)</td>
                                    <td>@item.VigenteDesde.ToString("dd/MM/yyyy")</td>
                                    <td>@(item.VigenteHasta?.ToString("dd/MM/yyyy") ?? "Indefinido")</td>
                                    <td>
                                        @if (item.Activa)
                                        {
                                            <span class="badge bg-success-subtle text-success"><i class="ti ti-check me-1"></i>Activa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary"><i class="ti ti-x me-1"></i>Inactiva</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Ver detalles"><i class="ti ti-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="ti ti-edit"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                pageLength: 25,
                order: [[2, 'desc']]
            });
        });
    </script>
}
