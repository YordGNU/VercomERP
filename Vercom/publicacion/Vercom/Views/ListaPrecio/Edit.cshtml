@model Vercom.Models.ListaPrecio
@{
    ViewBag.Title = "Editar Lista de Precios";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Gestión de Catálogo: Listas</h4>
        <p class="text-muted small mb-0">Actualización de términos comerciales y vigencias.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Comercial</a></li>
            <li class="breadcrumb-item active">Editar Lista</li>
        </ol>
    </div>
</div>

<div class="row mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                 <div class="card-header bg-light-subtle py-3 d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold text-primary"><i class="ti ti-edit me-2"></i>Modificar Tarifario</h5>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-arrow-left me-1"></i> VOLVER
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" class="row g-4" id="editPriceListForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="EntidadId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-12">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre de la Lista</label>
                            <input asp-for="Nombre" name="Nombre" class="form-control fw-bold" required maxlength="100" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="VigenteDesde" class="form-label fw-bold">Vigente Desde</label>
                            <input asp-for="VigenteDesde" name="VigenteDesde" type="date" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="VigenteHasta" class="form-label fw-bold">Vigente Hasta</label>
                            <input asp-for="VigenteHasta" name="VigenteHasta" type="date" class="form-control" />
                        </div>

                        <div class="col-12 mt-2">
                            <div class="form-check form-switch p-3 bg-light-subtle border rounded-3">
                                <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="Activa" name="Activa">
                                <label class="form-check-label fw-bold">Lista de Precios Habilitada</label>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> ACTUALIZAR LISTA
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('editPriceListForm');
        });
    </script>
}
