@model Vercom.Models.Auditorium
@{
    ViewBag.Title = "Detalle de Auditoría";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Detalle de Transacción: @Model.Id</h4>
    </div>
</div>

<div class="row mt-4">
    <div class="row">
        <div class="col-lg-4">
            <div class="card">
                 <div class="card-header border-light justify-content-between"><h4 class="card-title">Metadatos</h4></div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Usuario:</span> <span class="fw-bold">@Model.NombreUsuario</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Fecha:</span> <span class="text-muted">@Model.OcurridoEn.ToString("F")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Acción:</span> <span class="badge bg-primary">@Model.Accion</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>IP Origen:</span> <span class="small">@Model.IpOrigen</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card">
                 <div class="card-header border-light justify-content-between"><h4 class="card-title">Cambios de Datos</h4></div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-danger fw-bold">Valores Anteriores</h6>
                            <pre class="bg-light p-3 rounded small" style="max-height: 400px; overflow: auto;">@(Model.ValoresAnteriores ?? "{}")</pre>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-success fw-bold">Valores Nuevos</h6>
                            <pre class="bg-light p-3 rounded small" style="max-height: 400px; overflow: auto;">@(Model.ValoresNuevos ?? "{}")</pre>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
                </div>
            </div>
        </div>
    </div>
</div>
