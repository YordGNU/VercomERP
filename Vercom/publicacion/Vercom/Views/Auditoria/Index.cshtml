@model Vercom.ViewModels.AuditIndexViewModel
@using Vercom.Helpers
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 text-dark"><i class="ti ti-history me-1"></i> @Model.Title</h4>
    </div>
</div>

<div class="row mt-4">
    <!-- Filtros Avanzados -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center"
             data-bs-toggle="collapse" data-bs-target="#filterCollapse">
            <h6 class="mb-0"><i class="ti ti-filter me-1"></i> Filtros</h6>
            <span class="text-muted small"><i class="ti ti-chevron-down"></i></span>
        </div>
        <div class="collapse show" id="filterCollapse">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Búsqueda global</label>
                        <input type="text" name="q" value="@Model.FilterUser"
                               class="form-control" placeholder="Usuario, tabla o ID...">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Acción</label>
                        <select name="action" class="form-select">
                            <option value="">Todas</option>
                            <option value="INSERT">INSERT</option>
                            <option value="UPDATE">UPDATE</option>
                            <option value="DELETE">DELETE</option>
                            <option value="LOGIN_FALLIDO">LOGIN FALLIDO</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Canal</label>
                        <select name="channel" class="form-select">
                            <option value="">Todos</option>
                            <option value="WEB">WEB</option>
                            <option value="POS">POS</option>
                            <option value="API">API</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Desde</label>
                        <input type="date" name="start" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold">Hasta</label>
                        <input type="date" name="end" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control">
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="ti ti-search me-1"></i> Aplicar filtros</button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="ti ti-x me-1"></i> Limpiar</a>
                        <div class="ms-auto">
                            <!-- Accesos rápidos de fecha -->
                            <button type="button" class="btn btn-sm btn-outline-dark" onclick="setDateRange('today')">Hoy</button>
                            <button type="button" class="btn btn-sm btn-outline-dark" onclick="setDateRange('7days')">7 días</button>
                            <button type="button" class="btn btn-sm btn-outline-dark" onclick="setDateRange('30days')">30 días</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="ti ti-list me-1"></i> Registros de auditoría</h6>
            <div class="btn-group">
                <button class="btn btn-sm btn-outline-secondary" onclick="exportData('excel')">
                    <i class="ti ti-file-spreadsheet me-1"></i> Excel
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="exportData('pdf')">
                    <i class="ti ti-file-text me-1"></i> PDF
                </button>
            </div>
        </div>
        <table class="table table-hover align-middle mb-0" id="auditTable">
        <thead class="thead-sm text-uppercase fs-xxs">
                <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Ubicación</th>
                    <th>Registro</th>
                    <th>Canal</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr data-detail-id="@log.Id">
                        <td>@log.OcurridoEn.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@log.NombreUsuario</td>
                        <td><span class="badge @AuditHelper.GetActionBadgeClass(log.Accion)">@log.Accion</span></td>
                        <td>@log.EsquemaTabla</td>
                        <td>@log.RegistroId</td>
                        <td>@log.Canal</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary btn-detail" data-id="@log.Id">
                                <i class="ti ti-eye"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="alert alert-info mt-4 py-2 small border-0 shadow-sm">
        <i class="ti ti-info-circle me-1"></i> RF-03: Los registros de auditoría son inalterables y cumplen con la Resolución 60/2011 de la CGR para trazabilidad total.
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function() {
            var table = $('#auditTable').DataTable({
                // configuración...
                columnDefs: [
                    { orderable: false, targets: 6 } // deshabilitar orden en columna de acciones
                ]
            });

            // Manejador para el botón de detalle
            $('#auditTable tbody').on('click', '.btn-detail', function() {
                var tr = $(this).closest('tr');
                var row = table.row(tr);

                if (row.child.isShown()) {
                    // Ocultar detalle
                    row.child.hide();
                    tr.removeClass('shown');
                } else {
                    // Obtener datos del detalle (pueden venir de data-attributes o de un objeto JS)
                    var detailHtml = '<div class="p-3 bg-light">' +
                        '<strong>Detalle completo:</strong><br>' +
                        '<pre>' + details[row.data().id] + '</pre>' +
                        '</div>';
                    row.child(detailHtml).show();
                    tr.addClass('shown');
                }
            });
        });      
    </script>
}
