@model Vercom.ViewModels.CostSheetCreateViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">@Model.Title</h4>
        <p class="text-muted small mb-0">Definición de costos estándar según metodología oficial del MFP.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Producción</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Fichas</a></li>
            <li class="breadcrumb-item active">Nueva</li>
        </ol>
    </div>
</div>

<div class="row">
    <form asp-action="Create" method="post" id="createCostSheetForm">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light-subtle">
                        <h5 class="m-0 fw-bold"><i class="ti ti-calculator me-2 text-primary"></i>Cálculo de Costo Unitario (Norma de Gasto)</h5>
                    </div>
                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>

                        <div class="row g-4">
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Producto Elaborado (Resultado)</label>
                                <select asp-for="CostSheet.ProductoId" name="CostSheet.ProductoId" class="form-control form-select w-100 select2" asp-items="Model.ProductosElaborados" required>
                                    <option value="">-- Seleccione el producto --</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">Materia Prima Directa ($)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="CostSheet.CostoMateriaPrima" name="CostSheet.CostoMateriaPrima" class="form-control text-end fw-bold" step="0.0001" required />
                                </div>
                                <small class="text-muted tiny">Según Ficha de Insumos (BOM).</small>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">Mano de Obra Directa ($)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="CostSheet.CostoManoObra" name="CostSheet.CostoManoObra" class="form-control text-end fw-bold" step="0.0001" required />
                                </div>
                                <small class="text-muted tiny">Tarifa horaria + contribución SS.</small>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">Gastos Indirectos ($)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="CostSheet.GastosIndirectos" name="CostSheet.GastosIndirectos" class="form-control text-end fw-bold" step="0.0001" required />
                                </div>
                                <small class="text-muted tiny">GIF / Depreciación / Energía.</small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Fecha de Vigencia</label>
                                <input asp-for="CostSheet.VigenteDesde" name="CostSheet.VigenteDesde" type="date" class="form-control" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Margen de Utilidad Deseado (%)</label>
                                <div class="input-group">
                                    <input asp-for="CostSheet.MargenPorcentaje" name="CostSheet.MargenPorcentaje" class="form-control text-end" placeholder="0.00" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 border-top border-primary border-3 mb-4">
                    <div class="card-header bg-primary-subtle py-3">
                        <h5 class="m-0 fw-bold text-primary">Resumen de Formación</h5>
                    </div>
                    <div class="card-body p-4 text-center">
                        <div class="mb-4">
                            <span class="text-muted tiny fw-bold text-uppercase d-block mb-1">Precio Sugerido (Venta)</span>
                            <h1 class="display-5 fw-bold text-dark m-0" id="lblPrecioSugerido">$ 0.00</h1>
                        </div>
                        <hr class="border-dashed">
                        <div class="alert alert-info border-0 py-2 small text-start">
                            <i class="ti ti-info-circle me-1"></i> <strong>RF-40:</strong> Al activar esta ficha, cualquier versión anterior de este producto pasará automáticamente al estado <strong>HISTÓRICA</strong>.
                        </div>

                        <div class="d-grid gap-3 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg shadow">
                                <i class="ti ti-device-floppy me-1"></i> ACTIVAR NUEVA VERSIÓN
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">DESCARTAR</a>
                        </div>
                    </div>
                </div>

                <div class="card bg-dark text-white border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-3"><i class="ti ti-help me-2"></i>Cumplimiento MFP</h4>
                        <p class="small opacity-75">Este cálculo se ajusta a la Resolución de Precios vigentes para actores económicos no estatales en Cuba.</p>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function calculate() {
            const mp = parseFloat(document.getElementsByName('CostSheet.CostoMateriaPrima')[0].value || 0);
            const mo = parseFloat(document.getElementsByName('CostSheet.CostoManoObra')[0].value || 0);
            const gif = parseFloat(document.getElementsByName('CostSheet.GastosIndirectos')[0].value || 0);
            const margin = parseFloat(document.getElementsByName('CostSheet.MargenPorcentaje')[0].value || 0);

            const totalCost = mp + mo + gif;
            const price = totalCost * (1 + (margin / 100));

            document.getElementById('lblPrecioSugerido').innerText = price.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        }

        document.querySelectorAll('input').forEach(i => i.addEventListener('input', calculate));
        document.addEventListener('DOMContentLoaded', () => {
            calculate();
            window.SubmitAjaxForm('createCostSheetForm');
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
</style>
