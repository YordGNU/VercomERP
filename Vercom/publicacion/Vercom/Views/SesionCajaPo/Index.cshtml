@model IEnumerable<Vercom.Models.SesionCajaPo>
@{
    ViewBag.Title = "Sesiones de Caja POS";
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Ventas", Title = "Monitor de Terminales: Sesiones POS", Subtitle = "Seguimiento de aperturas, cierres y arqueos de caja en puntos de venta.", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="col-lg-12">
          <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle d-flex justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-device-desktop me-2 text-primary"></i>Historial de Turnos</h5>
            <span class="badge badge-soft-info">Consolidado Cloud</span>
        </div>
        <div class="card-body">
          <table id="sessionsTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th class="ps-4">Terminal / Cajero</th>
                          <th>Apertura</th>
                          <th>Cierre</th>
                            <th>Ventas ($)</th>
                            <th>Dif. Arqueo</th>
                          <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var hasDiff = item.DiferenciaArqueo != 0 && item.Estado == "CERRADA";
                            var diffClass = item.DiferenciaArqueo < 0 ? "text-danger" : "text-success";

                            <tr>
                              <td>
                                    <div class="fw-bold">@item.DispositivoPos.Nombre</div>
                                    <small class="text-muted tiny">ID: @item.DispositivoPos.Codigo</small>
                                </td>
                                <td small">@item.FechaApertura.ToString("dd/MM HH:mm")</td>
                                <td small">
                                    @(item.FechaCierre.HasValue ? item.FechaCierre.Value.ToString("dd/MM HH:mm") : "-")
                                </td>
                               <td class="fw-bold">@item.TotalVentas.ToString("N2")</td>
                               <td class="@(hasDiff ? "fw-bold " + diffClass : "text-muted")">
                                    @(item.Estado == "CERRADA" ? item.DiferenciaArqueo?.ToString("N2") : "-")
                                    @if(hasDiff && item.DiferenciaArqueo < 0) { <i class="ti ti-alert-triangle ms-1"></i> }
                                </td>
                                <td >
                                    <span class="badge @(item.Estado == "ABIERTA" ? "bg-success" : "bg-secondary") px-3">@item.Estado</span>
                                </td>
                                <td>
                                    <div class="btn-list justify-content-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle" title="Ver Arqueo Detallado">
                                            <i class="ti ti-report-money"></i>
                                        </a>
                                        @if (item.AsientoCierreId.HasValue)
                                        {
                                            <a asp-controller="AsientoContable" asp-action="Details" asp-route-id="@item.AsientoCierreId" class="btn btn-sm btn-icon btn-light rounded-circle text-info" title="Ver Asiento de Cierre">
                                                <i class="ti ti-calculator"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
        </div>
    </div>
    </div>  
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#sessionsTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',      
            });
        });
    </script>
}

