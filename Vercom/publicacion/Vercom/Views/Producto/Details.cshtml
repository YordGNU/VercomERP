@model Vercom.Models.Producto
@{
    ViewBag.Title = "Ficha Técnica de Producto";
    var totalStock = Model.Existencia.Sum(e => e.Cantidad);
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Catálogo</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Inventario", Title = "Artículo: " + Model.Nombre, Subtitle = "Especificaciones técnicas, valoración de inventario y disponibilidad global.", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <!-- Columna Izquierda: Identidad y Valoración -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-status-top bg-primary"></div>
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <div class="avatar avatar-xl bg-light text-muted rounded-3 mx-auto" style="width: 120px; height: 120px; border: 2px dashed #ddd;">
                            <i class="ti ti-photo fs-48"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.Nombre</h3>
                    <code class="fs-13 text-primary fw-bold">@Model.Codigo</code>

                    <div class="mt-4 pt-3 border-top">
                        <div class="row g-2">
                            <div class="col-12">
                                <div class="bg-primary-subtle rounded py-3">
                                    <div class="h2 fw-bold mb-0 text-primary">@totalStock.ToString("N2")</div>
                                    <div class="text-muted tiny fw-bold text-uppercase">EXISTENCIA TOTAL (@Model.UnidadMedida.Codigo)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold small text-uppercase">Valoración de Venta</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted tiny fw-bold text-uppercase d-block mb-1">Precio Vigente (CUP)</label>
                        <h2 class="text-success fw-bold m-0">@Model.PrecioVentaActual?.ToString("C")</h2>
                    </div>
                    <hr class="my-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted fw-bold">Tipo de Artículo:</span>
                        <span class="badge badge-outline text-primary small">@Model.Tipo</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="small text-muted fw-bold">Impuesto Venta:</span>
                        @if(Model.AplicaImpuestoVentas) { <span class="badge bg-info-subtle text-info">SÍ (10%)</span> }
                        else { <span class="badge bg-light">EXENTO</span> }
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Almacenes e Integración -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header p-0">
                    <ul class="nav nav-tabs nav-tabs-alt border-0" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active px-4 py-3 fw-bold" data-bs-toggle="tab" href="#tab-stock">DISPONIBILIDAD</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-4 py-3 fw-bold" data-bs-toggle="tab" href="#tab-lots">LOTES Y VENCIMIENTOS</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-4 py-3 fw-bold" data-bs-toggle="tab" href="#tab-accounting">INTEGRACIÓN CONTABLE</a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content">
                        <!-- Disponibilidad por Almacén -->
                        <div class="tab-pane fade show active" id="tab-stock">
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Almacén / Depósito</th>
                                          <th>Stock</th>
                                          <th>Costo PPP</th>
                                          <th>Min / Max</th>
                                            <th width="50"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach(var ex in Model.Existencia) {
                                            <tr>
                                                <td class="fw-bold ps-4">@ex.Almacen.Nombre</td>
                                                <td >
                                                    <span class="badge @(ex.Cantidad <= ex.StockMinimo ? "bg-danger" : "bg-success")">@ex.Cantidad.ToString("N2")</span>
                                                </td>
                                                <td font-monospace">@ex.CostoPromedio.ToString("N4")</td>
                                                <td small text-muted">@ex.StockMinimo / @ex.StockMaximo</td>
                                                <td class="pe-4">
                                                    <a asp-action="Movements" asp-route-productId="@Model.Id" asp-route-warehouseId="@ex.AlmacenId" class="btn btn-icon btn-sm btn-ghost-primary"><i class="ti ti-history"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Lotes y Vencimientos -->
                        <div class="tab-pane fade" id="tab-lots">
                            <div class="table-responsive">
                                <table class="table table-vcenter card-table table-hover">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">Nº de Lote</th>
                                            <th>Almacén</th>
                                          <th>Vencimiento</th>
                                            <th>Existencia</th>
                                          <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach(var lote in Model.ExistenciaLotes.Where(l => l.Cantidad > 0).OrderBy(l => l.FechaVencimiento)) {
                                            var isExpired = lote.FechaVencimiento.HasValue && lote.FechaVencimiento < DateOnly.FromDateTime(DateTime.Now);
                                            var isNear = lote.FechaVencimiento.HasValue && lote.FechaVencimiento < DateOnly.FromDateTime(DateTime.Now.AddDays(30));

                                            <tr>
                                              <td><code class="fw-bold">@lote.Lote</code></td>
                                                <td class="small">@lote.Almacen.Nombre</td>
                                                <td @(isExpired ? "text-danger fw-bold" : (isNear ? "text-warning fw-bold" : ""))">
                                                    @(lote.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "N/A")
                                                </td>
                                               <td class="fw-bold">@lote.Cantidad.ToString("N2")</td>
                                                <td >
                                                    @if(isExpired) { <span class="badge bg-danger">VENCIDO</span> }
                                                    else if(isNear) { <span class="badge bg-warning">PRÓXIMO</span> }
                                                    else { <span class="badge bg-success">VIGENTE</span> }
                                                </td>
                                            </tr>
                                        }
                                        @if(!Model.ExistenciaLotes.Any(l => l.Cantidad > 0)) {
                                            <tr>
                                                <td colspan="5" class="text-center py-5 text-muted small">No se registran lotes activos para este producto.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Integración Contable -->
                        <div class="tab-pane fade p-4" id="tab-accounting">
                            <div class="row row-cards g-3">
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded-3 border-start border-info border-3">
                                        <label class="text-muted tiny fw-bold text-uppercase d-block mb-1">Inventario (Activo)</label>
                                        <span class="fw-bold fs-12">@(Model.CuentaInventario?.Codigo ?? "-")</span>
                                        <p class="tiny text-truncate mb-0">@(Model.CuentaInventario?.Nombre ?? "No asignada")</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded-3 border-start border-danger border-3">
                                        <label class="text-muted tiny fw-bold text-uppercase d-block mb-1">Costo Venta (Gasto)</label>
                                        <span class="fw-bold fs-12">@(Model.CuentaCostoVenta?.Codigo ?? "-")</span>
                                        <p class="tiny text-truncate mb-0">@(Model.CuentaCostoVenta?.Nombre ?? "No asignada")</p>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 bg-light rounded-3 border-start border-success border-3">
                                        <label class="text-muted tiny fw-bold text-uppercase d-block mb-1">Ventas (Ingreso)</label>
                                        <span class="fw-bold fs-12">@(Model.CuentaIngreso?.Codigo ?? "-")</span>
                                        <p class="tiny text-truncate mb-0">@(Model.CuentaIngreso?.Nombre ?? "No asignada")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="ti ti-arrow-left me-1"></i> VOLVER AL CATÁLOGO
                </a>
                <a asp-action="Kardex" asp-route-id="@Model.Id" class="btn btn-dark px-4 shadow-sm">
                    <i class="ti ti-history me-1"></i> VER REPORTE KARDEX
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-12 { font-size: 0.75rem; }
    .fs-13 { font-size: 0.8125rem; }
</style>
