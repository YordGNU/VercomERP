@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@model IEnumerable<Vercom.Models.Producto>

@{
    ViewBag.Title = "Catálogo de Productos";
    var totalItems = Model.Count();
    var activos = Model.Count(p => p.Activo);
    var inactivos = totalItems - activos;
    var puedeEliminar = (await AuthorizationService.AuthorizeAsync(User, "INVENTARIO.PRODUCTO.ELIMINAR")).Succeeded;
    var puedeCrear = (await AuthorizationService.AuthorizeAsync(User, "INVENTARIO.PRODUCTO.CREAR")).Succeeded;

    var headerActions = (puedeCrear
        ? "<a href='" + Url.Action("create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> Nuevo Producto</a>"
        : null);
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Catálogo de Inventario", Title = "Maestro de Productos e Insumos", Subtitle = "Catálogo centralizado para inventario, producción y ventas.", Icon = "ti-box", Tone = "primary", BadgeText = totalItems.ToString("N0"), BadgeTone = "primary", ActionsHtml = headerActions != null ? new Microsoft.AspNetCore.Html.HtmlString(headerActions) : null }; }
<partial name='_PageHeader' model='pageHeader' />

<!-- ============================================================ -->
<!-- ESTADÍSTICAS RÁPIDAS -->
<!-- ============================================================ -->
@{ var kpiTotal = new Vercom.ViewModels.KpiCardModel { Label = "Total productos", Value = totalItems.ToString("N0"), Icon = "ti-box", Tone = "primary" }; var kpiActivos = new Vercom.ViewModels.KpiCardModel { Label = "Activos", Value = activos.ToString("N0"), Icon = "ti-check", Tone = "success" }; var kpiInactivos = new Vercom.ViewModels.KpiCardModel { Label = "Inactivos", Value = inactivos.ToString("N0"), Icon = "ti-x", Tone = "danger" }; }
<div class='row g-2 mb-3'>
    <div class='col-md-4 col-6'>
        <partial name='_KpiCard' model='kpiTotal' />
    </div>
    <div class='col-md-4 col-6'>
        <partial name='_KpiCard' model='kpiActivos' />
    </div>
    <div class='col-md-4 col-6'>
        <partial name='_KpiCard' model='kpiInactivos' />
    </div>
</div><!-- TABLA PRINCIPAL -->
<!-- ============================================================ -->
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2 py-3">
                <h5 class="m-0 fw-bold d-flex align-items-center gap-2">
                    <i class="ti ti-list text-primary"></i>
                    Artículos Registrados
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-normal">@totalItems</span>
                </h5>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="text-muted small d-none d-md-inline">Filtrar:</span>

                    <!-- Filtro por Tipo -->
                    <div style="min-width: 160px;">
                        <select id="filterTipo" class="form-select form-select-sm">
                            <option value="">Todos los tipos</option>
                            <option value="TERMINADO">Terminado</option>
                            <option value="INSUMO">Insumo</option>
                            <option value="ELABORADO">Elaborado</option>
                            <option value="MATERIA_PRIMA">Materia Prima</option>
                            <option value="MERCANCIA">Mercancía</option>
                            <option value="SERVICIO">Servicio</option>
                        </select>
                    </div>

                    <!-- Filtro por Estado -->
                    <div style="min-width: 140px;">
                        <select id="filterEstado" class="form-select form-select-sm">
                            <option value="">Todos los estados</option>
                            <option value="ACTIVO">Activos</option>
                            <option value="INACTIVO">Inactivos</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <!-- Barra de acciones para seleccionados -->
                @if (puedeEliminar)
                {
                    <div class="row align-items-end g-2 mb-3">
                        <div class="col-md-6">
                            <span id="selectedCount" class="text-muted small">
                                <i class="ti ti-checkbox me-1"></i> Ningún producto seleccionado
                            </span>
                        </div>
                        <div class="col-md-6 text-end">
                            <button type="button" id="deleteSelected" class="btn btn-danger btn-sm" disabled>
                                <i class="ti ti-trash me-1"></i> Eliminar seleccionados
                            </button>
                        </div>
                    </div>
                }
                <!-- Token antiforgery para AJAX -->
                @Html.AntiForgeryToken()
                <table id="productsTable" class="table table-striped table-hover dt-responsive mb-0 w-100">
                    <thead class="thead-sm text-uppercase fs-xxs bg-light">
                        <tr>
                            <th class="text-center">
                                <input type="checkbox" id="selectAll" class="form-check-input" />
                            </th>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Familia</th>
                            <th class="text-center">U/M</th>
                            <th class="text-end">Precio</th>
                            <th class="text-center">Tipo</th>
                            <th class="text-center">Estado</th>
                            <th style="width: 120px;" class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var typeClass = item.Tipo switch
                            {
                                "TERMINADO" => "badge-soft-success",
                                "INSUMO" => "badge-soft-info",
                                "ELABORADO" => "badge-soft-warning",
                                "MATERIA_PRIMA" => "badge-soft-secondary",
                                "MERCANCIA" => "badge-soft-primary",
                                "SERVICIO" => "badge-soft-purple",
                                _ => "badge-soft-secondary"
                            };

                            <tr>
                                <td>
                                    <input type="checkbox" class="row-checkbox form-check-input" data-id="@item.Id" />
                                </td>
                                <td class="fw-bold text-primary">@item.Codigo</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-xs bg-light rounded-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px;">
                                            <i class="ti ti-package-export fs-16 text-muted"></i>
                                        </div>
                                        <span class="fw-semibold text-truncate" style="max-width: 200px;">@item.Nombre</span>
                                    </div>
                                </td>
                                <td><span class="small text-muted">@item.Familia?.Nombre</span></td>
                                <td class="text-center small fw-bold">@item.UnidadMedida?.Codigo</td>
                                <td class="text-end fw-bold text-success">@item.PrecioVentaActual?.ToString("N2")</td>
                                <td>
                                    <span class="badge @typeClass">@item.Tipo</span>
                                </td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge badge-soft-success">
                                            <i class="ti ti-circle-check me-1"></i> ACTIVO
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-danger">
                                            <i class="ti ti-circle-x me-1"></i> INACTIVO
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-soft-primary btn-icon btn-sm rounded-circle" title="Detalles">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-soft-warning btn-icon btn-sm rounded-circle" title="Editar">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        @if (puedeEliminar)
                                        {
                                            <button type="button"
                                                    class="btn btn-soft-danger btn-icon btn-sm rounded-circle delete-single"
                                                    data-id="@item.Id"
                                                    data-nombre="@item.Nombre"
                                                    title="Eliminar">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/plugins/toastr/toastr.min.js"></script>
    <link href="~/css/plugins/toastr/toastr.min.css" rel="stylesheet" />

    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: "5000",
            extendedTimeOut: "2000"
        };

        $(document).ready(function () {
            // ============================================================
            // 1. INICIALIZACIÓN DE DATATABLE
            // ============================================================
            var table = $('#productsTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                pageLength: 100,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
                columnDefs: [
                    { targets: [0], orderable: false, searchable: false, className: 'text-center' },
                    {
                        targets: [5], type: 'numeric', className: 'text-end',
                        render: function (data) {
                            if (typeof data === 'string') return parseFloat(data.replace(/[$,]/g, '')) || 0;
                            return data || 0;
                        }
                    },
                    { targets: [6, 7], orderable: true, searchable: true },
                    { targets: [8], orderable: false, searchable: false, className: 'text-center' }
                ],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
                autoWidth: false,
                responsive: true,
                drawCallback: function () {
                    updateSelectedCount();
                    updateDeleteButtonState();
                }
            });

            // ============================================================
            // 2. FILTROS PERSONALIZADOS (Tipo + Estado)
            // ============================================================
            $.fn.dataTable.ext.search.push(function (settings, data) {
                var filterTipo = $('#filterTipo').val();
                if (filterTipo && data[6] !== filterTipo) return false;
                return true;
            });

            $.fn.dataTable.ext.search.push(function (settings, data) {
                var filterEstado = $('#filterEstado').val();
                if (filterEstado) {
                    var estadoActual = data[7].includes('ACTIVO') ? 'ACTIVO' : 'INACTIVO';
                    if (estadoActual !== filterEstado) return false;
                }
                return true;
            });

            $('#filterTipo, #filterEstado').on('change', function () {
                table.draw();
            });

            // ============================================================
            // 3. MANEJO DE CHECKBOXES
            // ============================================================
            $('#selectAll').on('change', function () {
                var isChecked = $(this).prop('checked');
                $('.row-checkbox').prop('checked', isChecked);
                updateSelectedCount();
                updateDeleteButtonState();
            });

            $('#productsTable').on('change', '.row-checkbox', function () {
                var total = $('.row-checkbox').length;
                var checked = $('.row-checkbox:checked').length;
                $('#selectAll').prop('checked', total > 0 && checked === total);
                updateSelectedCount();
                updateDeleteButtonState();
            });

            // ============================================================
            // 4. FUNCIONES AUXILIARES
            // ============================================================
            function updateSelectedCount() {
                var count = $('.row-checkbox:checked').length;
                if (count === 0) {
                    $('#selectedCount').html('<i class="ti ti-checkbox me-1"></i> Ningún producto seleccionado');
                } else {
                    $('#selectedCount').html('<i class="ti ti-checkbox me-1"></i> ' + count + ' producto(s) seleccionado(s)');
                }
            }

            function updateDeleteButtonState() {
                var count = $('.row-checkbox:checked').length;
                $('#deleteSelected').prop('disabled', count === 0);
            }

            function getSelectedIds() {
                var ids = [];
                $('.row-checkbox:checked').each(function () {
                    ids.push($(this).data('id'));
                });
                return ids;
            }

            // ============================================================
            // 5. ELIMINACIÓN EN LOTE
            // ============================================================
            $('#deleteSelected').on('click', function () {
                var selectedIds = getSelectedIds();
                if (selectedIds.length === 0) return;

                Swal.fire({
                    title: '¿Eliminar productos seleccionados?',
                    text: `Se eliminarán ${selectedIds.length} producto(s). Esta acción no se puede deshacer.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: `Sí, eliminar (${selectedIds.length})`,
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        var token = $('input[name="__RequestVerificationToken"]').val();

                        $.ajax({
                            url: '@Url.Action("DeleteSelected", "Producto")',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ ids: selectedIds }),
                            headers: { 'RequestVerificationToken': token },
                            beforeSend: function () {
                                $('#deleteSelected').prop('disabled', true).html(
                                    '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Eliminando...'
                                );
                            },
                            success: function (response) {
                                if (response.success) {
                                    toastr.success(response.message);
                                    setTimeout(function () { location.reload(); }, 1000);
                                } else {
                                    toastr.error(response.message);
                                }
                            },
                            error: function () {
                                toastr.error('Error al eliminar los productos seleccionados.');
                            },
                            complete: function () {
                                $('#deleteSelected').prop('disabled', false).html(
                                    '<i class="ti ti-trash me-1"></i> Eliminar seleccionados'
                                );
                            }
                        });
                    }
                });
            });

            // ============================================================
            // 6. ELIMINACIÓN INDIVIDUAL
            // ============================================================
            $('#productsTable').on('click', '.delete-single', function () {
                var id = $(this).data('id');
                var nombre = $(this).data('nombre');
                var row = $(this).closest('tr');
                var $btn = $(this);

                Swal.fire({
                    title: `¿Eliminar "${nombre}"?`,
                    text: 'Esta acción no se puede deshacer.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        var token = $('input[name="__RequestVerificationToken"]').val();

                        $.ajax({
                            url: '@Url.Action("Delete", "Producto")',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ id: id }),
                            headers: { 'RequestVerificationToken': token },
                            beforeSend: function () {
                                $btn.prop('disabled', true).html(
                                    '<span class="spinner-border spinner-border-sm"></span>'
                                );
                            },
                            success: function (response) {
                                if (response.success) {
                                    toastr.success(response.message);
                                    table.row(row).remove().draw();
                                    updateSelectedCount();
                                    updateDeleteButtonState();
                                } else {
                                    toastr.error(response.message);
                                    $btn.prop('disabled', false).html('<i class="ti ti-trash"></i>');
                                }
                            },
                            error: function () {
                                toastr.error('Error al eliminar el producto.');
                                $btn.prop('disabled', false).html('<i class="ti ti-trash"></i>');
                            }
                        });
                    }
                });
            });

            // ============================================================
            // 7. ESTADO INICIAL
            // ============================================================
            updateSelectedCount();
            updateDeleteButtonState();
        });
    </script>
}