@model Vercom.ViewModels.AttendanceMonthlyReportViewModel
@{
    ViewBag.Title = "Reporte Mensual Consolidado de Asistencia";
    var culture = System.Globalization.CultureInfo.CurrentCulture;
    var nombreMes = culture.DateTimeFormat.GetMonthName(Model.Mes);
}

@{ var exportUrl = Url.Action("ExportMensual", new { year = Model.Anio, month = Model.Mes, sucursalId = Model.SucursalId }); var headerActions = "<a href='" + exportUrl + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> EXPORTAR CSV</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Reporte Consolidado de Asistencia - " + nombreMes + " " + Model.Anio, Subtitle = "Resumen mensual para control interno. El subsidio es estimado y no sustituye la liquidación de nómina.", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="card shadow-sm border-0 mb-4 d-print-none">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold">Año</label>
                <select name="year" class="form-select">
                    @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++)
                    {
                        <!option value="@y" @(y == Model.Anio ? "selected" : "")>@y</!option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Mes</label>
                <select name="month" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <!option value="@m" @(m == Model.Mes ? "selected" : "")>@culture.DateTimeFormat.GetMonthName(m)</!option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold">Sucursal</label>
                <select name="sucursalId" class="form-select" asp-items="ViewBag.Sucursales">
                    <option value="">-- Todas las Sucursales --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="ti ti-search me-1"></i> FILTRAR</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle fs-12">
                <thead class="table-light text-uppercase text-center">
                    <tr>
                        <th class="text-start ps-3" style="min-width: 220px;">Apellidos y Nombres</th>
                        <th style="min-width: 130px;">Cargo</th>
                        <th class="bg-success-subtle">Asistencias</th>
                        <th class="bg-info-subtle">Horas Extra</th>
                        <th class="bg-warning-subtle">Vacaciones</th>
                        <th class="bg-warning-subtle">Incapacidad</th>
                        <th class="bg-warning-subtle">Otras Ausencias</th>
                        <th class="bg-danger-subtle">Retardos</th>
                        <th class="bg-danger-subtle">Salidas Tempranas</th>
                        <th class="bg-secondary-subtle">Subsidio estimado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">@row.NombreCompleto</td>
                            <td class="text-muted">@row.Cargo</td>
                            <td class="text-center fw-bold text-success">@row.Asistencias</td>
                            <td class="text-center fw-bold text-info">@row.HorasExtra.ToString("0.##")</td>
                            <td class="text-center fw-bold text-warning">@row.Vacaciones</td>
                            <td class="text-center fw-bold text-warning">@row.Incapacidades</td>
                            <td class="text-center fw-bold text-warning">@row.OtrasAusencias</td>
                            <td>
                                @if (row.CantidadRetardos > 0)
                                {
                                    <span class="badge bg-danger">@row.CantidadRetardos (@row.MinutosRetardo min)</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td>
                                @if (row.CantidadSalidasTempranas > 0)
                                {
                                    <span class="badge bg-danger">@row.CantidadSalidasTempranas</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-center font-monospace">@row.ImporteSubsidio.ToString("N2")</td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">No hay trabajadores para los filtros seleccionados.</td>
                        </tr>
                    }
                </tbody>
                @if (Model.Rows.Any())
                {
                    <tfoot class="table-light fw-bold text-center">
                        <tr>
                            <td class="text-end ps-3" colspan="2">TOTALES (@Model.Rows.Count trabajadores)</td>
                            <td class="text-success">@Model.TotalAsistencias</td>
                            <td class="text-info">@Model.TotalHorasExtra.ToString("0.##")</td>
                            <td class="text-warning">@Model.TotalVacaciones</td>
                            <td class="text-warning">@Model.TotalIncapacidades</td>
                            <td class="text-warning">@Model.TotalOtrasAusencias</td>
                            <td class="text-danger">@Model.TotalCantidadRetardos (@Model.TotalMinutosRetardo min)</td>
                            <td class="text-danger">@Model.TotalSalidasTempranas</td>
                            <td class="font-monospace">@Model.TotalSubsidio.ToString("N2")</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>

        <div class="row mt-5 pt-4 border-top d-none d-print-flex">
            <div class="col-4 text-center">
                <div class="border-top border-dark pt-2 fw-bold">Elaborado por (RR.HH.)</div>
            </div>
            <div class="col-4 text-center">
                <div class="border-top border-dark pt-2 fw-bold">Revisado (Control Interno)</div>
            </div>
            <div class="col-4 text-center">
                <div class="border-top border-dark pt-2 fw-bold">Aprobado (Dirección)</div>
            </div>
        </div>
    </div>
</div>

<style>
    .fs-12 { font-size: 0.75rem; }

    @@media print {
        .d-print-flex { display: flex !important; }
    }
</style>
