@model IEnumerable<Vercom.Models.TipoMovimiento>
@{
    ViewBag.Title = "Tipos de Movimiento";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Logística: Tipos de Movimiento de Inventario</h4>
        <p class="text-muted small mb-0">Nomenclador de operaciones de almacén (Entradas, Salidas, Ajustes y Transferencias).</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Inventario</a></li>
            <li class="breadcrumb-item active">Configuración</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle">
            <h5 class="m-0 fw-bold"><i class="ti ti-settings-automation me-2 text-primary"></i>Nomenclador Logístico</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="movementTypesTable" class="table table-striped dt-responsive mb-0">
                <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th class="ps-4">Código</th>
                            <th>Nombre de la Operación</th>
                            <th class="text-center">Naturaleza</th>
                            <th class="text-center">Afecta Costo</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(x => x.Naturaleza))
                        {
                            var natColor = item.Naturaleza == "ENTRADA" ? "success" : (item.Naturaleza == "SALIDA" ? "danger" : "info");
                            <tr>
                                <td class="ps-4">
                                    <code class="fw-bold fs-13 text-primary">@item.Codigo</code>
                                </td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td >
                                    <span class="badge badge-soft-@natColor px-3">@item.Naturaleza</span>
                                </td>
                                <td >
                                    @if(item.AfectaCosto) { <i class="ti ti-check text-success" title="Actualiza PPP"></i> }
                                    else { <i class="ti ti-minus text-muted" title="Informativo"></i> }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-list justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#movementTypesTable').DataTable({
                language: { url: '/js/i18n/es-ES.json' },
                order: [[2, 'asc']]
            });
        });
    </script>
}

<style>
    .fs-13 { font-size: 0.8125rem; }
</style>
