@model Vercom.Models.Rol
@{
    ViewBag.Title = "Definir Nuevo Rol";
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Roles</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Administración", Title = "Crear Nuevo Perfil de Acceso", Subtitle = "Define el nombre, código y propósito del rol según la política de roles de la organización.", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row justify-content-center">
    <div class="col-lg-7">
        <form asp-action="Create" method="post" id="createRolForm">
            @Html.AntiForgeryToken()

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light-subtle d-flex align-items-center gap-2">
                    <i class="ti ti-shield-plus fs-18 text-primary"></i>
                    <h5 class="m-0 fw-bold">Datos del rol</h5>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>

                    <label class="form-label fw-bold small text-uppercase text-muted">Identificación</label>
                    <div class="row g-3 mb-4">
                        <div class="col-md-5">
                            <label class="form-label fw-bold">Código del Sistema</label>
                            <input asp-for="Codigo" class="form-control fw-bold text-primary text-uppercase" placeholder="Ej: CONTADOR_GENERAL" required maxlength="30" />
                            <span asp-validation-for="Codigo" class="text-danger small"></span>
                            <div class="text-muted tiny mt-1"><i class="ti ti-info-circle me-1"></i>Único, en mayúsculas y sin espacios. No se puede modificar después.</div>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label fw-bold">Nombre Descriptivo</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Especialista Contable" required maxlength="100" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                    </div>

                    <label class="form-label fw-bold small text-uppercase text-muted">Propósito</label>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Descripción / Objetivo</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Define el alcance de este perfil y el área que cubre..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            @if (User.IsInRole("MASTER"))
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light-subtle d-flex align-items-center gap-2">
                        <i class="ti ti-shield-lock fs-18 text-danger"></i>
                        <h5 class="m-0 fw-bold">Protección del rol</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch d-flex align-items-center gap-2 m-0">
                            <input class="form-check-input m-0" type="checkbox" asp-for="EsSistema">
                            <label class="form-check-label fw-bold text-danger" asp-for="EsSistema">Rol de Sistema (Protegido)</label>
                        </div>
                        <p class="text-muted small mb-0 mt-2">Si se marca, el rol se considerará parte del núcleo del sistema y los administradores no podrán eliminarlo.</p>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">CANCELAR</a>
                <button type="submit" class="btn btn-primary px-5 fw-bold shadow">
                    <i class="ti ti-device-floppy me-1"></i> GUARDAR ROL
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            window.SubmitAjaxForm('createRolForm');
        });
    </script>
}