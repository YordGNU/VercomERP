@model Vercom.Models.Rol
@{
    ViewBag.Title = "Definir Nuevo Rol";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Crear Nuevo Perfil de Acceso</h4>
        <p class="text-muted small mb-0">Definición de roles para la segregación de funciones en la organización.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Seguridad</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Roles</a></li>
            <li class="breadcrumb-item active">Crear</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle">
                    <h5 class="m-0 fw-bold"><i class="ti ti-shield-plus me-2 text-primary"></i>Datos del Rol</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-4">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Código del Sistema</label>
                            <input asp-for="Codigo" class="form-control fw-bold text-primary text-uppercase" placeholder="Ej: CONTADOR_GENERAL" required maxlength="30" />
                            <small class="text-muted">Identificador único e inalterable para auditorías.</small>
                            <span asp-validation-for="Codigo" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Nombre Descriptivo</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Especialista Contable" required maxlength="100" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Descripción / Objetivo</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Defina el alcance de este perfil..."></textarea>
                        </div>

                        @if (User.IsInRole("MASTER"))
                        {
                            <div class="col-12">
                                <div class="form-check form-switch p-3 bg-light-subtle border rounded-3">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="EsSistema">
                                    <label class="form-check-label fw-bold text-danger">Rol de Sistema (Protegido)</label>
                                    <p class="text-muted small mb-0 mt-1">Si se marca, el rol no podrá ser eliminado por usuarios administrativos.</p>
                                </div>
                            </div>
                        }

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR ROL
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
