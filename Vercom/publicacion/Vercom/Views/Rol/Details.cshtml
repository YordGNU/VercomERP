@model Vercom.Models.Rol
@{
    ViewBag.Title = "Detalle del Rol";
}

@{ var headerActions = "<a href='" + Url.Action("Edit") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> CAMBIAR NOMBRE</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Administración", Title = "Perfil: " + Model.Nombre, Subtitle = "Código del Sistema: @Model.Codigo", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row g-4">
    <div class="col-lg-3">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4 text-center">
                <div class="avatar avatar-xl bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3 mx-auto" style="margin-left:0;width:80px;height:80px;">
                    <i class="ti ti-shield-half fs-40"></i>
                </div>
                <h3 class="fw-bold mb-1 text-truncate" title="@Model.Nombre">@Model.Nombre</h3>
                <p class="font-monospace text-muted tiny mb-2">@Model.Codigo</p>
                <p class="text-muted small mb-0">@(Model.Descripcion ?? "Perfil de acceso corporativo.")</p>

                <div class="mt-4 pt-3 border-top">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="bg-light-subtle rounded py-2">
                                <div class="fw-bold text-primary">@Model.Permisos.Count</div>
                                <div class="text-muted tiny fw-bold text-uppercase">Permisos</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bg-light-subtle rounded py-2">
                                <div class="fw-bold text-primary">@Model.UsuarioRols.Count</div>
                                <div class="text-muted tiny fw-bold text-uppercase">Usuarios</div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.EsSistema)
                {
                    <div class="alert alert-danger py-2 mt-4 mb-0 small">
                        <i class="ti ti-lock me-1"></i> ROL PROTEGIDO (SISTEMA)
                    </div>
                }
            </div>
        </div>

        <div class="card bg-dark text-white border-0 shadow-sm">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3 fs-16"><i class="ti ti-help me-2"></i>Segregación de Funciones</h4>
                <p class="small opacity-75 mb-0">Cumpliendo con la Resolución 60/2011, los roles definen los límites operativos para evitar conflictos de interés en la organización.</p>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold"><i class="ti ti-list-check me-2 text-primary"></i>Matriz de Capacidades Habilitadas</h5>
                @if (Model.Permisos.Any())
                {
                    <span class="badge bg-primary-subtle text-primary">
                        <i class="ti ti-key me-1"></i>@Model.Permisos.Count capacidades
                    </span>
                }
            </div>
            <div class="card-body">
                @if (Model.Permisos.Any())
                {
                    var groups = Model.Permisos.GroupBy(p => p.Modulo).OrderBy(g => g.Key);
                    <div class="row row-cards">
                        @foreach (var g in groups)
                        {
                            <div class="col-md-6 col-xl-4">
                                <div class="card card-sm shadow-none border-light h-100">
                                    <div class="card-status-top bg-primary"></div>
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary-subtle text-primary p-2 rounded me-2">
                                                    <i class="ti ti-layout-grid fs-16"></i>
                                                </div>
                                                <h6 class="m-0 fw-bold text-uppercase tiny">@g.Key</h6>
                                            </div>
                                            <span class="badge bg-light text-muted">@g.Count()</span>
                                        </div>
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var p in g.OrderBy(x => x.Codigo))
                                            {
                                                <li class="d-flex align-items-start mb-2">
                                                    <i class="ti ti-circle-check-filled text-success mt-1 me-2 fs-12"></i>
                                                    <span class="fs-12 text-muted" title="@p.Codigo">@(p.Descripcion ?? p.Codigo)</span>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="avatar avatar-xl bg-warning-subtle text-warning rounded-circle mb-3 mx-auto">
                            <i class="ti ti-alert-triangle fs-48"></i>
                        </div>
                        <h4 class="fw-bold">Sin capacidades asignadas</h4>
                        <p class="text-muted px-5">Este rol está actualmente vacío y no otorga acceso a ninguna funcionalidad del ERP.</p>
                        <a asp-action="ManagePermissions" asp-route-id="@Model.Id" class="btn btn-warning mt-3">CONFIGURAR AHORA</a>
                    </div>
                }                
            </div>
            <div class="card-footer text-end">
               <a asp-action="Index" class="btn btn-sm btn-secondary px-4">
                   <i class="ti ti-arrow-left me-1"></i> VOLVER AL LISTADO
                   </a>
            </div>
        </div>      
    </div>
</div>