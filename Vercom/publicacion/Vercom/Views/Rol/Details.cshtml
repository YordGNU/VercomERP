@model Vercom.Models.Rol
@{
    ViewBag.Title = "Configuración de Rol";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Rol: @Model.Nombre</h4>
        <p class="text-muted small mb-0">Código del Sistema: <span class="badge bg-light text-dark font-monospace">@Model.Codigo</span></p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Seguridad</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Roles</a></li>
            <li class="breadcrumb-item active">Detalle</li>
        </ol>
        <div class="btn-list">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                <i class="ti ti-edit me-1"></i> CAMBIAR NOMBRE
            </a>
            <a asp-action="ManagePermissions" asp-route-id="@Model.Id" class="btn btn-sm btn-warning shadow-sm">
                <i class="ti ti-lock-access me-1"></i> CONFIGURAR PERMISOS
            </a>
        </div>
    </div>
</div>

<div class="container-xxl">
    <div class="row">
        <!-- Resumen del Rol -->
        <div class="col-lg-3">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4 text-center">
                    <div class="avatar avatar-xl bg-primary-subtle text-primary rounded-circle mb-3 mx-auto" style="width: 80px; height: 80px;">
                        <i class="ti ti-shield-half fs-40"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.Nombre</h3>
                    <p class="text-muted small">@(Model.Descripcion ?? "Perfil de acceso corporativo.")</p>

                    <div class="mt-4 pt-3 border-top">
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="bg-light-subtle rounded py-2">
                                    <div class="fw-bold text-primary">@Model.Permisos.Count</div>
                                    <div class="text-muted tiny fw-bold text-uppercase">Permisos</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light-subtle rounded py-2">
                                    <div class="fw-bold text-primary">@Model.UsuarioRols.Count</div>
                                    <div class="text-muted tiny fw-bold text-uppercase">Usuarios</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if(Model.EsSistema)
                    {
                        <div class="alert alert-danger py-2 mt-4 mb-0 small">
                            <i class="ti ti-lock me-1"></i> ROL PROTEGIDO (SISTEMA)
                        </div>
                    }
                </div>
            </div>

            <div class="card bg-dark text-white border-0 shadow-sm">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3"><i class="ti ti-help me-2"></i>Segregación de Funciones</h4>
                    <p class="small opacity-75">Cumpliendo con la Resolución 60/2011, los roles definen los límites operativos para evitar conflictos de interés en la organización.</p>
                </div>
            </div>
        </div>

        <!-- Matriz de Permisos -->
        <div class="col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle d-flex justify-content-between">
                    <h5 class="m-0 fw-bold"><i class="ti ti-list-check me-2 text-primary"></i>Matriz de Capacidades Habilitadas</h5>
                </div>
                <div class="card-body">
                    @if (Model.Permisos.Any())
                    {
                        var groups = Model.Permisos.GroupBy(p => p.Modulo).OrderBy(g => g.Key);
                        <div class="row row-cards">
                            @foreach (var g in groups)
                            {
                                <div class="col-md-6 col-xl-4">
                                    <div class="card card-sm shadow-none border-light h-100">
                                        <div class="card-status-top bg-primary"></div>
                                        <div class="card-body p-3">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="bg-primary-subtle text-primary p-2 rounded me-2">
                                                    <i class="ti ti-layout-grid fs-16"></i>
                                                </div>
                                                <h6 class="m-0 fw-bold text-uppercase tiny">@g.Key</h6>
                                            </div>
                                            <ul class="list-unstyled mb-0">
                                                @foreach (var p in g.OrderBy(x => x.Codigo))
                                                {
                                                    <li class="d-flex align-items-start mb-2">
                                                        <i class="ti ti-circle-check-filled text-success mt-1 me-2 fs-12"></i>
                                                        <span class="fs-12 text-muted" title="@p.Codigo">@(p.Descripcion ?? p.Codigo)</span>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="avatar avatar-xl bg-warning-subtle text-warning rounded-circle mb-3 mx-auto">
                                <i class="ti ti-alert-triangle fs-48"></i>
                            </div>
                            <h4 class="fw-bold">Sin capacidades asignadas</h4>
                            <p class="text-muted px-5">Este rol está actualmente vacío y no otorga acceso a ninguna funcionalidad del ERP.</p>
                            <a asp-action="ManagePermissions" asp-route-id="@Model.Id" class="btn btn-warning mt-3">CONFIGURAR AHORA</a>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="ti ti-arrow-left me-1"></i> VOLVER AL LISTADO
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .tiny { font-size: 0.7rem; letter-spacing: 0.05em; }
    .fs-12 { font-size: 0.75rem; }
</style>
