@model Vercom.ViewModels.RolPermissionsViewModel
@{
    ViewBag.Title = "Seguridad - Permisos de Rol";
}

<div class="page-title-head d-flex align-items-center">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">@Model.Title: <span class="text-primary">@Model.Rol.Nombre</span></h4>
    </div>
</div>

<div class="row mt-4">
    <form asp-action="ManagePermissions" method="post" id="managePermissionsForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Rol.Id" />

        <div class="row">
            @foreach (var module in Model.Modules.OrderBy(m => m.ModuleName))
            {
                <div class="col-md-6 col-xl-4 mb-4">
                    <div class="card h-100 shadow-sm border-top border-primary border-3">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0 text-uppercase small fw-bold">@module.ModuleName</h5>
                            <span class="badge bg-primary-subtle text-primary">@module.Permissions.Count(p => p.IsSelected) / @module.Permissions.Count</span>
                        </div>
                        <div class="card-body">
                            @foreach (var perm in module.Permissions.OrderBy(p => p.Codigo))
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="selectedPermissions" value="@perm.Id" id="perm_@perm.Id" @(perm.IsSelected ? "checked" : "")>
                                    <label class="form-check-label" for="perm_@perm.Id">
                                        <span class="fw-bold d-block small">@perm.Codigo</span>
                                        <span class="text-muted extra-small">@perm.Descripcion</span>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="card sticky-bottom shadow-lg border-0 mb-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <p class="mb-0 text-muted italic">RF-02: La asignación de permisos es auditada de forma inmutable (RF-03).</p>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                    <button type="submit" class="btn btn-primary px-5 fw-bold">
                        <i class="ti ti-shield-check me-1"></i> ACTUALIZAR MATRIZ DE ACCESO
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('managePermissionsForm');
        });
    </script>
}
