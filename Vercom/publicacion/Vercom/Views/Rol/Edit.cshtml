@model Vercom.Models.Rol
@{
    ViewBag.Title = "Modificar Rol";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1 me-3">
        <h4 class="page-main-title m-0 fw-bold">Editar Perfil: @Model.Nombre</h4>
        <p class="text-muted small mb-0">Actualiza los datos descriptivos del rol. El código, referente de auditoría, permanece fijo.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Seguridad</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Roles</a></li>
            <li class="breadcrumb-item active">Editar</li>
        </ol>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        @if (Model.EsSistema)
        {
            <div class="alert alert-danger d-flex align-items-start shadow-sm" role="alert">
                <i class="ti ti-lock fs-18 me-2 mt-1"></i>
                <div><span class="fw-bold">Rol de sistema.</span> Los cambios quedan auditados; solo un Administrador Global ve los campos de protección.</div>
            </div>
        }

        <form asp-action="Edit" method="post" id="editRolForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light-subtle d-flex align-items-center gap-2">
                    <i class="ti ti-edit fs-18 text-primary"></i>
                    <h5 class="m-0 fw-bold">Actualización de datos</h5>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-4 shadow-sm"></div>

                    <label class="form-label fw-bold small text-uppercase text-muted">Identificación</label>
                    <div class="row g-3 mb-4">
                        <div class="col-md-5">
                            <label class="form-label fw-bold">Código Interno</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="ti ti-lock text-muted"></i></span>
                                <input asp-for="Codigo" class="form-control fw-bold bg-light font-monospace" readonly />
                            </div>
                            <span asp-validation-for="Codigo" class="text-danger small"></span>
                            <div class="text-muted tiny mt-1"><i class="ti ti-info-circle me-1"></i>No editable para preservar la integridad de la auditoría.</div>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label fw-bold">Nombre del Rol</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Especialista Contable" required maxlength="100" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                    </div>

                    <label class="form-label fw-bold small text-uppercase text-muted">Propósito</label>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Descripción</label>
                            <textarea asp-for="Descripcion" name="Descripcion" class="form-control" rows="3" placeholder="Describe el alcance y las funciones que habilita este perfil...">@Model.Descripcion</textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            @if (User.IsInRole("MASTER"))
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light-subtle d-flex align-items-center gap-2">
                        <i class="ti ti-shield-lock fs-18 text-danger"></i>
                        <h5 class="m-0 fw-bold">Protección del rol</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch d-flex align-items-center gap-2 m-0">
                            <input class="form-check-input m-0" type="checkbox" asp-for="EsSistema">
                            <label class="form-check-label fw-bold text-danger" asp-for="EsSistema">Rol de Sistema (Protegido)</label>
                        </div>
                        <p class="text-muted small mb-0 mt-2">@(Model.EsSistema ? "Este rol está protegido por el núcleo y no puede ser eliminado ni modificado por administradores regulares." : "Marque para proteger este rol contra eliminaciones accidentales.")</p>
                    </div>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="EsSistema" />
            }

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">CANCELAR</a>
                <button type="submit" class="btn btn-primary px-5 fw-bold shadow">
                    <i class="ti ti-device-floppy me-1"></i> GUARDAR CAMBIOS
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            window.SubmitAjaxForm('editRolForm');
        });
    </script>
}