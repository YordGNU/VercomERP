@model IEnumerable<Vercom.Models.Entidad>
@{ ViewBag.Title = "Consola de Entidades"; }

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Administración", Title = "Administración Global (Multi-entidad)", Subtitle = "Gestión de entidades y configuración multi-empresa.", Icon = "ti-building", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />

<div class="row mt-4">
    <div class="card">
        <div class="card-body">
            <table id="tablaEntidad" class="table table-striped table-hover dt-responsive">
            <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th>Razón Social / Empresa</th>
                        <th>NIT</th>
                        <th>Provincia</th>
                        <th>Moneda</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.RazonSocial</td>
                            <td><code>@item.Nit</code></td>
                            <td>@item.Provincia</td>
                            <td><span class="badge bg-dark">@item.MonedaBase</span></td>
                            <td>
                                <span class="badge @(item.Activo ? "bg-success" : "bg-danger")">@(item.Activo ? "Activa" : "Suspendida")</span>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light"><i class="ti ti-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light"><i class="ti ti-edit"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
     $(document).ready(function () {
            $("#tablaEntidad").DataTable({
                pageLength: 25,
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
                responsive: true,
            });
        });
    </script>
}
