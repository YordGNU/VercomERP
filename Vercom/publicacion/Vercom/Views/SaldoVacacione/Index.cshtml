@model Vercom.ViewModels.VacationSubledgerViewModel
@{
    ViewBag.Title = Model.Title;
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Recursos Humanos", Title = "@Model.Title (9.09%)", Subtitle = "", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table id="dataTable" class="table table-striped table-hover dt-responsive">
                <thead class="table-dark">
                    <tr>
                        <th>Trabajador</th>
                        <th>Año Fiscal</th>
                      <th>Días Acumulados</th>
                      <th>Días Disfrutados</th>
                      <th>Días Compensados</th>
                        <th class="text-center bg-primary">SALDO ACTUAL</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Saldos)
                    {
                        <tr>
                            <td class="fw-bold">@item.Empleado.Apellidos, @item.Empleado.Nombres</td>
                            <td>@item.Anio</td>
                            <td >@item.DiasAcumulados.ToString("N2")</td>
                            <td >@item.DiasDisfrutados.ToString("N2")</td>
                            <td >@item.DiasCompensados.ToString("N2")</td>
                            <td class="fw-bold text-primary">@(item.SaldoActual?.ToString("N2") ?? "0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="alert alert-info mt-4 py-2 small border-0 shadow-sm">
        <i class="ti ti-info-circle me-1"></i> RF-21: La acumulación de vacaciones se calcula automáticamente basándose en los días efectivamente trabajados (0.0909 por día).
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
            });
        });
    </script>
}
