@model IEnumerable<Vercom.Models.TipoAusencium>
@{
    ViewBag.Title = "Nomenclador de Ausencias";
}
<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Nomenclador: Causas de Incidencia Laboral</h4>
        <p class="text-muted small mb-0">Definición de tipos de ausencias, licencias y suspensiones para el control de asistencia (RF-21).</p>
    </div>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus me-1"></i> NUEVO TIPO
        </a>
    </div>
</div>
<div class="row">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle">
            <h5 class="m-0 fw-bold"><i class="ti ti-id-badge-2 me-2 text-primary"></i>Catálogo de Incidencias</h5>
        </div>
        <div class="card-body">
            <table id="absenceTypesTable" class="table table-striped dt-responsive mb-0">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th class="ps-4">Código</th>
                        <th>Descripción de la Ausencia / Incidencia</th>
                        <th class="text-center">Remunerada</th>
                        <th class="text-center">Afecta Vacaciones</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <code class="fw-bold fs-13 text-primary">@item.Codigo</code>
                            </td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td>
                                @if (item.Remunerada)
                                {
                                    <span class="badge badge-soft-success"><i class="ti ti-check me-1"></i> SÍ</span>
                                }
                                else
                                {

                                    <span class="badge badge-soft-danger"><i class="ti ti-x me-1"></i> NO</span>
                                }
                            </td>
                            <td>
                                @if (item.AfectaVacaciones)
                                {
                                    <span class="badge badge-soft-warning">SÍ</span>
                                }
                                else
                                {

                                    <span class="badge badge-soft-info">NO</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-list justify-content-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $('#absenceTypesTable').DataTable({
                pageLength: 25,
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
                responsive: true,
            });
        });
    </script>
}

