@model IEnumerable<Vercom.Models.ConceptoNomina>

@{
    ViewData["Title"] = "Index";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Configuración de Conceptos de Nómina</h4>
        <p class="text-muted small mb-0">Definición de devengos, deducciones y aportes patronales (RF-23).</p>
    </div>
    <div class="text-end">  
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-plus"></i> NUEVO CONCEPTO
        </a>
    </div>
</div>

<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-settings me-2 text-primary"></i>Catálogo de Conceptos Salariales</h5>
        </div>
        <div class="card-body">
            <table id="conceptosTable" class="table table-hover align-middle">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th >Código</th>
                        <th>Descripción del Concepto</th>
                        <th  class="text-center">Tipo</th>
                        <th>Cuenta Contable</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var typeClass = item.Tipo switch
                        {
                            "DEVENGO" => "badge-soft-success",
                            "DEDUCCION" => "badge-soft-danger",
                            "APORTE_PATRONAL" => "badge-soft-info",
                            _ => "badge-soft-secondary"
                        };

                        <tr>
                            <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td ><span class="badge @typeClass">@item.Tipo</span></td>
                            <td class="small">@item.CuentaContableId</td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Editar">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Ver">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#conceptosTable').DataTable({
                pageLength: 25,
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
                responsive: true,
            });
        });
    </script>
}
