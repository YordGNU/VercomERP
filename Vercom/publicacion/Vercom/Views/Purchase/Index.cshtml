@model IEnumerable<Vercom.Models.OrdenCompra>
@{
    ViewBag.Title = "Órdenes de Compra";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Abastecimiento y Compras</h4>
        <p class="text-muted small mb-0">Gestión de órdenes de compra a proveedores y recepción de mercancías.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Comercial</a></li>
            <li class="breadcrumb-item active">Compras</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-shopping-cart-plus"></i> NUEVA ORDEN
        </a>
    </div>
</div>

<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Órdenes de Compra Emitidas</h5>
        </div>
        <div class="card-body">
            <table id="purchaseTable" class="table table-striped dt-responsive mb-0">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th  class="text-center">Fecha</th>
                        <th> Nº Orden</th>
                        <th>Proveedor</th>
                        <th >Moneda</th>
                       <th>Monto Total ($)</th>
                        <th  class="text-center">Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.Estado switch
                        {
                            "RECIBIDA" => "badge-soft-success",
                            "APROBADA" => "badge-soft-info",
                            "BORRADOR" => "badge-soft-warning",
                            "ANULADA" => "badge-soft-danger",
                            _ => "badge-soft-secondary"
                        };

                        <tr>
                            <td class="text-date">@item.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="text-numeric fw-bold text-primary">@item.NumeroOrden</td>
                            <td class="fw-semibold">@item.Proveedor.RazonSocial</td>
                            <td >@item.Moneda</td>
                            <td class="text-numeric fw-bold">@item.Total.ToString("N2")</td>
                            <td ><span class="badge @statusClass">@item.Estado</span></td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Detalles">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    @if (item.Estado == "APROBADA")
                                    {
                                        <a asp-action="Receive" asp-route-id="@item.Id" class="btn btn-sm btn-outline py-1 px-2 text-success" title="Recibir Mercancía">
                                            <i class="ti ti-download"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#purchaseTable').DataTable({
                    language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[0, 'desc']]
            });
        });
    </script>
}
