@model Vercom.Models.OrdenCompra
@inject Vercom.Services.IEntidadDisplayService EntidadDisplay
@{
    ViewBag.Title = "Orden de Compra: " + Model.NumeroOrden;
}

@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> VOLVER</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Gestión de Aprovisionamiento", Subtitle = "Orden de Compra a Suministrador (RF-51).", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <!-- Columna Izquierda: Información de la Orden -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4 invoice-print">
                <div class="card-body p-5">
                    <!-- Cabecera Documento -->
                    <div class="row mb-5">
                        <div class="col-6">
                            <h2 class="fw-bold text-primary mb-1">@EntidadDisplay.Name</h2>
                            <p class="text-muted mb-0 small">NIT: @Model.Entidad.Nit | REEUP: @Model.Entidad.CodigoReeup</p>
                            <p class="text-muted small">@Model.Entidad.DireccionLegal</p>
                        </div>
                        <div class="col-6 text-end">
                            <h1 class="fw-bold text-uppercase h3 mb-0">Orden de Compra</h1>
                            <h3 class="fw-bold text-primary mb-0">#@Model.NumeroOrden</h3>
                            <p class="mb-0 fw-bold">Fecha: @Model.Fecha.ToString("dd/MM/yyyy")</p>
                            @{
                                var statusClass = Model.Estado switch {
                                    "RECIBIDA_TOTAL" => "bg-success",
                                    "RECIBIDA_PARCIAL" => "bg-info",
                                    "RECIBIDA" => "bg-success",
                                    "APROBADA" => "bg-primary",
                                    "BORRADOR" => "bg-warning",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusClass px-3">@Model.Estado</span>
                        </div>
                    </div>

                    <!-- Datos de las Partes -->
                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <h6 class="text-muted text-uppercase small fw-bold mb-2">Proveedor:</h6>
                            <h5 class="fw-bold mb-1">@Model.Proveedor.RazonSocial</h5>
                            <p class="mb-1 text-muted small">NIT: @Model.Proveedor.Nit</p>
                            <p class="mb-0 text-muted small">Dirección: @Model.Proveedor.Direccion</p>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <h6 class="text-muted text-uppercase small fw-bold mb-2">Logística:</h6>
                            <p class="mb-1 small"><strong>Almacén Destino:</strong> @Model.AlmacenDestino.Nombre</p>
                            <p class="mb-1 small"><strong>Entrega Esperada:</strong> @(Model.FechaEntregaEsperada?.ToString("dd/MM/yyyy") ?? "Inmediata")</p>
                            @if (Model.Contrato != null) {
                                <p class="mb-0 text-primary small"><strong>Contrato:</strong> @Model.Contrato.NumeroContrato</p>
                            }
                        </div>
                    </div>

                    <!-- Tabla de Artículos -->
                    <div class="table-responsive mb-5">
                        <table class="table table-bordered align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th width="80">Cód.</th>
                                    <th>Descripción del Producto</th>
                                    <th class="text-center">Cant. Solicitada</th>
                                    <th class="text-center">Cant. Recibida</th>
                                    <th class="text-end">Precio Unit.</th>
                                    <th class="text-end pe-4">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var det in Model.OrdenCompraDetalles)
                                {
                                    <tr>
                                        <td class="font-monospace small">@det.Producto.Codigo</td>
                                        <td>
                                            <div class="fw-bold">@det.Producto.Nombre</div>
                                            <small class="text-muted">U.M: @det.Producto.UnidadMedida.Codigo</small>
                                        </td>
                                        <td class="text-center fw-bold">@det.CantidadSolicitada.ToString("N2")</td>
                                        <td>
                                            <span class="badge @(det.CantidadRecibida >= det.CantidadSolicitada ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                                @det.CantidadRecibida.ToString("N2")
                                            </span>
                                        </td>
                                        <td class="text-end">@det.PrecioUnitario.ToString("C2")</td>
                                       <td class="fw-bold">@(det.SubtotalLinea?.ToString("C2") ?? "0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Totales -->
                    <div class="row justify-content-end">
                        <div class="col-md-5">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <th class="text-muted">Subtotal:</th>
                                   <td class="fw-bold">@Model.Subtotal.ToString("C2")</td>
                                </tr>
                                <tr class="border-top">
                                    <th class="h4 fw-bold">TOTAL @Model.Moneda:</th>
                                    <td class="h4 text-end text-primary fw-bold">@Model.Total.ToString("C2")</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Recepciones y Auditoría -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                 <div class="card-header bg-light-subtle py-3">
                    <h5 class="m-0 fw-bold small text-uppercase"><i class="ti ti-package me-2"></i>Historial de Recepciones</h5>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @foreach (var rec in Model.RecepcionCompras)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-primary small">IR #@rec.NumeroInformeRecepcion</span>
                                    <small class="text-muted">@rec.Fecha.ToString("dd/MM/yyyy")</small>
                                </div>
                                <div class="small text-muted">Recibido por: @rec.RecibidoPorNavigation?.NombreCompleto</div>
                            </div>
                        }
                        @if (!Model.RecepcionCompras.Any())
                        {
                            <div class="p-4 text-center text-muted small italic">No hay informes de recepción registrados.</div>
                        }
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center mb-2">
                        <i class="ti ti-user me-2 text-muted"></i>
                        <small class="text-muted">Emitido por: <strong>@Model.CreadoPorNavigation?.NombreCompleto</strong></small>
                    </div>
                    @if (Model.AprobadoPor.HasValue)
                    {
                        <div class="d-flex align-items-center text-success mb-2">
                            <i class="ti ti-shield-check me-2"></i>
                            <small>Aprobado por: <strong>@Model.AprobadoPorNavigation?.NombreCompleto</strong></small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .app-topbar, .sidenav-menu, .footer, .btn, .page-title-head { display: none !important; }
        .content-page { margin-left: 0 !important; padding: 0 !important; }
        .container-xxl { max-width: 100% !important; width: 100% !important; }
        .card { border: 0 !important; box-shadow: none !important; }
        body { background: white !important; }
    }
</style>
