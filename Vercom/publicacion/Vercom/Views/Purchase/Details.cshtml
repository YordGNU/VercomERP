@model Vercom.Models.OrdenCompra
@{
    ViewBag.Title = "Detalle de Orden de Compra";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0">Orden de Compra #@Model.NumeroOrden</h4>
        <p class="text-muted small mb-0">Proveedor: <span class="fw-bold">@Model.Proveedor.RazonSocial</span></p>
    </div>
    <div class="text-end d-flex gap-2">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i> VOLVER
        </a>

        @if (Model.Estado == "PENDIENTE")
        {
            <form asp-action="Approve" method="post" class="d-inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-sm btn-success">
                    <i class="ti ti-check me-1"></i> APROBAR ORDEN
                </button>
            </form>
        }

        @if (Model.Estado == "APROBADA")
        {
            <a asp-action="Receive" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                <i class="ti ti-package-import me-1"></i> REGISTRAR RECEPCIÓN
            </a>
        }
    </div>
</div>

<div class="row">
    <div class="row">
        <!-- Información de Cabecera -->
        <div class="col-lg-8">
            <div class="card mb-4">
                 <div class="card-header border-light justify-content-between">
                    <h5 class="m-0 fw-bold"><i class="ti ti-info-circle me-2 text-primary"></i>Datos de la Orden</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold d-block">Fecha Emisión</label>
                            <span>@Model.Fecha.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted small text-uppercase fw-bold d-block">Entrega Esperada</label>
                            <span>@(Model.FechaEntregaEsperada?.ToString("dd/MM/yyyy") ?? "No definida")</span>
                        </div>
                        <div class="col-md-4 text-end">
                            <label class="text-muted small text-uppercase fw-bold d-block">Estado Actual</label>
                            @{
                                var statusClass = Model.Estado switch {
                                    "RECIBIDA" => "badge-soft-success",
                                    "APROBADA" => "badge-soft-primary",
                                    "PENDIENTE" => "badge-soft-warning",
                                    _ => "badge-soft-secondary"
                                };
                            }
                            <span class="badge @statusClass fs-13">@Model.Estado</span>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold d-block">Almacén Destino</label>
                            <span class="fw-bold">@Model.AlmacenDestino.Nombre</span>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small text-uppercase fw-bold d-block">Contrato Relacionado</label>
                            <span>@(Model.Contrato?.NumeroContrato ?? "Operación sin contrato")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detalle de Ítems -->
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Partidas de Compra</h5>
                </div>
                <div class="card-body">
                    <table class="table table-vcenter mb-0">
                    <thead class="thead-sm text-uppercase fs-xxs">
                            <tr>
                                <th>Artículo</th>
                                <th class="text-center">Cantidad</th>
                               <th>P. Unitario</th>
                               <th>Importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var det in Model.OrdenCompraDetalles)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@det.Producto.Nombre</div>
                                        <small class="text-muted">@det.Producto.Codigo</small>
                                    </td>
                                    <td >@(det.CantidadSolicitada.ToString("N2") ?? "0.00")</td>
                                    <td>@det.PrecioUnitario.ToString("N2")</td>
                                    <td class="text-end fw-bold">@(det.SubtotalLinea?.ToString("N2") ?? "0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Resumen de Costos -->
        <div class="col-lg-4">
            <div class="card mb-4">
                 <div class="card-header border-light justify-content-between">
                    <h5 class="m-0 fw-bold"><i class="ti ti-calculator me-2 text-primary"></i>Resumen Financiero</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <span>@Model.Subtotal.ToString("N2") @Model.Moneda</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Impuestos:</span>
                        <span>@((Model.Total - Model.Subtotal).ToString("N2")) @Model.Moneda</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="fw-bold m-0">TOTAL:</h4>
                        <h3 class="fw-bold text-primary m-0">@Model.Total.ToString("N2") @Model.Moneda</h3>
                    </div>
                </div>
            </div>

            <!-- Auditoría -->
            <div class="card">
                <div class="card-body py-3">
                    <div class="d-flex align-items-center mb-2">
                        <i class="ti ti-user me-2 text-muted"></i>
                        <small class="text-muted">Registrado por: <strong>@Model.CreadoPorNavigation?.NombreCompleto</strong></small>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <i class="ti ti-calendar me-2 text-muted"></i>
                        <small class="text-muted">Fecha Sistema: @Model.CreadoEn.ToString("g")</small>
                    </div>
                    @if (Model.AprobadoPor.HasValue)
                    {
                        <div class="d-flex align-items-center text-success">
                            <i class="ti ti-shield-check me-2"></i>
                            <small>Aprobado por: <strong>@Model.AprobadoPorNavigation?.NombreCompleto</strong></small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .badge-soft-success { background-color: #ecfdf5; color: #059669; }
    .badge-soft-primary { background-color: #eff6ff; color: #2563eb; }
    .badge-soft-warning { background-color: #fffbeb; color: #d97706; }
</style>
