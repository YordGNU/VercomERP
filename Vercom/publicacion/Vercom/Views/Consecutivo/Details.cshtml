@model Vercom.Models.Consecutivo

@inject Vercom.Services.IEntidadDisplayService EntidadDisplay
@{
    ViewBag.Title = "Detalle del Consecutivo";
}
@{ var headerActions = "<a href='" + Url.Action("Index") + "' class='btn btn-sm btn-outline-secondary'><i class='ti-file me-1'></i> Consecutivo</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Sistema", Title = "Detalle del Consecutivo", Subtitle = "Control de numeración por tipo de documento y serie (RNF-51).", Icon = "ti-file", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />


<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header border-light justify-content-between">
                <h4 class="card-title">Información del Consecutivo</h4>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Tipo de documento</dt>
                    <dd class="col-sm-8">@Model.TipoDocumento</dd>
                    <dt class="col-sm-4">Serie</dt>
                    <dd class="col-sm-8">@Model.Serie</dd>
                    <dt class="col-sm-4">Sucursal</dt>
                    <dd class="col-sm-8">@(Model.Sucursal?.Nombre ?? "Central (todas)")</dd>
                    <dt class="col-sm-4">Entidad</dt>
                    <dd class="col-sm-8">@EntidadDisplay.Name</dd>
                    <dt class="col-sm-4">Último número</dt>
                    <dd class="col-sm-8"><span class="badge bg-success fs-6 px-3 py-2 text-numeric">@Model.UltimoNumero</span></dd>
                    <dt class="col-sm-4">Longitud de relleno</dt>
                    <dd class="col-sm-8">@Model.LongitudPadding</dd>
                    <dt class="col-sm-4">Actualizado en</dt>
                    <dd class="col-sm-8">@Model.ActualizadoEn.ToLocalTime().ToString("g")</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm"><i class="ti ti-edit me-1"></i>Editar</a>
                <a asp-action="Index" class="btn btn-light btn-sm">Volver</a>
            </div>
        </div>
    </div>
</div>