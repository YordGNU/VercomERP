@model Vercom.ViewModels.MermaFormViewModel

@{
    ViewData["Title"] = "Edit";
}



<h4>Merma</h4>
<hr />
<div class="row">
    <div class="col-md-4">
       @{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Inventario", Title = "Editar Merma", Subtitle = "", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h4 class="card-title">Formulario de Edición</h4>
                </div>
                <div class="card-body">
<form class="row g-3" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Merma.Id" />
            <div class="mb-3">
                <label asp-for="Merma.OrdenProduccionId" class="form-label"></label>
                <select asp-for="Merma.OrdenProduccionId" class="form-control" asp-items="ViewBag.OrdenProduccionId"></select>
                <span asp-validation-for="Merma.OrdenProduccionId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Merma.ProductoId" class="form-label"></label>
                <input asp-for="Merma.ProductoId" class="form-control" />
                <span asp-validation-for="Merma.ProductoId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Merma.Cantidad" class="form-label"></label>
                <input asp-for="Merma.Cantidad" class="form-control" />
                <span asp-validation-for="Merma.Cantidad" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Merma.Causa" class="form-label"></label>
                <input asp-for="Merma.Causa" class="form-control" />
                <span asp-validation-for="Merma.Causa" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Merma.ValorContable" class="form-label"></label>
                <input asp-for="Merma.ValorContable" class="form-control" />
                <span asp-validation-for="Merma.ValorContable" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Merma.AsientoId" class="form-label"></label>
                <input asp-for="Merma.AsientoId" class="form-control" />
                <span asp-validation-for="Merma.AsientoId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Merma.Fecha" class="form-label"></label>
                <input asp-for="Merma.Fecha" class="form-control" />
                <span asp-validation-for="Merma.Fecha" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Merma.Observaciones" class="form-label"></label>
                <input asp-for="Merma.Observaciones" class="form-control" />
                <span asp-validation-for="Merma.Observaciones" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

