@model IEnumerable<Vercom.Models.UnidadMedidum>
@{ ViewBag.Title = "Unidades de Medida"; }

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> NUEVA UNIDAD</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Catálogo de Inventario", Title = "Unidades de Medida", Subtitle = "Nomenclador de magnitudes para el control de inventario y producción.", Icon = "ti-scale", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name="_PageHeader" model="pageHeader" />

<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-scale me-2 text-primary"></i>Unidades Registradas</h5>
        </div>
        <div class="card-body">
            <table id="unitsTable" class="table table-striped table-hover dt-responsive">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                           <th>Sigla / Código</th>
                        <th>Nombre de la Unidad</th>
                        <th>Fraccionable</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td >
                                @if (item.EsFraccionable)
                                {
                                    <span class="badge badge-soft-info">SÍ</span>
                                }
                                else
                                {

                                    <span class="badge badge-soft-secondary">NO</span>
                                }
                            </td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle"title="Editar">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#unitsTable").DataTable({
                language: { url: "@Url.Content("~/lib/i18n/es-ES.json")" },
                order: [[1, "asc"]],
                dom: "<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>",
            });
        });
    </script>
}
