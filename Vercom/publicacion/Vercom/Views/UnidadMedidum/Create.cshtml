@model Vercom.Models.UnidadMedidum
@{
    ViewBag.Title = "Nueva Unidad de Medida";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Definir Unidad de Medida</h4>
        <p class="text-muted small mb-0">Gestión de magnitudes físicas para el control de inventarios.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Inventario</a></li>
            <li class="breadcrumb-item active">Unidades</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                 <div class="card-header border-light justify-content-between">
                    <h5 class="m-0 fw-bold"><i class="ti ti-scale me-2 text-primary"></i>Datos de la Magnitud</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-4" id="createUnitForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-4">
                            <label class="form-label">Sigla / Código</label>
                            <input asp-for="Codigo" class="form-control w-100 fw-bold text-primary text-uppercase" placeholder="Ej: KG" required maxlength="10" />
                            <span asp-validation-for="Codigo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Nombre de la Unidad</label>
                            <input asp-for="Nombre" class="form-control w-100" placeholder="Ej: Kilogramos" required maxlength="50" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-2">
                            <div class="form-check form-switch p-3 bg-light-subtle border rounded-3">
                                <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="EsFraccionable">
                                <label class="form-check-label fw-bold">Permitir Cantidades Fraccionarias (Decimales)</label>
                                <p class="text-muted small mb-0 mt-1">Habilite esta opción para unidades que puedan dividirse (ej: litros, gramos).</p>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> GUARDAR UNIDAD
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            window.SubmitAjaxForm('createUnitForm');
        });
    </script>
}
