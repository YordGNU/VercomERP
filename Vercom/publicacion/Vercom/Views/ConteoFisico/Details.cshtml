@model Vercom.Models.ConteoFisico
@{
    ViewBag.Title = "Detalle de Conteo Físico";
    var diffCount = Model.ConteoFisicoDetalles.Count(d => d.Diferencia != 0);
}

@{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Inventario", Title = "Auditoría de Stock: ", Subtitle = "Resultados del levantamiento físico vs. existencias en sistema.", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <!-- Resumen del Conteo -->
        <div class="col-lg-3">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-status-top @(Model.Estado == "CERRADO" ? "bg-success" : "bg-warning")"></div>
                <div class="card-body p-4 text-center">
                    <div class="avatar avatar-xl bg-light text-primary rounded-circle mb-3 mx-auto" style="width: 80px; height: 80px;">
                        <i class="ti ti-clipboard-check fs-40"></i>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.Fecha.ToString("dd MMM yyyy")</h3>
                    <p class="text-muted small text-uppercase fw-bold mb-3">Fecha del Levantamiento</p>

                    <span class="badge @(Model.Estado == "CERRADO" ? "badge-soft-success" : "badge-soft-warning") fs-12 px-3 py-2">
                        <i class="ti ti-circle-filled me-1"></i> @Model.Estado
                    </span>

                    <div class="mt-4 pt-3 border-top text-start">
                        <div class="mb-2">
                            <label class="text-muted tiny fw-bold text-uppercase d-block mb-1">Responsable</label>
                            <span class="small fw-bold">@(Model.Responsable?.NombreCompleto ?? "No asignado")</span>
                        </div>
                        <div>
                            <label class="text-muted tiny fw-bold text-uppercase d-block mb-1">Tipo de Auditoría</label>
                            <span class="badge badge-outline text-primary">@Model.Tipo</span>
                        </div>
                    </div>
                </div>
            </div>

            @if(diffCount > 0) {
                <div class="card bg-danger-subtle border-0 shadow-sm mb-4">
                    <div class="card-body p-4 text-center">
                        <h1 class="display-5 fw-bold text-danger mb-0">@diffCount</h1>
                        <p class="text-danger fw-bold small text-uppercase">Discrepancias Detectadas</p>
                    </div>
                </div>
            } else if(Model.Estado == "CERRADO") {
                <div class="card bg-success-subtle border-0 shadow-sm mb-4">
                    <div class="card-body p-4 text-center">
                        <i class="ti ti-circle-check fs-48 text-success mb-2"></i>
                        <h4 class="fw-bold text-success">Inventario Cuadrado</h4>
                        <p class="text-success small mb-0">Sin diferencias relevantes.</p>
                    </div>
                </div>
            }
        </div>

        <!-- Matriz de Resultados -->
        <div class="col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
                    <h5 class="m-0 fw-bold"><i class="ti ti-list me-2 text-primary"></i>Cuadro Comparativo de Existencias</h5>
                </div>
                <div class="card-body">
                    @if (Model.Estado == "EN_PROCESO")
                    {
                        <form asp-action="SubmitDetail" method="post" class="row g-2 align-items-end mb-4 d-print-none">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="conteoId" value="@Model.Id" />
                            <div class="col-lg-5">
                                <label class="form-label small fw-bold">Producto</label>
                                <select name="productoId" class="form-select" required>
                                    <option value="">-- Seleccione un producto --</option>
                                    @foreach (var producto in (IEnumerable<Vercom.Models.Producto>)ViewBag.Productos)
                                    {
                                        <option value="@producto.Id">@producto.Codigo - @producto.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="col-lg-2">
                                <label class="form-label small fw-bold">Cantidad física</label>
                                <input name="cantidadFisica" type="number" min="0" step="0.0001" class="form-control" required />
                            </div>
                            <div class="col-lg-3">
                                <label class="form-label small fw-bold">Justificación (obligatoria si hay faltante)</label>
                                <input name="justificacion" maxlength="500" class="form-control" />
                            </div>
                            <div class="col-lg-2">
                                <button type="submit" class="btn btn-primary w-100"><i class="ti ti-plus me-1"></i> REGISTRAR</button>
                            </div>
                        </form>
                    }
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table table-hover">
                            <thead>
                                <tr>
                                    <th>Producto / Artículo</th>
                                  <th>Sistema</th>
                                  <th>Físico</th>
                                  <th>Diferencia</th>
                                    <th>Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var d in Model.ConteoFisicoDetalles) {
                                    var diff = d.Diferencia ?? 0;
                                    var rowClass = diff < 0 ? "bg-danger-subtle" : diff > 0 ? "bg-success-subtle" : "";
                                    <tr>
                                        <td>
                                            <div class="fw-bold fs-13">@d.Producto.Nombre</div>
                                            <div class="text-muted tiny font-monospace">@d.Producto.Codigo</div>
                                        </td>
                                        <td fw-bold">@d.CantidadSistema.ToString("N2")</td>
                                        <td class="fw-bold text-primary">@(d.CantidadFisica?.ToString("N2") ?? "-")</td>
                                        <td >
                                            @if(d.CantidadFisica.HasValue) {
                                                <span class="badge @(diff < 0 ? "bg-danger" : diff > 0 ? "bg-success" : "bg-light text-dark")">
                                                    @(diff > 0 ? "+" : "")@diff.ToString("N2")
                                                </span>
                                            } else {
                                                <span class="text-muted">Pendiente</span>
                                            }
                                        </td>
                                        <td class="small">@(d.Justificacion ?? "-")</td>
                                    </tr>
                                }
                                @if(!Model.ConteoFisicoDetalles.Any()) {
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted small">No se han registrado lecturas en esta auditoría.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="ti ti-arrow-left me-1"></i> VOLVER AL LISTADO
                </a>

                @if(Model.Estado == "EN_PROCESO") {
                    <form asp-action="Close" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success px-5 py-2 shadow" disabled="@(Model.ConteoFisicoDetalles.Any(d => !d.CantidadFisica.HasValue) ? "disabled" : null)">
                            <i class="ti ti-lock-check me-1"></i> CERRAR Y AJUSTAR STOCK
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-12 { font-size: 0.75rem; }
    .fs-13 { font-size: 0.8125rem; }
</style>
