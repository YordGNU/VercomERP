@model IEnumerable<Vercom.Models.Cargo>
@{ ViewData["Title"] = "Index"; ViewBag.Title = "Gestión de Cargos"; }

@{ var headerActions = "<a href='" + Url.Action("Create") + "' class='btn btn-sm btn-primary'><i class='ti ti-plus me-1'></i> NUEVO CARGO</a>"; var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Recursos Humanos", Title = "Nomenclador de Cargos y Ocupaciones", Subtitle = "Definición de perfiles laborales y escalas salariales base.", Icon = "ti-briefcase", Tone = "primary", ActionsHtml = new Microsoft.AspNetCore.Html.HtmlString(headerActions) }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="card">
         <div class="card-header border-light justify-content-between">
            <h5 class="m-0 fw-bold"><i class="ti ti-briefcase me-2 text-primary"></i>Cargos Registrados</h5>
        </div>
        <div class="card-body">
            <table id="cargosTable" class="table table-hover align-middle">
                <thead class="thead-sm text-uppercase fs-xxs">
                    <tr>
                        <th >Código</th>
                        <th>Nombre del Cargo</th>
                        <th>Categoría</th>
                        <th>Escala Mínima ($)</th>
                        <th>Escala Máxima ($)</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-numeric fw-bold text-primary">@item.Codigo</td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td class="small">@item.CategoriaOcupacional</td>
                            <td class="text-numeric">@item.SalarioEscalaMin?.ToString("N2")</td>
                            <td class="text-numeric">@item.SalarioEscalaMax?.ToString("N2")</td>
                            <td>
                               <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle" title="Editar">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-icon btn-sm rounded-circle" title="Ver">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    <button type="button" class="btn btn-light btn-icon btn-sm rounded-circle text-danger" onclick="deleteCargo('@item.Id', '@item.Nombre')" title="Eliminar">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#cargosTable').DataTable({
                pageLength: 100,
                language: { url: '@Url.Content("~/lib/i18n/es-ES.json")' },
                order: [[1, 'asc']],
                dom: '<"row align-items-center"<"col-md-6"l><"col-md-6"f>>rt<"row align-items-center"<"col-md-5"i><"col-md-7"p>>',
                responsive: true,
            });
        });

        function deleteCargo(id, nombre) {
            Swal.fire({
                title: '¿Eliminar Cargo?',
                text: `Se eliminará el cargo: ${nombre}. Esta acción no se puede deshacer.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'SÍ, ELIMINAR'
            }).then((result) => {
                if (result.isConfirmed) {
                    const formData = new FormData();
                    formData.append("id", id);
                    formData.append("__RequestVerificationToken", $('input[name="__RequestVerificationToken"]').val());

                    fetch('/Cargo/Delete', {
                        method: 'POST',
                        body: formData
                    }).then(res => res.json()).then(data => {
                        if (data.success) {
                            window.SwalAlert('success', data.message);
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            Swal.fire('Error', data.message, 'error');
                        }
                    });
                }
            });
        }
    </script>
}
