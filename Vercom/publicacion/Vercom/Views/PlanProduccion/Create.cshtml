@model Vercom.Models.PlanProduccion
@{
    ViewBag.Title = "Nuevo Plan de Producción";
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Establecer Metas Mensuales</h4>
        <p class="text-muted small mb-0">Planificación de volúmenes de fabricación para el cumplimiento presupuestario.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Producción</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Planificación</a></li>
            <li class="breadcrumb-item active">Nuevo</li>
        </ol>
    </div>
</div>

<div class="container-xxl">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light-subtle py-3">
                    <h5 class="m-0 fw-bold"><i class="ti ti-calendar-plus me-2 text-primary"></i>Configuración del Periodo</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="row g-4">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small border-0 mb-0 shadow-sm"></div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Año Fiscal</label>
                            <input asp-for="Anio" class="form-control fw-bold text-center" value="@DateTime.Now.Year" required />
                            <span asp-validation-for="Anio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label fw-bold">Mes de Planificación</label>
                            <select asp-for="Mes" class="form-select" required>
                                <option value="1">Enero</option>
                                <option value="2">Febrero</option>
                                <option value="3">Marzo</option>
                                <option value="4">Abril</option>
                                <option value="5">Mayo</option>
                                <option value="6">Junio</option>
                                <option value="7">Julio</option>
                                <option value="8">Agosto</option>
                                <option value="9">Septiembre</option>
                                <option value="10">Octubre</option>
                                <option value="11">Noviembre</option>
                                <option value="12">Diciembre</option>
                            </select>
                            <span asp-validation-for="Mes" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Presupuesto Vinculado (Opcional)</label>
                            <select asp-for="PresupuestoId" class="form-select select2" asp-items="ViewBag.PresupuestoId">
                                <option value="">-- Sin vinculación directa --</option>
                            </select>
                            <small class="text-muted">Permite comparar la ejecución física contra la financiera.</small>
                        </div>

                        <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">CANCELAR</a>
                            <button type="submit" class="btn btn-sm btn-primary px-5 py-2 shadow">
                                <i class="ti ti-device-floppy me-1"></i> CREAR PLAN MAESTRO
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
