@model Vercom.ViewModels.PlanProduccionFormViewModel

@{
    ViewData["Title"] = "Edit";
}



<h4>PlanProduccion</h4>
<hr />
<div class="row">
    <div class="col-md-4">
       @{ var pageHeader = new Vercom.ViewModels.PageHeaderModel { Eyebrow = "Producción", Title = "Editar PlanProduccion", Subtitle = "", Icon = "ti-file", Tone = "primary" }; }
<partial name='_PageHeader' model='pageHeader' />



<div class="row">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                 <div class="card-header border-light justify-content-between">
                    <h4 class="card-title">Formulario de Edición</h4>
                </div>
                <div class="card-body">
<form class="row g-3" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Plan.Id" />
            <div class="mb-3">
                <label asp-for="Plan.EntidadId" class="form-label"></label>
                <input asp-for="Plan.EntidadId" class="form-control" />
                <span asp-validation-for="Plan.EntidadId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Plan.Anio" class="form-label"></label>
                <input asp-for="Plan.Anio" class="form-control" />
                <span asp-validation-for="Plan.Anio" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Plan.Mes" class="form-label"></label>
                <input asp-for="Plan.Mes" class="form-control" />
                <span asp-validation-for="Plan.Mes" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Plan.PresupuestoId" class="form-label"></label>
                <input asp-for="Plan.PresupuestoId" class="form-control" />
                <span asp-validation-for="Plan.PresupuestoId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Plan.Estado" class="form-label"></label>
                <input asp-for="Plan.Estado" class="form-control" />
                <span asp-validation-for="Plan.Estado" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Plan.CreadoEn" class="form-label"></label>
                <input asp-for="Plan.CreadoEn" class="form-control" />
                <span asp-validation-for="Plan.CreadoEn" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

