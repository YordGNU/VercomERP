@model IEnumerable<Vercom.Models.PlanProduccion>
@{
    ViewBag.Title = "Planificación de Producción";
    var meses = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
}

<div class="page-title-head d-flex align-items-center p-3 mb-4">
    <div class="flex-grow-1">
        <h4 class="page-main-title m-0 fw-bold">Planificación Mensual de Producción</h4>
        <p class="text-muted small mb-0">Gestión de metas de fabricación alineadas con el presupuesto corporativo.</p>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 mb-2 justify-content-end">
            <li class="breadcrumb-item"><a href="javascript: void(0);">Vercom</a></li>
            <li class="breadcrumb-item"><a href="javascript: void(0);">Producción</a></li>
            <li class="breadcrumb-item active">Planificación</li>
        </ol>
        <a asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="ti ti-calendar-plus me-1"></i> NUEVO PLAN MENSUAL
        </a>
    </div>
</div>

<div class="container-xxl">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-light-subtle d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold"><i class="ti ti-calendar-stats me-2 text-primary"></i>Planes Maestros de Producción</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="productionPlansTable" class="table table-striped dt-responsive mb-0">
                <thead class="thead-sm text-uppercase fs-xxs">
                        <tr>
                            <th class="ps-4">Periodo (Mes/Año)</th>
                            <th>Presupuesto Vinculado</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">F. Creación</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(p => p.Anio).ThenByDescending(p => p.Mes))
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold fs-15 text-primary">@item.Mes @item.Anio</div>
                                </td>
                                <td>
                                    @if(item.Presupuesto != null) {
                                        <div class="fw-semibold small">@item.Presupuesto.Nombre</div>
                                        <small class="text-muted tiny">Código: @item.Presupuesto.Id.ToString().Substring(0,8)</small>
                                    } else {
                                        <span class="text-muted small italic">Sin vinculación</span>
                                    }
                                </td>
                                <td >
                                    @{
                                        var statusClass = item.Estado switch {
                                            "APROBADO" => "bg-success-subtle text-success",
                                            "BORRADOR" => "bg-warning-subtle text-warning",
                                            "CERRADO" => "bg-secondary-subtle text-secondary",
                                            _ => "bg-light"
                                        };
                                    }
                                    <span class="badge @statusClass px-3">@item.Estado</span>
                                </td>
                                <td class="text-center small text-muted">
                                    @item.CreadoEn.ToString("dd/MM/yyyy")
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-list justify-content-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle" title="Ver Detalles">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        @if(item.Estado == "BORRADOR") {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-light rounded-circle" title="Editar">
                                                <i class="ti ti-edit"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted small">
                                    <i class="ti ti-calendar-off fs-40 d-block mb-2 opacity-50"></i>
                                    No se han definido planes de producción.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#productionPlansTable').DataTable({
                language: { url: '/js/i18n/es-ES.json' },
                order: [[0, 'desc']]
            });
        });
    </script>
}

<style>
    .tiny { font-size: 0.65rem; letter-spacing: 0.05em; }
    .fs-15 { font-size: 0.95rem; }
</style>
